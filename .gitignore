/.idea/
/local/

# Секреты/рантайм be7000.ps1 (лежат в корне; в git только *.example-шаблоны).
awg.conf
/configs/
notify.conf
/backups/
/diag/
# Рантайм гео-категорий (реестр действий + снимки CIDR) — живёт на /data роутера; локально
# создаётся только при случайном сорсинге geo.sh (его top-level mkdir), в репо не нужен.
/geo/
*.bak
# Xray-секреты (vless-ключи внутри). hev.yaml/xray-transport.sh — НЕ секрет, в git.
xray.json
/xray-configs/
# Hysteria2-секреты (auth/obfs-пароли внутри). transport-hy2.sh — НЕ секрет, в git.
hysteria.yaml
/hy2-configs/
# Режим поддержки: КЛЮЧ туннеля роутер→релей (.support-key) и координаты релея
# (.support-relay). Оба — доступ к ТВОЕМУ VPS-релею; никогда не в git/публичный репо
# (support.sh — не секрет, в git). connect-ключ разработчика лежит в /local/ (уже ignored).
.support-key
.support-relay
# Рабочая папка UPX-сжатия бинарей (сам upx + оригинал-бэкап amneziawg-go.user.orig).
# Локальный инструментарий, не для репо; оригинал держим как fallback, если UPX сломает awg0.
/.upxtmp/

# Артефакты Python-порта ПК-стороны (enodia.py).
__pycache__/
*.pyc

# УТИЛИТА ОТКРЫТИЯ ДОСТУПА (xmir-patcher) — БОЛЬШЕ НЕ ВЕНДОРИМ, качается по нужде.
# У апстрима (openwrt-xiaomi/xmir-patcher) ЛИЦЕНЗИИ НЕТ ВООБЩЕ — ни файла, ни строки в README
# (проверено 30.08.2026). Отсутствие лицензии = все права у автора: ToS GitHub даёт смотреть и
# ФОРКАТЬ в пределах GitHub, но не раздавать копию своим архивом — а мы раздавали её и в репо,
# и в ZIP, который качают тестеры. Теперь байты приезжают человеку С GITHUB, из нашего форка
# Axel173/xmir-patcher (ветка `enodia` = апстрим + наши правки), пиннутого ПО КОММИТУ, и только
# когда SSH реально закрыт: `_patcher_ensure()` в enodia.py. Заодно минус 21 МБ из репо и из
# дев-архива (он собирается по `git ls-files`, так что снятие с учёта убирает файлы и оттуда).
# Каталог у себя оставить МОЖНО — если он на месте, enodia.py берёт ЕГО и ничего не качает.
/wizard/patcher/

# Хеши релиза генерит dev/build-sha256.ps1 в ПУБЛИЧНОЙ папке (там и коммитятся). В рабочем
# дереве файл появляется только при локальной проверке генератора и мгновенно протухает
# (каждая правка скрипта = новая сумма) — в git его тут не держим.
/SHA256SUMS

# Артефакты Playwright (скриншоты UX-проверок живой панели), не для репо.
# Только корень: docs/img/*.png (скриншоты инструкции) остаются в git.
/.playwright-mcp/
/*.png
