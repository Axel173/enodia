#!/bin/sh
# cgi-bin/2fa — ЕДИНСТВЕННАЯ точка входа для второго фактора (TOTP): вход по коду, привязка
# приложения, отключение, перевыпуск кодов восстановления, список подтверждённых устройств и
# выход на всех / на всех кроме текущего / на одном конкретном.
# Вся логика — в $ENODIA_DIR/totp.sh (одна копия), тут только разбор формы и куки.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ CGI, А НЕ ВЕТКА В action: сессионную куку выдаёт заголовок Set-Cookie, а
# action печатает заголовки ПЕРВОЙ строкой, ещё не зная результата — приделать туда куку можно
# было бы только переписав его вывод целиком. Плюс `op=login` обязан работать БЕЗ действующей
# сессии (это и есть вход), а любая ветка внутри action по определению уже за гейтом.
#
# Защита:
#  - ПАРОЛЬНАЯ сессия (cgi-bin/login, уровень 1) обязательна даже для op=login: код не заменяет
#    пароль, а ПОВЫШАЕТ его сессию до уровня 2 (03.09.2026: форма входа вместо HTTP-Basic);
#  - CSRF-токен синхронизатора (как в action) на КАЖДУЮ операцию, включая вход;
#  - полный гейт (уровень 2) на всё, кроме op=login (иначе знающий пароль отключил бы второй фактор);
#  - перебор кода тормозит счётчик неудач в totp.sh (пауза 60 с → ×2 → 15 мин), общий с паролем.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026 пробным CGI: все ENODIA_*
# пусты), а в режиме «всё на накопителе» литералы ниже указывают в пустоту — панель отвечала бы
# «ничего не установлено» на живой системе. Каталог кода знаем бесплатно из $0, остальное
# разбирает cgi-paths.sh: второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
ENODIA_DIR=${ENODIA_DIR:-/data/usr/app/enodia}
TOKFILE=/tmp/enodia-panel-token

TOTP_LIB=1
[ -f "$ENODIA_DIR/totp.sh" ] || {
	echo "Content-Type: application/json; charset=utf-8"; echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0; }
. "$ENODIA_DIR/totp.sh"
# И СПОСОБНОСТЬ, А НЕ ТОЛЬКО НАЛИЧИЕ — тот же гард, что в десяти остальных CGI и в login.
# totp.sh СТАРЕЕ формы входа сорсится успешно, но его `totp_gate` при ВЫКЛЮЧЕННОМ 2FA возвращал 0,
# то есть этот файл оставался бы открыт целиком: `enroll`+`enable` дают постороннему включить
# второй фактор СВОИМ секретом (хозяин потом не войдёт вовсе), `logout` — мгновенный отказ в
# обслуживании. Смешанный набор «новые CGI + старый totp.sh» штатен: apply-scripts на провале
# ОДНОГО файла продолжает список.
command -v pw_verify >/dev/null 2>&1 || {
	echo "Content-Type: application/json; charset=utf-8"; echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }

# jesc <лимит> — «текст скрипта → строка внутри JSON» (json-lib.sh, одна копия на проект). Ветки
# enable/disable/recovery ниже показывают ЧЕЛОВЕКУ причину отказа из totp.sh, а она по-русски:
# прежняя форма резала `cut -c1-160` БАЙТАМИ и обрывала сообщение посреди буквы. Шим = прежнее
# поведение (либа могла не доехать на старую установку).
if [ -f "$ENODIA_DIR/json-lib.sh" ]; then . "$ENODIA_DIR/json-lib.sh"; fi
command -v jesc >/dev/null 2>&1 || {
	jesc() { tr -d '\033\r' | tr '\n\t' '  ' | cut -c1-"$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
}

# Ответ формируем ДО заголовков: от результата зависит Set-Cookie.
out=""; cookie=""
say()  { out=$(printf '{"ok":true,"msg":"%s"}' "$1"); }
deny() { out=$(printf '{"ok":false,"msg":"%s"}' "$1"); }
# ОТКАЗ ПО КОДУ — ОДНА ЛЕСТНИЦА на выключение и перевыпуск (ревью шага 7a, круг 2): перевыпуск схлопывал паузу в «код не подошёл»,
# и верный код во время паузы получал тот же отказ, что неверный. Код 3 — пауза с остатком (экран держит отсчёт), иначе — слова totp.sh.
code_refuse() {   # $1 — код totp.sh, $2 — его вывод
	if [ "$1" = 3 ]; then out=$(printf '{"ok":false,"msg":"слишком много неудачных попыток","lock":%s}' "$(totp_lock_left)")
	else deny "$(printf '%s' "$2" | jesc 160)"; lock_note; fi
}
# ПАУЗУ ВКЛЮЧИЛА ЭТА ЖЕ НЕУДАЧА (ревью шага 8a): проверка кода сама считает неудачи, и пятый неверный код уже запер вход — а ответ
# говорил только «код не подошёл». Человек тут же вводил ВЕРНЫЙ код и получал «слишком много неудачных попыток»: читалось как
# «верный код отвергли». Пауза пошла — отказ несёт её остаток (`lock`), как отказ пароля в cgi-bin/login, и окно ведёт отсчёт сразу.
# Последний знак `out` — всегда `}` (его строят deny и printf выше): снимаем его `%?`, без экранирования скобки в шаблоне.
lock_note() {
	_ln=$(totp_lock_left 2>/dev/null); case "$_ln" in ''|*[!0-9]*) _ln=0 ;; esac
	[ "$_ln" -gt 0 ] || return 0
	out="${out%?},\"lock\":$_ln}"
}
# ОТКРЫТА ЛИ ПАНЕЛЬ НАРУЖУ — по полю `wan_on` состояния, а не вербом `wan-enabled` (ревью шага 7a, круг 2): верб есть только у
# нового web-ui.sh, а старый на неизвестный верб печатает usage с кодом 1 — «закрыто», и при частичном обновлении второй фактор
# снимался при открытом порту. Поле `wan_on` отдаёт и старый.
# ТРИ ОТВЕТА, а не два (ревью шага 7a, круг 3): молчащий `json` (сбой одного верба) читался как «закрыто», и фактор снимался при открытом
# входе снаружи. Снимаем только при ЯВНОМ `"wan_on":false`; web-ui.sh нет вовсе — открыть наружу нечем, это «закрыто».
wan_state() {   # печатает open | closed | unknown
	[ -f "$ENODIA_DIR/web-ui.sh" ] || { echo closed; return 0; }
	case "$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)" in
		*'"wan_on":true'*) echo open ;; *'"wan_on":false'*) echo closed ;; *) echo unknown ;;
	esac
}
wan_open() { [ "$(wan_state)" = open ]; }

emit() {
	echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"
	[ -n "$cookie" ] && echo "Set-Cookie: $cookie"
	echo ""
	printf '%s\n' "$out"
	exit 0
}

# Кука сессии — значение заголовка строит totp.sh (одна копия на login и 2fa; флаги и их «почему»
# — там же, у totp_cookie).
clear_cookie() { cookie=$(totp_cookie_gone); }

[ "$REQUEST_METHOD" = "POST" ] || { deny "только POST"; emit; }

len=${CONTENT_LENGTH:-0}
case "$len" in ''|*[!0-9]*) len=0 ;; esac
{ [ "$len" -gt 0 ] && [ "$len" -le 4096 ]; } || { deny "пустой или слишком большой запрос"; emit; }
body=$(head -c "$len")
field() { echo "$body" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2-; }

tok=$(field token)
echo "$tok" | grep -qE '^[0-9a-f]+$' || { deny "нет токена"; emit; }
{ [ -s "$TOKFILE" ] && [ "$tok" = "$(cat "$TOKFILE")" ]; } || { deny "неверный токен (перезагрузите панель)"; emit; }

op=$(field op | tr -cd 'a-z')
# Код: только цифры/буквы/дефис (коды восстановления вида xxxxx-xxxxx). В shell-команду не
# уходит никогда — totp.sh сравнивает его строкой.
code=$(field code | tr -cd '0-9A-Za-z-' | cut -c1-16)
# id сессии для точечного отзыва = sha256 её токена (см. totp_sess_list).
sid=$(field sid | tr -cd 'a-f0-9' | cut -c1-64)

# Гейт на всё, кроме входа. Формально это тот же totp_gate_deny, но ответ здесь — обычный JSON
# без 403: фронт на этих экранах уже знает про 2FA, и HTTP-ошибка только запутала бы обработчик.
# Вход по коду требует ПАРОЛЬНОЙ сессии (код её повышает, а не заменяет): нет никакой — 403
# need_login от totp_gate_deny, и фронт поднимет форму пароля, а не окно кода. То же и для
# остальных операций: сессия истекла посреди экрана 2FA — человеку нужен пароль, не код.
case "$op" in
	login) totp_has_session || totp_gate_deny ;;
	*) totp_gate || { [ "$_tg_need" = login ] && totp_gate_deny; deny "нужен вход по коду"; emit; } ;;
esac

case "$op" in
	# --- Вход по коду: ПОВЫШАЕМ парольную сессию (её родил cgi-bin/login — UA и адрес уже там)
	# до уровня 2. Кука в браузере остаётся той же, Set-Cookie не нужен.
	login)
		totp_enabled || { deny "двухфакторный вход выключен"; emit; }
		totp_check_code "$code"; r=$?
		case "$r" in
			0) totp_sess_upgrade "$(totp_cookie)" || { deny "сессия не найдена — войдите заново"; emit; }
			   say "вход выполнен" ;;
			2) deny "часы роутера не синхронизированы — подождите минуту и повторите" ;;
			3) out=$(printf '{"ok":false,"msg":"слишком много неудачных попыток","lock":%s}' "$(totp_lock_left)") ;;
			*) out=$(printf '{"ok":false,"msg":"код не подошёл","left":%s}' "$(totp_rec_left)"); lock_note ;;
		esac ;;
	# --- Привязка приложения: секрет живёт в .totp-pending до подтверждения кодом.
	enroll)
		totp_enabled && { deny "двухфакторный вход уже включён"; emit; }
		s=$(sh "$ENODIA_DIR/totp.sh" enroll 2>/dev/null)
		b32=$(printf '%s' "$s" | head -1 | tr -cd 'A-Z2-7')
		uri=$(printf '%s' "$s" | sed -n '2p' | tr -d '"\\')
		[ -n "$b32" ] || { deny "не удалось сгенерировать секрет"; emit; }
		out=$(printf '{"ok":true,"secret":"%s","uri":"%s"}' "$b32" "$uri") ;;
	# --- Включение: код ИЗ ПРИВЯЗЫВАЕМОГО секрета + сразу уровень 2 текущей сессии, иначе
	# человек, включивший 2FA, тут же получил бы окно ввода кода поверх своей же панели.
	enable)
		res=$(sh "$ENODIA_DIR/totp.sh" enable "$code" 2>&1); rc=$?
		if [ "$rc" != 0 ]; then
			deny "$(printf '%s' "$res" | jesc 160)"; emit
		fi
		totp_sess_upgrade "$(totp_cookie)" >/dev/null 2>&1 || true
		codes=""
		for c in $res; do
			case "$c" in *-*) codes="$codes,\"$c\"" ;; esac
		done
		out=$(printf '{"ok":true,"msg":"двухфакторный вход включён","recovery":[%s]}' "${codes#,}") ;;
	# --- Отключение: сессия (гейт выше) И действующий код. Знать пароль панели мало.
	# Куку НЕ гасим: сессия парольная и без TOTP достаточна — «выключил код» ≠ «выйди».
	disable)
		# ПАНЕЛЬ ОТКРЫТА НАРУЖУ — ВТОРОЙ ФАКТОР НЕ СНИМАЕМ (ревью шага 7a): `wan-on` без него порт наружу не открывает, а снять
		# его при открытом порту давало ровно то состояние, которое он запрещает, — «в интернете под одним паролем». Сперва
		# закрыть вход снаружи. Аварийный путь с роутера (`totp.sh disable --force` по SSH) этот гейт не видит — так и задумано.
		case "$(wan_state)" in
			open) deny "панель открыта снаружи — сперва закройте вход снаружи, потом снимайте второй фактор"; emit ;;
			unknown) deny "роутер не сообщил, открыт ли вход снаружи — второй фактор не снят; попробуйте ещё раз"; emit ;;
		esac
		res=$(sh "$ENODIA_DIR/totp.sh" disable "$code" 2>&1); rc=$?
		if [ "$rc" != 0 ]; then
			code_refuse "$rc" "$res"
		elif wan_open; then
			# Вход снаружи открыли из другой вкладки, пока мы сверяли код (гонка, разбор у web-ui.sh::wan_on): без второго фактора
			# наружу не держим — закрываем и говорим это.
			sh "$ENODIA_DIR/web-ui.sh" wan-off >/dev/null 2>&1
			say "двухфакторный вход выключен; вход снаружи закрыт — без второго фактора панель наружу не открывается"
		else
			say "двухфакторный вход выключен"
		fi ;;
	# --- Отмена брошенной привязки (ревью шага 7a, круг 2): открыть «Начать привязку» и уйти — и `.totp-pending` оставался навсегда,
	# с жёлтым «привязка не закончена» на двери и экране; снять его было нечем, кроме SSH. Секрет в привязке ещё не действует.
	cancel)
		res=$(sh "$ENODIA_DIR/totp.sh" enroll-cancel 2>&1); rc=$?
		# Старый totp.sh верба не знает и печатает usage — это не «причина», а «движок старее»: говорим словами (ревью шага 7a, круг 3).
		if [ "$rc" = 0 ]; then say "привязка отменена"
		else case "$res" in usage:*) deny "движок второго фактора старее отмены привязки — переустановите панель с компьютера" ;; *) deny "$(printf '%s' "$res" | jesc 160)" ;; esac; fi ;;
	# --- Перевыпуск кодов восстановления (старые перестают работать сразу).
	recovery)
		res=$(sh "$ENODIA_DIR/totp.sh" recovery-new "$code" 2>&1); rc=$?
		if [ "$rc" != 0 ]; then
			code_refuse "$rc" "$res"; emit
		fi
		codes=""
		for c in $res; do
			case "$c" in *-*) codes="$codes,\"$c\"" ;; esac
		done
		out=$(printf '{"ok":true,"msg":"коды восстановления перевыпущены","recovery":[%s]}' "${codes#,}") ;;
	# --- Список подтверждённых устройств. Кода не требует: запрос и так за гейтом, то есть
	# сессия уже подтверждена вторым фактором. Отдаём как есть — свою сессию панель узнаёт по
	# полю `cur`, а не по адресу (адрес за panel-tls всегда наш же LAN, см. шапку totp.sh).
	# `on` — включён ли второй фактор, В ТОМ ЖЕ ответе: уровень сессии (1 = только пароль) что-то
	# значит лишь при включённом 2FA, и панель обязана судить по факту из этого ответа, а не по
	# флагу, снятому другим экраном раньше (список рисуется отдельным запросом).
	sessions)
		_on=false; totp_enabled && _on=true
		out=$(printf '{"ok":true,"on":%s,"sessions":%s}' "$_on" "$(totp_sess_list "$(totp_cookie)")") ;;
	# --- Выход на всех устройствах (сменили телефон, отдали ноутбук, потеряли доверие к сети).
	logout)
		totp_sess_clear
		clear_cookie; say "все устройства разлогинены" ;;
	# --- Выход на ОСТАЛЬНЫХ: самый частый случай («вошёл с чужого ноутбука и забыл выйти»),
	# при котором переспрашивать код у себя же незачем. Куку НЕ гасим — эта сессия остаётся.
	others)
		totp_sess_keep_only "$(totp_cookie)" || { deny "текущая сессия не найдена — попробуйте войти заново"; emit; }
		say "остальные устройства разлогинены" ;;
	# --- Отзыв ОДНОГО устройства. Если отзывают то, с которого пришли, куку надо погасить здесь
	# же: иначе браузер продолжал бы слать мёртвый токен и получал 403 на каждом поллинге.
	revoke)
		[ -n "$sid" ] || { deny "не указано устройство"; emit; }
		self=""; c=$(totp_cookie); [ -n "$c" ] && self=$(totp_sess_id "$c")
		totp_sess_revoke "$sid" || { deny "такого устройства уже нет в списке"; emit; }
		if [ "$sid" = "$self" ]; then clear_cookie; say "вы вышли на этом устройстве"
		else say "устройство отвязано"; fi ;;
	*) deny "неизвестная операция" ;;
esac

emit
