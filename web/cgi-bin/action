#!/bin/sh
# cgi-bin/action — управляющие действия панели (Фаза 2). Зовётся ТОЛЬКО POST-ом из
# самой панели (за гейтом входа, totp.sh). Каждое действие — это вызов СУЩЕСТВУЮЩЕГО безопасного
# скрипта; пользовательский ввод НИКОГДА не попадает в shell-команду (имя действия лишь
# выбирает ветку case, а аргументы скрипта захардкожены). Сами скрипты держат fail-open
# (safety_off при смерти VPS), так что «уронить интернет» действие не способно.
#
# Защита:
#  - только POST (GET/прочее -> отказ);
#  - CSRF-токен синхронизатора (сверка с /tmp/enodia-panel-token, его выдаёт cgi-bin/token);
#  - белый список действий; неизвестное -> отказ;
#  - тело <= 32 КБ (запас под загрузку конфига base64-ом; обычные действия — сотни байт).
#  - 2FA-гейт (totp.sh) — см. разбор в cgi-bin/status; включён = знать пароль панели мало.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026 пробным CGI: все ENODIA_*
# пусты), а в режиме «всё на накопителе» литералы указывают в пустоту — панель отвечала бы
# «ничего не установлено» на живой системе, а ГЕЙТ ВТОРОГО ФАКТОРА ниже просто не находил бы
# totp.sh и молча пропускал запрос. Каталог кода знаем бесплатно из $0, остальное разбирает
# cgi-paths.sh: второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
if [ -f "$ENODIA_DIR/totp.sh" ]; then
	TOTP_LIB=1; . "$ENODIA_DIR/totp.sh"
	# СУДИМ ПО СПОСОБНОСТИ, А НЕ ПО НАЛИЧИЮ. totp.sh СТАРЕЕ формы входа сорсится успешно, но его
	# гейт при выключенном 2FA пропускал всё — а uhttpd к этому моменту уже поднят БЕЗ `-c`, то
	# есть панель отдавала бы данные и ДЕЙСТВИЯ без пароля. Признак эпохи — pw_verify (его же
	# спрашивает cgi-bin/login).
	command -v pw_verify >/dev/null 2>&1 || {
		echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
		echo "Cache-Control: no-store"; echo ""
		printf '{"ok":false,"need_login":true,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }
	totp_gate_deny
else   # НЕТ totp.sh — ОТКАЗ, А НЕ ПРОПУСК: двери-Basic больше нет, пускать некому (разбор — в totp.sh, «Гейт»)
	echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"need_login":true,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0
fi
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

ENODIA_DIR=${ENODIA_DIR:-/data/usr/app/enodia}
ENODIA_BIN=${ENODIA_BIN:-/data/usr/app/enodia-bin}
ENODIA_STATE=${ENODIA_STATE:-/data/usr/app/enodia-state}
TOKFILE=/tmp/enodia-panel-token
SWITCH_LOCK=/tmp/enodia-switching.lock

# Где лежит бинарь — ЕДИНСТВЕННЫЙ ответ у store-lib. Пре-чеки ниже («xray не установлен»,
# «nfqws не установлен») судили по резидентному пути и с внешним накопителем ОТКАЗЫВАЛИ на
# рабочем компоненте: включить Zapret из панели было нельзя вовсе, хотя ⋮-меню его предлагало
# (`ready` считает transport.sh, а он store-aware). Гард `[ -f ]` обязателен: провалившийся `.`
# в busybox ash убивает шелл на месте, и шим ниже был бы мёртвым кодом.
if [ -f "$ENODIA_DIR/store-lib.sh" ]; then . "$ENODIA_DIR/store-lib.sh"; fi
command -v bin_path >/dev/null 2>&1 || bin_path() { printf '%s' "$ENODIA_BIN/$1"; }

fail() { printf '{"ok":false,"code":1,"msg":"%s"}\n' "$1"; exit 0; }

# jesc/jtrim — «вывод скрипта → строка внутри JSON». Живут в json-lib.sh: конвейер нужен ещё
# в cgi-bin/data (4 ветки), cgi-bin/2fa (3) и web-ui.sh, а общего файла у этой четвёрки нет
# (action/data сорсят store-lib, 2fa — totp.sh, web-ui — nf-i18n) — поэтому у примитива свой дом.
# Разбор трёх ловушек (байтовая обрезка UTF-8, нечётный `\` на границе, сырой TAB) — в шапке либы.
# ШИМ = ПРЕЖНЕЕ поведение этого файла: либа не доехала (старая установка) — ведём себя как раньше,
# а не падаем. Гард `[ -f ]` обязателен: провалившийся `.` в busybox ash убивает шелл на месте.
if [ -f "$ENODIA_DIR/json-lib.sh" ]; then . "$ENODIA_DIR/json-lib.sh"; fi
# Данные (адрес из конфига) — jtxt; прежняя копия либы его не знает — через jesc, как в cgi-bin/data (без шима адрес приходил пустым).
command -v jtxt >/dev/null 2>&1 || jtxt() { jesc "$1"; }
command -v jesc >/dev/null 2>&1 || {
	jtrim() { cat; }
	jesc() { tr -d '\033\r' | sed 's/\[[0-9;]*m//g' | tr '\n\t' '  ' | cut -c1-"$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
}

# dom_ok (dns-lib.sh) — «годится ли строка как домен в конфиге dnsmasq». Здесь она нужна как
# ВХОДНОЙ гард панели: поле «добавить домен» принимало что угодно длиной без потолка, а метка
# длиннее 63 символов роняет ВЕСЬ конфиг демона — то есть одна опечатка в поле оставляла всю сеть
# без DNS (класс «домен → IP», разобранный 15.08.2026). Владельцы (domain.sh/groups.sh) проверяют
# у себя тоже — здесь мы лишь отвечаем человеку сразу и понятной строкой.
# Сорсинг стоит 5 мс на POST (замерено на AX3600, самом слабом из поддержанных) — на фоне
# нескольких форков самого действия это ничто. Шим = ПРАВИЛО, а не прежнее поведение.
if [ -f "$ENODIA_DIR/dns-lib.sh" ]; then . "$ENODIA_DIR/dns-lib.sh"; fi
command -v dom_ok >/dev/null 2>&1 || {
	dom_ok() { [ -n "$1" ] && [ "${#1}" -le 253 ] || return 1
	           printf '%s' "$1" | grep -qE '^[A-Za-z0-9_-]{1,63}(\.[A-Za-z0-9_-]{1,63})*$'; }
}

# Ручной switch «побеждает» авто-failover. Пока панель переключает транспорт/сервер, держим
# switching-lock: watchdog его чтит (`[ -e лок ] && exit 0` в watchdog.sh), а xray/hy2
# cmd_failover прерывают перебор, увидев лок между итерациями. Снимаем на выходе CGI (процесс
# короткоживущий → лок не «залипает»). Иначе (инцидент 2026-07-09) юзерский выбор сервера гонялся
# с циклом cmd_failover, который переписывал .xray-active на каждой итерации, и не применялся.
# ЧУЖОЙ лок не трогаем (идиома take_switch_lock из transport.sh, она же в proto-install.sh):
# прежняя форма `: > лок` + безусловный `rm` в trap СНИМАЛА лок ЧУЖОГО владельца — клик по
# «переключить транспорт» посреди установки компонентов открывал сторожу дорогу в середину чужой
# операции. Замер: старая форма чужой лок сносила, новая — оставляет.
# ЖИВОЙ ДЕРЖАТЕЛЬ С ПИДОМ — подъём несущей сторожем (watchdog.sh::wd_switch_take) или другой запрос панели: ЖДЁМ, пока отпустит.
# Иначе наш switch гасит недоподнятое, а подъём, закончив, рождает сирот или переписывает флаг и маршрут — ручной выбор проигрывал
# (BE7000 02.10.2026: xray и hev остались жить при `.transport=awg`). Потолок 60 с — ниже срока CGI у uhttpd (-t 180); держатели
# без пида (transport.sh switch, установка, перенос) — прежнее поведение, сразу; лок МЁРТВОГО держателя с пидом забираем себе.
SWITCH_LOCK_MINE=0
# «Ведёт ли кто-то смену» — у владельца (daemon-lib.sh::switch_work_alive): смену CGI ведёт потомок, и SIGKILL вкладки его не трогает.
hs_work_alive() {   # $1 — пид держателя из лока
	[ -n "$CBN_LIB" ] || { CBN_LIB=1; if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi; }
	command -v switch_work_alive >/dev/null 2>&1 && switch_work_alive "$1"
}
# Снять мёртвый лок — у владельца (daemon-lib.sh::switch_lock_reap: сверка увиденного и rm под мьютексом, разбор там). Библиотеки
# нет (частичная заливка) — прежняя пара «сверка → rm». Мьютекс снятия ЗАНЯТ (код 1: снимает сторож или вторая вкладка, либо он
# брошен и не старше 10 с) — ПАУЗА: без неё цикл hold_switch прокручивал свои 60 шагов за пару секунд и шёл дальше БЕЗ лока, а
# вторая вкладка — так же (ревью с.97).
hs_reap() {   # $1 — мёртвый пид из лока
	[ -n "$CBN_LIB" ] || { CBN_LIB=1; if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi; }
	if command -v switch_lock_reap >/dev/null 2>&1; then switch_lock_reap "$1" || sleep 1; return 0; fi
	[ "$(cat "$SWITCH_LOCK" 2>/dev/null | tr -d ' \r\n')" = "$1" ] && rm -f "$SWITCH_LOCK" 2>/dev/null
	return 0
}
hold_switch() {
	_hsw=0
	while [ "$_hsw" -lt 60 ]; do
		_hsp=$(cat "$SWITCH_LOCK" 2>/dev/null | tr -d ' \r\n')
		case "$_hsp" in ''|*[!0-9]*) break ;; esac
		if [ ! -d "/proc/$_hsp" ] && ! hs_work_alive "$_hsp"; then
			# Держатель с пидом МЁРТВ (вкладку закрыли посреди смены — uhttpd бьёт CGI SIGKILL, ловушка молчит), и смены, которую
			# он вёл потомком, тоже нет: лок ничей, и сторож снимет его на ближайшем тике (watchdog.sh::switch_lock_held). Не забрать
			# его себе — значит идти дальше, НЕ владея, а сторож следующим тиком поведёт лестницу поверх нашей смены (ревью с.93,
			# круг 3). Снимаем, только если в локе всё ещё ТОТ ЖЕ мёртвый пид, и идём на новый круг: вторая вкладка, успевшая взять
			# лок раньше нас, его не потеряет, а мы её дождёмся (ревью с.96, круг 2 — прежде обе шли дальше, одна без лока). Сверка и
			# снятие — атомарно, у владельца: голой паре вторая вкладка успевала вклиниться между ними (хвост ревью с.96).
			hs_reap "$_hsp"
			( set -C; echo $$ > "$SWITCH_LOCK" ) 2>/dev/null && { SWITCH_LOCK_MINE=1; break; }
			_hsw=$((_hsw + 1)); continue   # счёт — и тут: неснимаемый лок (права, раздел) не должен крутить цикл вечно
		fi
		sleep 1; _hsw=$((_hsw + 1))
	done
	# Свой пид внутри и создание АТОМАРНО (`set -C`): по пиду сторож отличает CGI, убитый uhttpd на закрытой вкладке (SIGKILL,
	# ловушка молчит), и снимает его лок сразу, а не через 30 минут (watchdog.sh::switch_lock_held); вторая вкладка ждёт живую первую.
	[ "$SWITCH_LOCK_MINE" = 1 ] || { ( set -C; echo $$ > "$SWITCH_LOCK" ) 2>/dev/null && SWITCH_LOCK_MINE=1; }
	# Держатель с пидом ЖИВ (или смену ведёт его потомок) и за минуту не отпустил — идти поверх нельзя: это и есть гонка, которую лок
	# закрывает. Отказ словами; держатели без пида (установка, перенос, CLI) — как раньше, дальше без лока.
	if [ "$SWITCH_LOCK_MINE" != 1 ]; then
		_hsp=$(cat "$SWITCH_LOCK" 2>/dev/null | tr -d ' \r\n')
		case "$_hsp" in ''|*[!0-9]*) ;; *) { [ -d "/proc/$_hsp" ] || hs_work_alive "$_hsp"; } && fail "${HS_FAIL_MSG:-идёт смена транспорта или сервера либо перезапуск компонентов (другая вкладка или сам роутер) — повторите через минуту}" ;; esac
	fi
	# Метка держателя — потомкам: смену ведут они, и SIGKILL закрытой вкладки их не трогает (daemon-lib.sh::switch_work_alive).
	if [ "$SWITCH_LOCK_MINE" = 1 ]; then ENODIA_SWITCH_HOLDER=$$; export ENODIA_SWITCH_HOLDER; fi
	trap 'drop_switch' EXIT
	trap 'exit 1' INT TERM HUP PIPE
}
drop_switch() { _rc=$?; [ "$SWITCH_LOCK_MINE" = 1 ] && rm -f "$SWITCH_LOCK" 2>/dev/null; return "$_rc"; }

# ВЕДЁТ ЛИ НЕСУЩУЮ ПРЯМО СЕЙЧАС тик сторожа или heal — они ведут её БЕЗ лока смены (перебор резервов идёт прямо в плагине).
carrier_busy_now() {
	[ -n "$CBN_LIB" ] || { CBN_LIB=1; if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi; }
	command -v pid_runs >/dev/null 2>&1 || pid_runs() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
	command -v wd_tick_alive >/dev/null 2>&1 && { wd_tick_alive || heal_alive; }
}
# dns_rewire_hold — ПЕРЕД перепроводкой DNS вербами «Шифрованного DNS» (doh_on/off, set_doh_*). ХВОСТ ревью с.84: они звали
# `transport.sh dns` поверх ЧУЖОЙ операции — смены транспорта, установки, переноса, тика сторожа посреди перебора. Параллельный
# `transport.sh dns` читал прежний `.transport`, и два doh_apply_dns ставили и снимали правила резолвера навстречу друг другу.
# Чужой лок — отказ «через минуту». Тик сторожа или heal — ЖДЁМ до 20 с: здоровый тик идёт секунды, и отказ «роутер сам
# восстанавливает соединение» на каждом пятидесятом клике был бы ложью; дольше — это уже перебор, и отказ честный. Дальше держим
# лок со своим пидом (hold_switch): новые тики его чтут, а лок вкладки, закрытой посреди пробы, сторож снимет сразу.
# `doh_retry` устроен сложнее (перепроводка в фоновом узле) и этого хелпера не зовёт — у него свои мутанты стенда.
dns_rewire_hold() {
	[ -e "$SWITCH_LOCK" ] && fail "Роутер занят другой операцией — попробуйте через минуту"
	_dbw=0
	while carrier_busy_now; do
		[ "$_dbw" -ge "${DNS_REWIRE_WAIT:-20}" ] && fail "Роутер сейчас сам восстанавливает соединение — попробуйте через минуту"
		sleep 1; _dbw=$((_dbw + 1))
	done
	hold_switch
	[ "$SWITCH_LOCK_MINE" = 1 ] || fail "Роутер занят другой операцией — попробуйте через минуту"
}

# ВЫКЛЮЧЕН ЛИ VPN ЧЕЛОВЕКОМ (`.vpn-off`, персист с 02.09.2026). Спрашивают ВЫБОРЫ СЕРВЕРА: они
# единственные в этом файле, кто поднимает несущую ПОМИМО тумблера и смены транспорта.
# ЗАЧЕМ (ревью 02.09.2026). Выключение переживает ребут, ядро маркировки гейтится флагом, heal
# несущую не поднимает — а «активировать сервер» поднимало: демоны запускались, а у AmneziaWG
# DNS всего дома уезжал В ТУННЕЛЬ (плагин пишет туннельный адрес и маршрут к нему), при том что
# тумблер показывает ВЫКЛЮЧЕНО. Правильный ответ уже есть в этом же файле и написан для соседнего
# случая — «трафик несёт другой транспорт ⇒ СТЕЙДЖИМ, а не переключаем»: выключенный VPN — тот же
# случай, сейчас не несёт никто. Конфиг выбираем, несущую не трогаем, человек включает тумблером.
vpn_is_off() { [ -f "$ENODIA_STATE/.vpn-off" ]; }

[ "$REQUEST_METHOD" = "POST" ] || fail "только POST"

len=${CONTENT_LENGTH:-0}
case "$len" in ''|*[!0-9]*) len=0 ;; esac
{ [ "$len" -gt 0 ] && [ "$len" -le 32768 ]; } || fail "пустой или слишком большой запрос"
body=$(head -c "$len")

field() { echo "$body" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2-; }
# «ЖИВ ЛИ ДЕСИНК» СПРАШИВАЕМ У ПЛАГИНА, А НЕ У ФАЙЛА. `.zapret-on` значит «zapret — несущая всего
# дома»; nfqws же общий на ТРЁХ потребителей (транспорт · доп-выходы · устройства «целиком в
# десинк»), и на zapret-ВЫХОДЕ файла нет. Пока гейты стояли на файле, панель на выходе писала
# «применится при включении zapret» и НЕ перезапускала демон — тот крутил СТАРУЮ стратегию
# (разбор 07.09.2026). Определение стоит ЗДЕСЬ, а не в ветке case: функция, объявленная внутри
# ветки, существует только когда эта ветка выполнилась, — свип её бы не увидел.
# rc=2 — старая копия zapret.sh на роутере не знает верба: падаем на прежний файл, то есть ведём
# себя как раньше, а не отказываем. Та же идиома, что у `nfq-ok` в data.
zt_wired() {
	# БЫСТРЫЙ ПУТЬ БЕЗ ФОРКА: zapret-ТРАНСПОРТ — самый частый случай, а `.zapret-on` для него
	# достаточен (у плагина тот же файл стоит вторым условием в `cmd_wired`). Свип зовёт этот
	# гейт на КАЖДУЮ стратегию — два десятка форков подряд там лишние.
	[ -f "$ENODIA_STATE/.zapret-on" ] && return 0
	sh "$ENODIA_DIR/zapret.sh" wired >/dev/null 2>&1; _zw=$?
	[ "$_zw" = 2 ] || return "$_zw"
	return 1
}
# urldecode для значений из формы (%XX и '+'). Применяем к ПОЛЬЗОВАТЕЛЬСКИМ полям
# (ip/cidr/domain/ifaces) ПЕРЕД строгой валидацией regex'ом — даже если декод
# пропустит мусор, валидация его отобьёт; в shell-команду уходит только то, что
# прошло whitelisted-regex.
# ПЕРВЫМ ДЕЛОМ УДВАИВАЕМ ОБРАТНЫЙ СЛЭШ, и только потом делаем из `%XX` последовательность `\xXX`:
# `printf %b` разворачивает ЛЮБЫЕ escape-последовательности, а не только наши. Пароль `C:\new`
# приезжал в роутер как `C:` + перевод строки (замерено на BE7000 23.08.2026), `pa$s\tab` — с
# табуляцией вместо `\t`. Инъекции тут нет (значения уходят в кавычках), но данные молча портятся,
# и человек видит это лишь как «панель не принимает мой пароль». Порядок в sed ЖЁСТКИЙ: удвой
# слэши ДО подстановки `\x`, иначе удвоятся и свои собственные, и `%5C` перестанет давать слэш.
# Копия этой строки живёт в cgi-bin/backup (общего файла у двух CGI нет — см. шапку json-lib.sh);
# побайтовое равенство копий стережёт C37.
urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/+/ /g; s/%\(..\)/\\x\1/g')"; }
# ГАРД «ВСЯ СТРОКА ЦЕЛИКОМ» РАБОТАЕТ ТОЛЬКО НА ОДНОЙ СТРОКЕ, и это не теория: `grep -qE '^…$'`
# судит ПОСТРОЧНО, поэтому значение с переводом строки ВНУТРИ проходит гард, если ему хватило
# ПЕРВОЙ строки, — а перевод строки в теле POST приезжает как `%0A` и становится настоящим в
# `urldecode` (поймано стендом dev/layout-blob-cgi-test.sh на блобе раскладки). Отсекаем
# многострочное значение ДО регулярки. `wc -l` считает ПЕРЕВОДЫ СТРОК: у однострочного значения
# без хвостового `\n` их ноль.
one_line() { [ "$(printf '%s' "$1" | wc -l)" -eq 0 ]; }
# ВЫБРАН DoT, А ШИФРУЕТ DoH (doh-lib.sh::doh_proto_now: порт 853 этим путём не проходит, прокси переехал на DoH того же
# резолвера) — хвост ответа DoH-вербов. Без него тост «протокол: dot» / «включён» врал бы, чем шифруется DNS. Решает
# библиотека, здесь только слово; библиотека старше переезда — хвоста нет.
dot_fb_tail() {
	command -v doh_proto_now >/dev/null 2>&1 || return 0
	[ "$(doh_proto)" = dot ] && [ "$(doh_proto_now)" = doh ] && printf '%s' '; DoT этим путём не проходит — пока шифрую по DoH, вернусь на DoT сам'
	return 0
}
# ПРИЧИНА ОТКАЗА ДВИЖКА ПРАВИЛ СЕТЕЙ — последняя строка его вывода (выше неё служебные строки сборки цепочек). Без
# перевода строки на входе jesc: он превращает `\n` в пробел, и причина уезжала бы с хвостовым пробелом мимо словаря.
# cap_run <скрипт> [аргументы] — ВЫЗОВ НАШЕГО СКРИПТА С ВЫВОДОМ В ФАЙЛ, а не в трубу `$(…)`. uhttpd, потеряв клиента (закрытая
# вкладка, свой таймаут, перезапуск терминатора HTTPS с HTTPS-вкладки), бьёт CGI SIGKILL, и потомок, пишущий в трубу мёртвому читателю,
# падает по SIGPIPE на ближайшей строке — посреди работы (ревью шага 7a, круг 3: вербы web-ui.sh). Замер BE7000 04.10.2026: `switch xray`,
# чей держатель убит, откатился на AmneziaWG через 4 с — подъём xray умер на записи; `up` после `down` так оставил бы роутер без несущей.
# Файл держит вывод и без читателя. Имя — с пидом (две вкладки разом не пишут в один файл), сирот убитых CGI снимаем здесь же — по
# мёртвому пиду. Итог — в CAP_OUT, код — возвратом. Долгую работу, которую трогают несущая и её конфиг, CGI зовёт ТОЛЬКО так (C127).
# ФАЙЛ — В СВОЁМ КАТАЛОГЕ, СОЗДАННОМ `mkdir` (ревью с.97): /tmp общий, имя предсказуемо, а пишем от root — симлинк, разложенный
# заранее чужим процессом (nobody) на диапазон пидов, превращал первое действие панели в запись поверх его цели. `mkdir` атомарен и
# по симлинку не идёт (лежит что угодно — не наш каталог), а в каталог root чужой процесс не положит ничего; лежавшее на нашем имени
# снимаем ДО него (rm по симлинку снимает сам симлинк). Не вышло — скрипт ВСЁ РАВНО выполняется, а вывод уходит в /dev/null (ревью
# с.98): отказ посреди работы хуже потерянного текста — вызыватели зовут cap_run и ПОСЛЕ `down` несущей, и `up`, не запущенный из-за
# каталога, оставил бы роутер без неё. Человеку — что вывод не сохранён; код — настоящий, скрипта.
cap_run() {
	for _crf in /tmp/enodia-cgi-out.*; do
		[ -e "$_crf" ] || [ -L "$_crf" ] || continue
		[ -d "/proc/${_crf##*.}" ] || rm -rf "$_crf" 2>/dev/null
	done
	_crd="/tmp/enodia-cgi-out.$$"; _crs=$1; shift
	rm -rf "$_crd" 2>/dev/null
	if ! ( umask 077; mkdir "$_crd" ) 2>/dev/null; then   # 700 — кодом, а не замеренной umask uhttpd (`mkdir -m` в git-bash врёт)
		sh "$ENODIA_DIR/$_crs" "$@" >/dev/null 2>&1; _crr=$?
		CAP_OUT="вывод не сохранён: не удалось создать каталог вывода $_crd"; return "$_crr"
	fi
	sh "$ENODIA_DIR/$_crs" "$@" > "$_crd/out" 2>&1; _crr=$?
	CAP_OUT=$(cat "$_crd/out" 2>/dev/null); rm -rf "$_crd"
	return "$_crr"
}
wui_run() { cap_run web-ui.sh "$@"; _wur=$?; WUI_OUT=$CAP_OUT; return "$_wur"; }
# owner_relay <script> [args] — the OWNER's one-line JSON answer relayed as is (tasks.sh, access-sched.sh: they validate and
# answer, this CGI only carries). Through cap_run: uhttpd's SIGKILL of a lost client must not cut a registry write halfway on
# SIGPIPE. cap_run merges stderr into the same file, so a stray warning (`mv: …`) before the answer must not turn it into
# «error: {…}» — the last line that is a JSON object is the answer (review s.106); anything else is a refusal with its last line.
owner_relay() {
	cap_run "$@"
	_orj=$(printf '%s\n' "$CAP_OUT" | grep '^{' | tail -n 1)
	case "$_orj" in '{'*) printf '%s\n' "$_orj" ;; *) fail "$(printf '%s' "$CAP_OUT" | tail -n 1 | jesc 300)" ;; esac
	exit 0
}
# in_dir — a private 700 directory for the request's input files -> IN_DIR (removed on exit). /tmp is shared, and a symlink laid
# on a predictable name would turn our write into a write into its target (the cap_run class); dirs of killed CGIs (a dead pid
# in the name) are swept here, as cap_run does with its own.
in_dir() {
	for _ind in /tmp/enodia-cgi-in.*; do
		[ -e "$_ind" ] || [ -L "$_ind" ] || continue
		[ -d "/proc/${_ind##*.}" ] || rm -rf "$_ind" 2>/dev/null
	done
	IN_DIR="/tmp/enodia-cgi-in.$$"; rm -rf "$IN_DIR" 2>/dev/null
	( umask 077; mkdir "$IN_DIR" ) 2>/dev/null || fail "не удалось создать временный каталог"
	trap 'rm -rf "$IN_DIR"' EXIT
}
wf_why() { _wy=$(printf '%s\n' "$1" | tail -n 1); printf '%s' "${_wy:-не удалось}" | jesc 300; }
tok=$(field token)
act=$(field action)

echo "$tok" | grep -qE '^[0-9a-f]+$' || fail "нет токена"
{ [ -s "$TOKFILE" ] && [ "$tok" = "$(cat "$TOKFILE")" ]; } || fail "неверный токен (перезагрузите панель)"

# Запуск скрипта с ЗАХАРДкоженными аргументами, возврат JSON {ok,code,msg}.
run() {
	cap_run "$@"; code=$?; raw=$CAP_OUT
	# Весь разбор текста — в jesc (ANSI, переводы строк/табы, эскейп, безопасная обрезка).
	# ПОТОЛОК — 2000, А НЕ 1000. Замер 08.09.2026: тост НЕУДАЧНОЙ смены сервера (пять шагов, две
	# серии точек ожидания, откат, safety_off и «Что делать» из пяти строк) — около 1,25 КБ, то
	# есть на 1000 он УЖЕ резался; у «Включить VPN» с отказом переигрыша — 868 байт. Обрезка тут
	# стоит дорого вдвойне: `cut -c1-N` режет ПО БАЙТАМ (обрывок UTF-8), а оборванная фраза больше
	# не совпадает с ключом словаря — и англоязычный получает весь тост по-русски (гард i18nStr
	# «остался кириллический хвост ⇒ вернуть оригинал целиком»).
	msg=$(printf '%s' "$raw" | jesc 2000)
	printf '{"ok":%s,"code":%s,"msg":"%s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$msg"
	exit 0
}

# Фоновый запуск БЕЗ nohup. На этом busybox НЕТ ни nohup, ни setsid — прежний
# `nohup sh … &` молча падал ("nohup: not found"), и фоновая задача (смена набора /
# обновление) НЕ стартовала вовсе: CGI успевал записать state=RUNNING, а скрипт не
# запускался → статус залипал в RUNNING навсегда. start-stop-daemon -b делает
# setsid (новая сессия) → процесс переживает завершение CGI/uhttpd. -m -p <pidfile>
# ОБЯЗАТЕЛЬНЫ: без них -x /bin/sh матчит ВСЕ процессы sh и даёт ложное «already
# running». Пид-файл чистим перед стартом (защита от устаревшего). Фолбэк — ( … & ).
spawn_bg() {  # spawn_bg <pidfile> <argv для /bin/sh…>:  spawn_bg /tmp/enodia-x.pid scr.sh apply X  |  spawn_bg /tmp/enodia-x.pid -c "cmd"
	pf="$1"; shift
	rm -f "$pf" 2>/dev/null
	if [ -x /sbin/start-stop-daemon ]; then
		start-stop-daemon -S -b -m -p "$pf" -x /bin/sh -- "$@" >/dev/null 2>&1
		# ПИДФАЙЛ ПИШЕТ ВНУК: `-b` в busybox — двойной fork, родитель выходит сразу, а `-m` кладёт pid уже потомок, позже. Опрос
		# панели, пришедший в это окно, видел RUNNING без живого держателя — «прервано» / «не удалось» до начала операции (ревью
		# шага 6c, круг 2). Ждём файл до 2 с: `usleep` — дробного `sleep` в этом busybox нет (замер BE7000).
		# fixed-wait: ждём не старт демона, а запись пидфайла потомком start-stop-daemon — жизни процесса тут судить не по чему.
		_sw=0
		while [ ! -s "$pf" ] && [ "$_sw" -lt 20 ]; do
			if command -v usleep >/dev/null 2>&1; then usleep 100000; else sleep 1; _sw=$((_sw+9)); fi
			_sw=$((_sw+1))
		done
	else
		# Фолбэк тоже пишет пидфайл: по нему «идёт ли» судят гарды кнопок (`upd-busy`, `packages.sh busy`), и без него на прошивке
		# без start-stop-daemon они не срабатывали никогда (ревью шага 6c, круг 2).
		( sh "$@" >/dev/null 2>&1 & echo $! > "$pf" )
	fi
}

# ЕДИНАЯ точка запуска ДВИЖКА КОМПОНЕНТОВ (packages.sh) из панели: карточка «Компоненты»,
# кнопки «Установить» у DoH/HTTPS и установка/удаление Zapret ходят СЮДА.
# Зачем: те кнопки раньше звали fetch-bin сами — свой лог, свой лок и НИ ОДНОЙ проверки места,
# хотя свободных на /data бывает 4 МБ. Две такие кнопки, нажатые подряд, гарантированно давали
# ENOSPC посреди закачки; а снятие nfqws мимо движка уносило доп-выход, который на нём висит
# (гард «несёт выход» живёт в packages.sh, у кнопки его не было).
# Отказ ДОЛЖЕН приезжать синхронно: план считаем ДО фонового запуска, иначе причина оседает в
# логе, а человек видит бодрое «запущено» и пустой прогресс.
# START OF A COMPONENTS OPERATION in the background — one sequence for «Применить» and «Перезапустить»: status, log and plan are
# written HERE, before the spawn, or the screen's first poll would read the previous operation and call this one finished.
pkg_spawn() {  # pkg_spawn <строка плана: ставим⇥снимаем⇥обновляем[⇥перезапускаем]> <верб движка> [аргументы…]
	# Атомарно (запись рядом + `mv`) — разбор у packages.sh::set_state: читатель обрезанного файла видит «IDLE».
	echo RUNNING > "$ENODIA_STATE/.proto-install.state.new" && mv -f "$ENODIA_STATE/.proto-install.state.new" "$ENODIA_STATE/.proto-install.state"
	: > "$ENODIA_STATE/.proto-install.log"
	printf '%s\n' "$1" > "$ENODIA_STATE/.proto-install.plan"
	shift
	spawn_bg /tmp/enodia-proto-install.pid "$ENODIA_DIR/packages.sh" "$@"
}
pkg_bg() {  # pkg_bg <ставим|-> <снимаем|-> <сообщение об успехе>
	[ -f "$ENODIA_DIR/packages.sh" ] || fail "packages.sh не установлен (обновите скрипты с GitHub)"
	# «Идёт ли установка» спрашиваем У ДВИЖКА — единственного владельца ответа (packages.sh busy).
	sh "$ENODIA_DIR/packages.sh" busy >/dev/null 2>&1 && fail "операция с компонентами уже идёт — дождитесь её конца"
	# …и обновление системы: оно заменит движок и манифест бинарей посреди операции (ревью ветки bins-2026-10, круг 3)
	sh "$ENODIA_DIR/gh-update.sh" upd-busy >/dev/null 2>&1 && fail "идёт обновление системы — дождитесь его конца"
	pplan=$(sh "$ENODIA_DIR/packages.sh" plan "$1" "$2" 2>/dev/null | grep '^{' | tail -1)
	case "$pplan" in
		*'"ok":true'*) : ;;
		*)
			# Причина — словами движка: сперва гард удаления, потом ошибка плана, иначе место.
			pwhy=$(printf '%s' "$pplan" | sed -n 's/.*"why":"\([^"]*\)".*/\1/p')
			[ -n "$pwhy" ] || pwhy=$(printf '%s' "$pplan" | sed -n 's/.*"errors":\["\([^"]*\)".*/\1/p')
			[ -n "$pwhy" ] || pwhy="не хватает места на флеше — снимите что-нибудь в «Роутер → Компоненты»"
			fail "$pwhy" ;;
	esac
	# Третье поле — какие из «ставим» обновления, словами плана (`upd`): иначе до перезаписи движком карточка «Идёт установка»
	# называла обновление «Поставить». Только имена связок — план печатает их сам, чужого в строку не пускаем.
	pupd=$(printf '%s' "$pplan" | sed -n 's/.*"upd":"\([a-z0-9 ]*\)".*/\1/p' | tr ' ' ',')
	pkg_spawn "$(printf '%s\t%s\t%s' "$1" "$2" "${pupd:--}")" apply "$1" "$2"
	printf '{"ok":true,"code":0,"msg":"%s"}\n' "$3"
	exit 0
}

# clampint <raw> <default> <min> <max> — оставить цифры, подставить дефолт, зажать в диапазон.
clampint() {
	v=$(printf '%s' "$1" | tr -cd '0-9'); [ -n "$v" ] || v="$2"
	[ "$v" -lt "$3" ] && v="$3"; [ "$v" -gt "$4" ] && v="$4"; echo "$v"
}

# Анти-SSRF для ссылок (подписки + источники списков) и работа с реестром подписок живут в
