# del_sub_configs <tag> — удалить конфиги ПОДПИСКИ <tag>, НЕ задев соседние. Теги подписок
# могут быть ПРЕФИКСАМИ друг друга («liberty» ⊂ «liberty-vpn»), а «-» разделяет и внутри тега →
# голый глоб sub-<tag>-*.json смёл бы и «sub-<tag>-vpn-*.json» соседа. Владелец файла = ДЛИНЕЙШИЙ
# тег-префикс среди ВСЕХ тегов .subs (зеркало ownerTag() в index.html). Удаляем лишь свои.
del_sub_configs() {
	_t="$1"; TAB=$(printf '\t')
	_tags="$_t"; [ -f "$ENODIA_STATE/.subs" ] && _tags="$_tags $(cut -d"$TAB" -f1 "$ENODIA_STATE/.subs" 2>/dev/null)"
	# ДВА каталога: подписка бывает смешанной (vless/vmess/trojan/ss ложатся xray-JSON'ом,
	# hysteria2 — YAML'ом), и удаление подписки обязано уносить оба — иначе hy2-конфиги
	# остаются сиротами с именем несуществующей подписки.
	for _f in "$ENODIA_STATE"/xray-configs/sub-"$_t"-*.json "$ENODIA_STATE"/hy2-configs/sub-"$_t"-*.yaml; do
		[ -e "$_f" ] || continue
		_b=$(basename "$_f"); _own=""; _ol=-1
		for _g in $_tags; do
			case "$_b" in sub-"$_g"-*) _gl=${#_g}; [ "$_gl" -gt "$_ol" ] && { _own="$_g"; _ol=$_gl; } ;; esac
		done
		[ "$_own" = "$_t" ] && rm -f "$_f" 2>/dev/null
	done
}

# --- Менеджер источников списков (lists-update.sh) ---------------------------
# Категории-whitelist для generic-верб src_*. tunnel-cidr — маршрутизация (CIDR через VPN);
# adblock/ipblock — блокировка, zapret-cidr — пул десинка ПО IP, zapret-dom — свой пул десинка ПО
# ДОМЕНАМ (все четыре off по умолчанию). tunnel-domains/bypass-ip — задел (реестр держит).
_valid_lcat() { case "$1" in tunnel-cidr|tunnel-domains|bypass-ip|adblock|ipblock|zapret-cidr|zapret-dom) return 0 ;; *) return 1 ;; esac; }
# Категории с мастер-тумблером (block_enable) + их подпись для сообщения. Верб исторически назван
# block_enable, но по смыслу это «включить опциональную категорию источников» — пулы десинка это не
# блокировка, поэтому текст берём отсюда, а не хардкодим «Блокировка».
_lcat_switchable() { case "$1" in adblock|ipblock|zapret-cidr|zapret-dom) return 0 ;; *) return 1 ;; esac; }
# Ответ — фразой ЦЕЛИКОМ, а не «подпись + включён»: у «блокировки» и «пула» разный род, и склейка давала «Блокировка
# включён» (замер на BE7000, шаг 5c); перевод панели к тому же берёт строку целиком. Включение ipblock идёт своим путём
# (проверка связи) и сюда не попадает.
_lcat_msg() {  # _lcat_msg <cat> on|off
	case "$1:$2" in
		zapret-cidr:on)  echo "Пул десинка по IP включён — идёт загрузка списков" ;;
		zapret-cidr:off) echo "Пул десинка по IP выключен" ;;
		zapret-dom:on)   echo "Свой пул десинка по доменам включён — идёт загрузка списков" ;;
		zapret-dom:off)  echo "Свой пул десинка по доменам выключен" ;;
		adblock:on)      echo "Блокировка рекламы включена — идёт загрузка списков" ;;
		adblock:off)     echo "Блокировка рекламы выключена" ;;
		*)               echo "Блокировка по адресам выключена" ;;
	esac
}
# Нормализация введённого домена — ОДНО место на все пути (одиночное правило, пачка, любой клиент).
# Режем схему/путь/www и ВЕДУЩУЮ маску «*.».
# ПОЧЕМУ маска режется, а не поддерживается: она не нужна — dnsmasq в `ipset=/дом/сет` матчит домен
# И ВСЕ его поддомены сам, т.е. `ya.ru` уже накрывает mail.ya.ru и a.b.ya.ru (на этом стоит весь
# re-filter-список). До этого `*.ya.ru` просто отлетал в «недопустимый домен» (валидатор ниже не
# пускает «*»), и со стороны выглядело, будто маски «не работают», хотя они подразумеваются всегда.
# Режем ИМЕННО ЗДЕСЬ, ДО валидации: «*» не должен доехать до domain.sh — там имя подставляется в
# sed-выражение (`/^ipset=\/$1\/.*/d`), где «*» стал бы метасимволом регулярки.
norm_domain() { printf '%s' "$1" | sed 's|^https\?://||; s|/.*$||; s/^\*\.//; s/^www\.//'; }
# Пакетное добавление доменов «в туннель» из stdin (текст/файл/URL) — через domain.sh (он персистит
# и переигрывается на boot). Каждая строка чистится от схемы/пути/www/маски и валидируется как домен.
# ОДНИМ вызовом `add-many`, а не `add` на домен: у `add` полный цикл применения (рестарт dnsmasq +
# пересборка сета + `conntrack -F`) и стоит он ЧЕТЫРЕ секунды — замерено на BE7000. Пачка из 30
# доменов прежним путём = две минуты синхронного CGI, тридцать обрывов DNS у ВСЕЙ сети и таймаут
# запроса; человек видит «сбой», а роутер в это время всё ещё молотит.
bulk_domains() {
	_bt="/tmp/enodia-bulk-dom.$$"
	tr ',; \t\r' '\n\n\n\n\n' > "$_bt"
	_n=$(sh "$ENODIA_DIR/domain.sh" add-many < "$_bt" 2>/dev/null | tail -1)
	case "$_n" in
		''|*[!0-9]*)
			# Дрейф деплоя: domain.sh без add-many (старее панели) — прежний путь, медленный, но рабочий.
			_n=0
			while read -r _raw || [ -n "$_raw" ]; do
				_d=$(norm_domain "$_raw")
				dom_ok "$_d" || continue
				echo "$_d" | grep -qE '\.[A-Za-z]{2,}$' || continue
				sh "$ENODIA_DIR/domain.sh" add "$_d" >/dev/null 2>&1 && _n=$((_n + 1))
			done < "$_bt" ;;
	esac
	rm -f "$_bt" 2>/dev/null
	echo "$_n"
}
# Пакетное «мимо VPN» из stdin — через apply-bypass.sh add-dst (персист + boot-replay).
bulk_dsts() {
	_n=0
	for _c in $(tr ',;\r\n' '    '); do
		echo "$_c" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$' || continue
		sh "$ENODIA_DIR/apply-bypass.sh" add-dst "$_c" >/dev/null 2>&1 && _n=$((_n + 1))
	done
	echo "$_n"
}

case "$act" in
	ping)        printf '{"ok":true,"code":0,"msg":"pong"}\n'; exit 0 ;;
	vpn_on)      run vpn-toggle.sh on ;;
	vpn_off)     run vpn-toggle.sh off ;;
	repair)      run vpn-toggle.sh repair ;;
	# `--home` = ВЫБОР СДЕЛАЛ ЧЕЛОВЕК: панель — единственное место, где транспорт выбирают руками,
	# поэтому именно отсюда записывается «домашний транспорт» (transport.sh switch … --home).
	# Сторож зовёт тот же verb БЕЗ флага: иначе аварийный уход на резерв назначил бы домом резерв.
	switch_awg)    hold_switch; run transport.sh switch awg --home ;;
	switch_xray)   hold_switch; run transport.sh switch xray --home ;;
	switch_hy2)    hold_switch; run transport.sh switch hy2 --home ;;
	switch_byedpi) hold_switch; run transport.sh switch byedpi --home ;;
	# zapret — 5-й транспорт (десинк направо БЕЗ VPS): switch гасит туннель, весь трафик
	# напрямую, заблок-категории пробивает nfqws. Гард — бинарь должен быть установлен.
	switch_zapret) [ -x "$(bin_path nfqws)" ] || fail "nfqws не установлен — поставьте его в «Компонентах»"; hold_switch; run transport.sh switch zapret --home ;;

	# --- Перезагрузка роутера. Фоном с задержкой, чтобы CGI успел ответить панели до разрыва.
	reboot)
		spawn_bg /tmp/enodia-panel-reboot.pid -c "sleep 2; reboot"
		printf '{"ok":true,"code":0,"msg":"Роутер перезагружается… панель вернётся через ~40-60 с (обновите страницу)."}\n'
		exit 0 ;;

	# --- «ЗАДАЧИ» (cron manager, tasks.sh). Like the console, the user's own code runs as root BY DESIGN (decision 07.10.2026:
	# risk is on the user, no extra confirmation — the gate is the panel login + CSRF). The CGI only CARRIES: fields go into a
	# spec file in a private 700 directory (the cap_run class: /tmp is shared, a symlink laid on a predictable name would turn
	# our write into a write into its target), free text stays base64 all the way to tasks.sh, and every value is validated
	# THERE — the owner. Answers are the owner's JSON, relayed as is (they carry the new task's id).
	task_save|task_del|task_toggle|task_dup|task_run|task_stop|task_get|cron_line_set|cron_line_toggle|cron_adopt|cron_raw_get|cron_raw_save|task_file_get|task_file_put)
		[ -f "$ENODIA_DIR/tasks.sh" ] || fail "на роутере нет tasks.sh — обновите скрипты роутера"
		tk_relay() { owner_relay tasks.sh "$@"; }   # the owner's JSON as is (owner_relay above)
		# the base64 alphabet; EMPTY passes — an optional field the panel leaves out («свой скрипт» sends no target_b64).
		# `grep` cannot say that: empty input has no line to match, so every «свой скрипт» save was refused (BE7000
		# 07.10.2026; the mock server validated in Python and never ran this line). A newline is outside the class too.
		b64f() { case "$1" in *[!A-Za-z0-9+/=]*) return 1 ;; esac; return 0; }
		tid=$(field id)
		case "$act" in task_save) ;; task_del|task_toggle|task_dup|task_run|task_stop|task_get)
			printf '%s' "$tid" | grep -qE '^t[0-9]{1,6}$' || fail "неверный номер задачи" ;; esac
		# private input dir (in_dir above) — only the verbs that write a file there
		case "$act" in task_save|cron_raw_save|task_file_put) in_dir; tkin=$IN_DIR ;; esac
		case "$act" in
			task_save)
				: > "$tkin/spec"
				for _k in id run enabled kind lang boot delay timeout overlap prio clockwait keep mail journal; do
					_v=$(field "$_k"); case "$_v" in *[!A-Za-z0-9]*) fail "неверные данные задачи ($_k)" ;; esac
					[ -n "$_v" ] && printf '%s=%s\n' "$_k" "$_v" >> "$tkin/spec"
				done
				for _k in name_b64 target_b64 args_b64 sched_b64 workdir_b64 body_b64 env_b64; do
					_v=$(urldecode "$(field "$_k")"); b64f "$_v" || fail "неверные данные задачи ($_k)"
					# a SENT empty field is a value too: «no variables» clears them — dropped, it read as «not sent» and the old
					# variables stayed (review s.106); an absent field stays absent (the owner keeps what it has)
					if [ -n "$_v" ] || printf '%s' "$body" | tr '&' '\n' | grep -q "^$_k="; then printf '%s=%s\n' "$_k" "$_v" >> "$tkin/spec"; fi
				done
				tk_relay save "$tkin/spec" ;;
			task_del)    tk_relay del "$tid" ;;
			task_toggle) case "$(field on)" in 1) tk_relay toggle "$tid" on ;; 0) tk_relay toggle "$tid" off ;; *) fail "нужно 0|1" ;; esac ;;
			task_dup)    tk_relay dup "$tid" ;;
			task_run)    tk_relay run-bg "$tid" ;;
			task_stop)   tk_relay stop "$tid" ;;
			task_get)    tk_relay get-json "$tid" ;;
			cron_raw_get) tk_relay raw-get ;;
			cron_line_set|cron_line_toggle|cron_adopt)
				_old=$(urldecode "$(field old)"); b64f "$_old" && [ -n "$_old" ] || fail "нет строки"
				case "$act" in
					cron_line_set) _new=$(urldecode "$(field new)"); b64f "$_new" || fail "неверная строка"; tk_relay line-set "$_old" "$_new" ;;
					cron_line_toggle) tk_relay line-toggle "$_old" ;;
					*) tk_relay adopt "$_old" ;;
				esac ;;
			cron_raw_save)
				_v=$(urldecode "$(field text)"); b64f "$_v" || fail "неверный текст"
				# the version the tab READ is required: without it an empty editor (still reading) saved over the whole file (round 2)
				_rv=$(field rev); case "$_rv" in '') fail "нет версии файла — откройте вкладку заново" ;; *[!0-9a-f]*) fail "неверная версия файла" ;; esac
				printf '%s' "$_v" > "$tkin/text"; tk_relay raw-save "$tkin/text" "$_rv" ;;
			task_file_get|task_file_put)
				_p=$(urldecode "$(field path)"); b64f "$_p" && [ -n "$_p" ] || fail "нет пути к файлу"
				_p=$(printf '%s' "$_p" | base64 -d 2>/dev/null); one_line "$_p" || fail "путь — одной строкой"
				if [ "$act" = task_file_get ]; then tk_relay file-get "$_p"; fi
				_v=$(urldecode "$(field text)"); b64f "$_v" || fail "неверный текст"
				printf '%s' "$_v" > "$tkin/text"; tk_relay file-put "$_p" "$tkin/text" ;;
		esac ;;

	# --- ACCESS SCHEDULES (access-sched.sh). The CGI only CARRIES: each value is URL-decoded and charset-checked here, its meaning
	# (a window, a MAC, a term) is checked by the owner, whose JSON answer is relayed as is. Free text (the name) stays base64.
	sched_save|sched_del|sched_toggle|sched_ovr|sched_all|sched_hol)
		[ -f "$ENODIA_DIR/access-sched.sh" ] || fail "на роутере нет access-sched.sh — обновите скрипты роутера"
		sid=$(field id)
		case "$act" in
			sched_all) ;;
			sched_save) [ "$sid" = new ] || printf '%s' "$sid" | grep -qE '^s[0-9]{1,6}$' || fail "неверный номер расписания" ;;
			*) printf '%s' "$sid" | grep -qE '^s[0-9]{1,6}$' || fail "неверный номер расписания" ;;
		esac
		# a term: minutes, HH:MM, end, off or 0 — letters, digits and a colon only
		# (into SC_ARG, not through `$(…)`: `fail` inside a subshell would print its refusal into the variable and exit only there)
		sc_arg() { SC_ARG=$(urldecode "$(field "$1")"); case "$SC_ARG" in ''|*[!0-9a-z:]*) fail "неверный срок" ;; esac; }
		case "$act" in
			sched_save)
				in_dir
				printf 'id=%s\n' "$sid" > "$IN_DIR/spec"
				for _k in ver enabled base wins devs lim_wd lim_we; do
					_v=$(urldecode "$(field "$_k")"); case "$_v" in *[!A-Za-z0-9.:\;,]*) fail "неверные данные расписания ($_k)" ;; esac
					printf '%s=%s\n' "$_k" "$_v" >> "$IN_DIR/spec"
				done
				_v=$(urldecode "$(field name_b64)"); case "$_v" in ''|*[!A-Za-z0-9+/=]*) fail "неверное имя расписания" ;; esac
				printf 'name_b64=%s\n' "$_v" >> "$IN_DIR/spec"
				# «limited»: ONLY the keys the request carries — absent means «keep the schedule's own» (a panel tab opened before
				# an update knows nothing of them and must not wipe the categories); empty means «none»
				for _k in lmode cats geo sites_b64 safe; do
					echo "$body" | tr '&' '\n' | grep -q "^$_k=" || continue
					_v=$(urldecode "$(field "$_k")")
					case "$_k:$_v" in lmode:*[!a-z]*|cats:*[!a-z,]*|geo:*[!a-z0-9._!,-]*|sites_b64:*[!A-Za-z0-9+/=]*|safe:*[!01]*) fail "неверные данные расписания ($_k)" ;; esac
					printf '%s=%s\n' "$_k" "$_v" >> "$IN_DIR/spec"
				done
				owner_relay access-sched.sh save "$IN_DIR/spec" ;;
			sched_del)    owner_relay access-sched.sh del "$sid" ;;
			sched_toggle) case "$(field on)" in 1) owner_relay access-sched.sh toggle "$sid" on ;; 0) owner_relay access-sched.sh toggle "$sid" off ;; *) fail "нужно 0|1" ;; esac ;;
			sched_ovr)
				_op=$(field op); case "$_op" in close|open|postpone|clear) ;; *) fail "неизвестное действие" ;; esac
				if [ "$_op" = clear ]; then owner_relay access-sched.sh ovr "$sid" clear; fi
				sc_arg arg; owner_relay access-sched.sh ovr "$sid" "$_op" "$SC_ARG" ;;
			sched_all)    sc_arg arg; owner_relay access-sched.sh all "$SC_ARG" ;;
			sched_hol)
				_ar=$(field date); case "$_ar" in off|20[0-9][0-9]-[01][0-9]-[0-3][0-9]) ;; *) fail "неверная дата" ;; esac
				owner_relay access-sched.sh hol "$sid" "$_ar" ;;
		esac ;;

	# --- SSH-КОНСОЛЬ (root). Полный доступ ПО ЯВНОМУ ВЫБОРУ пользователя: команда исполняется
	# как есть (sh -c) с правами root — это НЕ инъекция, а назначение фичи (гейт = HTTP-Basic +
	# CSRF-токен + доверенная LAN). Предупреждение об осторожности показывает панель. Неинтерактивно
	# (один запрос/ответ): интерактивные команды вроде top/vi не годятся. timeout рубит зависшую
	# команду (иначе висел бы весь запрос). Вывод (stdout+stderr) чистим от ANSI, экранируем для
	# JSON, переносы -> \n, кап ~100 КБ.
	console)
		cmd=$(urldecode "$(field cmd)")
		[ -n "$cmd" ] || fail "пустая команда"
		# ПОТОЛОК 60 СЕКУНД — ВСЕМУ ДЕРЕВУ, А НЕ ОДНОМУ `sh` (ревью шага 6d, замер BE7000 23.09.2026). `timeout -t` убивал лишь
		# `sh -c`, а потомки (`ping`, `tail -f`, `sleep`) жили и держали трубу `$(…)` открытой: `ping -c 100` шёл 100 с и получал
		# пометку «оборвана», а `tail -f` вешал CGI до потолка uhttpd (180 с) и жил сиротой. Поэтому вывод — в ФАЙЛ (труба не держит
		# ответ), команда — фоном, и по сроку её гасят вместе с потомками (обход /proc по PPid). Отцепленное (`start-stop-daemon -b`)
		# потомком init уже не числится и живёт — это законный запуск службы.
		# Конец команды — по файлу кода, а не `kill -0`: завершившийся фоновый потомок до `wait` остаётся зомби, и `kill -0` отвечал бы
		# «жив» — каждая команда ждала бы весь потолок.
		cof=/tmp/enodia-console.$$
		# `.rc` ловушка НЕ трогает: по нему сторож узнаёт, что команда кончилась, и стёртый раньше его взгляда он принимал за «идёт» —
		# минуту крутил опрос и гасил дерево уже закончившейся команды вместе с её честным фоном (ревью шага 6d, круг 3). Его убирает сторож.
		trap 'rm -f "$cof" "$cof.k" "$cof.cut"' EXIT
		trap 'exit 1' INT TERM HUP PIPE
		# Вывод — ПРЯМО В ФАЙЛ, без трубы: `head -c` в трубе копит вывод в своём буфере до выхода, а фон, оставленный командой без
		# перенаправления (`sh x.sh &`), держит трубу и не даёт ему выйти — ответ приходил пустым (ревью шага 6d, круг 3). Потолок по
		# объёму держит сторож ниже. stdio фона — в /dev/null: унаследованный stdout CGI держал бы ответ, пока жив фон.
		( sh -c "$cmd" > "$cof" 2>&1; echo $? > "$cof.rc" ) </dev/null >/dev/null 2>&1 &
		cpid=$!
		# Шаг ожидания — 0,1 с (`usleep` у busybox есть; дробного `sleep` нет — замер BE7000), чтобы быстрая команда не ждала секунду.
		lim=60; cstep=usleep; usleep 1 >/dev/null 2>&1 || cstep=sleep
		cmax=$((lim*10)); [ "$cstep" = sleep ] && cmax=$lim
		# СТОРОЖ ПОТОЛКА — ОТДЕЛЬНЫЙ ФОНОВЫЙ УЗЕЛ, а не цикл самого CGI: uhttpd, потеряв клиента (вкладку закрыли, не дождавшись), бьёт
		# CGI SIGKILL, ловушка на нём не срабатывает, и команда без конца (`ping` без `-c`, `tcpdump`) жила до ребута (ревью шага 6d,
		# круг 2). Сторож переживает CGI: по сроку ставит метку «оборвана» и гасит дерево, а если CGI уже мёртв — убирает и времянки.
		# Метка — ДО сигналов: иначе группа, поймавшая TERM после `sh -c`, успевала бы записать код 143, и оборванная читалась бы упавшей сама.
		# ПОТОЛОК ПО ОБЪЁМУ — тот же сторож, на каждом шаге: /tmp — это ОЗУ, и `yes` или `cat /dev/zero` за секунды забивали его, а страницы
		# tmpfs OOM не освобождает — он убивал несущую и dnsmasq (ревью шага 6d, круг 2). Вывод перевалил за 100 КБ — дерево гасим (как
		# SIGPIPE у `… | head`), меткой `.cut`, а не `.k`: оборвана не по сроку. Переполнение ограничено одним шагом (0,1 с) записи.
		(
			ci=0
			while [ ! -s "$cof.rc" ] && [ "$ci" -lt "$cmax" ]; do
				if [ "$cstep" = usleep ]; then usleep 100000; else sleep 1; fi
				ci=$((ci+1))
				[ "$(wc -c < "$cof" 2>/dev/null)" -gt 100000 ] 2>/dev/null && { : > "$cof.cut"; break; }
			done
			if [ ! -s "$cof.rc" ]; then
				[ -e "$cof.cut" ] || : > "$cof.k"
				# The tree walk's owner — daemon-lib.sh::proc_tree (shared with the task runner); an older library without it — the
				# former walk.
				[ -n "$CBN_LIB" ] || { CBN_LIB=1; if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi; }
				if command -v proc_tree >/dev/null 2>&1; then ctree=$(proc_tree "$cpid")
				else
					ctree="$cpid"; cq="$cpid"
					while [ -n "$cq" ]; do
						cn=""
						for cp in $cq; do
							for cf in $(grep -l "^PPid:[[:space:]]*$cp\$" /proc/[0-9]*/status 2>/dev/null); do
								cc=${cf#/proc/}; cc=${cc%/status}; cn="$cn $cc"
							done
						done
						ctree="$ctree$cn"; cq=$cn
					done
				fi
				kill -TERM $ctree 2>/dev/null; sleep 1; kill -KILL $ctree 2>/dev/null
			fi
			# CGI жив — он прочтёт вывод и уберёт времянки сам; мёртв — убираем мы (запас на чтение живым CGI).
			sleep 3; kill -0 $$ 2>/dev/null || rm -f "$cof" "$cof.rc" "$cof.k" "$cof.cut"
		) </dev/null >/dev/null 2>&1 &
		# CGI ждёт конца команды или вердикта сторожа; свой предел — с запасом, на случай если сторож сам не дожил.
		ci=0; cwmax=$((cmax + cmax/10 + 30))
		while [ ! -s "$cof.rc" ] && [ ! -e "$cof.k" ] && [ ! -e "$cof.cut" ] && [ "$ci" -lt "$cwmax" ]; do
			if [ "$cstep" = usleep ]; then usleep 100000; else sleep 1; fi
			ci=$((ci+1))
		done
		killed=false; [ -e "$cof.k" ] && killed=true
		# Фон НЕ ждём (`wait`): код уже в файле, а зомби приберёт init вместе с нами. Обрезанную по объёму тоже не ждём: первые 100 КБ
		# уже лежат и не меняются, а код у неё — от сигнала сторожа (нет файла кода = 143).
		code=$(cat "$cof.rc" 2>/dev/null | tr -d ' \r\n'); case "$code" in ''|*[!0-9]*) code=143 ;; esac
		[ "$killed" = true ] && code=143
		# Управляющие байты (0x00–0x1F, кроме таба и перевода строки, и DEL) — вон: сырой в строке JSON ломает разбор ВСЕГО ответа, и
		# панель читала выполненную команду как «нет связи» (тот же довод, что у `jtxt` в json-lib.sh). ESC уходит тем же `tr`, хвост
		# ANSI-последовательности (`[0;32m`) снимает sed.
		esc=$(head -c 100000 "$cof" | tr '\t' ' ' | tr -d '\000-\010\013-\037\177' | sed 's/\[[0-9;]*m//g' | jtrim | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s\\n",$0}')
		# ФАКТЫ, КОТОРЫХ ПАНЕЛЬ САМА НЕ ЗНАЕТ: вывод обрезан (потолок 100 КБ — в БАЙТАХ, `wc -c`), каков потолок и сработал ли он
		# (`killed` — по факту, а не «код 143»: его команда может вернуть и сама).
		cut=false; [ "$(wc -c < "$cof")" -gt 100000 ] && cut=true
		printf '{"ok":%s,"code":%s,"cut":%s,"limit":%s,"killed":%s,"out":"%s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$cut" "$lim" "$killed" "$esc"
		exit 0 ;;

	# --- РЕЖИМ ПОДДЕРЖКИ: временный обратный SSH-туннель разработчику (support.sh). Тестер жмёт
	# кнопку → роутер сам инициирует исходящее к VPS-релею (пробивает CGNAT), поверхность = SSH :22,
	# E2E-шифрование, авто-экспайр. support.sh печатает свой JSON-статус на stdout ({active,port,
	# expires_in} | {active:0,error}) и возвращает 0/1 → пробрасываем его как "status", ok=по коду.
	# Аутентификация: стоячий .support-key (приватные сборки, поле не нужно) ИЛИ одноразовый кред из
	# поля (per-session) → env SUPPORT_PW (в argv НЕ уходит — ps виден). ttl опционален (support.sh
	# сам клэмпит до cap 2ч; деф. 30 мин).
	support_on)
		ttl=$(field ttl); case "$ttl" in ''|*[!0-9]*) ttl=1800 ;; esac
		cred=$(urldecode "$(field cred)")
		[ -n "$cred" ] && export SUPPORT_PW="$cred"
		raw=$(sh "$ENODIA_DIR/support.sh" up "$ttl" 2>/dev/null); code=$?
		unset SUPPORT_PW
		# support.sh обязан печатать на stdout ТОЛЬКО JSON; подстраховка — берём последнюю {…}-строку.
		# Грабля: busybox `start-stop-daemon -K` пишет "stopped process…"/"no process… none killed" в
		# STDOUT (не stderr) → строка протекала в $out → битый JSON → фронт ловил catch «сбой запроса»,
		# хотя туннель реально поднимался/гасился. Гард держит контракт «CGI всегда отдаёт валидный JSON».
		out=$(printf '%s\n' "$raw" | grep '^{' | tail -n1)
		printf '{"ok":%s,"code":%s,"status":%s}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "${out:-null}"
		exit 0 ;;
	support_off)
		raw=$(sh "$ENODIA_DIR/support.sh" down 2>/dev/null)
		out=$(printf '%s\n' "$raw" | grep '^{' | tail -n1)   # тот же гард — только JSON-строка (см. support_on)
		printf '{"ok":true,"code":0,"msg":"Доступ закрыт","status":%s}\n' "${out:-null}"
		exit 0 ;;
	# --- РЕЖИМ ПОДДЕРЖКИ через «код поддержки» (широкая сборка БЕЗ данных релея в билде). Тестер
	# вставляет base64-код от разработчика (`BE7SUP1 IP PORT USER PASSWORD`). Код уходит в support.sh
	# open-code ЧЕРЕЗ STDIN (не argv/env — пароль не светится в ps). support.sh провижнит релей
	# (.support-relay — координаты не секрет) и поднимает туннель паролем; ничего серверного в
	# билде/репе не хранится. Тот же контракт + гард «только {…}-строка», что у support_on.
	support_open)
		ttl=$(field ttl); case "$ttl" in ''|*[!0-9]*) ttl=1800 ;; esac
		scode=$(urldecode "$(field code)")
		[ -n "$scode" ] || fail "пустой код поддержки"
		raw=$(printf '%s' "$scode" | sh "$ENODIA_DIR/support.sh" open-code "$ttl" 2>/dev/null); rc=$?
		out=$(printf '%s\n' "$raw" | grep '^{' | tail -n1)
		# ПРИЧИНА ОТКАЗА — СЛОВАМИ: support.sh отвечает кодом (`error`), а панель показывала на любой отказ «ошибка», и
		# человек не мог отличить обрезанный при копировании код от мёртвого интернета. Коды — контракт support.sh.
		case "$out" in
			*'"active":1'*)       smsg="Доступ открыт" ;;
			*'"empty-code"'*)     smsg="код поддержки пустой — вставьте его целиком" ;;
			*'"bad-code"'*)       smsg="код поддержки не распознан — скопируйте его целиком, без обрезки" ;;
			*'"bad-relay"'*)      smsg="в коде неверный адрес релея — попросите у разработчика новый код" ;;
			*'"tunnel-failed"'*)  smsg="соединение с релеем не поднялось за три попытки — проверьте интернет и повторите" ;;
			*'"wan-down"'*)       smsg="у роутера нет связи с провайдером — подключите интернет и повторите" ;;
			*)                    smsg="не удалось открыть доступ" ;;
		esac
		printf '{"ok":%s,"code":%s,"msg":"%s","status":%s}\n' "$([ "$rc" -eq 0 ] && echo true || echo false)" "$rc" "$smsg" "${out:-null}"
		exit 0 ;;
	# --- НАСТРОЙКИ панели (.prefs, key=value). Ключ — строгий whitelist (в файл уходит только
	# проверенное имя ключа), значение валидируется по типу ключа. Атомарная запись: переписать
	# без старой строки ключа + добавить новую. Чтение — cgi-bin/data section=prefs. Расширяемо:
	# новый knob = ветка валидации тут + строка чтения в emit_prefs.
	set_pref)
		k=$(field key); v=$(urldecode "$(field val)")
		case "$k" in
			egress_url)      echo "$v" | grep -qE '^https://[A-Za-z0-9._~-]+(/[A-Za-z0-9._~/-]*)?$' || fail "URL должен быть https://хост[/путь] (буквы, цифры, . _ ~ - /)" ;;
			sort_after_test) case "$v" in 0|1) : ;; *) fail "значение 0 или 1" ;; esac ;;
			del_dead_after_test) case "$v" in 0|1) : ;; *) fail "значение 0 или 1" ;; esac ;;
			autoping_min)    case "$v" in 0|5|10|15) : ;; *) fail "значение 0/5/10/15" ;; esac ;;
			balancer)        case "$v" in 0|1) : ;; *) fail "значение 0 или 1" ;; esac ;;
			theme)           case "$v" in auto|light|dark) : ;; *) fail "значение auto/light/dark" ;; esac ;;
			lang)            case "$v" in ru|en) : ;; *) fail "значение ru/en" ;; esac ;;
			# Что меряет живая скорость в шапке (через туннель · напрямую · всего) — ВИД, а не
			# настройка, но храним тут же, рядом с темой: выбор едет за человеком на все устройства.
			live_src)        case "$v" in tun|direct|all) : ;; *) fail "значение tun/direct/all" ;; esac ;;
			*) fail "неизвестная настройка" ;;
		esac
		P="$ENODIA_STATE/.prefs"; tmp="$P.$$"
		{ [ -f "$P" ] && grep -v "^$k=" "$P"; printf '%s=%s\n' "$k" "$v"; } > "$tmp" 2>/dev/null && mv "$tmp" "$P" || { rm -f "$tmp" 2>/dev/null; fail "не удалось сохранить настройку"; }
		printf '{"ok":true,"code":0,"msg":"настройка сохранена"}\n'
		exit 0 ;;

	# --- РЕАЛЬНЫЙ тест xray-конфига (не пинг): xray-test.sh поднимает конфиг на временном socks
	# и проверяет фактический выход в интернет. Печатает свой JSON {ok,ip,ms|msg}. Имя — строгий
	# whitelist (в shell не уходит ничего, кроме прошедшего regex имени файла конфига).
	test_xray_server)
		[ -f "$ENODIA_DIR/xray-test.sh" ] || fail "xray-test.sh не установлен (обновите панель)"
		[ -x "$(bin_path xray)" ]  || fail "xray не установлен"
		name=$(urldecode "$(field name)")
		# Форма имени — та же, что у чтения и удаления (`^[A-Za-z0-9_.-]+$`): прежний потолок 80 знаков отвечал «плохое имя» на
		# экране конфига с длинным именем, и панель писала мёртвым живой сервер (ревью пачки 2, круг 2). Длину держит ФС.
		echo "$name" | grep -qE '^[A-Za-z0-9._-]+$' || fail "плохое имя конфига"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "конфиг не найден"
		# Необязательный порт временного socks: панель шлёт разные (10812..10819) для ПАРАЛЛЕЛЬНОГО
		# теста группы серверов подписки. Строго валидируем (порт идёт в sed/netstat скрипта).
		port=$(field port); case "$port" in 1081[2-9]) : ;; *) port=10812 ;; esac
		sh "$ENODIA_DIR/xray-test.sh" egress "$name" "$port"   # режим — явным словом: конфиг «speed» иначе читался как режим
		exit 0 ;;

	# --- ТЕСТ СКОРОСТИ xray-конфига: качает известный размер через socks конфига → Мбит/с.
	# Тот же xray-test.sh в режиме speed (DRY). Жжёт реальный трафик (через VPS) → это РАЗОВОЕ
	# действие по кнопке, не часть «проверить все». Многопоточно (streams/dur, скрипт капит).
	speedtest_xray_server)
		[ -f "$ENODIA_DIR/xray-test.sh" ] || fail "xray-test.sh не установлен (обновите панель)"
		[ -x "$(bin_path xray)" ]  || fail "xray не установлен"
		name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9._-]+$' || fail "плохое имя конфига"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "конфиг не найден"
		port=$(field port); case "$port" in 1081[2-9]) : ;; *) port=10812 ;; esac
		streams=$(field streams); case "$streams" in ''|*[!0-9]*) streams=4 ;; esac
		dur=$(field dur); case "$dur" in ''|*[!0-9]*) dur=12 ;; esac
		sh "$ENODIA_DIR/xray-test.sh" speed "$name" "$port" "$streams" "$dur"
		exit 0 ;;

	# --- Свои имена (оверрайд домен→IP): dns-hosts.sh валидирует домен/IP и пишет живой conf + reload.
	# add и del печатают «ok» или причину словами (exit != 0). ТОЛЬКО stdout и ТОЛЬКО последняя строка:
	# stderr — это вывод `dnsmasq --test` (conf_test пишет его туда для лога), и склеенный с причиной переводом
	# строки он ломал JSON ответа (`fail` кладёт строку как есть) — панель показывала «сбой: …JSON…» вместо
	# «dnsmasq не принял такой адрес» (ревью шага 5a, круг 1). Причина — через jesc: её пишет скрипт.
	dns_host_add)
		[ -f "$ENODIA_DIR/dns-hosts.sh" ] || fail "dns-hosts.sh не установлен (обновите панель)"
		dom=$(urldecode "$(field domain)"); ip=$(urldecode "$(field ip)")
		out=$(sh "$ENODIA_DIR/dns-hosts.sh" add "$dom" "$ip" 2>/dev/null | tail -n 1)
		case "$out" in
			ok) printf '{"ok":true,"code":0,"msg":"своё имя добавлено"}\n' ;;
			*)  fail "$(printf '%s' "${out:-не удалось добавить}" | jesc 200)" ;;
		esac
		exit 0 ;;
	dns_host_del)
		[ -f "$ENODIA_DIR/dns-hosts.sh" ] || fail "dns-hosts.sh не установлен (обновите панель)"
		dom=$(urldecode "$(field domain)")
		out=$(sh "$ENODIA_DIR/dns-hosts.sh" del "$dom" 2>/dev/null | tail -n 1)
		[ "$out" = ok ] || fail "$(printf '%s' "${out:-не удалось убрать}" | jesc 200)"
		printf '{"ok":true,"code":0,"msg":"своё имя убрано"}\n'; exit 0 ;;

	# --- Раздельный резолв рунета (.ru/.рф/.su напрямую через RF-резолвер). dns-split.sh пишет
	# живой conf + reload dnsmasq. Только вкл/выкл (резолвер хардкод Яндекс — надёжный RF-дефолт).
	split_runet_on)
		[ -f "$ENODIA_DIR/dns-split.sh" ] || fail "dns-split.sh не установлен (обновите панель)"
		sh "$ENODIA_DIR/dns-split.sh" on >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"раздельный резолв рунета включён"}\n'; exit 0 ;;
	split_runet_off)
		[ -f "$ENODIA_DIR/dns-split.sh" ] || fail "dns-split.sh не установлен (обновите панель)"
		sh "$ENODIA_DIR/dns-split.sh" off >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"раздельный резолв рунета выключен"}\n'; exit 0 ;;

	# --- Сеть/MTU: MTU туннеля AmneziaWG (awg0) + блок клиентского IPv6-интернета. net-tune.sh
	# применяет флаги (.tun-mtu / .ipv6-block) и переигрывается heal.sh на буте.
	set_tun_mtu)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обновите панель)"
		mtu=$(field mtu | tr -cd '0-9')
		[ -n "$mtu" ] || fail "нет значения MTU"
		{ [ "$mtu" -ge 1280 ] && [ "$mtu" -le 1500 ]; } 2>/dev/null || fail "MTU вне диапазона 1280..1500"
		echo "$mtu" > "$ENODIA_STATE/.tun-mtu"
		sh "$ENODIA_DIR/net-tune.sh" mtu >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"MTU awg0 = %s"}\n' "$mtu"; exit 0 ;;
	# Потолок кучи Go у демонов AmneziaWG. Значение ПРИМЕНЯЕТСЯ СТАРТОМ демона (на лету потолок
	# не меняется) ⇒ здесь только пишем флаг и честно говорим об этом в ответе; несущую сами не
	# роняем — рвать соединения всему дому ради настройки нельзя.
	set_go_memlimit)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обновите панель)"
		gv=$(field value | tr -cd 'a-z0-9')
		case "$gv" in
			auto)   rm -f "$ENODIA_STATE/.go-memlimit" 2>/dev/null; gm="автоматически" ;;
			off)    echo off > "$ENODIA_STATE/.go-memlimit"; gm="без ограничения" ;;
			[0-9]*) { [ "$gv" -ge 16 ] && [ "$gv" -le 512 ]; } 2>/dev/null || fail "значение вне диапазона 16..512 МиБ"
			        echo "$gv" > "$ENODIA_STATE/.go-memlimit"; gm="$gv МиБ" ;;
			*)      fail "нет значения" ;;
		esac
		printf '{"ok":true,"code":0,"msg":"потолок памяти: %s — вступит в силу при следующем подъёме туннеля"}\n' "$gm"; exit 0 ;;
	ipv6_block_on)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обновите панель)"
		: > "$ENODIA_STATE/.ipv6-block"
		sh "$ENODIA_DIR/net-tune.sh" ipv6 >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"IPv6-интернет клиентам заблокирован"}\n'; exit 0 ;;
	ipv6_block_off)
		[ -f "$ENODIA_DIR/net-tune.sh" ] || fail "net-tune.sh не установлен (обновите панель)"
		rm -f "$ENODIA_STATE/.ipv6-block" 2>/dev/null
		sh "$ENODIA_DIR/net-tune.sh" ipv6 >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"IPv6-интернет клиентам разрешён"}\n'; exit 0 ;;

	# --- Шифрованный DNS (DoH): тумблер + выбор резолвера. Слой doh-lib.sh (supervise локального
	# https_dns_proxy + каталог резолверов). Live-переигрыш DNS активного транспорта — через
	# transport.sh dns (единый верб): каждый DNS-сеттер плагина проходит через doh_apply_dns, поэтому
	# on ставит dnsmasq→127.0.0.1#5053 + марку резолвера, off возвращает прежний путь БАЙТ-В-БАЙТ.
	# Пока бинарь не вендорен — тумблер персистится, но doh_enabled=false ⇒ реального эффекта нет
	# (безопасно): карточка честно покажет «бинарь не установлен».
	doh_on)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обновите панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		dns_rewire_hold   # чужая операция — отказ, тик сторожа — подождать; дальше под своим локом
		echo on > "$ENODIA_STATE/.doh-on"
		# Включение — новое намерение: выбранный DoT пробуем заново, а не шифруем по DoH, куда его когда-то увела
		# проверка ДРУГОГО пути (иначе хвост ответа говорил бы «DoT не проходит» о пути, который никто не проверял).
		# Переезд был, а прокси жив (держал авто-режим) — он ещё на DoH: снять его правила и поднять под DoT.
		if command -v doh_dot_forget >/dev/null 2>&1 && doh_dot_forget && doh_running; then
			doh_resolver_mark del; doh_resolver_bypass del; doh_restart
		fi
		sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1   # переиграть DNS активного транспорта → локальный DoH-прокси + марка резолвера
		# СУДИМ ПО ФАКТУ, а не по коду шага. DNS переходит на прокси только если проба резолва
		# прошла (doh_apply_dns пробует и откатывается сам). Не перешёл — тумблер обязан вернуться
		# в «выкл»: иначе человек остаётся с ЗЕЛЁНЫМ переключателем над сетью без имён. Ровно это
		# случилось 31.08.2026 на AX3600 (прокси слушает порт и не отвечает ни на один запрос).
		# Библиотека сеть уже вернула; наше дело — не соврать про состояние и снять НАМЕРЕНИЕ,
		# потому что видим человека здесь только мы.
		if doh_installed && ! grep -q "server=$(doh_upstream)" /etc/dnsmasq.d/00-upstream.conf 2>/dev/null; then
			rm -f "$ENODIA_STATE/.doh-on"
			# В ЦЕНТР УВЕДОМЛЕНИЙ, а не только тостом: тост живёт секунды, журнал действий —
			# клиентский и умирает вместе с вкладкой, а узнать «почему у меня выключился
			# шифрованный DNS» человек захочет позже. Единая точка события — notify-event.sh
			# (он пишет журнал ДО почтовых гейтов, письмо уйдёт только если почта настроена).
			# Фоном: notify-event ходит к SMTP, а CGI и так ждал пробу резолва ~12 с.
			# Троттл час — повторные нажатия не должны спамить ни журнал, ни почту.
			spawn_bg /tmp/enodia-doh-event.pid -c "sh '$ENODIA_DIR/notify-event.sh' doh-enable-failed 3600 'Шифрованный DNS не включился' 'Резолвер $(doh_resolver_name) не ответил на проверочный запрос. DNS возвращён на прежний путь, тумблер снят — сеть работает. Если это повторяется, шифрованный DNS на этом роутере лучше оставить выключенным.'"
			fail "Шифрованный DNS не заработал: резолвер не ответил. Вернул прежний DNS, тумблер снят."
		fi
		if doh_installed; then
			printf '{"ok":true,"code":0,"msg":"Шифрованный DNS включён (резолвер: %s)%s"}\n' "$(doh_resolver_name)" "$(dot_fb_tail)"; exit 0
		fi
		printf '{"ok":true,"code":0,"msg":"Включено, но бинарь DoH ещё не установлен — шифрование заработает после установки"}\n'; exit 0 ;;
	doh_off)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обновите панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		dns_rewire_hold   # чужая операция — отказ, тик сторожа — подождать; дальше под своим локом
		doh_dns_bailout                                   # снять форс-марку/RETURN резолвера, погасить прокси, стереть флаг «уведён»
		rm -f "$ENODIA_STATE/.doh-on" 2>/dev/null                  # ДО reapply: doh_apply_dns теперь вернёт 1 → прежний путь транспорта
		sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
		# В прямом режиме (zapret/byedpi/fail-open) reapply мог тут же поднять DoH ЗАНОВО по авто-режиму —
		# честно об этом сказать, иначе «выключил, а он работает» выглядит багом.
		if command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; then
			printf '{"ok":true,"code":0,"msg":"Тумблер выключен; в прямом режиме DNS остаётся шифрованным (авто-режим)"}\n'; exit 0
		fi
		printf '{"ok":true,"code":0,"msg":"Шифрованный DNS выключен"}\n'; exit 0 ;;
	# «ПОПРОБОВАТЬ СЕЙЧАС» — во время паузы ручного DoH (doh-lib.sh::doh_apply_fail: резолвер не ответил, DNS на прежнем пути,
	# сторож повторит через DOH_BAIL_BACKOFF). Прежде экран советовал «выключите и включите тумблер», а включение, проваливая
	# пробу, СНИМАЕТ тумблер (doh_on выше: новое намерение, которое не прошло проверку) — совет, выполненный при всё ещё
	# мёртвом резолвере, стирал намерение, и роутер переставал пробовать вовсе. Здесь намерение не трогаем: перепроводка
	# (`transport.sh dns` → doh_apply_dns) сама снимает паузу, а провал ставит её заново. Итог — по указателю dnsmasq.
	doh_retry)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обновите панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		doh_enabled || fail "Шифрованный DNS выключен — пробовать нечего"
		# ЧУЖАЯ ОПЕРАЦИЯ ИДЁТ — не вмешиваемся (ревью ветки, круги 1–2): кнопка видна ровно тогда, когда несущая под подозрением, то
		# есть в окне failover. Лок смены держат смена транспорта, установка компонентов, перенос на накопитель, «Отключить VPN»;
		# а тик сторожа и heal ведут несущую БЕЗ него — перебор резервов xray/hy2 идёт прямо в плагине, и наш лок его ПРЕРВАЛ бы
		# («ручная смена важнее»): сторож счёл бы пул исчерпанным и ушёл в cross или FAILOPEN. Параллельный `transport.sh dns`
		# прочёл бы ещё прежний `.transport`, и два doh_apply_dns ставили бы и снимали правила резолвера навстречу друг другу.
		[ -e "$SWITCH_LOCK" ] && fail "Роутер занят другой операцией — попробуйте через минуту"
		if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi
		command -v pid_runs >/dev/null 2>&1 || pid_runs() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
		_drc() { command -v wd_tick_alive >/dev/null 2>&1 && { wd_tick_alive || heal_alive; }; }
		_drc && fail "Роутер сейчас сам восстанавливает соединение — попробуйте через минуту"
		doh_upstream_set && { printf '{"ok":true,"code":0,"msg":"Шифрованный DNS уже работает"}\n'; exit 0; }
		# ЛОК И ПЕРЕПРОВОДКА — В ФОНОВОМ УЗЛЕ, а не в CGI (ревью ветки, круг 2): при мёртвом резолвере перепроводка идёт 30–60 с,
		# и закрытая вкладка = SIGKILL от uhttpd, при котором trap молчит — лок оставался бы до SWITCH_STALE (30 мин), и всё это
		# время сторож не чинил бы ничего. Узел снимает лок сам; CGI его только ждёт. Тик, успевший стартовать между сверкой и
		# локом, ловим повторной сверкой уже под локом (новые тики лок чтут и выходят сами).
		[ -e "$SWITCH_LOCK" ] && fail "Роутер занят другой операцией — попробуйте через минуту"
		# Свой пид в лок, создание атомарное: CGI, убитый ДО старта узла, оставит МЁРТВЫЙ пид — сторож снимет такой лок сразу
		# (watchdog.sh::switch_lock_held), а не через 30 мин. Узел, стартовав, ПЕРЕНИМАЕТ этот лок своим пидом (не создаёт свой).
		( set -C; echo $$ > "$SWITCH_LOCK" ) 2>/dev/null || fail "не удалось взять лок смены транспорта"
		if _drc; then rm -f "$SWITCH_LOCK" 2>/dev/null; fail "Роутер сейчас сам восстанавливает соединение — попробуйте через минуту"; fi
		spawn_bg /tmp/enodia-doh-retry.pid -c ": doh-retry; [ -e \"$SWITCH_LOCK\" ] && echo \$\$ > \"$SWITCH_LOCK\"; trap 'rm -f \"$SWITCH_LOCK\"' EXIT; trap 'exit 1' INT TERM HUP PIPE; sh '$ENODIA_DIR/transport.sh' dns >/dev/null 2>&1"
		_drp=$(cat /tmp/enodia-doh-retry.pid 2>/dev/null | tr -cd '0-9'); _drw=0
		# Узел не поднялся (нет пидфайла и после запаса) — лок наш и снять его больше некому: иначе сторож стоял бы до SWITCH_STALE.
		# fixed-wait: запас на запись пидфайла внуком start-stop-daemon под нагрузкой (spawn_bg ждёт 2 с), жизнь судить не по чему.
		[ -n "$_drp" ] || { sleep 3; _drp=$(cat /tmp/enodia-doh-retry.pid 2>/dev/null | tr -cd '0-9'); }
		[ -n "$_drp" ] || { rm -f "$SWITCH_LOCK" 2>/dev/null; fail "Не удалось запустить проверку — попробуйте ещё раз"; }
		# Потолок ниже таймаута uhttpd (-t 180). fixed-wait: ждём не старт демона, а конец перепроводки — судим по жизни узла.
		while [ "$_drw" -lt "${DOH_RETRY_WAIT:-150}" ] && pid_runs "$_drp" ': doh-retry;'; do sleep 1; _drw=$((_drw+1)); done
		pid_runs "$_drp" ': doh-retry;' && { printf '{"ok":true,"code":0,"msg":"Проверка ещё идёт — итог появится на экране"}\n'; exit 0; }
		if ! doh_upstream_set; then
			# Срок — только если пауза и правда встала: провал при лежащем WAN её не ставит (doh_apply_fail), и сторож пробует сразу.
			[ -f "$DOH_BAIL_STAMP" ] && fail "Резолвер снова не ответил — DNS остался на прежнем пути. Роутер попробует сам через $((DOH_BAIL_BACKOFF / 60)) мин."
			fail "Резолвер снова не ответил — DNS остался на прежнем пути. Роутер попробует сам на ближайшей проверке сторожа."
		fi
		printf '{"ok":true,"code":0,"msg":"Шифрованный DNS снова работает (резолвер: %s)%s"}\n' "$(doh_resolver_name)" "$(dot_fb_tail)"; exit 0 ;;
	# Авто-режим: включать DoH САМ, когда туннеля нет (zapret/byedpi/fail-open) — там dnsmasq иначе
	# форвардит плейн UDP:53 и ISP может травить DNS. Дефолт вкл; функциональная проба в doh_apply_dns
	# откатит на прежний DNS, если резолвер недостижим. [[doh-direct-modes-backlog]]
	set_doh_auto)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обновите панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		dns_rewire_hold   # чужая операция — отказ, тик сторожа — подождать; дальше под своим локом
		v=$(field value | tr -cd 'a-z')
		case "$v" in on|off) : ;; *) fail "ожидается on|off" ;; esac
		if [ "$v" = off ]; then
			echo off > "$ENODIA_STATE/.doh-auto"
			doh_auto_active && doh_auto_rollback   # авто держит DNS прямо сейчас → снять до reapply
			sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
			printf '{"ok":true,"code":0,"msg":"Авто-DNS в прямых режимах выключен"}\n'; exit 0
		fi
		rm -f "$ENODIA_STATE/.doh-auto" 2>/dev/null          # отсутствие файла = разрешено (дефолт)
		sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"Авто-DNS в прямых режимах включён"}\n'; exit 0 ;;
	set_doh_resolver)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обновите панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		dns_rewire_hold   # чужая операция — отказ, тик сторожа — подождать; дальше под своим локом
		r=$(field resolver | tr -cd 'a-z0-9')
		case " $(doh_resolver_list) " in *" $r "*) : ;; *) fail "неизвестный резолвер" ;; esac
		nid=$(field nextdns_id | tr -cd 'a-f0-9' | cut -c1-16)
		[ "$r" = nextdns ] && [ -z "$nid" ] && fail "для NextDNS укажите ID профиля"
		# --- СВОЙ резолвер: разобрать ввод и ПОСЧИТАТЬ ЯКОРЯ ДО единой правки состояния ---
		# Разбор и валидация — в doh-lib (doh_custom_parse), здесь только длина: поле приходит из
		# сети, и обрезать его до разбора дешевле, чем гонять регексп по мегабайту.
		cu=""; cs=""; cips=""; cdp=""
		if [ "$r" = custom ]; then
			# urldecode ОБЯЗАТЕЛЕН: панель шлёт значение через encodeURIComponent, и без декода
			# сюда приходит `https%3A%2F%2F…` — строгий разбор такое отвергает ЦЕЛИКОМ, то есть
			# поле не работало бы вовсе ни с одним адресом. Порядок «декод → обрезка» сознателен:
			# режем то, что человек ввёл, а не проценты. Пробелы НЕ трогаем — их края снимет
			# doh_custom_parse, а внутренние обязаны уронить разбор (см. его шапку).
			cin=$(urldecode "$(field custom_url | cut -c1-900)" | cut -c1-300)
			[ -n "$cin" ] || fail "укажите адрес своего резолвера"
			cp=$(doh_custom_parse "$cin") || fail "адрес не похож на резолвер: ждём https://хост/путь, tls://хост, имя или IP"
			cu=$(printf '%s' "$cp" | cut -f1); cs=$(printf '%s' "$cp" | cut -f2); ch=$(printf '%s' "$cp" | cut -f3)
			cdp=$(printf '%s' "$cp" | cut -f4)   # порт DoT из `tls://хост:порт` (пусто = 853); библиотека старше поля — пусто
			# DoT предъявляет имя в SNI, и `-s` у dot-proxy обязателен ⇒ голый IP с ним несовместим.
			# Говорим это ДО того, как что-то поменяли: иначе человек получил бы откат вместо ответа.
			[ "$(doh_proto)" = dot ] && [ -z "$cs" ] && fail "для DoT нужно ИМЯ резолвера (у IP нечего предъявить в SNI) — введите имя или переключите протокол на DoH"
			# Якоря считаем ЗДЕСЬ, пока DNS ещё держит ПРЕЖНИЙ (рабочий) резолвер — после переключения
			# резолвить было бы уже нечем. Пустой набор = отказ: без якорей в прямом режиме запросы к
			# резолверу попадут под десинк, то есть мы своими руками положим DNS всему дому.
			if [ -n "$cs" ]; then
				# Конвейер якорей — ОДИН на двоих (doh-lib::doh_anchor_ips), он же канонизирует
				# набор сортировкой: иначе первый же перерезолв в стороже объявил бы «адреса
				# сменились» лишь потому, что резолвер отдал те же A-записи в другом порядке.
				cips=$(doh_anchor_ips "$cs")
				[ -n "$cips" ] || fail "не удалось узнать адреса $cs — проверьте имя (сейчас DNS ещё работает через прежний резолвер)"
			else
				cips="$ch"
			fi
		fi
		# Прежний резолвер запоминаем ДО перезаписи: недостижимый новый откатим на него (проба ниже).
		prev=$(doh_resolver_name); prevnid=$(cat "$ENODIA_STATE/.doh-nextdns-id" 2>/dev/null)
		prevcu=$(cat "$ENODIA_STATE/.doh-custom-url" 2>/dev/null); prevcs=$(cat "$ENODIA_STATE/.doh-custom-sni" 2>/dev/null)
		prevcips=$(cat "$ENODIA_STATE/.doh-custom-ips" 2>/dev/null); prevcdp=$(cat "$ENODIA_STATE/.doh-custom-dot-port" 2>/dev/null)
		# Teardown :443-правил СТАРОГО резолвера ДО записи нового (guard знает лишь текущий резолвер —
		# иначе марка/RETURN прежнего IP останутся висеть в mangle OUTPUT).
		doh_resolver_mark del; doh_resolver_bypass del
		# Вердикт «853 этим путём закрыт» был про ПРЕЖНИЙ резолвер: новый обязан сперва попробовать DoT.
		command -v doh_dot_forget >/dev/null 2>&1 && doh_dot_forget
		echo "$r" > "$ENODIA_STATE/.doh-resolver"
		[ "$r" = nextdns ] && echo "$nid" > "$ENODIA_STATE/.doh-nextdns-id"
		# Своё — тремя файлами разом: URL (DoH), имя (SNI для DoT; пусто у литерала) и якоря.
		# Порядок «teardown выше → запись здесь → расстановка ниже» обязателен: правила снимаются
		# по ТЕКУЩЕМУ содержимому .doh-custom-ips, и переписать его раньше teardown значило бы
		# оставить марку/RETURN прежних адресов висеть в mangle навсегда.
		if [ "$r" = custom ]; then
			echo "$cu" > "$ENODIA_STATE/.doh-custom-url"
			echo "$cs" > "$ENODIA_STATE/.doh-custom-sni"
			echo "$cips" > "$ENODIA_STATE/.doh-custom-ips"
			if [ -n "$cdp" ]; then echo "$cdp" > "$ENODIA_STATE/.doh-custom-dot-port"; else rm -f "$ENODIA_STATE/.doh-custom-dot-port" 2>/dev/null; fi
		fi
		# Под новый резолвер: DoH активен (тумблер ИЛИ авто держит DNS) → перезапустить прокси + переиграть
		# DNS (добавит марку/RETURN :443 НОВОГО резолвера). Выключен → просто персист, применится при включении.
		if doh_enabled || { command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; }; then
			doh_restart
			sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
			# ФУНКЦИОНАЛЬНАЯ ПРОБА нового резолвера: dnsmasq уже смотрит на прокси с НОВЫМ URL — не
			# отвечает (недостижим/заблокирован ISP/битый NextDNS-ID) ⇒ вернуть ПРЕЖНИЙ резолвер, DNS
			# всего дома не рвём (симметрия авто-режима doh_apply_dns, только откат на резолвер, не на plain).
			# Заодно проба ГРЕЕТ TCP+TLS+HTTP/2 первого запроса — без неё пару секунд после смены клиенты
			# ловили «Try again» (та же грабля, что при включении тумблера, см. doh_apply_dns).
			# 4 попытки, а не дефолтные 2: холодная сессия к новому резолверу бывает медленной
			# (таймаут+перебор anycast-IP), а ложный откат выглядит как «резолвер не работает».
			# ПЕРВЫМ — указатель dnsmasq на прокси (у владельца, doh_upstream_set): ручной режим с 31.08 сам проверяет имена и при
			# отказе откатывает DNS на путь плагина, и проба имён через ТОТ DNS проходит — «ок» при мёртвом новом резолвере, без
			# возврата прежнего и с паузой 15 минут (ревью ветки fix/dot-tails, круг 2).
			if ! doh_upstream_set || ! doh_probe 4; then
				doh_resolver_mark del; doh_resolver_bypass del
				# Переезд, если он случился на попытке НОВОГО резолвера, — вердикт о нём, а не о прежнем: забыть,
				# иначе прежний резолвер вернулся бы на DoH с экраном «DoT не проходит», хотя его DoT работал.
				command -v doh_dot_forget >/dev/null 2>&1 && doh_dot_forget
				echo "$prev" > "$ENODIA_STATE/.doh-resolver"
				if [ -n "$prevnid" ]; then echo "$prevnid" > "$ENODIA_STATE/.doh-nextdns-id"; else rm -f "$ENODIA_STATE/.doh-nextdns-id" 2>/dev/null; fi
				# Своё возвращаем ЦЕЛИКОМ, включая якоря: прежний резолвер тоже мог быть своим, и
				# полуоткат (имя старое, адреса новые) оставил бы правила на чужих IP.
				if [ -n "$prevcu" ]; then
					echo "$prevcu" > "$ENODIA_STATE/.doh-custom-url"; echo "$prevcs" > "$ENODIA_STATE/.doh-custom-sni"
					echo "$prevcips" > "$ENODIA_STATE/.doh-custom-ips"
					if [ -n "$prevcdp" ]; then echo "$prevcdp" > "$ENODIA_STATE/.doh-custom-dot-port"; else rm -f "$ENODIA_STATE/.doh-custom-dot-port" 2>/dev/null; fi
				else
					rm -f "$ENODIA_STATE/.doh-custom-url" "$ENODIA_STATE/.doh-custom-sni" "$ENODIA_STATE/.doh-custom-ips" "$ENODIA_STATE/.doh-custom-dot-port" 2>/dev/null
				fi
				doh_restart
				sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
				# ПРИЧИНА, а не «не отвечает». Отказ по сертификату выглядит для человека так же
				# («не работает»), но чинится совсем иначе — и такой отказ бывает ПЛАВАЮЩИМ: на
				# железе 14.08.2026 dns.comss.one по DoH прошёл 2 раза из 3, а по DoT — всегда.
				# Единственный, кто знает правду, — лог демона; ловим сигнатуру mbedTLS в свежем
				# хвосте (лог мы только что переписали рестартом, старое сюда не попадёт).
				why=""
				grep -q 'BADCERT_CN_MISMATCH' /tmp/enodia-doh.log 2>/dev/null && \
					why=" (сертификат резолвера не принят; у этого адреса такое бывает через раз — попробуйте протокол DoT)"
				[ -z "$why" ] && grep -q 'BADCERT' /tmp/enodia-doh.log 2>/dev/null && \
					why=" (сертификат резолвера не прошёл проверку)"
				# «возвращён custom» человеку ничего не говорит, когда прежний тоже был своим.
				pname="$prev"; [ "$prev" = custom ] && pname="прежний адрес"
				fail "резолвер $r не отвечает$why — возвращён $pname"
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"Резолвер DoH: %s%s"}\n' "$r" "$(dot_fb_tail)"; exit 0 ;;

	# --- Протокол шифрованного DNS: doh (HTTPS/:443) | dot (TLS/:853, наш dot-proxy). Зеркало
	# set_doh_resolver: teardown обоих портов (del в либе proto-agnostic), персист, при активном
	# DNS — перезапуск под новый бинарь + функциональная проба с откатом на прежний протокол.
	set_doh_proto)
		[ -f "$ENODIA_DIR/doh-lib.sh" ] || fail "doh-lib.sh не установлен (обновите панель)"
		ENODIA_DIR="$ENODIA_DIR"; . "$ENODIA_DIR/doh-lib.sh"
		dns_rewire_hold   # чужая операция — отказ, тик сторожа — подождать; дальше под своим локом
		v=$(field value | tr -cd 'a-z')
		case "$v" in doh|dot) : ;; *) fail "ожидается doh|dot" ;; esac
		prev=$(doh_proto)
		if [ "$v" = "$prev" ]; then
			# ПОВТОРНЫЙ ВЫБОР DoT, ПОКА РОУТЕР ШИФРУЕТ ПО DoH (переезд порта), — просьба «проверь DoT СЕЙЧАС», а не пустой клик:
			# иначе человеку, починившему путь (сменил выход, провайдер открыл 853), оставалось ждать сверку сторожа до часа.
			# Тот же ход, что у включения тумблера: забыть вердикт, поднять прокси под DoT, переиграть DNS — а решит проба
			# имён в doh_apply_dns (не пошли — doh_dot_rescue переедет обратно, и хвост ответа это скажет).
			if [ "$v" = dot ] && command -v doh_dot_forget >/dev/null 2>&1 && \
			   { doh_enabled || { command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; }; } && doh_dot_forget; then
				doh_resolver_mark del; doh_resolver_bypass del; doh_restart
				sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
				# ИТОГ — ПО ФАКТУ (указатель dnsmasq на прокси — у владельца, doh_upstream_set), а не бодрым «ок»: не пошли ни DoT, ни
				# DoH — DNS откатан на прежний путь и стоит пауза, а тост говорил «Протокол шифрованного DNS: dot» (ревью ветки, круг 1).
				doh_upstream_set || fail "Резолвер не ответил ни по DoT, ни по DoH — вернул прежний DNS. Роутер проверит снова сам."
			fi
			printf '{"ok":true,"code":0,"msg":"Протокол шифрованного DNS: %s%s"}\n' "$v" "$(dot_fb_tail)"; exit 0
		fi
		[ -x "$(doh_bin_for "$v")" ] || fail "бинарь для $v не установлен — нажмите «Установить» в карточке"
		# Свой резолвер, введённый ГОЛЫМ IP,c DoT несовместим (в SNI нечего предъявить, а `-s`
		# обязателен). Сказать это ДО переключения — иначе doh_start молча не поднимется, проба
		# провалится и человек увидит откат вместо причины.
		[ "$v" = dot ] && [ "$(doh_resolver_name)" = custom ] && [ -z "$(dot_resolver_sni)" ] && \
			fail "у своего резолвера указан IP — для DoT нужно ИМЯ (или оставьте DoH)"
		doh_resolver_mark del; doh_resolver_bypass del
		echo "$v" > "$ENODIA_STATE/.doh-proto"
		# Новый выбор человека — прежний вердикт о порте забыт: выбранный DoT сперва пробуем честно, а не
		# продолжаем шифровать по DoH, куда его увела прошлая проверка (doh-lib.sh::doh_dot_fallback).
		command -v doh_dot_forget >/dev/null 2>&1 && doh_dot_forget
		if doh_enabled || { command -v doh_auto_active >/dev/null 2>&1 && doh_auto_active; }; then
			doh_restart
			sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
			# Попыток больше дефолта: у DoT холодный старт стоит 3 с таймаута на IP + 3 с backoff,
			# и одиночная проба ложно объявляла «протокол не заработал» (железо 2026-07-27).
			# Указатель на прокси — первым (разбор у set_doh_resolver: проба через откатанный DNS плагина проходит).
			if ! doh_upstream_set || ! doh_probe 4; then
				doh_resolver_mark del; doh_resolver_bypass del
				echo "$prev" > "$ENODIA_STATE/.doh-proto"
				doh_restart
				sh "$ENODIA_DIR/transport.sh" dns >/dev/null 2>&1
				fail "протокол $v не заработал (резолвер не отвечает; :853 может резать провайдер) — возвращён $prev"
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"Протокол шифрованного DNS: %s%s"}\n' "$v" "$(dot_fb_tail)"; exit 0 ;;

	# --- Доустановка бинарей DoH ПО ВОЗДУХУ. Установка с ПК несёт их в payload, но обновившиеся
	# из панели (apply-scripts тянет только скрипты из манифеста) остаются без бинаря — карточка
	# честно пишет «не установлен», а поставить было нечем.
	# Ставит ДВИЖОК (packages.sh, связка doh = https-dns-proxy + dot-proxy): качаем ОБА
	# недостающих одной кнопкой — протокол переключается пикером, и «Установить» не должен
	# зависеть от текущего выбора. Арку и порог обрыва берёт fetch-bin из bin-manifest.txt
	# (у https-dns-proxy арки различаются в 27 раз, ручное число неизбежно врало одной из них).
	doh_fetch_bin)
		[ -x "$(bin_path https-dns-proxy)" ] && [ -x "$(bin_path dot-proxy)" ] && \
			{ printf '{"ok":true,"code":0,"msg":"Бинари DoH уже установлены"}\n'; exit 0; }
		pkg_bg doh - "Скачиваю компоненты шифрованного DNS…" ;;

	# --- Доступ к панели: HTTPS (panel-tls) и вход снаружи по WAN. Вся логика — в web-ui.sh
	# (он владеет и терминатором, и правилом в input_wan_rule); тут только валидация ввода и
	# ЧЕСТНЫЙ вердикт по факту: вербы печатают человеческий текст, поэтому итог перепроверяем
	# вербом json, а не парсингом сообщения (текст переводится/меняется — состояние нет).
	panel_tls_on)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обновите панель)"
		[ -x "$(bin_path panel-tls)" ] || fail "бинарь panel-tls не установлен — сперва «Установить»"
		# Порт — СТРОГО цифры и без ведущих нулей (ревью шага 7a, круг 2): «08443» уходил в флаг и ломал JSON состояния (разбор у
		# web-ui.sh::port_norm), а `tr -cd` молча делал из «8a443» порт 8443. Поле пусто — порт прежний.
		p=$(field port)
		if [ -n "$p" ]; then
			case "$p" in *[!0-9]*) fail "порт — число от 1 до 65535" ;; esac
			p=$(printf '%s' "$p" | sed 's/^0*//')
			case "$p" in ''|??????*) fail "порт — число от 1 до 65535" ;; esac
			[ "$p" -le 65535 ] || fail "порт — число от 1 до 65535"
		fi
		# Исход — КОДОМ web-ui.sh и ФАКТОМ после (ревью шага 7a): отказ до записи флага (порт занят самой панелью или чужой
		# службой) оставлял прежний живой терминатор, и сверка одного `tls_running` давала зелёный «HTTPS включён» на порт, который
		# не сменился. Причина отказа — последней строкой вывода web-ui.sh (она и есть слова для человека).
		# Был ли HTTPS включён ДО — от этого слова успеха: у выключенного порт не «перенесён», а HTTPS «включён на порту» (замер BE7000).
		st0=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		was=0; case "$st0" in *'"tls_on":true'*) was=1 ;; esac
		same=0; [ -n "$p" ] && case "$st0" in *'"tls_running":true'*"\"tls_port\":$p,"*) same=1 ;; esac
		# Вывод — В ФАЙЛ, не в трубу (ревью шага 7a, круг 3): с HTTPS-вкладки перезапуск терминатора рвёт этот же запрос, uhttpd бьёт CGI,
		# и web-ui.sh, пишущий в трубу мёртвому читателю, падал по SIGPIPE ДО `wan_rule_apply` — правило наружу оставалось на старом порту.
		wui_run tls-on $p; rc=$?; out=$WUI_OUT
		why=$(printf '%s\n' "$out" | grep -v '^вернул прежний порт' | tail -n 1 | jesc 200)
		[ "$rc" = 0 ] || fail "$why"
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"tls_running":true'*) : ;; *) fail "HTTPS не поднялся: $why" ;; esac
		if [ -n "$p" ]; then
			case "$st" in *"\"tls_port\":$p,"*) : ;; *) fail "порт HTTPS не сменился" ;; esac
			if [ "$same" = 1 ]; then printf '{"ok":true,"code":0,"msg":"HTTPS уже работает на порту %s"}\n' "$p"
			elif [ "$was" = 1 ]; then printf '{"ok":true,"code":0,"msg":"HTTPS перенесён на порт %s"}\n' "$p"
			else printf '{"ok":true,"code":0,"msg":"HTTPS включён на порту %s"}\n' "$p"; fi
			exit 0
		fi
		printf '{"ok":true,"code":0,"msg":"HTTPS включён"}\n'; exit 0 ;;
	# СМЕНА ПАРОЛЯ ПАНЕЛИ ИЗ САМОЙ ПАНЕЛИ. До сих пор единственным владельцем был `web-ui.sh
	# setpass` — то есть SSH или ПК-установщик. Для типового «поставил родне/тестеру и настраиваю
	# удалённо» это значило «сменить пароль нечем»: панель отдаётся только по Basic, а Basic
	# меняется мимо панели. Текущий пароль тут не спрашиваем: за гейтом входа мы уже стоим (пароль,
	# а при включённом TOTP — ещё и код), и второй ввод проверял бы только память. Зато сессии
	# ОСТАЛЬНЫХ устройств эта ветка теперь гасит — разбор там же, ниже.
	# Пароль приходит base64 (в нём бывают & и %, а form-поле — плоское), в команду уходит уже
	# декодированным и ПОСЛЕ проверки формы.
	panel_pass)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обновите панель)"
		np=$(urldecode "$(field pass)" | base64 -d 2>/dev/null | tr -d '\r\n')
		[ -n "$np" ] || fail "пустой пароль"
		# Только печатаемый ASCII без пробелов: форма входа шлёт пароль base64 через btoa, а тот
		# кириллицу не берёт, да и раскладка на телефоне подводит — человек рискует задать пароль,
		# которым потом не войдёт. Правило ОДНО с ПК (PANEL_PW_RE в enodia.py). Нижняя граница 8 —
		# панель бывает открыта наружу по HTTPS.
		printf '%s' "$np" | grep -qE '^[!-~]{8,64}$' || fail "пароль: 8..64 символов, латиница/цифры/знаки, без пробелов"
		# ПЕРВЫЙ судья — КОД ВОЗВРАТА setpass, и конвейер с jesc тут разорван нарочно: в нём
		# `$?` принадлежал бы jesc, то есть ЛЮБОЙ отказ (нет бинаря uhttpd, пустой хэш, «No
		# space» на 20-МБ /data) уезжал бы наверх как успех.
		# `--no-restart` обязателен ИМЕННО ОТСЮДА: setpass сам применяет пароль (иначе живая панель
		# пускала бы по старому), но мы — потомок этого же uhttpd, и его смерть унесла бы наш ответ.
		# Перезапуск ниже, отвязанным шагом.
		out=$(sh "$ENODIA_DIR/web-ui.sh" setpass "$np" --no-restart 2>&1); rc=$?
		out=$(printf '%s' "$out" | jesc 200)
		[ "$rc" = 0 ] || fail "пароль не записан: $out"
		# ВТОРОЙ — факт: файл пароля непуст. Ловит обрыв записи на полном флеше (`printf >` усёк,
		# дописать не смог): без пароля следующий вход невозможен, а чинится это только по SSH.
		[ -s "$ENODIA_STATE/.panel-pass" ] || fail "файл пароля пуст — пароль НЕ записан: $out"
		# Перезапуск НЕ нужен: cgi-bin/login читает файл на каждом входе (`--no-restart` выше — на
		# случай uhttpd, поднятого ещё с Basic: его перезапустит cron-овский start, не мы — мы его
		# потомок).
		# СМЕНА ПАРОЛЯ ВЫГОНЯЕТ ОСТАЛЬНЫЕ УСТРОЙСТВА. Под HTTP-Basic так было по сути: браузер держал
		# сам пароль, и старый переставал подходить. С сессиями пароль и доступ разошлись — кука живёт
		# своей жизнью (с «Запомнить меня» это ГОД), и «меняю пароль, потому что боюсь, что его узнали»
		# переставало работать ровно в том случае, ради которого пароль и меняют. Своё устройство
		# оставляем: выкинуть себя тем же кликом — не безопасность, а сюрприз. Best-effort: не вышло —
		# пароль всё равно уже сменён, и в ответе честная разница между «выгнали» и «не смогли».
		_kept=false
		if command -v totp_sess_keep_only >/dev/null 2>&1; then
			totp_sess_keep_only "$(totp_cookie)" >/dev/null 2>&1 && _kept=true
		fi
		if [ "$_kept" = true ]; then
			printf '{"ok":true,"code":0,"msg":"Пароль изменён. Остальные устройства вышли из панели — на них панель спросит новый."}\n'
		else
			printf '{"ok":true,"code":0,"msg":"Пароль изменён. При следующем входе панель спросит новый."}\n'
		fi
		exit 0 ;;
	panel_tls_off)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обновите панель)"
		# Слова — по ФАКТУ (ревью шага 7a, круг 2, замер на BE7000): прежний ответ всегда говорил «доступ снаружи снят вместе с ним»,
		# и при закрытом входе снаружи панель сообщала о действии, которого роутер не делал. Вердикт — по состоянию после.
		w=0; sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep -q '"wan_on":true' && w=1
		sh "$ENODIA_DIR/web-ui.sh" tls-off >/dev/null 2>&1
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"tls_on":false'*'"tls_running":false'*) : ;; *) fail "HTTPS не выключился" ;; esac
		if [ "$w" = 1 ]; then printf '{"ok":true,"code":0,"msg":"HTTPS выключен, вход снаружи закрыт вместе с ним"}\n'
		else printf '{"ok":true,"code":0,"msg":"HTTPS выключен"}\n'; fi
		exit 0 ;;
	# Перевыпуск сертификата: нужен, если его выписали при неверных часах (RTC на роутере нет)
	# либо сменился hostname. Рвёт текущие HTTPS-сессии — браузер переспросит про самоподписанный.
	panel_tls_cert)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обновите панель)"
		wui_run tls-cert; out=$(printf '%s\n' "$WUI_OUT" | tail -n 1 | jesc 200)
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"cert":true'*) : ;; *) fail "сертификат не выписан: $out" ;; esac
		# Сертификат есть, а терминатор с ним не встал — это не «перевыпущен» (ревью шага 7a, круг 2): HTTPS лежит.
		case "$st" in *'"tls_on":true'*) case "$st" in *'"tls_running":true'*) : ;; *) fail "сертификат выписан, но HTTPS с ним не поднялся: $out" ;; esac ;; esac
		printf '{"ok":true,"code":0,"msg":"Сертификат перевыпущен"}\n'; exit 0 ;;
	# ОТКРЫТИЕ ПОРТА В ИНТЕРНЕТ. Гарды живут в web-ui.sh (без HTTPS не открываем вовсе), тут
	# добавляем честный ответ про CGNAT: правило встанет, но снаружи не достучаться — молчать об
	# этом нельзя, иначе человек будет искать поломку у себя.
	panel_wan_on)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обновите панель)"
		wui_run wan-on
		st=$(sh "$ENODIA_DIR/web-ui.sh" json 2>/dev/null | grep '^{' | tail -1)
		# ВЕРДИКТ — ПО СОСТОЯНИЮ, А НЕ ПО СКЛЕЙКЕ ВЫВОДА (ревью шага 7a, круг 3): флаг встал, а правило ждёт внешнего адреса (WAN не поднят) —
		# это «включено, правило встанет само», а не красный отказ с CLI-текстом при включённом тумблере. Отказ — первой строкой web-ui.sh
		# (остальные строки у него — подсказки для SSH: `wan-on --force`, пути), без хвостового двоеточия.
		case "$st" in
			*'"wan_on":true'*) : ;;
			*) fail "$(printf '%s\n' "$WUI_OUT" | head -n 1 | sed 's/:$//' | jesc 200)" ;;
		esac
		case "$st" in
			*'"wan_rule":true'*'"wan_kind":"private"'*) printf '{"ok":true,"code":0,"msg":"Правило поставлено, но WAN-адрес приватный (CGNAT) — снаружи не откроется"}\n' ;;
			*'"wan_rule":true'*) printf '{"ok":true,"code":0,"msg":"Доступ снаружи открыт"}\n' ;;
			*) printf '{"ok":true,"code":0,"msg":"Вход снаружи включён, но правило пока не встало: у роутера нет внешнего адреса — поставит само, когда появится интернет"}\n' ;;
		esac
		exit 0 ;;
	panel_wan_off)
		[ -f "$ENODIA_DIR/web-ui.sh" ] || fail "web-ui.sh не установлен (обновите панель)"
		sh "$ENODIA_DIR/web-ui.sh" wan-off >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"Доступ снаружи закрыт"}\n'; exit 0 ;;
	# Доустановка panel-tls ПО ВОЗДУХУ — та же схема, что doh_fetch_bin: обновившиеся из панели
	# (apply-scripts везёт только скрипты манифеста) иначе остались бы без бинаря и без способа
	# его получить. Ставит движок — он же считает место (panel-tls мелкий, но на 4 свободных МБ
	# «мелкий» решает не глазомер, а резерв).
	panel_tls_fetch_bin)
		[ -x "$(bin_path panel-tls)" ] && { printf '{"ok":true,"code":0,"msg":"Бинарь HTTPS уже установлен"}\n'; exit 0; }
		pkg_bg tls - "Скачиваю компонент HTTPS…" ;;

	# --- «Доступ домой»: роутер как VPN-СЕРВЕР (vpn-server.sh) ------------------
	# Направление обратное всему остальному: не роутер идёт к VPS, а телефон приходит к роутеру.
	# id пира строгий 2..9 (последний октет подсети), имя НЕ валидируем — vpn-server.sh хранит его
	# base64 и в команду не подставляет (та же схема, что у слотов). Итог сверяем вербом json:
	# вербы печатают человеческий текст, а он переводится — состояние надёжнее.
	vpnsrv_on)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обновите скрипты роутера)"
		out=$(sh "$ENODIA_DIR/vpn-server.sh" up 2>&1 | jesc 300)
		st=$(sh "$ENODIA_DIR/vpn-server.sh" json 2>/dev/null | grep '^{' | tail -1)
		case "$st" in *'"running":true'*) ;; *) fail "сервер не поднялся: $out" ;; esac
		# Серый WAN — правило встанет, но снаружи не достучаться. Молчать нельзя: человек будет
		# искать поломку в телефоне (тот же довод, что у доступа к панели снаружи).
		case "$st" in
			*'"wan_private":true'*) printf '{"ok":true,"code":0,"msg":"Сервер поднят, но WAN-адрес приватный (CGNAT) — снаружи не подключиться"}\n' ;;
			*) printf '{"ok":true,"code":0,"msg":"Доступ домой включён"}\n' ;;
		esac
		exit 0 ;;
	vpnsrv_off)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обновите скрипты роутера)"
		sh "$ENODIA_DIR/vpn-server.sh" down >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"Доступ домой выключен"}\n'; exit 0 ;;
	vpnsrv_peer_add)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обновите скрипты роутера)"
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя устройства"
		raw=$(sh "$ENODIA_DIR/vpn-server.sh" peer-add "$name" 2>&1)
		# Берём МАШИННУЮ строку «id⇥ip», а не человеческий текст (урок groups.sh new).
		TABC=$(printf '\t')
		line=$(printf '%s\n' "$raw" | grep "$TABC" | head -1)
		nid=$(printf '%s' "$line" | cut -f1); nip=$(printf '%s' "$line" | cut -f2)
		case "$nid" in 2|3|4|5|6|7|8|9) ;; *) fail "$(printf '%s' "$raw" | jesc 200)" ;; esac
		printf '{"ok":true,"code":0,"id":%s,"ip":"%s","msg":"Устройство добавлено"}\n' "$nid" "$nip"; exit 0 ;;
	vpnsrv_peer_del|vpnsrv_peer_mode|vpnsrv_peer_lan|vpnsrv_peer_toggle|vpnsrv_peer_rename|vpnsrv_peer_conf)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обновите скрипты роутера)"
		pid=$(field id); case "$pid" in 2|3|4|5|6|7|8|9) ;; *) fail "битый id устройства" ;; esac
		case "$act" in
			vpnsrv_peer_del)  run vpn-server.sh peer-del "$pid" ;;
			vpnsrv_peer_mode) md=$(field mode); case "$md" in split|vpn|direct) ;; *) fail "режим: split|vpn|direct" ;; esac
			                  run vpn-server.sh peer-mode "$pid" "$md" ;;
			vpnsrv_peer_lan)  en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			                  run vpn-server.sh peer-lan "$pid" "$([ "$en" = 1 ] && echo on || echo off)" ;;
			vpnsrv_peer_toggle) en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			                  run vpn-server.sh peer-toggle "$pid" "$([ "$en" = 1 ] && echo on || echo off)" ;;
			vpnsrv_peer_rename) nm=$(urldecode "$(field name)"); [ -n "$nm" ] || fail "нужно имя"
			                  run vpn-server.sh peer-rename "$pid" "$nm" ;;
			# Конфиг несёт ПРИВАТНЫЙ КЛЮЧ телефона: отдаём base64-ом одним полем (переводы строк в
			# JSON на busybox не заэкранировать), а показывает его панель — за Basic + 2FA.
			vpnsrv_peer_conf)
				raw=$(sh "$ENODIA_DIR/vpn-server.sh" peer-conf "$pid" 2>/dev/null)
				case "$raw" in *'[Interface]'*) ;; *) fail "конфиг не собран — не определён внешний адрес?" ;; esac
				printf '{"ok":true,"code":0,"conf_b64":"%s"}\n' "$(printf '%s' "$raw" | base64 | tr -d '\n')"; exit 0 ;;
		esac ;;
	# Адрес для клиентских конфигов вручную: DDNS-имя вместо голого IP (конфиг телефона тогда не
	# протухает при смене WAN-адреса). Пустое значение = вернуться к автодетекту.
	vpnsrv_endpoint)
		[ -f "$ENODIA_DIR/vpn-server.sh" ] || fail "vpn-server.sh не установлен (обновите скрипты роутера)"
		h=$(urldecode "$(field host)" | tr -d ' \t\r\n')
		case "$h" in '') ;; *[!A-Za-z0-9.:_-]*) fail "в адресе есть недопустимые символы" ;; esac
		run vpn-server.sh endpoint-set "$h" ;;

	# --- Периодичность обновления списков источников (iplist + включённые adblock/ipblock). update-sched.sh
	# владеет cron-строкой iplist-update.sh и маркером .update-interval (переживает ребут/переустановку).
	set_update_interval)
		[ -f "$ENODIA_DIR/update-sched.sh" ] || fail "update-sched.sh не установлен (обновите панель)"
		iv=$(field interval | tr -cd 'a-z0-9')
		case "$iv" in off|6h|12h|daily|weekly) : ;; *) fail "неизвестный интервал" ;; esac
		got=$(sh "$ENODIA_DIR/update-sched.sh" set "$iv" 2>/dev/null)
		# Словами, а не значением маркера («6h», «weekly» — машинные): тост читает человек, и его переводит панель.
		# «Выкл» — своей фразой: «Списки обновляются: по расписанию не обновляются» спорило само с собой.
		case "$got" in
			off) printf '{"ok":true,"code":0,"msg":"Автообновление списков выключено"}\n'; exit 0 ;;
			6h) w="каждые 6 часов" ;; 12h) w="каждые 12 часов" ;;
			weekly) w="по понедельникам в 05:00" ;; daily) w="каждый день в 05:00" ;; *) fail "расписание не записано" ;;
		esac
		printf '{"ok":true,"code":0,"msg":"Списки обновляются: %s"}\n' "$w"; exit 0 ;;

	# --- Периодичность HEADLESS-обновления подписок (subs-update.sh update по cron). Отдельная
	# задача того же владельца cron (update-sched.sh job `subs`), маркер .subs-interval. Дефолт
	# off: подписка ходит по ЧУЖОЙ ссылке, включать это за пользователя молча — не наше решение.
	set_subs_interval)
		[ -f "$ENODIA_DIR/update-sched.sh" ] || fail "update-sched.sh не установлен (обновите панель)"
		[ -f "$ENODIA_DIR/subs-update.sh" ] || fail "subs-update.sh не установлен (обновите скрипты роутера)"
		iv=$(field interval | tr -cd 'a-z0-9')
		case "$iv" in off|6h|12h|daily|weekly) : ;; *) fail "неизвестный интервал" ;; esac
		got=$(sh "$ENODIA_DIR/update-sched.sh" set subs "$iv" 2>/dev/null)
		printf '{"ok":true,"code":0,"msg":"автообновление подписок: %s"}\n' "$got"; exit 0 ;;
	# Прогон подписок ПРЯМО СЕЙЧАС тем же путём, что у cron (не браузерным разбором). Это же
	# зовёт ⟳ в списке серверов: правила «какой выход взять из пула» и «как назвать файл» живут
	# в subs-update.sh, и вторая (браузерная) их копия тасовала серверы по файлам на каждом
	# ручном обновлении. Необязательная метка = обновить ОДНУ подписку (кнопка ⟳ у неё), без
	# метки = все (кнопка экрана «Подписки»). Фоном: разбор десятков серверов дольше таймаута CGI.
	subs_update_now)
		[ -f "$ENODIA_DIR/subs-update.sh" ] || fail "subs-update.sh не установлен (обновите скрипты роутера)"
		[ -s "$ENODIA_STATE/.subs" ] || fail "подписок нет — добавьте подписку в списке серверов"
		tag=$(field tag)
		if [ -n "$tag" ]; then
			echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
			TAB=$(printf '\t')
			grep -q "^$tag$TAB" "$ENODIA_STATE/.subs" 2>/dev/null || fail "подписка не найдена"
			spawn_bg /tmp/enodia-subs-update-cgi.pid "$ENODIA_DIR/subs-update.sh" update "$tag"
		else
			spawn_bg /tmp/enodia-subs-update-cgi.pid "$ENODIA_DIR/subs-update.sh" update
		fi
		printf '{"ok":true,"code":0,"msg":"обновляю подписки на роутере — результат появится через минуту"}\n'; exit 0 ;;

	# --- Раскладка панели → .panel-layout: порядок и свёрнутость карточек «Обзора», ПОРЯДОК
	# подписок, а с шага 2i редизайна ещё и СОСТАВ (`cardoff`) с ШИРИНОЙ (`cardw`) карточек.
	# Блоб пишется ЦЕЛИКОМ и отдаётся обратно как есть — новое поле панели не требует правки
	# здесь: роутер раскладку не разбирает, он её хранит. Меняется только потолок длины.
	#
	# ГАРД БЕЗ РЕГУЛЯРКИ, И ЭТО НЕ ВКУС. Прежний `grep -qE '^[…]{2,4096}$'` БУСИБОКС НЕ ПОНИМАЕТ
	# ВОВСЕ: у его движка регулярок ПОТОЛОК ИНТЕРВАЛА 255 (RE_DUP_MAX), и `{2,4096}` — это
	# `grep: bad regex: Invalid contents of {}`, код 2, то есть ОТКАЗ ВСЕГДА (замерено на живом
	# BE7000 11.09.2026: 255 принимает, 256 уже нет; так же ведут себя sed и awk — следит C96).
	# Цена была тихой и полной: раскладка не сохранялась НИКОГДА, файла `.panel-layout` на
	# роутере не было, а панель молчала — `layoutSave` глотает отказ намеренно (тост посреди
	# перетаскивания хуже). Персист «на роутере» оказался фикцией: всё держалось на localStorage,
	# то есть ровно на том, от чего уходили.
	# `tr -d` набором символов от этого потолка свободен: у него не регулярка, а НАБОР, и длину
	# мы меряем отдельно — теми же двумя числами, но словами шелла. Пусто на выходе = все
	# символы из белого списка.
	# Персист НА РОУТЕРЕ (а не localStorage), чтобы раскладка ехала за юзером между устройствами.
	# БЕЗОПАСНОСТЬ: блоб — JSON-массивы тегов/id ([A-Za-z0-9_.-], спец-тег __own__), пишется в файл
	# и позже отдаётся cgi-bin/data verbatim ВНУТРЬ JSON-ответа. В shell-команду не уходит (только
	# в файл). Строгий whitelist символов (лишь JSON-структура + токены, без \\ / переводов строк /
	# %-мусора после декода) + потолок длины → нельзя ни сломать наш JSON, ни протащить шелл-инъекцию.
	save_layout)
		data=$(urldecode "$(field data)")
		# guard-begin: save_layout — метки читает стенд dev/layout-blob-cgi-test.sh: он вынимает
		# ЭТИ строки и исполняет ИХ, а не свою копию (копия однажды уже разошлась с оригиналом и
		# была зелёной на гарде, который роутер отвергал целиком). Нет метки — стенд отказывает.
		one_line "$data" || fail "плохой формат раскладки"
		dlen=$(printf '%s' "$data" | wc -c)
		[ "$dlen" -ge 2 ] && [ "$dlen" -le 4096 ] || fail "плохой формат раскладки"
		[ -z "$(printf '%s' "$data" | tr -d '[]{}",:_.A-Za-z0-9 -')" ] || fail "плохой формат раскладки"
		# guard-end: save_layout
		# ВРЕМЯНКА — С ПИДОМ: писателей может быть ДВОЕ (панель на телефоне и на ноутбуке, у
		# каждой свой процесс uhttpd), общего лока у них нет, и на общем имени один сделал бы
		# `mv` НЕДОПИСАННОГО файла другого. В `.panel-layout` легла бы обрезанная строка, а
		# дальше — тихо и навсегда: `cgi-bin/data` отдаёт её как есть, разбор у панели падает,
		# и раскладка молча остаётся на localStorage. Тот же приём, что у `.sub-info.<pid>.new`;
		# хвост `.new` опознаёт чистка (`clean.sh`, маска мусора).
		_lnew="$ENODIA_STATE/.panel-layout.$$.new"
		printf '%s' "$data" > "$_lnew" 2>/dev/null \
			&& mv "$_lnew" "$ENODIA_STATE/.panel-layout" 2>/dev/null \
			|| { rm -f "$_lnew" 2>/dev/null; fail "не удалось сохранить раскладку"; }
		printf '{"ok":true}\n'; exit 0 ;;

	# --- Десинк-аргументы ByeDPI (ciadpi) → .byedpi-args. БЕЗОПАСНОСТЬ: эти args идут
	# НЕквотированно в `exec ciadpi … $args` (transport-byedpi.sh spawn_byedpi), поэтому
	# СТРОГО ограничиваем charset ASCII-флагами ciadpi (буквы/цифры/пробел/+ , . : / = _ -),
	# отсекая shell-метасимволы ($ ; | & ` ( ) < > " ' \ * ? и пр.) = защита от инъекции.
	# Пусто → вернуть авто-дефолт (rm файла). Применяем сразу, если ByeDPI активен (reload
	# перезапускает только ciadpi, несущая не рвётся); иначе сохраняем — применится при up.
	# Поле slot=2..7 (опц.) переводит ту же ветку на стратегию ДОП-ВЫХОДА (.byedpi-args-s<id>):
	# у каждого byedpi-выхода свой ciadpi со своим десинком, и подбирать его надо отдельно от
	# основной несущей. Валидация/charset/перезапуск — ОДИН код на оба случая (разъехались бы).
	# Пул проб браузер-свипа: список строк `url⇥w⇥h` (base64 — URL несут / ? & и в form-поле
	# резались бы). Цель = slot: пусто (основная несущая byedpi) · 2..7 (доп-выход) · zapret
	# (общий nfqws). Пустой список = пул снят, и свип у этой цели идти НЕ будет: вшитых наборов
	# больше нет — мерить домены, про которые неизвестно, едут ли они через десинк, значит врать.
	# Схему пускаем ТОЛЬКО https: DPI режет TLS-хэндшейк по SNI, и проба по открытому http
	# мерила бы совсем другой путь, а «красным» выглядела бы как заслуга DPI.
	# Ссылка бывает двух видов — на картинку (сверяем размер) и на корень сайта (сверяем сам факт
	# соединения); вид выводит панель ИЗ ССЫЛКИ, отдельного поля здесь намеренно нет.
	set_probe_pool)
		psl=$(field slot); case "$psl" in ''|[2-7]|zapret) ;; *) fail "битый id выхода" ;; esac
		pf="$ENODIA_STATE/.probe-pool"
		case "$psl" in '') ;; zapret) pf="$ENODIA_STATE/.probe-pool-zapret" ;; *) pf="$ENODIA_STATE/.probe-pool-s$psl" ;; esac
		raw=$(urldecode "$(field data)" | base64 -d 2>/dev/null | tr -d '\r')
		if [ -z "$raw" ]; then
			rm -f "$pf"
			printf '{"ok":true,"code":0,"msg":"пул проб очищен — свип не сможет идти, пока пул не собран"}\n'; exit 0
		fi
		: > "$pf.new" || fail "не удалось сохранить пул проб"
		n=0
		while IFS="$(printf '\t')" read -r u w h; do
			[ -n "$u" ] || continue
			case "$u" in https://*) ;; *) continue ;; esac
			printf '%s' "$u" | grep -qE '^https://[A-Za-z0-9._~:/?#@!$&+,;=%-]+$' || continue
			case "$w" in ''|*[!0-9]*) w=0 ;; esac
			case "$h" in ''|*[!0-9]*) h=0 ;; esac
			printf '%s\t%s\t%s\n' "$u" "$w" "$h" >> "$pf.new"
			n=$((n+1))
			[ "$n" -ge 40 ] && break        # кап: свип гоняет пул на КАЖДУЮ стратегию
		done <<EOF
$raw
EOF
		[ "$n" -gt 0 ] || { rm -f "$pf.new"; fail "ни одной годной ссылки (нужны https://…)"; }
		mv "$pf.new" "$pf" || fail "не удалось сохранить пул проб"
		printf '{"ok":true,"code":0,"msg":"пул проб сохранён: %s","n":%s}\n' "$n" "$n"; exit 0 ;;
	set_byedpi_args)
		bsl=$(field slot); case "$bsl" in ''|[2-7]) ;; *) fail "битый id выхода" ;; esac
		af="$ENODIA_STATE/.byedpi-args"; [ -n "$bsl" ] && af="$ENODIA_STATE/.byedpi-args-s$bsl"
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -z "$args" ]; then
			rm -f "$af"
			msg="Десинк-аргументы сброшены на авто-набор"
		else
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_-]+$' || fail "недопустимые символы — разрешены только флаги ciadpi (буквы, цифры, пробел, + , . : / = _ -)"
			printf '%s\n' "$args" > "$af.new" && mv "$af.new" "$af" || fail "не удалось сохранить аргументы"
			msg="Десинк-аргументы сохранены"
			# Ядро BE7000 без CONFIG_TCP_MD5SIG → -S/md5sig вырезается плагином при запуске (см.
			# transport-byedpi.sh strip_unsupported). Предупреждаем, чтобы не было сюрприза.
			case " $args " in *" -S "*|*--md5sig*) msg="$msg (флаг -S/md5sig ядром не поддержан — будет проигнорирован)" ;; esac
		fi
		if [ -n "$bsl" ] && vpn_is_off; then
			# VPN выключен тумблером — выход снят вместе с ним, а плагин при флаге ciadpi не поднимет (carrier_run): «перезапуск не
			# удался» было бы неправдой, как и у основной ветки ниже (ревью ветки, круг 3).
			msg="$msg (VPN выключен — применится при его включении)"
		elif [ -n "$bsl" ]; then
			# slot-reload перезапускает ТОЛЬКО ciadpi выхода (hev/xtun/маршрут живы); выход выключен
			# → плагин сам ответит no-op, стратегия применится при включении.
			sh "$ENODIA_DIR/transport-byedpi.sh" slot-reload "$bsl" >/dev/null 2>&1 && msg="$msg, ciadpi выхода №$bsl перезапущен" || msg="$msg, но перезапуск ciadpi выхода не удался (см. журнал)"
		else
			cur=$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')
			# VPN выключен тумблером — ByeDPI не несёт, и перезапускать нечего: плагин при флаге и сам откажет (daemon-lib.sh
			# carrier_run), а «перезапуск не удался» было бы неправдой.
			if [ "$cur" = byedpi ] && vpn_is_off; then
				msg="$msg (VPN выключен — применится при его включении)"
			elif [ "$cur" = byedpi ]; then
				sh "$ENODIA_DIR/transport-byedpi.sh" reload >/dev/null 2>&1 && msg="$msg, ciadpi перезапущен" || msg="$msg, но перезапуск ciadpi не удался (см. статус)"
			else
				msg="$msg (применится при включении ByeDPI)"
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$msg"; exit 0 ;;
	set_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя сервера"
		[ -f "$ENODIA_STATE/configs/$name.conf" ] || fail "нет конфига $name"
		# ТРАФИК СЕЙЧАС НЕСЁТ ДРУГОЙ ТРАНСПОРТ ⇒ СТЕЙДЖИМ, а не переключаем. Ровно так уже
		# ведут себя соседи (set_xray_server/set_hy2_server: «НЕ роняет чужую несущую»), и
		# AmneziaWG был единственным исключением — а цена исключения высокая. switch-vpn.sh
		# СНАЧАЛА отпускает текущую несущую и лишь потом поднимает awg; не поднялся — откат
		# невозможен, если прежнего awg.conf не было (типовой случай: awg только что доставили
		# из «Компонентов»), и остаётся safety_off, то есть НИ ОДНОГО работающего транспорта.
		# Разбор с тестером 14.08.2026: «после попытки установить авг теперь даже хистерия не
		# запускается», а панель при этом продолжала писать «нужен конфиг» — потому что awg.conf
		# так и не появился, и `transport_ready awg` оставался false.
		# Включение самого транспорта — отдельный, ЯВНЫЙ жест в «Транспорт VPN» наверху панели.
		# ПОД ЛОКОМ СМЕНЫ, как соседи (set_xray_server/set_hy2_server, switch_*): switch-vpn.sh при занятом локе идёт дальше БЕЗ него
		# (вложенные вызовы — failover сторожа, transport.sh — держат лок за него), и две вкладки, выбравшие сервер разом, вели две
		# смены поверх друг друга, а тик сторожа — свою лестницу поверх ручной (замер BE7000 04.10.2026: смена AWG-сервера из
		# панели шла без лока вовсе). Раскладка конфигов — под тем же: она пишет те же файлы, что смена.
		hold_switch
		_ct=$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')
		if { [ -n "$_ct" ] && [ "$_ct" != awg ]; } || vpn_is_off; then
			cap_run switch-vpn.sh stage "$name"; code=$?; raw=$CAP_OUT
			msg=$(printf '%s' "$raw" | jesc 600)
			if [ "$code" -eq 0 ]; then
				# УСПЕХ СО СЛОВАМИ. Раскладка умеет закончиться нулём И предупреждением («имя
				# активного конфига не записалось — считаем неизвестным»): конфиги легли, а
				# `.active` пуст, и карточка не покажет сервер активным. Свой литерал выбрасывал
				# этот текст целиком, и человек оставался с обещанием без оговорки (ревью 8).
				_warn=$(printf '%s' "$raw" | grep -F '[warn]' | head -1 | jesc 300)
				[ -n "$_warn" ] && _warn=" $_warn"
				if vpn_is_off; then
					printf '{"ok":true,"code":0,"msg":"Конфиг %s выбран. VPN сейчас выключен тумблером — включите его в шапке панели, и роутер пойдёт через этот сервер.%s"}\n' "$name" "$_warn"
					exit 0
				fi
				printf '{"ok":true,"code":0,"msg":"Конфиг %s выбран для AmneziaWG. Чтобы пойти через него, включите AmneziaWG в «Транспорт VPN» наверху панели.%s"}\n' "$name" "$_warn"
			else
				printf '{"ok":false,"code":%s,"msg":"%s"}\n' "$code" "$msg"
			fi
			exit 0
		fi
		run switch-vpn.sh "$name" ;;

	# --- Активировать xray/hy2-конфиг по имени (зеркало Set-ActiveXray/Hy2Config). --
	# Копируем выбранный конфиг в рабочий (xray.json / hysteria.yaml) + пишем .*-active.
	# Несущую ПЕРЕЗАПУСКАЕМ только если этот транспорт сейчас активен (иначе просто
	# стейджим конфиг — применится при switch на него). НЕ роняет чужую несущую.
	set_xray_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "нет xray-конфига $name"
		hold_switch    # выбор сервера побеждает авто-failover (иначе цикл cmd_failover затирал .xray-active)
		cp "$ENODIA_STATE/xray-configs/$name.json" "$ENODIA_STATE/xray.json" 2>/dev/null \
			&& chmod 600 "$ENODIA_STATE/xray.json" 2>/dev/null \
			&& echo "$name" > "$ENODIA_STATE/.xray-active" || fail "не удалось активировать $name"
		# `! vpn_is_off` — см. разбор у vpn_is_off: при выключенном тумблере конфиг СТЕЙДЖИМ
		# (копия уже сделана выше), а несущую не поднимаем. Ветка «транспорт не активен» ниже
		# уже говорит ровно это, поэтому второго текста не заводим.
		if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = xray ] && ! vpn_is_off; then
			# Вывод `up` НЕ глотаем. ЗАЧЕМ (жалоба тестера 13.08.2026 «минуту подключается»):
			# подъём по ИМЕНИ может ждать резолва десятками секунд и печатает про это ровно
			# здесь — «резолв server-host … попытка N не удалась». С `>/dev/null` этих строк не
			# видел НИКТО: ни человек в панели, ни диаг-архив, и минута молчания читалась как
			# «панель зависла». Провал `up` теперь тоже честный отказ, а не «ok» поверх мёртвой
			# несущей. jesc — единственный конвейер «вывод скрипта → строка в JSON» (json-lib.sh).
			sh "$ENODIA_DIR/xray-transport.sh" down >/dev/null 2>&1
			cap_run xray-transport.sh up; rc=$?; raw=$CAP_OUT
			# Берём ТОЛЬКО строки про причину: на успехе cmd_up печатает ещё и cmd_status, а он
			# в тост не нужен. Причина кладётся в msg, а не в отдельное поле: postAction в панели
			# показывает msg и в тосте, и в журнале действий, а лишних полей он не читает.
			why=$(printf '%s\n' "$raw" | grep -E 'резолв|зарезолвил|удал|встан' | tail -2 | jesc 200)
			if [ "$rc" = 0 ]; then
				if [ -n "$why" ]; then
					printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s активен, несущая перезапущена. %s"}\n' "$name" "$why"
				else
					printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s активен, несущая перезапущена"}\n' "$name"
				fi
			else
				printf '{"ok":false,"code":%s,"msg":"Xray-конфиг %s активен, но несущая НЕ поднялась. %s"}\n' "$rc" "$name" "${why:-подробности в логе транспорта}"
			fi
		elif vpn_is_off; then
			# ПОЧЕМУ не применилось — вопрос человека, и ответ у двух веток РАЗНЫЙ: «переключись
			# на Xray» отправило бы туда, где Xray и так выбран, а нужен тумблер.
			printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s сохранён активным. VPN сейчас выключен тумблером — включите его в шапке панели, и роутер пойдёт через этот сервер."}\n' "$name"
		else
			printf '{"ok":true,"code":0,"msg":"Xray-конфиг %s сохранён активным (применится при переключении на Xray)"}\n' "$name"
		fi
		exit 0 ;;
	set_hy2_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/hy2-configs/$name.yaml" ] || fail "нет hy2-конфига $name"
		hold_switch    # выбор сервера побеждает авто-failover (зеркало set_xray_server)
		cp "$ENODIA_STATE/hy2-configs/$name.yaml" "$ENODIA_STATE/hysteria.yaml" 2>/dev/null \
			&& chmod 600 "$ENODIA_STATE/hysteria.yaml" 2>/dev/null \
			&& echo "$name" > "$ENODIA_STATE/.hy2-active" || fail "не удалось активировать $name"
		if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = hy2 ] && ! vpn_is_off; then
			sh "$ENODIA_DIR/transport-hy2.sh" down >/dev/null 2>&1
			cap_run transport-hy2.sh up; rc=$?; raw=$CAP_OUT   # причину не глотаем — зеркало set_xray_server
			why=$(printf '%s\n' "$raw" | grep -E 'резолв|зарезолвил|удал|встан' | tail -2 | jesc 200)
			if [ "$rc" = 0 ]; then
				if [ -n "$why" ]; then
					printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s активен, несущая перезапущена. %s"}\n' "$name" "$why"
				else
					printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s активен, несущая перезапущена"}\n' "$name"
				fi
			else
				printf '{"ok":false,"code":%s,"msg":"Hysteria2-конфиг %s активен, но несущая НЕ поднялась. %s"}\n' "$rc" "$name" "${why:-подробности в логе транспорта}"
			fi
		elif vpn_is_off; then
			# ПОЧЕМУ не применилось — вопрос человека, и ответ у двух веток РАЗНЫЙ: «переключись
			# на Hysteria2» отправило бы туда, где Hysteria2 и так выбран, а нужен тумблер.
			printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s сохранён активным. VPN сейчас выключен тумблером — включите его в шапке панели, и роутер пойдёт через этот сервер."}\n' "$name"
		else
			printf '{"ok":true,"code":0,"msg":"Hysteria2-конфиг %s сохранён активным (применится при переключении на Hysteria2)"}\n' "$name"
		fi
		exit 0 ;;

	# --- Удалить конфиг (зеркало Action-Delete*Config в ПК-меню). Гард: нельзя удалить
	# конфиг, который СЕЙЧАС несёт трафик. awg: .active особый (его читают switch/heal при
	# подъёме несущей) → активный не удаляем вовсе. xray/hy2: блок лишь когда активен И этот
	# транспорт включён; при удалении активного чистим и маркер .*-active. Имя — strict-regex
	# (того же класса, что в set_*_server), `/` исключён → traversal невозможен.
	del_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя сервера"
		[ -f "$ENODIA_STATE/configs/$name.conf" ] || fail "нет конфига $name"
		active=$(cat "$ENODIA_STATE/.active" 2>/dev/null | tr -d ' \r\n')
		[ "$name" = "$active" ] && fail "нельзя удалить активный конфиг ($name) — сначала переключитесь на другой"
		rm -f "$ENODIA_STATE/configs/$name.conf" || fail "не удалось удалить $name"
		[ -f "$ENODIA_DIR/cfg-names.sh" ] && sh "$ENODIA_DIR/cfg-names.sh" del awg "$name" >/dev/null 2>&1   # настоящее имя — вместе с файлом
		printf '{"ok":true,"code":0,"msg":"awg-конфиг %s удалён"}\n' "$name"
		exit 0 ;;
	del_xray_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/xray-configs/$name.json" ] || fail "нет xray-конфига $name"
		active=$(cat "$ENODIA_STATE/.xray-active" 2>/dev/null | tr -d ' \r\n')
		{ [ "$name" = "$active" ] && [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = xray ]; } \
			&& fail "это активный конфиг при включённом Xray — сначала переключитесь на другой транспорт"
		rm -f "$ENODIA_STATE/xray-configs/$name.json"
		[ -f "$ENODIA_DIR/cfg-names.sh" ] && sh "$ENODIA_DIR/cfg-names.sh" del xray "$name" >/dev/null 2>&1
		[ "$name" = "$active" ] && rm -f "$ENODIA_STATE/.xray-active"
		printf '{"ok":true,"code":0,"msg":"xray-конфиг %s удалён"}\n' "$name"; exit 0 ;;
	del_hy2_server)
		name=$(field name)
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ -f "$ENODIA_STATE/hy2-configs/$name.yaml" ] || fail "нет hy2-конфига $name"
		active=$(cat "$ENODIA_STATE/.hy2-active" 2>/dev/null | tr -d ' \r\n')
		{ [ "$name" = "$active" ] && [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null)" = hy2 ]; } \
			&& fail "это активный конфиг при включённой Hysteria2 — сначала переключитесь на другой транспорт"
		rm -f "$ENODIA_STATE/hy2-configs/$name.yaml"
		[ -f "$ENODIA_DIR/cfg-names.sh" ] && sh "$ENODIA_DIR/cfg-names.sh" del hy2 "$name" >/dev/null 2>&1
		[ "$name" = "$active" ] && rm -f "$ENODIA_STATE/.hy2-active"
		printf '{"ok":true,"code":0,"msg":"hy2-конфиг %s удалён"}\n' "$name"; exit 0 ;;

	# rename_config: ПЕРЕИМЕНОВАТЬ конфиг сервера (экран сервера в панели). Имя живёт не только в имени файла: активный
	# (.active/.xray-active/.hy2-active), «дом» резерва AWG (.failover-home), откат смены (.last.bak.name) и выходы (.slots —
	# через slots.sh rename-config, под ЕГО локом). Всё переписывается здесь, под локом смены сервера (его берут смена и сторож
	# на переключении) и НЕ во время тика сторожа: перебор серверов резерва лок смены берёт не всегда, а сверяет имя активного в
	# конце — переименование посреди перебора оставило бы активным не тот сервер. Несущую не трогаем: демоны читают рабочие копии
	# (awg.conf / xray.json / hysteria.yaml; у выходов — по номеру слота), имя им не нужно.
	# Порядок — сначала реестр выходов (его откатить проще всего), затем файл, затем «активный/дом/откат».
	# СТАРОЕ имя — любое, какое роутер держит файлом (как у удаления): прежние версии давали «----------» и имена длиннее 80, и
	# переименовывают прежде всего их. НОВОЕ — строже: с буквы или цифры (ведущая точка прячет файл от переборов `*.conf`), до 80.
	# Оба — ОДНОЙ строкой (гард `^…$` судит построчно; разбор у one_line). НЕЛЬЗЯ: серверы подписки — по ВЛАДЕЛЬЦУ (тег из .subs,
	# subs-lib.sh::sub_owner_tag), а не по префиксу: имя их файла — ключ идентичности `.sub-names`; «default» — имя установщика (им
	# сеется .active, и он неявный «дом» резерва), в любом регистре: на exFAT/vfat «DEFAULT» и «default» — один файл. Смена ТОЛЬКО
	# регистра — через временное имя: там же `mv` в самого себя ничего не делает, а проверка «уже есть» видела бы сам файл.
	rename_config)
		kind=$(field kind); old=$(urldecode "$(field name)"); new=$(urldecode "$(field new)")
		# НАСТОЯЩЕЕ ИМЯ (cfg-names.sh): как набрал человек, с эмодзи; файл — латиницей (`new`). Нет поля — прежний клиент: показ едет за файлом.
		_rdh=0; disp=""; if printf "%s" "&$body" | grep -q "&display="; then _rdh=1; disp=$(urldecode "$(field display)"); fi
		case "$kind" in
			awg)  dir="$ENODIA_STATE/configs";      ext=conf; af="$ENODIA_STATE/.active" ;;
			xray) dir="$ENODIA_STATE/xray-configs"; ext=json; af="$ENODIA_STATE/.xray-active" ;;
			hy2)  dir="$ENODIA_STATE/hy2-configs";  ext=yaml; af="$ENODIA_STATE/.hy2-active" ;;
			*) fail "неизвестный тип конфига" ;;
		esac
		{ one_line "$old" && echo "$old" | grep -qE '^[A-Za-z0-9_.-]+$' && [ "$old" != . ] && [ "$old" != .. ]; } || fail "недопустимое имя конфига"
		{ one_line "$new" && echo "$new" | grep -qE '^[A-Za-z0-9_][A-Za-z0-9._-]{0,79}$'; } \
			|| fail "новое имя: латиница, цифры, точка, «_» и «-», до 80 знаков, первым — буква или цифра"
		[ "$old" = "$new" ] && [ "$_rdh" = 0 ] && fail "имя не изменилось"
		_rown=""
		if command -v sub_owner_tag >/dev/null 2>&1; then _rown=$(sub_owner_tag "$old"); else case "$old" in sub-*) _rown=1 ;; esac; fi
		[ -n "$_rown" ] && fail "имя сервера подписки задаёт подписка — переименовать его нельзя"
		case "$new" in sub-*) fail "имена «sub-…» принадлежат подпискам — выберите другое" ;; esac
		_rlo=$(printf '%s' "$old" | tr 'A-Z' 'a-z'); _rln=$(printf '%s' "$new" | tr 'A-Z' 'a-z')
		{ [ "$_rlo" = default ] || [ "$_rln" = default ]; } && fail "«default» — служебное имя установщика: его нельзя ни дать, ни снять"
		[ -f "$dir/$old.$ext" ] || fail "нет конфига $old"
		# Набранный ПОКАЗ дал латиницу ДРУГОГО конфига: после загрузки с суффиксом у «🚀 Fast» файл Fast-2, а «Fast 🚀» транслитом — Fast,
		# занятый «⚡ Fast». Человек менял показ, а не просил чужое имя файла, — меняем только показ (ревью с.96, круг 2: был отказ «конфиг
		# Fast уже есть», которого в списке человек не видит). Набрано ровно это латинское имя — прежний отказ ниже.
		if [ "$_rdh" = 1 ] && [ "$old" != "$new" ] && [ "$disp" != "$new" ]; then
			if [ "$_rlo" = "$_rln" ]; then ls -1 "$dir" 2>/dev/null | grep -Fxq "$new.$ext" && new=$old
			elif [ -e "$dir/$new.$ext" ]; then new=$old; fi
		fi
		# Файл тот же, сменился только показ (добавили флаг, эмодзи, поменяли регистр кириллицы) — правка одного .cfg-names: ни
		# слотов, ни лока смены, ни переезда файла.
		if [ "$old" = "$new" ]; then
			[ -f "$ENODIA_DIR/cfg-names.sh" ] || fail "нет cfg-names.sh — обновите установку"
			_rdo=$(sh "$ENODIA_DIR/cfg-names.sh" set "$kind" "$old" "$disp" 2>&1) || fail "$(printf '%s' "$_rdo" | tail -n 1 | sed 's/^\[cfg-names\] //' | jesc 200)"
			# Что СОХРАНЕНО — словами владельца (последняя строка «имя «…»» / «своё имя снято»): очистка могла убрать знаки, и тост с
			# набранным текстом говорил бы неправду (ревью с.95: «Berlin""» на файле Berlin снимал показ, а тост хвалил набранное).
			_rdm=$(printf '%s' "$_rdo" | tail -n 1 | sed 's/^\[cfg-names\] //' | jesc 200)
			printf '{"ok":true,"code":0,"name":"%s","slots":0,"msg":"%s"}\n' "$old" "${_rdm:-имя сохранено}"; exit 0
		fi
		# Смена только регистра: «уже есть» — лишь если в каталоге ДРУГОЙ файл с этим именем (на ФС без регистра его не будет).
		if [ "$_rlo" = "$_rln" ]; then
			ls -1 "$dir" 2>/dev/null | grep -Fxq "$new.$ext" && fail "конфиг «$new» уже есть — выберите другое имя"
		else
			[ -e "$dir/$new.$ext" ] && fail "конфиг «$new» уже есть — выберите другое имя"
		fi
		[ -e "$SWITCH_LOCK" ] && fail "идёт смена транспорта или сервера либо перезапуск компонентов — повторите через минуту"
		_rwp=$(cat /tmp/enodia-watchdog.pid 2>/dev/null | tr -cd '0-9')
		{ [ -e /tmp/enodia-watchdog.lock ] && [ -n "$_rwp" ] && [ -d "/proc/$_rwp" ]; } && fail "сторож сейчас проверяет туннель — повторите через минуту"
		hold_switch
		_rs=0
		if [ -f "$ENODIA_DIR/slots.sh" ]; then
			# Отказ реестра — ЕГО словами: «имя уже указано у выхода №N» — не «переписать не удалось», а причина не начинать; метка
			# `[slots]` — для лога, не для человека (ревью пачки 2, круг 2).
			_rs=$(sh "$ENODIA_DIR/slots.sh" rename-config "$kind" "$old" "$new" 2>&1) || fail "$(printf '%s' "$_rs" | tail -n 1 | sed 's/^\[slots\] //' | jesc 200)"
			_rs=$(printf '%s' "$_rs" | tail -n 1 | tr -cd '0-9'); [ -n "$_rs" ] || _rs=0
		fi
		if [ "$_rlo" = "$_rln" ]; then
			mv "$dir/$old.$ext" "$dir/.enodia-rn.$$" 2>/dev/null && { mv "$dir/.enodia-rn.$$" "$dir/$new.$ext" 2>/dev/null || { mv "$dir/.enodia-rn.$$" "$dir/$old.$ext" 2>/dev/null; false; }; }
		else
			mv "$dir/$old.$ext" "$dir/$new.$ext" 2>/dev/null
		fi
		if [ $? -ne 0 ]; then
			[ "$_rs" -gt 0 ] && sh "$ENODIA_DIR/slots.sh" rename-config "$kind" "$new" "$old" >/dev/null 2>&1
			fail "не удалось переименовать файл"
		fi
		_ra=$(cat "$af" 2>/dev/null | tr -d ' \r\n'); [ "$_ra" = "$old" ] && echo "$new" > "$af"
		# Показ едет за файлом: набранное имя — новым показом, иначе прежний показ переезжает на новое имя файла. Сбой записи показа
		# файл назад не возвращает (переименование уже состоялось), но ответ обязан это сказать (ревью с.95: успех без оговорки
		# терял набранное имя молча, а строка старого ключа доставалась следующему файлу с тем же именем).
		_rnw=""
		if [ -f "$ENODIA_DIR/cfg-names.sh" ]; then
			if [ "$_rdh" = 1 ]; then _rno=$(sh "$ENODIA_DIR/cfg-names.sh" mv "$kind" "$old" "$new" "$disp" 2>&1)
			else _rno=$(sh "$ENODIA_DIR/cfg-names.sh" mv "$kind" "$old" "$new" 2>&1); fi
			[ $? = 0 ] || _rnw=$(printf '%s' "$_rno" | tail -n 1 | sed 's/^\[cfg-names\] //' | jesc 160)
		fi
		if [ "$kind" = awg ]; then
			for _rf in .failover-home .last.bak.name; do
				_rv=$(cat "$ENODIA_STATE/$_rf" 2>/dev/null | tr -d ' \r\n'); [ "$_rv" = "$old" ] && echo "$new" > "$ENODIA_STATE/$_rf"
			done
		fi
		if [ -n "$_rnw" ]; then
			printf '{"ok":true,"code":0,"name":"%s","slots":%s,"msg":"конфиг «%s» переименован в «%s», но имя не записано: %s"}\n' "$new" "$_rs" "$old" "$new" "$_rnw"
		else
			printf '{"ok":true,"code":0,"name":"%s","slots":%s,"msg":"конфиг «%s» переименован в «%s»"}\n' "$new" "$_rs" "$old" "$new"
		fi
		exit 0 ;;

	# --- Полный редактор конфига (гибрид «форма + сырой режим» в панели) ------------
	# get_config_raw: отдаёт ВЕСЬ файл конфига base64-ом (вкл. секреты — uuid/ключи/пароль:
	# владельцу роутера под токеном это ок; наружу без токена не уходит, в diag/бэкап-без-
	# секретов — нет). Фронт строит из него форму (config→params) ИЛИ показывает как сырой JSON.
	get_config_raw)
		kind=$(field kind); name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		case "$kind" in
			xray) cfg="$ENODIA_STATE/xray-configs/$name.json" ;;
			hy2)  cfg="$ENODIA_STATE/hy2-configs/$name.yaml" ;;
			*) fail "неизвестный тип (xray/hy2)" ;;
		esac
		[ -f "$cfg" ] || fail "нет конфига $name"
		b=$(base64 < "$cfg" | tr -d '\r\n')
		printf '{"ok":true,"code":0,"content":"%s"}\n' "$b"; exit 0 ;;
	# get_config_info: НЕСЕКРЕТНОЕ из конфига AmneziaWG для экрана сервера. Редактора у AWG нет (`awg setconf` отвергает конфиг
	# целиком — полуправка оставила бы интерфейс без рукопожатия), но куда он ведёт и задан ли в нём MTU, человек видеть обязан:
	# у нативного .conf строки MTU нет никогда, и действует общий (карта проекта, «нативный .conf без MTU»). Ключи НЕ отдаём.
	get_config_info)
		kind=$(field kind); name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		[ "$kind" = awg ] || fail "сведения — только у AmneziaWG (у Xray и Hysteria2 есть редактор)"
		cfg="$ENODIA_STATE/configs/$name.conf"
		[ -f "$cfg" ] || fail "нет конфига $name"
		ep=$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=[[:space:]]*//p' "$cfg" | head -n 1 | tr -d '\r\n' | jtxt 200)
		# MTU — ДЕЙСТВУЮЩИЙ, как его выставит awg_setup.sh: ручной из «Параметров сети» (net-tune.sh — владелец флага) поверх строки
		# конфига, иначе строка конфига, иначе дефолт проекта 1376. Панель своей арифметики не держит (ревью пачки 2: панель ставила
		# конфиг поверх ручного и брала «общий» из MTU ЖИВОГО awg0 — то есть от другого конфига).
		mtu=$(sed -n 's/^[[:space:]]*MTU[[:space:]]*=[[:space:]]*//p' "$cfg" | head -n 1 | tr -cd '0-9' | cut -c1-5); msrc=config
		# Вывод чужого скрипта — ФИЛЬТРОМ ПО ФОРМЕ (шапка net-tune.sh): копия старше верба печатает `usage: …` в stdout, и прежний
		# `tr -cd 0-9` вынимал из «ipv6» шестёрку — «MTU 6, задан в «Параметрах сети»» (ревью пачки 2, круг 2).
		_tm=""; _tmo=""; [ -f "$ENODIA_DIR/net-tune.sh" ] && _tmo=$(sh "$ENODIA_DIR/net-tune.sh" mtu-flag 2>/dev/null)
		_tm=$(printf '%s\n' "$_tmo" | grep -E '^[0-9]{3,4}$' | head -n 1)
		# Копия СТАРШЕ верба (usage вместо ответа) ручной MTU применяет, а сказать о нём не может: источник «не знаю», а не «конфиг» —
		# иначе одна ложь («MTU 6») сменилась бы другой («задан в конфиге» при действующем ручном; ревью пачки 2, круг 3).
		_tmu=0; case "$_tmo" in usage:*) _tmu=1 ;; esac
		# «Параметры сети» действуют ТОЛЬКО на awg0 (net-tune.sh); выход (awgN) берёт строку конфига, иначе 1376 (transport-awg.sh).
		# Конфиг, на котором стоит выход, получает и ЕГО число: иначе экран обещал бы выходу ручной MTU, которого у него нет.
		xmtu=${mtu:-1376}; xsrc=config; [ -n "$mtu" ] || xsrc=default
		xs=$(awk -F'\t' -v n="$name" '$3=="awg" && $4==n { printf "%s%s", (c++ ? "," : ""), $1 }' "$ENODIA_STATE/.slots" 2>/dev/null | tr -cd '0-9,')
		if [ -n "$_tm" ]; then mtu=$_tm; msrc=tun; elif [ -z "$mtu" ]; then mtu=1376; msrc=default; fi
		[ "$_tmu" = 1 ] && msrc=unknown
		printf '{"ok":true,"code":0,"endpoint":"%s","mtu":%s,"mtu_src":"%s","exits":[%s],"exit_mtu":%s,"exit_mtu_src":"%s"}\n' "$ep" "$mtu" "$msrc" "$xs" "$xmtu" "$xsrc"; exit 0 ;;
	# save_config_raw: пишет ПОЛНЫЙ конфиг (из формы — пересобран фронтом, или сырой текст).
	# Валидация: xray → JSON через jsonfilter (на роутере есть) + наличие outbound-протокола;
	# hy2 → наличие server:. Атомарно (.new+mv). Если конфиг активен и транспорт его несёт —
	# копируем в живой xray.json/hysteria.yaml и перезапускаем несущую (как edit_*_server).
	save_config_raw)
		kind=$(field kind); name=$(urldecode "$(field name)")
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || fail "недопустимое имя"
		case "$kind" in
			xray) cfg="$ENODIA_STATE/xray-configs/$name.json"; live="$ENODIA_STATE/xray.json";     act="$ENODIA_STATE/.xray-active"; tsh="xray-transport.sh"; tname=xray ;;
			hy2)  cfg="$ENODIA_STATE/hy2-configs/$name.yaml";  live="$ENODIA_STATE/hysteria.yaml"; act="$ENODIA_STATE/.hy2-active";  tsh="transport-hy2.sh";  tname=hy2 ;;
			*) fail "неизвестный тип (xray/hy2)" ;;
		esac
		[ -f "$cfg" ] || fail "нет конфига $name (сначала загрузите)"
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null | tr -d '\r')
		[ -n "$content" ] || fail "пустой или битый конфиг (base64)"
		printf '%s' "$content" > "$cfg.new" || { rm -f "$cfg.new"; fail "не удалось записать"; }
		if [ "$kind" = xray ]; then
			if command -v jsonfilter >/dev/null 2>&1; then
				ov=$(jsonfilter -i "$cfg.new" -e '@.outbounds[*].protocol' 2>/dev/null)
				[ -n "$ov" ] || { rm -f "$cfg.new"; fail "невалидный JSON (проверьте скобки и запятые)"; }
				echo "$ov" | grep -qE 'vless|vmess|trojan|shadowsocks' || { rm -f "$cfg.new"; fail "нет outbound-протокола (vless/vmess/trojan/ss)"; }
			else
				grep -q '"outbounds"' "$cfg.new" || { rm -f "$cfg.new"; fail "нет outbounds в JSON"; }
				grep -qE '"protocol"[[:space:]]*:[[:space:]]*"(vless|vmess|trojan|shadowsocks)"' "$cfg.new" || { rm -f "$cfg.new"; fail "нет outbound-протокола"; }
			fi
		else
			grep -qE '^[[:space:]]*server:' "$cfg.new" || { rm -f "$cfg.new"; fail "нет server: в YAML"; }
		fi
		mv "$cfg.new" "$cfg" && chmod 600 "$cfg" || { rm -f "$cfg.new"; fail "не удалось сохранить"; }
		active=$(cat "$act" 2>/dev/null | tr -d ' \r\n')
		if [ "$name" = "$active" ]; then
			# Рабочая копия и перезапуск — ПОД ЛОКОМ СМЕНЫ, а «активен ли конфиг» и «чья несущая» перечитываем уже ПОД НИМ (ревью с.97):
			# пока ждали, вкладка или сторож могли выбрать другой сервер или транспорт, и копия поверх их рабочей, как и down/up несущей,
			# которую ведёт уже не этот транспорт, перебили бы чужой выбор (у Xray и Hysteria2 один socks и один hev). Между down и up
			# несущей НЕТ: тик сторожа в это окно читает «health провалился» и уводит транспорт в cross-failover — правка конфига
			# активного сервера сама себя отменяла бы. Конфиг УЖЕ записан: отказ лока обязан сказать это, а не «не вышло» (ревью с.96).
			HS_FAIL_MSG="Конфиг $name сохранён, но не применён: идёт смена транспорта или сервера — сохраните его ещё раз через минуту"
			hold_switch
			active=$(cat "$act" 2>/dev/null | tr -d ' \r\n')
		fi
		if [ "$name" = "$active" ]; then
			cp "$cfg" "$live" 2>/dev/null && chmod 600 "$live"
			# VPN выключен человеком — это СОСТОЯНИЕ (C67): конфиг сохранён и рабочая копия обновлена, а несущую не поднимаем — её
			# поднимет «Включить VPN» уже с новым конфигом (как set_xray_server/set_hy2_server).
			if vpn_is_off; then
				# Обещать «применится при включении» можно, только если включение поднимет ЭТОТ транспорт: активный конфиг Xray при
				# выбранном AWG включение не тронет (ревью пачки 2, круг 2).
				if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = "$tname" ]; then
					printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён — применится, когда включите VPN"}\n' "$name"
				else
					printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён"}\n' "$name"
				fi
				exit 0
			fi
			if [ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = "$tname" ]; then
				sh "$ENODIA_DIR/$tsh" down >/dev/null 2>&1
				cap_run "$tsh" up; rc=$?; raw=$CAP_OUT          # причину не глотаем — зеркало set_xray_server
				why=$(printf '%s\n' "$raw" | grep -E 'резолв|зарезолвил|удал|встан' | tail -2 | jesc 200)
				if [ "$rc" = 0 ]; then
					if [ -n "$why" ]; then
						printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён, несущая перезапущена. %s"}\n' "$name" "$why"
					else
						printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён, несущая перезапущена"}\n' "$name"
					fi
				else
					printf '{"ok":false,"code":%s,"msg":"Конфиг %s сохранён, но несущая НЕ поднялась. %s"}\n' "$rc" "$name" "${why:-подробности в логе транспорта}"
				fi
				exit 0
			fi
		fi
		printf '{"ok":true,"code":0,"msg":"Конфиг %s сохранён"}\n' "$name"; exit 0 ;;

	# --- Загрузка конфига с устройства пользователя (как drag-drop на десктопе). ----
	# Контент приходит base64-ом в поле content (фронт читает файл FileReader-ом). Тип
	# (awg/xray/hy2) задаёт каталог И расширение; имя — strict-regex. НЕ активируем —
	# просто кладём файл (активация — отдельным set_*_server). Запись атомарна (.new+mv).
	upload_config)
		kind=$(field kind)
		name=$(urldecode "$(field name)")
		# Одной строкой и не длиннее 80 — как у переименования (RE_CFG_NAME): гард `^…$` судит построчно, и имя в две строки прошло бы
		# (ревью с.96, круг 2); а имя длиннее 80 потом не открыть и не переименовать.
		{ one_line "$name" && echo "$name" | grep -qE '^[A-Za-z0-9_.-]{1,80}$'; } || fail "недопустимое имя файла"
		case "$kind" in
			awg)  dir="$ENODIA_STATE/configs";      ext=conf ;;
			xray) dir="$ENODIA_STATE/xray-configs"; ext=json ;;
			hy2)  dir="$ENODIA_STATE/hy2-configs";  ext=yaml ;;
			*)    fail "неизвестный тип конфига" ;;
		esac
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый конфиг (base64)"
		# Мягкая валидация по типу — отбить явный мусор/не тот файл.
		case "$kind" in
			awg)  printf '%s' "$content" | grep -q '\[Interface\]'        || fail "не похоже на awg-конфиг (нет [Interface])" ;;
			xray) printf '%s' "$content" | grep -q '"outbounds"'          || fail "не похоже на xray JSON (нет outbounds)" ;;
			hy2)  printf '%s' "$content" | grep -qE '^[[:space:]]*server:' || fail "не похоже на hy2 YAML (нет server:)" ;;
		esac
		mkdir -p "$dir" 2>/dev/null
		dst="$dir/$name.$ext"
		# Черновик — СВОЙ у процесса и не под маской каталога (`*.conf` и т.п.): две вкладки, загружающие разом, не пишут друг другу.
		_utmp="$dir/.enodia-up.$$"
		printf '%s' "$content" | tr -d '\r' > "$_utmp" 2>/dev/null || { rm -f "$_utmp" 2>/dev/null; fail "не удалось записать файл"; }
		# ИМЯ ЗАНЯТО ДРУГИМ КОНФИГОМ (ревью с.95). Файл роутер держит латиницей, и разные серверы сходятся в одно имя («🇸🇬» и «🇸🇬⚡»
		# у VLESS дают `SG`, «⚡ Fast» и «🚀 Fast» — `Fast`): прежде второй импорт МОЛЧА затирал первый — и его показ тоже. А «заменить» —
		# это и законное «новые ключи того же сервера», и «второй конфиг того же сервера под доп-выход»: различить их может только человек
		# (ревью с.96, круг 3: экран AWG обещал «загрузите заново — заменит», а импорт клал рядом). Поэтому импорт руками (`uniq`):
		#   * тот же текст уже лежит — под базой или суффиксом — это тот файл (повторный импорт той же ссылки; прежде повторы плодили -3, -4…);
		#   * база свободна — занимаем её;
		#   * база занята ДРУГИМ текстом: `uniq=1` — ответ 409 «уже есть», панель спрашивает человека и повторяет запрос его решением
		#     (`uniq=0` — заменить на месте, `uniq=2` — свободное имя с суффиксом).
		# Свободное имя ЗАНИМАЕМ атомарно (`set -C`): две вкладки разом не сядут на одно -2. Без `uniq` (подписка, прежний клиент) —
		# замена, как раньше: подписка свои файлы обновляет на месте.
		_unote=""; _unew=1; [ -e "$dst" ] && _unew=0; _ub=""; _uq=$(field uniq)
		if [ "$_uq" = 1 ] || [ "$_uq" = 2 ]; then
			_ub=$(printf '%s' "$name" | cut -c1-76); _un=1; _uc=""; _cc="$name"
			while [ "$_un" -lt 100 ]; do
				if [ -e "$dir/$_cc.$ext" ] && cmp -s "$_utmp" "$dir/$_cc.$ext"; then _uc=$_cc; _unew=0; break; fi
				_un=$((_un + 1)); _cc="$_ub-$_un"
			done
			if [ -z "$_uc" ]; then
				if ( set -C; : > "$dst" ) 2>/dev/null; then _uc=$name; _unew=1
				elif [ "$_uq" = 1 ]; then
					rm -f "$_utmp"
					printf '{"ok":false,"code":409,"exists":"%s","msg":"конфиг «%s» уже есть"}\n' "$name" "$name"; exit 0
				else
					_un=2
					while [ "$_un" -lt 100 ]; do
						( set -C; : > "$dir/$_ub-$_un.$ext" ) 2>/dev/null && { _uc="$_ub-$_un"; _unew=1; break; }
						_un=$((_un + 1))
					done
					[ -n "$_uc" ] || { rm -f "$_utmp"; fail "имя «$name» занято, и свободного с суффиксом нет — переименуйте прежние"; }
				fi
			fi
			if [ "$_uc" != "$name" ]; then
				_unote="; имя «$name» уже было у другого конфига — сохранён рядом"
				_ubase=$name; name="$_uc"; dst="$dir/$name.$ext"
			fi
		fi
		if mv "$_utmp" "$dst" && chmod 600 "$dst"; then
			# НАСТОЯЩЕЕ ИМЯ (ремарка ссылки, имя файла, description vpn://) — в .cfg-names (cfg-names.sh): файл латиницей, показ как
			# назван. Поля нет (повторная заливка редактором, прежний клиент) — показ не трогаем; но у НОВОГО файла снимаем строку,
			# оставшуюся от прежнего конфига с тем же именем (сбой снятия, ручная правка): чужой показ на новом сервере — ложь.
			# Сбой метки загрузку не отменяет, но ответ говорит о нём.
			_uw=""
			if [ -f "$ENODIA_DIR/cfg-names.sh" ]; then
				if printf '%s' "&$body" | grep -q '&display='; then
					_ud=$(urldecode "$(field display)")
					# Файл получил суффикс, а показ — тот же, что у соседа: в списке, шапке и выборе выхода стояли бы два одинаковых
					# «Germany» (ревью с.96, круг 2). Различитель — номер суффикса.
					if [ -n "$_unote" ] && [ -n "$_ud" ]; then
						# Сверка — со ВСЕМИ соседями (база и её суффиксы; у соседа без своего имени показ — имя файла), ревью с.96, круг 3:
						# прежде только с базой, и третий «🚀 Fast» вставал рядом со вторым неотличимым.
						_usame=0
						[ "$_ud" = "$_ubase" ] && [ -z "$(sh "$ENODIA_DIR/cfg-names.sh" get "$kind" "$_ubase" 2>/dev/null)" ] && _usame=1
						sh "$ENODIA_DIR/cfg-names.sh" list 2>/dev/null | awk -F'\t' -v k="$kind/$_ubase" -v p="$kind/$_ub-" -v d="$_ud" \
							'($1 == k || substr($1, 1, length(p)) == p) && $2 == d { f = 1 } END { exit f ? 0 : 1 }' && _usame=1
						# Не за потолок владельца (240 байт): длинный показ без различителя лучше, чем отказ записать имя вовсе.
						[ "$_usame" = 1 ] && [ "$(printf '%s' "$_ud ($_un)" | wc -c)" -le 240 ] && _ud="$_ud ($_un)"
					fi
					_uo=$(sh "$ENODIA_DIR/cfg-names.sh" set "$kind" "$name" "$_ud" 2>&1) \
						|| _uw=$(printf '%s' "$_uo" | tail -n 1 | sed 's/^\[cfg-names\] //' | jesc 160)
				elif [ "$_unew" = 1 ]; then
					sh "$ENODIA_DIR/cfg-names.sh" del "$kind" "$name" >/dev/null 2>&1
				fi
			fi
			_unote=$(printf '%s' "$_unote" | jesc 600)
			if [ -n "$_uw" ]; then
				printf '{"ok":true,"code":0,"name":"%s","msg":"Конфиг %s сохранён (%s), но имя не записано: %s"}\n' "$name" "$name" "$kind" "$_uw"
			else
				printf '{"ok":true,"code":0,"name":"%s","msg":"Конфиг %s сохранён (%s) — активируйте в списке серверов%s"}\n' "$name" "$name" "$kind" "$_unote"
			fi
		else
			rm -f "$_utmp" 2>/dev/null
			# Имя заняли пустышкой и не записали — пустышку снять, иначе в списке висел бы пустой конфиг.
			[ "$_unew" = 1 ] && [ -n "$_ub" ] && [ ! -s "$dst" ] && rm -f "$dst" 2>/dev/null
			fail "не удалось записать файл"
		fi
		exit 0 ;;

	# --- VLESS-подписки: URL-подписки живут НА РОУТЕРЕ ($ENODIA_STATE/.subs) --------------
	# Почему на роутере, а не в localStorage браузера: панелью рулят с разных устройств
	# (телефон/планшет/ПК), а localStorage — per-browser → подписку было видно/обновляемо
	# только с того устройства, где импортнули. Файл .subs = строки "tag⇥url⇥label"
	# (⇥=TAB, label последним — может содержать пробелы; url/tag валидированы regex'ом).
	# URL — это КРЕД: наружу (list / бэкап-без-секретов / diag-dump) НЕ отдаём; обновление
	# идёт по tag, роутер сам подставляет url (кред по проводу назад не гуляет). Секреты
	# конфигов подписки (server/uuid/Reality-ключ) и так уже лежат на роутере — .subs не
	# крупнее того, что есть.
	#
	# save_sub: upsert строки (импорт персистит url ОДИН раз). fetch_sub: тянет тело по tag
	# (обход CORS браузера — curl'ит РОУТЕР), отдаёт base64 (разбор base64/plaintext/
	# JSON-массив + vless://→xray JSON делает БРАУЗЕР; busybox JSON не собираем). Тело качаем
	# В ФАЙЛ, а не в $var: часть панелей (durev) отдаёт gzip'ом БЕЗУСЛОВНО, NUL-байты gzip
	# обрезали бы shell-переменную; od в busybox НЕТ — не читаем магию, а ПРОБУЕМ разжать
	# (удалось+непусто ⇒ был gzip). del_sub: снять ТОЛЬКО конфиги по метке (зовёт refresh/
	# import для идемпотентной перезаливки — строку .subs НЕ трогает). remove_sub: полное
	# снятие (конфиги + строка .subs) для кнопки удаления подписки.
	save_sub)
		tag=$(field tag)
		url=$(urldecode "$(field url)")
		label=$(urldecode "$(field label)")
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "не URL (нужен http(s)://…)"
		sub_host_public "$url" || fail "URL ведёт на приватный/локальный адрес — так нельзя (SSRF)"
		TAB=$(printf '\t')
		# Управляющие байты метки — вон целиком, а не только TAB/CR/LF: `.subs` — TSV, но метку потом кладут в JSON четыре читателя
		# (cgi-bin/list, status, data, subs-update.sh), и сырой байт ронял бы разбор всего ответа (ревью приёмки, круги 2–3). Читатели
		# режут их и сами: записи, сделанные до этой версии, и восстановленные из бэкапа эту чистку не проходили.
		label=$(printf '%s' "$label" | tr -d '\000-\037\177'); [ -n "$label" ] || label="$tag"
		# СЧЁТЧИКИ ПРИНАДЛЕЖАТ ССЫЛКЕ, А НЕ ТЕГУ: сменили адрес подписки — прежний остаток и срок
		# рассказывают о ЧУЖОМ провайдере, и до первой закачки панель показывала бы их как свои.
		# Тот же тег с тем же адресом (идемпотентная перезаливка) отметки сохраняет.
		_oldu=$([ -f "$ENODIA_STATE/.subs" ] && grep "^$tag$TAB" "$ENODIA_STATE/.subs" 2>/dev/null | head -1 | cut -d"$TAB" -f2)
		[ "$_oldu" = "$url" ] || sub_info_drop "$tag"
		{ [ -f "$ENODIA_STATE/.subs" ] && grep -v "^$tag$TAB" "$ENODIA_STATE/.subs"
		  printf '%s\t%s\t%s\n' "$tag" "$url" "$label"; } > "$ENODIA_STATE/.subs.new" 2>/dev/null
		mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" && chmod 600 "$ENODIA_STATE/.subs" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"подписка сохранена"}\n'; exit 0 ;;
	# rename_sub: сменить ТОЛЬКО отображаемое имя (label) подписки. tag и конфиги sub-<tag>-*
	# не трогаем (tag = внутренний ключ, фиксирован; переименование меняет лишь показ).
	rename_sub)
		tag=$(field tag)
		label=$(urldecode "$(field label)")
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		label=$(printf '%s' "$label" | tr -d '\000-\037\177'); [ -n "$label" ] || fail "пустое имя"   # как у save_sub
		[ -f "$ENODIA_STATE/.subs" ] || fail "подписка не найдена"
		TAB=$(printf '\t')
		url=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" | head -1 | cut -d"$TAB" -f2)
		[ -n "$url" ] || fail "подписка не найдена"
		{ grep -v "^$tag$TAB" "$ENODIA_STATE/.subs"; printf '%s\t%s\t%s\n' "$tag" "$url" "$label"; } > "$ENODIA_STATE/.subs.new" 2>/dev/null
		mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" && chmod 600 "$ENODIA_STATE/.subs" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"подписка переименована"}\n'; exit 0 ;;
	# edit_sub_url: сменить ССЫЛКУ подписки (url в .subs), сохранив label. Метка/конфиги не трогаем;
	# перетягивание серверов — отдельным refresh из панели. SSRF-гард как в save_sub.
	edit_sub_url)
		tag=$(field tag)
		url=$(urldecode "$(field url)")
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "не URL (нужен http(s)://…)"
		sub_host_public "$url" || fail "URL ведёт на приватный/локальный адрес — так нельзя (SSRF)"
		TAB=$(printf '\t')
		[ -f "$ENODIA_STATE/.subs" ] && grep -q "^$tag$TAB" "$ENODIA_STATE/.subs" || fail "подписка не найдена"
		label=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" | head -1 | cut -d"$TAB" -f3-); [ -n "$label" ] || label="$tag"
		# Счётчики принадлежат ССЫЛКЕ (см. save_sub): сменили адрес — остаток и срок теперь
		# рассказывают о чужом провайдере, и до первой закачки панель выдавала бы их за свои.
		_oldu=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" | head -1 | cut -d"$TAB" -f2)
		[ "$_oldu" = "$url" ] || sub_info_drop "$tag"
		{ grep -v "^$tag$TAB" "$ENODIA_STATE/.subs"; printf '%s\t%s\t%s\n' "$tag" "$url" "$label"; } > "$ENODIA_STATE/.subs.new" 2>/dev/null
		mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" && chmod 600 "$ENODIA_STATE/.subs" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"ссылка обновлена"}\n'; exit 0 ;;
	fetch_sub)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		TAB=$(printf '\t')
		url=$(grep "^$tag$TAB" "$ENODIA_STATE/.subs" 2>/dev/null | head -1 | cut -d"$TAB" -f2)
		echo "$url" | grep -qE '^https?://[^[:space:]]+$' || fail "подписка не найдена на роутере"
		# Одна копия закачки: тело тянет subs-update.sh (тот же путь, которым ходит cron) —
		# иначе панельный и headless-путь разъехались бы по гарду/gzip-детекту. Ниже — прежний
		# инлайн как фолбэк на случай дрейфа деплоя (скрипт ещё не залит).
		# Гард `-f`, а не `-x`: зовём через `sh`, и снятый бит выполнения ТИХО уводил бы панель
		# на фолбэк-путь вместо общего (класс Б7-2).
		if [ -f "$ENODIA_DIR/subs-update.sh" ]; then
			data=$(sh "$ENODIA_DIR/subs-update.sh" fetch "$tag" 2>/dev/null)
			[ -n "$data" ] || fail "подписка недоступна или пустая"
			printf '{"ok":true,"code":0,"data":"%s"}\n' "$data"; exit 0
		fi
		sub_host_public "$url" || fail "URL подписки ведёт на приватный/локальный адрес — отказ (SSRF)"
		# Дрейф деплоя (subs-update.sh ещё не залит) — тянем тем же ОБЩИМ слоем. Свой curl здесь
		# был ТРЕТЬЕЙ копией закачки, и уже разошёлся с оригиналом: без проверки КАЖДОГО редиректа
		# и без потолка на распаковку gzip.
		tmp="/tmp/enodia-sub.$$"
		sub_fetch "$url" "$tmp" || { rm -f "$tmp"; fail "подписка недоступна или пустая"; }
		data=$(base64 < "$tmp" | tr -d '\r\n'); rm -f "$tmp"
		printf '{"ok":true,"code":0,"data":"%s"}\n' "$data"; exit 0 ;;
	del_sub)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		del_sub_configs "$tag"
		printf '{"ok":true,"code":0,"msg":"конфиги подписки сняты"}\n'; exit 0 ;;
	remove_sub)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		del_sub_configs "$tag"   # снять конфиги ДО чистки строки .subs (нужен полный набор тегов)
		if [ -f "$ENODIA_STATE/.subs" ]; then
			TAB=$(printf '\t'); grep -v "^$tag$TAB" "$ENODIA_STATE/.subs" > "$ENODIA_STATE/.subs.new" 2>/dev/null
			mv "$ENODIA_STATE/.subs.new" "$ENODIA_STATE/.subs" 2>/dev/null
		fi
		# Имена снимаем ПО ВЛАДЕЛЬЦУ, а не по префиксу (та же причина, что у del_sub_configs:
		# «liberty» ⊂ «liberty-vpn» — голый грep уносил карту имён соседней подписки).
		if [ -f "$ENODIA_STATE/.sub-names" ]; then
			sub_names_keep_other "$tag" > "$ENODIA_STATE/.sub-names.new" 2>/dev/null
			mv "$ENODIA_STATE/.sub-names.new" "$ENODIA_STATE/.sub-names" 2>/dev/null
		fi
		# …и карту выбранных выходов (.sub-picks, владелец — subs-update.sh): она ключуется теми же
		# именами, и осиротевшие строки жили бы в ней вечно.
		if [ -f "$ENODIA_STATE/.sub-picks" ]; then
			sub_names_keep_other "$tag" "$ENODIA_STATE/.sub-picks" > "$ENODIA_STATE/.sub-picks.new" 2>/dev/null
			mv "$ENODIA_STATE/.sub-picks.new" "$ENODIA_STATE/.sub-picks" 2>/dev/null
		fi
		# …и счётчики провайдера (.sub-info, владелец — subs-lib.sh): строка ключуется ТЕГОМ, а
		# теги люди заводят повторно — осиротевшая запись отдала бы новой подписке чужой остаток.
		sub_info_drop "$tag"
		printf '{"ok":true,"code":0,"msg":"подписка удалена"}\n'; exit 0 ;;
	# set_sub_names: настоящие имена серверов подписки (эмодзи/флаги/юникод — как в v2rayNG).
	# В имя ФАЙЛА такое не кладём (спецсимволы ломают глоб/скрипты), поэтому сырой remark
	# храним отдельно: .sub-names = строки "sub-<tag>-<файл>⇥<remark>". names = base64 этих
	# строк (эмодзи проходят как UTF-8). Пакетно заменяем строки, чей ВЛАДЕЛЕЦ — этот tag.
	set_sub_names)
		tag=$(field tag)
		echo "$tag" | grep -qE '^[a-z0-9-]{1,16}$' || fail "плохая метка подписки"
		names=$(urldecode "$(field names)")
		NM="$ENODIA_STATE/.sub-names"
		# Блок панели приезжает как join('\n') — БЕЗ хвостового перевода строки, и файл после
		# браузерного ⟳ оставался без него. Читатели на busybox идут `while read`, а тот теряет
		# последнюю строку без \n (замер: 3 строки → 2 итерации) — то есть ПОСЛЕДНИЙ сервер
		# подписки терял своё настоящее имя. `awk '{print}'` дописывает перевод строки любому
		# последнему полю и ничего не меняет, если он уже есть.
		{ sub_names_keep_other "$tag"
		  printf '%s' "$names" | base64 -d 2>/dev/null | awk '{print}'; } > "$NM.new" 2>/dev/null
		mv "$NM.new" "$NM" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"имена сохранены"}\n'; exit 0 ;;
	# save_checks: кэш проверок серверов (пинг/скорость). Панель шлёт ВЕСЬ кэш (data=b64 TSV
	# key⇥st⇥ms⇥method⇥cdn⇥mbps⇥kind⇥ts). Полная замена — это хинты производительности, не критич-
	# ные данные (last-writer-wins). Валидируем построчно (ключ + 8 полей), кап 2000 строк.
	save_checks)
		raw=$(urldecode "$(field data)" | base64 -d 2>/dev/null)
		TAB=$(printf '\t')
		F="$ENODIA_STATE/.srv-checks"
		printf '%s\n' "$raw" | awk -F"$TAB" 'NR<=2000 && NF>=8 && $1 ~ /^(awg|xray|hy2)\|[A-Za-z0-9._-]+$/{print}' > "$F.new" 2>/dev/null
		mv "$F.new" "$F" 2>/dev/null && chmod 600 "$F" 2>/dev/null
		printf '{"ok":true,"code":0}\n'; exit 0 ;;

	# --- Устройства: режим конкретного IP (split / bypass / force / desync) -----------
	# Каждый режим взаимоисключающий: перед установкой нового снимаем
	# противоположную метку (apply-bypass идемпотентен; снятие безвредно).
	# desync («целиком в десинк») снимает противоположные САМ, в движке: его половины — ACCEPT
	# «мимо VPN» и NFQUEUE по источнику, и разводить это по двум вызовам отсюда значило бы
	# оставить окно, где устройство уже не в VPN, но ещё и не в десинке.
	dev_split|dev_bypass|dev_force|dev_desync)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		# Отметку владельца ставим ДО применения: `run` заканчивается `exit`, после него кода нет.
		# Для dev_split не ставим — это снятие режима, а не заведение правила.
		[ "$act" = dev_split ] || owner_note "$ip" >/dev/null 2>&1
		case "$act" in
			dev_split)  sh "$ENODIA_DIR/apply-bypass.sh" del-ip "$ip" >/dev/null 2>&1; run apply-bypass.sh force-del-ip "$ip" ;;
			dev_bypass) sh "$ENODIA_DIR/apply-bypass.sh" force-del-ip "$ip" >/dev/null 2>&1; run apply-bypass.sh add-ip "$ip" ;;
			dev_desync) run apply-bypass.sh desync-add-ip "$ip" ;;
			# slot — необязателен: пусто/0 = основной туннель, s2..s7 = доп-выход.
			# Выключенный выход движок сам уводит на основной (гейт в rebuild_force).
			dev_force)  slot=$(field slot); case "$slot" in s[2-7]) ;; *) slot="" ;; esac
			            sh "$ENODIA_DIR/apply-bypass.sh" del-ip "$ip" >/dev/null 2>&1; run apply-bypass.sh force-add-ip "$ip" "$slot" ;;
		esac ;;

	# --- Устройство «мимо VPN»: пускать ли по нему МОИ ручные правила -----------
	# ACCEPT выреза обрывает всю mangle ⇒ у такого устройства мертвы и добавленные вручную
	# домены/адреса/группы «в VPN». Тумблер поднимает их обратно отдельной ступенью выше
	# выреза (движок — apply-bypass.sh keep-*, цепочка VPN_KEEP). Гейт «устройство реально
	# в вырезе» держит движок, CGI только валидирует IP.
	dev_keep)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		case "$(field on)" in
			1|on|true) owner_note "$ip" >/dev/null 2>&1; run apply-bypass.sh keep-add-ip "$ip" ;;
			*)         run apply-bypass.sh keep-del-ip "$ip" ;;
		esac ;;

	# --- Устройство: свои адреса назначения (цепочка VPN_DEV) -----------------
	# «Этому ТВ ютуб — через выход №3, остальным как обычно». Общие списки/группы/гео действуют на
	# ВСЮ сеть, а тумблер «мои правила действуют» (dev_keep) включает их для устройства ОПТОМ —
	# выбора адресов для ОДНОГО источника не было ни у чего.
	# Хранит правила groups.sh (группа с непустым src, вербы dev-add/dev-del), цепочку держит
	# apply-bypass.sh. CGI только валидирует ввод: значение уезжает в подстановку, мусор туда
	# пускать нельзя. Направление панель шлёт СЛОВАРЁМ ПОРТ-ПРАВИЛ (vpn|direct|block|sN) — один
	# язык на оба экрана; в язык движка (dir + слот отдельным полем) переводим здесь.
	dev_dst_add|dev_dst_del)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		val=$(urldecode "$(field val)" | tr -d ' \t\r')
		echo "$val" | grep -qE '^[A-Za-z0-9._:/-]{1,200}$' || fail "нужен домен или IP/подсеть"
		if [ "$act" = dev_dst_del ]; then
			run groups.sh dev-del "$ip" "$val"
		else
			dir=$(field dir)
			echo "$dir" | grep -qE '^(vpn|direct|block|s[2-7])$' || fail "куда: в VPN, напрямую, блокировать или в доп-выход"
			slot=0
			case "$dir" in
				s[2-7]) slot=${dir#s}; dir=vpn ;;
				direct) dir=bypass ;;
			esac
			owner_note "$ip" >/dev/null 2>&1
			run groups.sh dev-add "$ip" "$dir" "$slot" "$val"
		fi ;;

	# --- Устройства: правила по портам (цепочка VPN_PORTS) --------------------
	# «У этого устройства ВОТ ЭТИ порты идут не туда, куда остальной его трафик»: режим
	# устройства выше (split/bypass/force) отвечает за трафик ЦЕЛИКОМ, а p2p-игры и
	# голосовые сервисы иногда требуют развести протоколы по разным путям. Четвёртое
	# направление `block` — «не выпускать вовсе», его главный потребитель QUIC (udp/443):
	# ByeDPI — socks-прокси, то есть только TCP, и QUIC уезжает мимо десинка. Владелец
	# правил и порядка цепочек — apply-bypass.sh; CGI только валидирует ввод (значения
	# уезжают в подстановку iptables, мусор туда пускать нельзя).
	port_add|port_del)
		ip=$(urldecode "$(field ip)")
		# СНЯТЬ можно любую строку, которую панель показала, — и ту, что ядро пропускает (`ok:false`: «UDP», «443,,80»,
		# адрес не из четырёх чисел из бэкапа). Движок сверяет ключ строкой по файлу, в iptables ничего не подставляется,
		# поэтому снятию хватает безопасного набора символов — того же, каким cgi-bin/data отдаёт строки. Строгая
		# грамматика добавления здесь оставляла «не действует — снимите её» невыполнимым (ревью пачки 3, круг 2).
		if [ "$act" = port_del ]; then
			proto=$(field proto); ports=$(urldecode "$(field ports)" | tr -d ' \t\r')
			case "$ip$proto$ports" in *[!0-9a-zA-Z.,-]*) fail "недопустимое правило" ;; esac
			[ -n "$ip" ] && [ -n "$proto" ] && [ -n "$ports" ] || fail "недопустимое правило"
			run apply-bypass.sh port-del "$ip" "$proto" "$ports"
		fi
		[ "$ip" = any ] || echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		proto=$(field proto)
		echo "$proto" | grep -qE '^(udp|tcp|both)$' || fail "протокол: udp, tcp или оба"
		# пробел после запятой человек ставит руками — режем ДО валидации, иначе честный
		# ввод «3478-3480, 7600» отбивался бы как мусор
		ports=$(urldecode "$(field ports)" | tr -d ' \t\r')
		[ "$ports" = all ] || echo "$ports" | grep -qE '^[0-9]{1,5}(-[0-9]{1,5})?(,[0-9]{1,5}(-[0-9]{1,5})?)*$' \
			|| fail "порты: 443, 3478-3480 или «все»"
		if [ "$act" = port_add ]; then
			dir=$(field dir)
			echo "$dir" | grep -qE '^(vpn|direct|block|s[2-7])$' || fail "куда: в VPN, напрямую, блокировать или в доп-выход"
			# `any` — правило на всю сеть, а не на устройство: владельца у него нет.
			[ "$ip" = any ] || owner_note "$ip" >/dev/null 2>&1
			run apply-bypass.sh port-add "$ip" "$proto" "$ports" "$dir"
		else
			run apply-bypass.sh port-del "$ip" "$proto" "$ports"
		fi ;;

	# --- Устройства: закрепить адрес (DHCP-резервация) ------------------------
	# ЗАЧЕМ КНОПКА. Правила проекта ключуются по IPv4, а адрес выдаётся на срок аренды: устройство
	# переподключилось — адрес другой, правило осталось на старом. Закрепление говорит dnsmasq
	# «этому MAC всегда вот этот адрес» и тем фиксирует связку, на которой держится вся политика.
	# MAC берёт сам движок (нынешний владелец адреса) — панель его не присылает: одно место, где
	# решают «кому принадлежит адрес», это lease-lib, и второй копии этого решения быть не должно.
	dhcp_pin|dhcp_unpin)
		ip=$(urldecode "$(field ip)")
		echo "$ip" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail "недопустимый IP"
		[ -f "$ENODIA_DIR/dhcp-static.sh" ] || fail "закрепление адресов недоступно (обновите скрипты с GitHub)"
		if [ "$act" = dhcp_pin ]; then run dhcp-static.sh add "$ip"; else run dhcp-static.sh del "$ip"; fi ;;

	# --- Наблюдение за трафиком устройства («Что запрашивает устройство») -----
	# devwatch.sh включает/выключает dnsmasq query-log на КОРОТКОЕ окно (verbose на весь LAN —
	# постоянно не держим; авто-выключение по таймеру). Печатает СВОЙ JSON {ok,watching,secs_left}
	# → echo как есть (не через run(), чтобы не оборачивать в {ok,code,msg}). Чтение (домены/conntrack)
	# — read-only в cgi-bin/data section=devtraffic. Кнопка «→ мимо VPN» по IP = существующий dst_bypass.
	# Гард на файл обязателен: ответ этих двух веток — ЧУЖОЙ JSON (печатает devwatch.sh), и без
	# файла CGI отдаёт ПУСТОЕ тело. Пустое тело фронт читает как «сбой запроса» — без причины на
	# экране, хотя причина известна («скрипт не залит»).
	devwatch_start)
		[ -f "$ENODIA_DIR/devwatch.sh" ] || fail "devwatch.sh не установлен (обновите скрипты роутера)"
		secs=$(clampint "$(field secs)" 60 10 300)
		sh "$ENODIA_DIR/devwatch.sh" start "$secs"; exit 0 ;;
	devwatch_stop)
		[ -f "$ENODIA_DIR/devwatch.sh" ] || fail "devwatch.sh не установлен (обновите скрипты роутера)"
		sh "$ENODIA_DIR/devwatch.sh" stop; exit 0 ;;
	# --- Сайты/домены ---------------------------------------------------------
	# ТРИ состояния одного домена, один хозяин (domain.sh): в VPN / мимо VPN / нет правила.
	# dom_bypass раньше резолвил домен и клал СНИМОК A-записей в плоский .bypass-dst — снимок
	# протухал (CDN крутит адреса), отменить «по домену» было нечем, а индикатор маршрута его не
	# видел (правило-то оставалось «в VPN») → «нажал мимо, а на странице ничего не изменилось».
	# Теперь это обычное правило `ipset=/дом/enodia_bypass` — динамика, персист и симметричная отмена.
	domain_add|domain_del|dom_bypass|domain_block)
		# norm_domain — тот же нормализатор, что у пачки (схема/путь/www/ведущая «*.»): маска
		# `*.ya.ru` = `ya.ru`, поддомены у dnsmasq и так входят. Снятие правила нормализуем ТЕМ ЖЕ
		# вызовом — иначе `*.ya.ru` не совпал бы со строкой, записанной как `ya.ru`, и правило не снялось бы.
		dom=$(norm_domain "$(urldecode "$(field domain)")")
		# dom_ok, а не «только разрешённые знаки»: прежний регекс не имел ПОТОЛКА длины, и домен
		# с меткой >63 символов уезжал в конфиг dnsmasq, который демон целиком отвергает (замер —
		# в шапке dom_ok). Панель показывала «правило сохранено», а сеть теряла DNS на ребуте.
		dom_ok "$dom" || fail "недопустимый домен (буквы, цифры, точка и дефис; часть между точками — до 63 знаков)"
		case "$act" in
			domain_add)   run domain.sh add "$dom" ;;
			dom_bypass)   run domain.sh bypass "$dom" ;;
			domain_block) run domain.sh block "$dom" ;;   # address=/дом/0.0.0.0 + :: (обе семьи), см. domain.sh
			*)            run domain.sh remove "$dom" ;;
		esac ;;
	# У адреса те же ТРИ состояния, что у домена: в VPN (dst_vpn) / мимо VPN (dst_bypass) /
	# правила нет (dst_unbypass, dst_unvpn — снять). Направление переключается одним вербом:
	# apply-bypass сам снимает противоположное правило, чтобы адрес не оказался разом и в
	# вырезе, и в маркировке.
	dst_bypass|dst_unbypass|dst_vpn|dst_unvpn)
		cidr=$(urldecode "$(field cidr)")
		echo "$cidr" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$' || fail "недопустимый IP/подсеть"
		case "$act" in
			dst_bypass)   run apply-bypass.sh add-dst "$cidr" ;;
			dst_unbypass) run apply-bypass.sh del-dst "$cidr" ;;
			dst_vpn)      run apply-bypass.sh add-vpn-dst "$cidr" ;;
			*)            run apply-bypass.sh del-vpn-dst "$cidr" ;;
		esac ;;

	# --- Именованные группы правил (groups.sh) --------------------------------
	# id/направление/флаг валидируем здесь строгим regex'ом, имя и члены НЕ валидируем —
	# groups.sh сам их санирует (san/is_dom/is_cidr) и в shell-команду не подставляет.
	# Члены едут base64-блобом (как bulk_*): в них переводы строк, а тело формы — urlencoded.
	grp_add)
		dir=$(field dir); case "$dir" in vpn|bypass) ;; *) fail "направление: в VPN или мимо VPN" ;; esac
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя группы"
		run groups.sh add "$dir" "$name" ;;
	grp_new)
		# Мастер импорта routing-правил из подписки (Ф4): группа + её состав ОДНИМ действием
		# (иначе фронт слал бы grp_add, вытаскивал id из человеческого сообщения и слал grp_members —
		# два do_apply на каждую из N групп). Ответ МАШИННЫЙ: {"ok",…,"id":"gN","n":<членов>};
		# человеческий текст строит панель (её строки и так переводятся i18n-слоем).
		dir=$(field dir); case "$dir" in vpn|bypass) ;; *) fail "направление: в VPN или мимо VPN" ;; esac
		slot=$(field slot); case "$slot" in ''|0) slot=0 ;; [2-7]) ;; *) fail "доп-выход: 0 или 2..7" ;; esac
		name=$(urldecode "$(field name)"); [ -n "$name" ] || fail "нужно имя группы"
		# Состав едет base64-блобом (как grp_members/bulk_*): в нём переводы строк, а тело формы urlencoded.
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		raw=$(printf '%s' "$content" | sh "$ENODIA_DIR/groups.sh" new "$dir" "$slot" "$name" 2>&1); code=$?
		last=$(printf '%s' "$raw" | tail -n 1)
		gid=$(printf '%s' "$last" | cut -f1); gn=$(printf '%s' "$last" | cut -f2)
		# Отказ — СЛОВАМИ groups.sh («ни одного домена или адреса — группа не создана»): общее «не удалось» не говорило,
		# что чинить. Своя строка — только если скрипт не сказал ничего (дрейф деплоя, падение).
		case "$gid" in
			g[0-9]*) ;;
			*) [ "$code" -ne 0 ] && [ -n "$last" ] || last="не удалось создать группу"
			   printf '{"ok":false,"code":1,"msg":"%s"}\n' "$(printf '%s' "$last" | jesc 300)"; exit 0 ;;
		esac
		case "$gn" in ''|*[!0-9]*) gn=0 ;; esac
		printf '{"ok":%s,"code":%s,"id":"%s","n":%s}\n' \
			"$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$gid" "$gn"
		exit 0 ;;
	grp_del|grp_rename|grp_dir|grp_slot|grp_toggle|grp_members)
		gid=$(field id)
		echo "$gid" | grep -qE '^g[0-9]+$' || fail "битый id группы"
		case "$act" in
			grp_del)    run groups.sh del "$gid" ;;
			grp_rename) name=$(urldecode "$(field name)"); [ -n "$name" ] || fail "нужно имя группы"
			            run groups.sh rename "$gid" "$name" ;;
			grp_dir)    dir=$(field dir); case "$dir" in vpn|bypass) ;; *) fail "направление: в VPN или мимо VPN" ;; esac
			            run groups.sh dir "$gid" "$dir" ;;
			grp_slot)   slot=$(field slot); case "$slot" in 0|[2-7]) ;; *) fail "доп-выход: 0 или 2..7" ;; esac
			            run groups.sh slot "$gid" "$slot" ;;
			grp_toggle) en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			            run groups.sh toggle "$gid" "$en" ;;
			grp_members)
				content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
				# Пустой блоб = «очистить группу», это законно (не fail): группу оставляем,
				# членов убираем. groups.sh set-members читает stdin и пересобирает всё сам.
				raw=$(printf '%s' "$content" | sh "$ENODIA_DIR/groups.sh" set-members "$gid" 2>&1); code=$?
				msg=$(printf '%s' "$raw" | jesc 1000)
				printf '{"ok":%s,"code":%s,"msg":"%s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$msg"
				exit 0 ;;
		esac ;;

	# --- Своё имя устройства (dev-names.sh) — метка панели по MAC ------------------------------------
	# MAC и имя судит ВЛАДЕЛЕЦ, своей копии гарда здесь нет: MAC — `lease-lib.sh::mac_ok` по всей строке целиком (одна копия
	# разбора на проект, любой регистр, перевод строки внутри — отказ), имя — санирует и меряет (таб и перевод строки — в
	# пробел, кавычка и косая — вон, длина — отказом). Аргументы уходят владельцу в кавычках, мимо eval. Пустое имя = снять.
	dev_name)
		# urldecode обязателен: панель кодирует параметры, и двоеточие MAC приезжает как `%3A` — без него владелец отвергал
		# ЛЮБОЙ настоящий MAC (поймано на BE7000 27.09.2026 первым же переименованием; стенд панели видел только, что ушло).
		mac=$(urldecode "$(field mac)")
		name=$(urldecode "$(field name)")
		run dev-names.sh set "$mac" "$name" ;;

	# --- Доп-выходы (слоты мульти-транспорта, slots.sh) -----------------------
	# id — строгий 2..7; транспорт/fallback — whitelist; config — имя файла (^[A-Za-z0-9._-]+$)
	# или '-' (нет конфига). Имя НЕ валидируем — slots.sh хранит его base64 и в eval не подставляет.
	slot_add)
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя выхода"
		tpt=$(field transport); case "$tpt" in awg|xray|hy2|byedpi|zapret) ;; *) fail "неизвестный транспорт" ;; esac
		cfg=$(field config); [ -n "$cfg" ] || cfg='-'
		case "$cfg" in '-') ;; *[!A-Za-z0-9._-]*) fail "битое имя конфига" ;; esac
		fb=$(field fallback); case "$fb" in main|direct) ;; *) fb=main ;; esac
		run slots.sh add "$name" "$tpt" "$cfg" "$fb" ;;
	slot_toggle|slot_del|slot_set)
		sid=$(field id); case "$sid" in [2-7]) ;; *) fail "битый id выхода" ;; esac
		case "$act" in
			slot_toggle) en=$(field enabled); case "$en" in 0|1) ;; *) fail "нужно 0|1" ;; esac
			             if [ "$en" = 1 ]; then run slots.sh enable "$sid"; else run slots.sh disable "$sid"; fi ;;
			slot_del)    run slots.sh del "$sid" ;;
			slot_set)    fld=$(field field); val=$(urldecode "$(field value)")
			             case "$fld" in
			                 name)      [ -n "$val" ] || fail "нужно имя"; run slots.sh set "$sid" name "$val" ;;
			                 transport) case "$val" in awg|xray|hy2|byedpi|zapret) ;; *) fail "неизвестный транспорт" ;; esac
			                            run slots.sh set "$sid" transport "$val" ;;
			                 config)    [ -n "$val" ] || val='-'; case "$val" in '-') ;; *[!A-Za-z0-9._-]*) fail "битое имя конфига" ;; esac
			                            run slots.sh set "$sid" config "$val" ;;
			                 fallback)  case "$val" in main|direct) ;; *) fail "fallback: main|direct" ;; esac
			                            run slots.sh set "$sid" fallback "$val" ;;
			                 *) fail "поле: name|transport|config|fallback" ;;
			             esac ;;
		esac ;;
	slot_pool)
		# «Свой пул…» на десинк-выходе: создать «в VPN»-группу, СРАЗУ привязанную к слоту
		# (домены юзер добавит в редакторе группы). id строгий 2..7; имя не валидируем —
		# groups.sh санирует (san) и в eval не подставляет.
		sid=$(field id); case "$sid" in [2-7]) ;; *) fail "битый id выхода" ;; esac
		name=$(urldecode "$(field name)")
		[ -n "$name" ] || fail "нужно имя пула"
		run groups.sh add-bound "$sid" "$name" ;;

	# --- Wi-Fi: режим SSID по его iface'ам (split / bypass / force) — 3 позиции,
	# как у устройств. Каждый iface ВАЛИДИРУЕМ (^wl[0-9]+$) И проверяем, что он ЕСТЬ В ЯДРЕ: hostapd-конф
	# лежит и у выключенной сети (конф третьего радио на BE7000), и прежний гард пропускал мёртвое имя.
	# Режимы взаимоисключающие: перед новым снимаем противоположные метки (add-if=мимо VPN
	# в VPN_EXCLUDE, force-add-if=целиком в VPN в VPN_FORCE; apply-bypass идемпотентен).
	# wifi_unbypass — легаси-алиас старого фронта (= wifi_split, «вернуть в VPN»).
	wifi_split|wifi_bypass|wifi_force|wifi_unbypass)
		raw=$(urldecode "$(field ifaces)")
		any=0; doneifs=""
		for ifc in $(echo "$raw" | tr ',' ' '); do
			echo "$ifc" | grep -qE '^wl[0-9]+$' || continue
			[ -d "/sys/class/net/$ifc" ] || continue
			case "$act" in
				wifi_bypass) sh "$ENODIA_DIR/apply-bypass.sh" force-del-if "$ifc" >/dev/null 2>&1; sh "$ENODIA_DIR/apply-bypass.sh" add-if "$ifc" >/dev/null 2>&1 ;;
				wifi_force)  sh "$ENODIA_DIR/apply-bypass.sh" del-if "$ifc" >/dev/null 2>&1; sh "$ENODIA_DIR/apply-bypass.sh" force-add-if "$ifc" >/dev/null 2>&1 ;;
				*)           sh "$ENODIA_DIR/apply-bypass.sh" del-if "$ifc" >/dev/null 2>&1; sh "$ENODIA_DIR/apply-bypass.sh" force-del-if "$ifc" >/dev/null 2>&1 ;;
			esac
			any=1; doneifs="$doneifs $ifc"
		done
		[ "$any" = 1 ] || fail "нет валидных Wi-Fi интерфейсов"
		# Сброс — через ct-lib.sh (владелец один): на ядре 4.4 утилиты conntrack в прошивке нет,
		# и голая строка была тихим no-op — режим Wi-Fi менялся только для НОВЫХ соединений.
		ENODIA_DIR="$ENODIA_DIR"; if [ -f "$ENODIA_DIR/ct-lib.sh" ]; then . "$ENODIA_DIR/ct-lib.sh"; fi
		if command -v ct_flush >/dev/null 2>&1; then ct_flush; else conntrack -F >/dev/null 2>&1; fi
		# Слова — те же, что у сегментов экрана сетей (и у гостевой в apply-bypass.sh): тост переводится целиком.
		# Имена интерфейсов в тост не кладём — человек выбирал СЕТЬ, а не wlN.
		w=$(case "$act" in wifi_bypass) echo "мимо VPN";; wifi_force) echo "целиком в VPN";; *) echo "по правилам";; esac)
		printf '{"ok":true,"code":0,"msg":"Wi-Fi → %s"}\n' "$w"; exit 0 ;;
	# Правило сети, которой НЕТ В ЭФИРЕ: интерфейса у неё нет, панель знает только строку хранилища (`offair` в
	# section=wifi). Строку проверяет и снимает владелец хранилища (apply-bypass.sh forget-if: отказ, если её нет);
	# здесь — только форма: одна строка, не пустая, не длиннее имени сети с запасом. Вывод движка в тост не идёт:
	# сборка VPN_FORCE печатает свою служебную строку, и тост читался бы логом; отказ — последней строкой (причина).
	wifi_forget)
		key=$(urldecode "$(field key)")
		[ -n "$key" ] || fail "нет имени сети"
		one_line "$key" || fail "имя сети — одной строкой"
		[ "${#key}" -le 200 ] || fail "слишком длинное имя сети"
		out=$(sh "$ENODIA_DIR/apply-bypass.sh" forget-if "$key" 2>&1) || fail "$(wf_why "$out")"
		printf '{"ok":true,"code":0,"msg":"правило сети снято"}\n'; exit 0 ;;
	# Гостевая 192.168.33.0/24 — те же 3 режима. guest_unbypass — легаси-алиас (= guest_split). Тост — своими словами,
	# как у сетей: весь вывод движка (`run`) нёс служебную строку сборки VPN_FORCE («[apply-bypass] force(в VPN): ip=0, …»)
	# перед итогом, и тост читался логом. Отказ — последней строкой вывода (причина).
	guest_split|guest_unbypass|guest_bypass|guest_force)
		case "$act" in
			guest_bypass) g1=force-guest-off; g2=guest-on;       w="мимо VPN" ;;
			guest_force)  g1=guest-off;       g2=force-guest-on; w="целиком в VPN" ;;
			*)            g1=force-guest-off; g2=guest-off;      w="по правилам" ;;
		esac
		sh "$ENODIA_DIR/apply-bypass.sh" "$g1" >/dev/null 2>&1
		out=$(sh "$ENODIA_DIR/apply-bypass.sh" "$g2" 2>&1) || fail "$(wf_why "$out")"
		printf '{"ok":true,"code":0,"msg":"гостевая сеть → %s"}\n' "$w"; exit 0 ;;

	# --- Уведомления ----------------------------------------------------------
	notify_on)  rm -f "$ENODIA_STATE/.notify-off"; printf '{"ok":true,"code":0,"msg":"Уведомления включены"}\n'; exit 0 ;;
	notify_off) : > "$ENODIA_STATE/.notify-off"; printf '{"ok":true,"code":0,"msg":"Уведомления выключены"}\n'; exit 0 ;;
	# «О чём писать»: письма по ПОВОДАМ. Классы и формат файла выбора знает events.sh — CGI в него не лезет, как и в журнал.
	# Код 1 у events.sh — это usage СТАРОЙ копии (верба нет): «обновите», а не её английская строка в тосте. Свои отказы новый
	# events.sh отдаёт другими кодами (2 · 4 · 5) и своими словами — сбой записи не читается как «старый роутер».
	notify_mail)
		[ -f "$ENODIA_DIR/events.sh" ] || fail "выбор писем недоступен — обновите скрипты роутера"
		cls=$(field cls)
		case "$(field on)" in 1) w=on ;; 0) w=off ;; *) fail "не понял выбор: нужно 1 или 0" ;; esac
		out=$(sh "$ENODIA_DIR/events.sh" mail "$cls" "$w" 2>&1); rc=$?
		[ "$rc" = 1 ] && fail "выбор писем по поводам недоступен — обновите скрипты роутера"
		[ "$rc" = 0 ] || fail "$(printf '%s' "$out" | tail -n 1 | jesc 200)"
		printf '{"ok":true,"code":0,"msg":"Выбор писем сохранён"}\n'; exit 0 ;;
	notify_test)
		# Почту настраивает сама панель (форма «Уведомления»), установщик с ПК её больше не трогает. Полнота — ВСЕ ЧЕТЫРЕ поля, что
		# требует notify.sh: проверка одного пароля пропускала пустой логин или адрес, и notify.sh отвечал «не настроено» (код 3).
		[ -s "$ENODIA_STATE/notify.conf" ] || fail "почта не настроена — заполните форму настройки почты и сохраните"
		for _nk in SMTP_HOST SMTP_USER SMTP_PASS MAIL_TO; do
			grep -q "^$_nk=." "$ENODIA_STATE/notify.conf" 2>/dev/null || fail "настройки почты неполные — нужны сервер, логин, пароль и адрес получателя"
		done
		# Тема — в форме «КОД: …»: ровно её `notify.sh` прогоняет через router_relabel и подставляет
		# РЕАЛЬНУЮ модель. Без двоеточия тестер с AX3600 получал письмо «BE7000 web test» — проверка
		# почты первым делом сообщала о чужом роутере.
		raw=$(sh "$ENODIA_DIR/notify.sh" 'BE7000: web test' 'Panel test email - notifications work.' 2>&1); code=$?
		if [ "$code" -eq 0 ]; then
			printf '{"ok":true,"code":0,"msg":"Письмо отправлено (250 queued) — проверьте почту и Спам"}\n'
		elif [ "$code" -eq 3 ]; then
			# Конфиг выше найден и строки полей непусты, а notify.sh ответил «не настроено»: после `. notify.conf` значение
			# всё же пусто (ручная правка вида `SMTP_USER=""`, повтор строки с пустым значением) либо разошёлся ENODIA_STATE.
			# «SMTP отказ» тут был бы неправдой о сервере, «обновите систему» — неверным советом (ревью шага 3c-2, круг 2).
			printf '{"ok":false,"code":3,"msg":"Письмо не ушло: настройки почты не читаются — пересохраните форму настройки почты"}\n'
		else
			m=$(printf '%s' "$raw" | jesc 400)
			printf '{"ok":false,"code":%s,"msg":"SMTP отказ: %s"}\n' "$code" "$m"
		fi
		exit 0 ;;

	# --- Настройка почты из панели. notify.conf СОРСИТСЯ (`. notify.conf`) → пишем
	# БЕЗ кавычек (как десктоп), но СТРОГО валидируем поля: пароль без пробелов/шелл-
	# метасимволов (RHS присваивания не сплитится/не глобится, но пробел/`;`/`$`/бэктик
	# сломали бы sourcing/инъекция). Пустой пароль → сохраняем ПРЕЖНИЙ (не затираем).
	# ⚠️ пароль идёт по LAN в открытом HTTP — фронт предупреждает.
	write_notify_conf)
		host=$(urldecode "$(field host)"); port=$(urldecode "$(field port)")
		user=$(urldecode "$(field user)"); to=$(urldecode "$(field to)")
		pass=$(urldecode "$(field pass)"); tls=$(field tls)
		[ -n "$host" ] || host=smtp.yandex.ru
		echo "$host" | grep -qE '^[A-Za-z0-9.-]+$'                  || fail "SMTP_HOST: только буквы/цифры/точки/дефис"
		echo "$port" | grep -qE '^[0-9]+$'                         || port=465
		echo "$user" | grep -qE '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$' || fail "SMTP_USER: нужен email"
		echo "$to"   | grep -qE '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$' || fail "MAIL_TO: нужен email"
		# Шифрование: implicit (465, сразу TLS) / starttls (587/25, апгрейд) / auto (по порту в notify.sh).
		case "$tls" in implicit|starttls) ;; *) tls=auto ;; esac
		if [ -n "$pass" ]; then
			# Установщик с ПК почту больше не настраивает — прежний совет «задай там» вёл в никуда.
			echo "$pass" | grep -qE '^[A-Za-z0-9._@!#%^*+=:~-]+$' || fail "пароль: только латиница, цифры и знаки ._@!#%^*+=:~- — без пробелов и кавычек"
		else
			pass=$(sed -n 's/^SMTP_PASS=//p' "$ENODIA_STATE/notify.conf" 2>/dev/null | head -1)
			[ -n "$pass" ] || fail "пароль пуст и прежнего нет — введите пароль приложения"
		fi
		{ echo "# notify.conf — записан веб-панелью"; echo "SMTP_HOST=$host"; echo "SMTP_PORT=$port"; echo "SMTP_TLS=$tls";
		  echo "SMTP_USER=$user"; echo "SMTP_PASS=$pass"; echo "MAIL_TO=$to"; } > "$ENODIA_STATE/notify.conf.new" \
			&& mv "$ENODIA_STATE/notify.conf.new" "$ENODIA_STATE/notify.conf" && chmod 600 "$ENODIA_STATE/notify.conf" \
			|| { rm -f "$ENODIA_STATE/notify.conf.new"; fail "не удалось записать notify.conf"; }
		printf '{"ok":true,"code":0,"msg":"Почта сохранена (%s) — отправьте тест-письмо"}\n' "$user"; exit 0 ;;

	# --- Центр уведомлений: журнал событий. Читается через data?section=events;
	# здесь только две записи — отметка «прочитано» (одна на весь журнал) и очистка.
	# Формат хранения знает events.sh, CGI в него не лезет.
	events_read|events_clear)
		[ -f "$ENODIA_DIR/events.sh" ] || fail "журнал событий недоступен — обновите скрипты роутера"
		case "$act" in
			# До какого события прочитано — отметка самого свежего ПОКАЗАННОГО (панель шаг 7b); нет поля — «до сейчас», как раньше.
			# Сколько ОСТАЛОСЬ непрочитанным — ответом роутера: панель ставит колокольчику его, а не свой ноль (события с отметкой из
			# будущего после отката часов остаются непрочитанными, и нарисованный ноль «рос» бы обратно каждый опрос).
			events_read)  _et=$(field ts); case "$_et" in *[!0-9]*) _et= ;; esac
			              case "$(sh "$ENODIA_DIR/events.sh" mark-read $_et 2>/dev/null)" in *'"ok":false'*) fail "не удалось отметить прочитанным" ;; esac
			              _eu=$(sh "$ENODIA_DIR/events.sh" unread 2>/dev/null); case "$_eu" in ''|*[!0-9]*) _eu= ;; esac
			              printf '{"ok":true,"code":0,"msg":"Отмечено прочитанным"%s}\n' "${_eu:+,\"unread\":$_eu}" ;;
			events_clear) sh "$ENODIA_DIR/events.sh" clear     >/dev/null 2>&1; printf '{"ok":true,"code":0,"msg":"Журнал событий очищен"}\n' ;;
		esac
		exit 0 ;;

	# --- Режим VPN: авто-failover (две оси) — простые записи флагов (туннель НЕ трогают,
	# меняют лишь поведение watchdog). home без .failover-home → ставим текущий .active.
	set_failover)
		mode=$(field mode); esc=$(field esc)
		case "$mode" in off|sticky|home) ;; *) fail "режим: off|sticky|home" ;; esac
		case "$esc"  in cross|direct) ;; *) esc=cross ;; esac
		echo "$mode" > "$ENODIA_STATE/.failover-mode"
		echo "$esc"  > "$ENODIA_STATE/.failover-escalate"
		if [ "$mode" = home ] && [ ! -s "$ENODIA_STATE/.failover-home" ]; then
			a=$(cat "$ENODIA_STATE/.active" 2>/dev/null | tr -d ' \r\n'); [ -n "$a" ] && echo "$a" > "$ENODIA_STATE/.failover-home"
		fi
		printf '{"ok":true,"code":0,"msg":"Failover: режим %s, при исчерпании протокола — %s"}\n' "$mode" "$esc"; exit 0 ;;
	# full-tunnel («весь трафик через VPN») — apply-bypass безопасен (safety_off снимает).
	full_tunnel_on)  run apply-bypass.sh full-tunnel on ;;
	full_tunnel_off) run apply-bypass.sh full-tunnel off ;;

	# --- Списки IP: прежние вербы iplist_update / set_iplist_source / set_iplist_custom_mode /
	# upload_custom_iplist СНЯТЫ (28.09.2026): панель их не зовёт с тех пор, как источники живут в менеджере
	# списков (lists-update.sh, реестр tunnel-cidr). Писали они легаси-iplist.conf, который реестр читает ОДИН раз
	# — при миграции (обещание «применится при обновлении» было ложным), и iplist.custom в обход менеджера: у
	# источников свои вербы src_add_blob/src_edit_blob. Поверхность без единого вызывателя.

	# NB: верб `proto_install` (фиксированные наборы `awg-xray` и т.п.) отсюда СНЯТ. Панель его не
	# звала с тех пор, как наборы заменила карточка «Компоненты», а держать в CGI ветку, которая
	# качает мегабайты и переключает несущую, но никем не вызывается, — лишняя поверхность.
	# Сам `proto-install.sh` жив и нужен: его зовут CLI и `enodia.py` напрямую по SSH, минуя панель.

	# --- Компоненты à la carte (packages.sh): ОДИН план «поставить X, снять Y» одним прогоном.
	# Почему не два действия install/remove: между прогонами роутер остаётся без транспорта, а на
	# 20-МБ флеше замена (снять Xray → поставить Hysteria2) двумя заходами вообще не влезает.
	# Прогресс и лок — ТЕ ЖЕ .proto-install.{state,log} + /tmp/enodia-proto-install.lock, что у смены
	# набора: фронт уже умеет их опрашивать, а «две установки разом» лок и придуман не пускать.
	# «Перезапустить» у строки «работает прежняя сборка»: живые процессы связки — на установленную сборку, каждый через своего
	# владельца (разбор — packages.sh::cmd_restart). Фоном, под тем же локом и статусом, что «Применить»: ход и итог экран
	# показывает своей «Последней операцией». «Нечего перезапускать» — тоже ответ движка, синхронного отказа тут нет.
	# `u` — owners whose interruption the confirmation named (the screen's `rst_units`): the engine touches only those (consent, see
	# packages.sh::rst_agreed). Empty `u` from the panel would mean «everything», so it is refused rather than passed on.
	# DECODE FIRST, then the whitelist (the trap disk_clean below describes): the panel sends the list through encodeURIComponent,
	# and its commas arrive as %2C — a restart of two owners was refused every time (review of bins-2026-10, round 2).
	pkg_restart)
		prs=$(urldecode "$(field p)"); pru=$(urldecode "$(field u)")
		case "$prs" in ''|*[!a-z0-9,]*) fail "недопустимый список компонентов" ;; esac
		case "$pru" in ''|*[!a-z0-9,-]*) fail "недопустимый список перезапускаемого" ;; esac
		[ -f "$ENODIA_DIR/packages.sh" ] || fail "packages.sh не установлен (обновите скрипты с GitHub)"
		sh "$ENODIA_DIR/packages.sh" busy >/dev/null 2>&1 && fail "операция с компонентами уже идёт — дождитесь её конца"
		sh "$ENODIA_DIR/gh-update.sh" upd-busy >/dev/null 2>&1 && fail "идёт обновление системы — дождитесь его конца"
		pkg_spawn "$(printf -- '-\t-\t-\t%s' "$prs")" restart "$prs" "$pru"
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "Перезапуск запущен — ход виден на экране «Компоненты»"
		exit 0 ;;
	pkg_apply)
		pins=$(field ins); pdel=$(field del)
		# «-» = ПУСТАЯ сторона плана (так шлёт панель, так же зовётся CLI). Разбираем ДО whitelist'а:
		# дефис не входит в [a-z0-9,] и ловился как «недопустимый список», из-за чего любой план
		# в одну сторону («только поставить» / «только снять») отвергался на входе, а проходила
		# лишь замена сразу в обе. Поймано кликом по живой панели.
		[ "$pins" = "-" ] && pins=""
		[ "$pdel" = "-" ] && pdel=""
		# В shell уходит АРГУМЕНТОМ — только имена связок через запятую, никакого urldecode.
		case "$pins" in *[!a-z0-9,]*) fail "недопустимый список компонентов" ;; esac
		case "$pdel" in *[!a-z0-9,]*) fail "недопустимый список компонентов" ;; esac
		[ -n "$pins$pdel" ] || fail "план пуст — нечего применять"
		pkg_bg "${pins:--}" "${pdel:--}" "Изменение компонентов запущено. Идёт удаление и скачивание — ход виден на экране «Компоненты»." ;;

	# --- ЧИСТКА ФЛЕША (clean.sh — единственная истина «что считается мусором»).
	# Синхронно, а не через pkg_bg: снос пары каталогов занимает доли секунды и НИЧЕГО не
	# качает, значит ни лок установки, ни экран прогресса тут не нужны — а занять общий лок
	# значило бы блокировать установку компонентов на ровном месте.
	# Группы приходят с фронта галочками и проверяются ЗДЕСЬ по белому списку: аргумент уходит
	# в sh, а «снимки» и «логи» — разной цены операции (снимок = страховка на мёртвый источник),
	# поэтому подразумевать их по умолчанию нельзя.
	disk_clean)
		[ -f "$ENODIA_DIR/clean.sh" ] || fail "clean.sh не установлен (обновите скрипты с GitHub)"
		# ГРАБЛЯ (поймана кликом по живой панели): значение ОБЯЗАНО пройти urldecode. Общий
		# фронтовый postAction() гонит параметры через encodeURIComponent, а тот кодирует
		# запятую как %2C — `tr ',' ' '` разделителя не находит и весь список приезжает ОДНИМ
		# токеном «junk%2Cramlogs» ⇒ вечное «неизвестная группа чистки». Соседний pkg_apply
		# работает без декода лишь потому, что собирает тело строкой ВРУЧНУЮ, минуя postAction;
		# декодировать здесь надёжнее, чем полагаться на способ кодирования у вызывающего.
		# Порядок «декод → whitelist» обязателен: проверяем то, что реально уйдёт в sh.
		dgr=$(urldecode "$(field groups)")
		dsel=""
		for g in $(echo "$dgr" | tr ',' ' '); do
			case "$g" in junk|snaps|ramlogs|stocklogs) dsel="$dsel $g" ;; *) fail "неизвестная группа чистки" ;; esac
		done
		[ -n "$dsel" ] || fail "не выбрано, что чистить"
		dout=$(sh "$ENODIA_DIR/clean.sh" clean $dsel 2>/dev/null | grep '^{' | tail -1)
		[ -n "$dout" ] || fail "чистка не отработала"
		printf '%s\n' "$dout"; exit 0 ;;

	# --- ВНЕШНИЙ НАКОПИТЕЛЬ (usb-offload.sh — единственная истина; переезд с проверкой копии).
	# Синхронно, как disk_clean: движок копирует 13 МБ максимум (секунды), НИЧЕГО не качает и
	# несущую не переподнимает, поэтому общий лок установки тут занимать не за что. Прогресса
	# нет намеренно — операция короче, чем время на его отрисовку.
	# Ответ отдаём словами ДВИЖКА (его stdout), а не своими: он один знает, какой бинарь не
	# поехал и почему («не запускается с этой ФС» ≠ «не хватило места»), а вторая формулировка
	# в CGI разошлась бы с первой на первой же правке.
	store_enable|store_disable|store_forget)
		[ -f "$ENODIA_DIR/usb-offload.sh" ] || fail "usb-offload.sh не установлен (обновите скрипты с GitHub)"
		# Устройство приходит с фронта только у enable (выбор из списка воткнутого) и уходит
		# АРГУМЕНТОМ в sh ⇒ жёсткий whitelist: только /dev/sdXN, ничего другого.
		sdev=$(urldecode "$(field dev)")
		case "$sdev" in
			"") : ;;
			/dev/sd[a-z]|/dev/sd[a-z][0-9]|/dev/sd[a-z][0-9][0-9]) : ;;
			*) fail "неизвестное устройство" ;;
		esac
		# forget — выход из «включён, но не найден» (накопитель потерян насовсем): маркер снимается без
		# переноса, итог с ЦЕНОЙ (что стало неустановленным) движок кладёт последней строкой.
		case "$act" in
			store_enable) sout=$(sh "$ENODIA_DIR/usb-offload.sh" enable $sdev 2>&1); src=$? ;;
			store_forget) sout=$(sh "$ENODIA_DIR/usb-offload.sh" forget 2>&1); src=$? ;;
			*)            sout=$(sh "$ENODIA_DIR/usb-offload.sh" disable 2>&1); src=$? ;;
		esac
		# Многострочный отчёт движка в JSON не влезает — берём последнюю содержательную строку:
		# у обоих вербов там либо итог, либо причина отказа. Эскейп кавычек/бэкслешей — тем же
		# выражением, что в run(): в тексте движка попадаются пути, а не только буквы.
		smsg=$(printf '%s\n' "$sout" | grep -v '^ *$' | tail -1 | jesc 500)
		[ -n "$smsg" ] || smsg="накопитель: готово"
		[ "$src" = 0 ] || fail "$smsg"
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$smsg"; exit 0 ;;

	# --- РЕЖИМ РАСКЛАДКИ (usb-offload.sh mode data|bins|full).
	# ЗАПУСК ОТВЯЗАННЫЙ, и это не «на всякий случай»: переезд кончается перезапуском панели с
	# НОВОГО места (docroot uhttpd — это $ENODIA_DIR/web, а он переезжает), то есть наш родитель
	# будет убит посреди запроса. Ответить обязаны ДО этого — как при purge.
	# Отчёт движка кладём в лог: в фоне stdout уходит в /dev/null (start-stop-daemon -b), а
	# разбирать «почему не переехало» по пустому месту невозможно.
	store_mode)
		[ -f "$ENODIA_DIR/usb-offload.sh" ] || fail "usb-offload.sh не установлен (обновите скрипты с GitHub)"
		smd=$(field mode)
		case "$smd" in data|bins|full) : ;; *) fail "неизвестный режим" ;; esac
		sdev=$(urldecode "$(field dev)")
		case "$sdev" in
			"") : ;;
			/dev/sd[a-z]|/dev/sd[a-z][0-9]|/dev/sd[a-z][0-9][0-9]) : ;;
			*) fail "неизвестное устройство" ;;
		esac
		# Уже идёт? Судим по ЖИВОМУ процессу: pid-файл лежит в /tmp и переживает убитый движок,
		# а «переключение уже идёт» навсегда — это кнопка, залипшая до ребута (приём pkg_bg).
		# Ответ — у владельца (daemon-lib.sh::store_mode_alive); шим — прежнее «жив ли pid».
		if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi
		command -v store_mode_alive >/dev/null 2>&1 || store_mode_alive() {
			smp=$(cat /tmp/enodia-store-mode.pid 2>/dev/null | tr -cd '0-9'); [ -n "$smp" ] && kill -0 "$smp" 2>/dev/null; }
		store_mode_alive && fail "переключение раскладки уже идёт"
		spawn_bg /tmp/enodia-store-mode.pid -c \
			"sh '$ENODIA_DIR/usb-offload.sh' mode $smd $sdev > /tmp/enodia-store-mode.log 2>&1"
		if [ "$smd" = full ]; then
			printf '{"ok":true,"code":0,"msg":"Переезд на накопитель запущен. Панель ненадолго исчезнет и поднимется уже с накопителя."}\n'
		else
			printf '{"ok":true,"code":0,"msg":"Возврат на флеш роутера запущен. Панель ненадолго исчезнет и поднимется с флеша."}\n'
		fi
		exit 0 ;;

	# --- ПОИМЁННАЯ РЕЗИДЕНТНОСТЬ («этот бинарь держать на роутере», usb-offload.sh place).
	# Отдельное действие от store_enable/store_disable: те про накопитель ЦЕЛИКОМ, это про один
	# бинарь. Зависимости, гард места и запрет «отпустить hev из-под закреплённого xray» живут в
	# движке — здесь их копии нет.
	store_place)
		[ -f "$ENODIA_DIR/usb-offload.sh" ] || fail "usb-offload.sh не установлен (обновите скрипты с GitHub)"
		# Оба значения уходят АРГУМЕНТАМИ в sh ⇒ санитайз по ФОРМЕ. Членство в списке «кого можно
		# селить» тут НЕ проверяем: реестр живёт в store-lib.sh, и вторая его копия разошлась бы
		# с первой на первом же новом протоколе — движок ответит отказом сам.
		sbin=$(urldecode "$(field bin)")
		sto=$(urldecode "$(field to)")
		case "$sbin" in ''|*[!a-z0-9-]*) fail "неизвестный компонент" ;; esac
		case "$sto" in router|store) ;; *) fail "неизвестное направление" ;; esac
		# ПОТОКИ РАЗДЕЛЯЕМ, а не сливаем 2>&1: у движка есть путь, где отказ наступает ПОСЛЕ
		# успешных строк («закрепление записано, но перенести не вышло»). На слитом потоке
		# head -1 отдавал бы «Закреплено за роутером: …» — то есть панель показывала бы
		# ПОЛОЖИТЕЛЬНУЮ фразу под красным тостом. Диагноз всегда в stderr, итог — в stdout.
		_pe="/tmp/enodia-place-err.$$"
		sout=$(sh "$ENODIA_DIR/usb-offload.sh" place "$sbin" "$sto" 2>"$_pe"); src=$?
		serr=$(grep -v '^ *$' "$_pe" 2>/dev/null | head -1)
		rm -f "$_pe" 2>/dev/null
		# У УСПЕХА итог в ПОСЛЕДНЕЙ строке stdout («свободно на /data столько-то» — ровно то, ради
		# чего кнопку жали). У ОТКАЗА — ПЕРВАЯ строка stderr: там диагноз с числами, вторая уже
		# совет. Пустой stderr при ненулевом коде (движка нет, шелл упал) — падаем на stdout.
		if [ "$src" = 0 ]; then smsg=$(printf '%s\n' "$sout" | grep -v '^ *$' | tail -1 | jesc 500)
		else                    smsg=$(printf '%s\n' "${serr:-$sout}" | grep -v '^ *$' | head -1 | jesc 500); fi
		[ -n "$smsg" ] || smsg="готово"
		[ "$src" = 0 ] || fail "$smsg"
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$smsg"; exit 0 ;;

	# --- УДАЛЕНИЕ (uninstall.sh — единственная истина; своей логики снятия здесь НЕТ).
	# Два уровня: deactivate (снять VPN, панель и файлы оставить) и purge (стереть всё).
	# ТРИ вещи, без которых это действие опасно:
	#  1) ФРАЗА-ПОДТВЕРЖДЕНИЕ приезжает с фронта и сверяется ЗДЕСЬ: одного «клика по красной
	#     кнопке» для необратимой операции мало, а проверка только во фронте не защищает вовсе;
	#  2) запуск ОТВЯЗАННЫЙ (spawn_bg): purge гасит наш же uhttpd — доработать в рамках запроса
	#     мы не успеем, CGI обязан ответить ДО того, как его убьют;
	#  3) ответ отдаём СРАЗУ и честно говорим, что панель сейчас исчезнет (при purge) — иначе
	#     человек видит «сеть недоступна» и думает, что сломал роутер.
	uninstall_run)
		[ -f "$ENODIA_DIR/uninstall.sh" ] || fail "uninstall.sh не установлен (обновите скрипты с GitHub)"
		umode=$(field mode)
		uphrase=$(urldecode "$(field phrase)")
		case "$umode" in deactivate|purge) : ;; *) fail "неизвестный режим удаления" ;; esac
		# Фраза — РАЗНАЯ на два режима (перепутать уровни страшнее, чем промахнуться кнопкой)
		# и принимается в ОБОИХ языках панели: англоязычному вводить «УДАЛИТЬ ВСЁ» нечем.
		if [ "$umode" = purge ]; then uok1="УДАЛИТЬ ВСЁ"; uok2="DELETE ALL"
		else uok1="ОТКЛЮЧИТЬ"; uok2="TURN OFF"; fi
		{ [ "$uphrase" = "$uok1" ] || [ "$uphrase" = "$uok2" ]; } || fail "фраза подтверждения не совпала — ничего не тронуто"
		ust=$(cat "$ENODIA_STATE/.uninstall.state" 2>/dev/null | tr -d ' \r\n')
		# RUNNING без ЖИВОГО процесса = осиротевший статус: файл лежит на флеше и переживает всё,
		# поэтому одна прерванная попытка (ребут посреди деактивации) блокировала бы кнопку
		# НАВСЕГДА, а другого способа снять VPN из панели нет. Тот же приём, что в pkg_bg выше.
		# «ИДЁТ ЛИ» — ТЕМ ЖЕ ОТВЕТОМ, ЧТО У ПЛАНА (`uninstall.sh plan` → `running`): держатель — процесс ИМЕННО uninstall.sh. По одному
		# «жив ли» pid, переиспользованный чужим демоном после обрыва, держал бы «удаление уже идёт», пока экран предлагает «Повторить».
		if [ "$ust" = RUNNING ]; then
			if [ -f "$ENODIA_DIR/daemon-lib.sh" ]; then . "$ENODIA_DIR/daemon-lib.sh"; fi
			command -v pid_runs >/dev/null 2>&1 || pid_runs() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
			command -v uninstall_alive >/dev/null 2>&1 || uninstall_alive() {
				upid=$(cat /tmp/enodia-uninstall.pid 2>/dev/null | tr -cd '0-9'); pid_runs "$upid" 'uninstall\.sh (deactivate|purge)'; }
			uninstall_alive && fail "удаление уже идёт"
		fi
		# Идёт установка или обновление кода — снимать нельзя (разбор у uninstall.sh::un_busy); причина — ДО запуска, словами: сам
		# uninstall.sh откажет в фоне, и экран увидел бы лишь FAIL. Занят = код 0 И названа причина: старый uninstall.sh без верба
		# `busy` отвечает usage с кодом 2, а пустой ответ с нулём (обрезанный файл) — не повод запирать «Удалить».
		ubw=$(sh "$ENODIA_DIR/uninstall.sh" busy 2>/dev/null) && [ -n "$ubw" ] && fail "$ubw — дождитесь конца и повторите"
		# «ИДЁТ» — ДО запуска и атомарно: в файле лежит вердикт ПРОШЛОГО снятия (он на флеше и переживает всё), и опрос
		# экрана, пришедший раньше, чем сам скрипт перепишет строку, прочитал бы прежний OK как итог этого запуска (раньше
		# панель гадала задержкой первого опроса). Запись — рядом + `mv` (C105).
		echo RUNNING > "$ENODIA_STATE/.uninstall.state.new" && mv -f "$ENODIA_STATE/.uninstall.state.new" "$ENODIA_STATE/.uninstall.state"
		# Режим — рядом с пидфайлом и тоже ДО запуска: план отдаёт его экрану, открытому посреди снятия (`mode`), — иначе тот не отличал
		# отключение от полного удаления (разбор у uninstall.sh::cmd_plan).
		echo "$umode" > /tmp/enodia-uninstall.mode.new && mv -f /tmp/enodia-uninstall.mode.new /tmp/enodia-uninstall.mode
		spawn_bg /tmp/enodia-uninstall.pid "$ENODIA_DIR/uninstall.sh" "$umode"
		if [ "$umode" = purge ]; then
			# Путь отчёта — тот, куда его пишет uninstall.sh (`REPORT`, на томе кода); прежний `/data/…` был литералом другого
			# тома (на BE10000 — чужой cfg), и человек искал отчёт там, где его нет.
			printf '{"ok":true,"code":0,"msg":"Полное удаление запущено. Панель сейчас закроется — это нормально. Отчёт останется в /data/usr/enodia-uninstall.log"}\n'
		else
			printf '{"ok":true,"code":0,"msg":"Деактивация запущена. VPN снимется, панель останется работать."}\n'
		fi
		exit 0 ;;

	# --- Апдейтер с GitHub (Ф4). Проверку версии и сверку целостности экран «Обновление» спрашивает секциями data
	# (gh_check / gh_verify: ответ — вердикт, ничего не меняет); здесь — то, что МЕНЯЕТ файлы: обновление и откат.
	gh_apply_scripts)
		[ -f "$ENODIA_DIR/gh-update.sh" ] || fail "gh-update.sh не установлен"
		# «Идёт ли» — у апдейтера (живой держатель по пидфайлу фона): строка RUNNING, пережившая перезагрузку посреди
		# обновления, иначе запирала бы кнопку навсегда. Старая копия верба не знает (код 2) — тогда не судим.
		sh "$ENODIA_DIR/gh-update.sh" upd-busy >/dev/null 2>&1 && fail "обновление уже идёт"
		# Операция с компонентами идёт — обновление заменило бы движок и манифест бинарей под ней (ревью ветки bins-2026-10, круг 3).
		[ -f "$ENODIA_DIR/packages.sh" ] && sh "$ENODIA_DIR/packages.sh" busy >/dev/null 2>&1 && fail "идёт операция с компонентами — дождитесь её конца"
		# ИТОГ ПИШЕМ (OK | FAIL), а не «DONE»: экран «Обновление» показывает, чем кончилось, — прежний DONE ставился и на
		# провале, и «последнее обновление — готово» было бы враньём. Запись атомарная (рядом + `mv`): читатель обрезанного
		# файла видит «IDLE» (разбор у packages.sh::set_state). Лок в /tmp — примета «идёт» для дампа.
		# Самообновления апдейтера (`self`) перед обновлением БОЛЬШЕ НЕТ: код едет одним подписанным пакетом, и его установщик
		# берётся ИЗ ПАКЕТА, — прежний шаг и был тем «старый роутер обязан уметь завтрашнее», от которого уходили.
		echo RUNNING > "$ENODIA_STATE/.gh-update.state.new" && mv -f "$ENODIA_STATE/.gh-update.state.new" "$ENODIA_STATE/.gh-update.state"
		spawn_bg /tmp/enodia-gh-update.pid -c "touch /tmp/enodia-gh-update.lock; if sh '$ENODIA_DIR/gh-update.sh' apply >'$ENODIA_STATE/.gh-update.log' 2>&1; then s=OK; else s=FAIL; fi; echo \$s >'$ENODIA_STATE/.gh-update.state.new' && mv -f '$ENODIA_STATE/.gh-update.state.new' '$ENODIA_STATE/.gh-update.state'; rm -f /tmp/enodia-gh-update.lock"
		printf '{"ok":true,"code":0,"msg":"Обновление запущено: пакет скачивается и проверяется подписью, потом ставится. Когда кончится — обновите страницу и примените правила: «Починить правила» или перезагрузка."}\n'; exit 0 ;;
	gh_rollback)
		[ -f "$ENODIA_DIR/gh-update.sh" ] || fail "gh-update.sh не установлен"
		# Откат ПОСРЕДИ обновления перемешал бы два набора файлов (вторая вкладка, страница, открытая до запуска) — гард тот же, что
		# у кнопки обновления (ревью шага 6c, круг 1).
		sh "$ENODIA_DIR/gh-update.sh" upd-busy >/dev/null 2>&1 && fail "идёт обновление — дождитесь его конца"
		[ -f "$ENODIA_DIR/packages.sh" ] && sh "$ENODIA_DIR/packages.sh" busy >/dev/null 2>&1 && fail "идёт операция с компонентами — дождитесь её конца"
		# ИТОГ И ЖУРНАЛ ОТКАТА — в те же файлы, что у обновления (RBOK | RBFAIL): экран «Обновление» показывает последнее действие, и
		# после отката карточка иначе продолжала бы говорить «обновление — готово, панель уже новая» (ревью шага 6c, круг 1).
		# ОТКАТ — ФОНОМ, как обновление: теперь это установка из снимка вместе с установщиком возвращённой версии (cron, бутстрап,
		# переигрыш персиста), а это десятки секунд. Синхронный CGI uhttpd убил бы SIGKILL по потолку или уходу клиента — посреди
		# замены файлов (грабля «uhttpd, потеряв клиента, бьёт CGI SIGKILL»). Держатель «занято» — фон по пидфайлу, состояние RBRUN.
		# Строка начала — в журнал ДО отката: вторая вкладка во время RBRUN иначе показывала бы под «Идёт откат» хвост журнала прошлого
		# обновления (ревью шага 6c, круг 3).
		printf '%s\n' '[rollback] откат к последнему снимку начат' > "$ENODIA_STATE/.gh-update.log" 2>/dev/null
		echo RBRUN > "$ENODIA_STATE/.gh-update.state.new" && mv -f "$ENODIA_STATE/.gh-update.state.new" "$ENODIA_STATE/.gh-update.state"
		spawn_bg /tmp/enodia-gh-update.pid -c "touch /tmp/enodia-gh-update.lock; if sh '$ENODIA_DIR/gh-update.sh' rollback >>'$ENODIA_STATE/.gh-update.log' 2>&1; then s=RBOK; else s=RBFAIL; fi; echo \$s >'$ENODIA_STATE/.gh-update.state.new' && mv -f '$ENODIA_STATE/.gh-update.state.new' '$ENODIA_STATE/.gh-update.state'; rm -f /tmp/enodia-gh-update.lock"
		printf '{"ok":true,"code":0,"msg":"Откат к последнему снимку запущен. Когда кончится — обновите страницу и примените правила: «Починить правила» или перезагрузка."}\n'; exit 0 ;;

	# --- Браузер-свип ByeDPI: применяем стратегии ВЖИВУЮ к боевому ciadpi, а реальный браузер
	# грузит ассеты заблок-сайтов через активный ByeDPI (честнее curl-теста — реальный путь hev/QUIC).
	# Цикл драйвит ФРОНТ (begin → apply×N → end). Возможен ТОЛЬКО когда byedpi несёт трафик (иначе
	# браузер пойдёт мимо десинка = бессмысленно). Стратегия (args) санитизируется тем же charset'ом,
	# что set_byedpi_args (идёт неквотированно в exec ciadpi). По end/протуху lock — исходная восстанавливается.
	# ЦЕЛЬ свипа — slot=2..7 (ДОП-ВЫХОД со своей стратегией) либо пусто (основная несущая). Гард
	# у них РАЗНЫЙ и это принципиально: основной свип требует «byedpi = активный транспорт», а
	# выход живёт своей несущей и при awg-основном, ему нужно лишь «выход включён».
	byedpi_sweep_begin)
		[ -f "$ENODIA_DIR/transport-byedpi.sh" ] || fail "transport-byedpi.sh не установлен (обновите панель)"
		bsw=$(field slot); case "$bsw" in [2-7]) ;; *) bsw="" ;; esac
		if [ -n "$bsw" ]; then
			sh "$ENODIA_DIR/slots.sh" list-enabled 2>/dev/null | grep -q "^$bsw	byedpi	" \
				|| fail "браузер-свип выхода возможен только когда выход ВКЛЮЧЁН"
		else
			[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = byedpi ] || fail "браузер-свип возможен только когда ByeDPI несёт трафик — включите ByeDPI вверху панели"
		fi
		# VPN выключен тумблером — ByeDPI не несёт ни основным транспортом, ни выходом (их сняло «Отключить VPN»; в реестре лишь
		# намерение), а плагин при флаге ciadpi не поднимет: свип мерил бы пустоту.
		vpn_is_off && fail "браузер-свип возможен только когда ByeDPI несёт трафик — VPN сейчас выключен тумблером"
		sh "$ENODIA_DIR/transport-byedpi.sh" sweep-begin "$bsw" >/dev/null 2>&1 \
			&& printf '{"ok":true,"code":0,"msg":"свип начат"}\n' || fail "не удалось начать свип"
		exit 0 ;;
	byedpi_sweep_apply)
		bsw=$(field slot); case "$bsw" in [2-7]) ;; *) bsw="" ;; esac
		if [ -n "$bsw" ]; then
			sh "$ENODIA_DIR/slots.sh" list-enabled 2>/dev/null | grep -q "^$bsw	byedpi	" || fail "выход выключен — свип прерван"
		else
			[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = byedpi ] || fail "ByeDPI не активен — свип прерван"
		fi
		vpn_is_off && fail "VPN выключен — свип прерван"
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -n "$args" ]; then
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_-]+$' || fail "недопустимые символы стратегии"
		fi
		if sh "$ENODIA_DIR/transport-byedpi.sh" sweep-apply "$args" "$bsw" >/dev/null 2>&1; then up=true; else up=false; fi
		printf '{"ok":true,"code":0,"up":%s}\n' "$up"; exit 0 ;;
	byedpi_sweep_end)
		[ -f "$ENODIA_DIR/transport-byedpi.sh" ] || fail "transport-byedpi.sh не установлен"
		bsw=$(field slot); case "$bsw" in [2-7]) ;; *) bsw="" ;; esac
		sh "$ENODIA_DIR/transport-byedpi.sh" sweep-end "$bsw" >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"свип завершён, исходная стратегия восстановлена"}\n'; exit 0 ;;

	# --- Zapret (десинк-direct, nfqws/NFQUEUE) — 5-й ТРАНСПОРТ (взаимоисключающий с туннелем). -----
	# Включение/переключение НА zapret идёт через switch_zapret (выше). Выключение — zapret_off:
	# вернуться на первый ГОТОВЫЙ не-zapret транспорт (приоритет list: awg→xray→hy2→byedpi), а если
	# туннелей нет вовсе (zapret был единственным обходом) — полный teardown zapret → прямой режим. Прежний
	# zapret_toggle убран: он звал zapret.sh on/off, двигавшие .zapret-on БЕЗ .transport →
	# рассинхрон статуса (панель читает .transport). set-cats: категории (whitelist в zapret.sh).
	# args: стратегия nfqws → .zapret-args, идёт НЕквотированно в `exec nfqws … $args` → СТРОГО
	# charset флагов nfqws (+ @ для токенов фейков @tls/@quic), отсекая shell-метасимволы = защита
	# от инъекции. reload перезапускает только nfqws.
	zapret_off)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен (обновите панель)"
		[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = zapret ] || fail "Zapret не активен"
		# Под локом смены, как switch_* (разбор у set_server): обе ветки ниже меняют несущую — switch на готовый туннель или down zapret.
		hold_switch
		# …и «активен ли Zapret» — ЕЩЁ РАЗ, уже под локом (ревью с.97): пока ждали, вкладка или сторож могли сменить его на другой
		# транспорт, и ветки ниже перебили бы чужой выбор — switch на первый готовый поверх выбранного, при выключенном VPN запись
		# `.transport` поверх нового намерения, а без цели `down zapret` (DNS напрямую) и `rm .transport` на живой чужой несущей.
		[ "$(cat "$ENODIA_STATE/.transport" 2>/dev/null | tr -d ' \r\n')" = zapret ] || fail "Zapret уже не активен — транспорт сменили, пока ждали (другая вкладка или сам роутер)"
		# Имя цели берётся из transport.sh list (НЕ пользовательский ввод — только whitelisted
		# транспорты), но всё равно сверяем с белым списком: в shell-команду уходит лишь проверенное.
		tgt=$(sh "$ENODIA_DIR/transport.sh" list 2>/dev/null | grep -vx zapret | head -1)
		case "$tgt" in awg|xray|hy2|byedpi) ;; *) tgt="" ;; esac
		# Нет другого готового транспорта (zapret — единственный обход) → полный teardown zapret-плагина
		# (down: nfqws убит, правила/ipset сняты, DNS на прямой). `vpn-toggle off` СНИМЕТ несущую и сам
		# (с 23.08.2026 он спрашивает `transport.sh marking` и для немаркирующих зовёт down), но эта
		# кнопка про ДРУГОЕ: тумблер «Выключить VPN» снимает ПРОВОДКУ, сохраняя намерение, а здесь
		# человек выключает Zapret СОВСЕМ — значит надо стереть и `.transport`, иначе heal поднимет
		# его обратно на первом же буте. Две семантики, две ветки.
		# «ДОМ» СНИМАЕМ, если им был zapret: человек выключает его СОВСЕМ, а сторож в режиме
		# «резерв + возврат» тянул бы роутер обратно именно туда — против только что высказанной
		# воли. И наоборот, цели `$tgt` дом НЕ назначаем: её выбрал КОД (первый готовый из list),
		# а домашний транспорт — это осознанный выбор человека, иначе он станет случайным.
		[ "$(cat "$ENODIA_STATE/.transport-home" 2>/dev/null | tr -d ' \r\n')" = zapret ] \
			&& rm -f "$ENODIA_STATE/.transport-home" 2>/dev/null
		if [ -n "$tgt" ] && [ -f "$ENODIA_STATE/.vpn-off" ]; then
			# VPN ВЫКЛЮЧЕН ТУМБЛЕРОМ: выбор протокола здесь — не включение (кнопка «Выключить Zapret», а не «Включить VPN»).
			# Несущей Zapret и так нет — её снял `off`; меняем только НАМЕРЕНИЕ (`.transport` вместе с `.zapret-on`, они ходят
			# парой), а поднимет его «Включить VPN». Через switch нельзя: без `--home` он при флаге отказывает (автомат не
			# отменяет выключение), а с `--home` включил бы VPN и назначил домом протокол, который выбрал КОД (28.09.2026).
			echo "$tgt" > "$ENODIA_STATE/.transport"; rm -f "$ENODIA_STATE/.zapret-on" 2>/dev/null
			# Имя протокола — человеческое, у оркестратора (вопрос перед этим звал его «AmneziaWG»); старая копия без верба — идентификатор.
			tlbl=$(sh "$ENODIA_DIR/transport.sh" label "$tgt" 2>/dev/null | head -1)
			case "$tlbl" in ''|*[!A-Za-z0-9]*) tlbl=$tgt ;; esac
			printf '{"ok":true,"code":0,"msg":"Zapret выключен. VPN выключен тумблером — при включении поднимется %s."}\n' "$tlbl"; exit 0
		elif [ -n "$tgt" ]; then
			run transport.sh switch "$tgt"
		else
			# down zapret по контракту НЕ трогает .transport → панель (читает .transport) продолжала бы
			# рисовать zapret ВКЛ, а heal на буте воскресил бы его (transport.sh up zapret). Сбрасываем
			# .transport и .zapret-on здесь. run не годится (он exit'ает) — эмитим JSON вручную.
			cap_run transport.sh down zapret; code=$?; raw=$CAP_OUT
			rm -f "$ENODIA_STATE/.transport" "$ENODIA_STATE/.zapret-on" 2>/dev/null
			msg=$(printf '%s' "$raw" | jesc 800)
			printf '{"ok":%s,"code":%s,"msg":"Zapret выключен, прямой режим. %s"}\n' "$([ "$code" -eq 0 ] && echo true || echo false)" "$code" "$msg"
			exit 0
		fi ;;
	set_zapret_args)
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -z "$args" ]; then
			rm -f "$ENODIA_STATE/.zapret-args"
			msg="Стратегия сброшена на дефолт"
		else
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_@-]+$' || fail "недопустимые символы — разрешены флаги nfqws (буквы, цифры, пробел, + , . : / = _ @ -)"
			printf '%s\n' "$args" > "$ENODIA_STATE/.zapret-args.new" && mv "$ENODIA_STATE/.zapret-args.new" "$ENODIA_STATE/.zapret-args" || fail "не удалось сохранить стратегию"
			msg="Стратегия сохранена"
		fi
		if zt_wired; then
			sh "$ENODIA_DIR/zapret.sh" reload >/dev/null 2>&1 && msg="$msg, nfqws перезапущен" || msg="$msg, но перезапуск nfqws не удался (см. статус)"
		else
			msg="$msg (применится при включении десинка)"
		fi
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$msg"; exit 0 ;;

	# ИМПОРТ ДЕСКТОПНОГО КОНФИГА. Ничего НЕ СОХРАНЯЕТ: отдаёт разобранную строку и отчёт, а
	# кладёт её в поле панель — сохраняет человек кнопкой «Сохранить». Иначе вставка чужого
	# конфига молча меняла бы живую стратегию, и «я только посмотреть» стоило бы связи.
	zapret_import)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен (обновите скрипты роутера)"
		cfg=$(urldecode "$(field cfg)")
		[ -n "$cfg" ] || fail "пусто — вставьте текст конфига с десктопа"
		# ДВА ПОТОКА ОДНОЙ КОМАНДЫ: верб печатает флаги в stdout, отчёт человеку — в stderr.
		# Временных файлов не заводим (лишнее имя в /tmp = лишняя маска уборки): отчётные строки
		# помечены префиксом [import], и разделение по нему однозначно.
		raw=$(printf '%s' "$cfg" | sh "$ENODIA_DIR/zapret.sh" import 2>&1)
		# Результат берём ПО ТОКЕНУ `ARGS:`, а не «первую строку без [import]»: `log()` плагина
		# печатает в тот же stdout, и любая его строка иначе уехала бы в поле стратегии.
		iargs=$(printf '%s\n' "$raw" | sed -n 's/^ARGS://p' | head -1)
		irep=$(printf '%s\n' "$raw" | grep '^\[import\]' | jesc 1200)
		[ -n "$iargs" ] || fail "разобрать не вышло: ${irep:-конфиг не похож на zapret}"
		# ОБРЕЗКА ОБЯЗАНА БЫТЬ ГРОМКОЙ. Конвертированный конфиг Flowseal из шести секций — это около
		# тысячи символов, и прежний потолок 700 отрезал бы хвост МОЛЧА: человек сохранил бы
		# половину стратегии, не заметив. Потолок поднят, а если строка всё же длиннее — говорим об
		# этом прямо, вместо того чтобы отдать огрызок как результат.
		ilen=$(printf '%s' "$iargs" | wc -c | tr -d ' ')
		[ "${ilen:-0}" -gt 4000 ] && irep="$irep · ВНИМАНИЕ: строка длиннее 4000 символов и обрезана — проверьте её целиком перед сохранением"
		printf '{"ok":true,"code":0,"args":"%s","msg":"%s"}\n' "$(printf '%s' "$iargs" | jesc 4000)" "$irep"
		exit 0 ;;

	# NB: вербов `zapret_install`/`zapret_remove` здесь БОЛЬШЕ НЕТ. Ставит и снимает nfqws тот же
	# движок (`pkg_apply` → packages.sh), а ВТОРАЯ точка входа в UI означала вторую дорогу мимо
	# общего плана: цена операции («что освободится», «чего не хватит») там не считалась, и кнопка
	# «Удалить nfqws» однажды уже сносила бинарь из-под живого zapret-выхода. Карточка Zapret
	# осталась на месте — из неё теперь ведёт ссылка в «Компоненты».

	# --- Браузер-свип Zapret: применяем стратегии nfqws ВЖИВУЮ, реальный браузер грузит favicon
	# заблок-сайтов через настоящий форвард (честнее curl с роутера — тот мерил бы путь OUTPUT).
	# Возможен только при включённом zapret. Цикл драйвит ФРОНТ (begin → apply×N → end).
	zapret_sweep_begin)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен (обновите панель)"
		zt_wired || fail "браузер-свип возможен только при живом десинке — включите Zapret вверху карточки или включите zapret-выход"
		sh "$ENODIA_DIR/zapret.sh" sweep-begin >/dev/null 2>&1 \
			&& printf '{"ok":true,"code":0,"msg":"свип начат"}\n' || fail "не удалось начать свип"
		exit 0 ;;
	zapret_sweep_apply)
		zt_wired || fail "десинк выключен — свип прерван"
		args=$(urldecode "$(field args)")
		args=$(printf '%s' "$args" | tr '\r\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g')
		if [ -n "$args" ]; then
			echo "$args" | grep -qE '^[A-Za-z0-9 +,.:/=_@-]+$' || fail "недопустимые символы стратегии"
		fi
		if sh "$ENODIA_DIR/zapret.sh" sweep-apply "$args" >/dev/null 2>&1; then up=true; else up=false; fi
		printf '{"ok":true,"code":0,"up":%s}\n' "$up"; exit 0 ;;
	zapret_sweep_end)
		[ -f "$ENODIA_DIR/zapret.sh" ] || fail "zapret.sh не установлен"
		sh "$ENODIA_DIR/zapret.sh" sweep-end >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"свип завершён, исходная стратегия восстановлена"}\n'; exit 0 ;;

	# --- Менеджер источников списков (generic по категории) + блокировка рекламы/IP. -----
	# Реестр источников на /data (lists-update.sh). Мутации мгновенные; обновление (закачка) —
	# фоном через spawn_bg, прогресс в lists/<cat>/.update.state (панель опрашивает data?section=sources).
	src_add_url)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		url=$(urldecode "$(field url)"); fmt=$(field format); label=$(urldecode "$(field label)")
		echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%~@+-]+$' || fail "URL: http(s):// и безопасные символы"
		case "$fmt" in auto|cidr|hosts|dnsmasq|adblock|domain) ;; *) fmt=auto ;; esac
		# Управляющие символы — все: метка уходит в JSON списка источников как есть (jesc lists-update экранирует лишь \ и ").
		label=$(printf '%s' "$label" | tr -d '\t\r\n"\\' | tr -d '\001-\037\177' | cut -c1-120)
		sh "$ENODIA_DIR/lists-update.sh" add-url "$cat" "$url" "$fmt" "$label" >/dev/null 2>&1 || fail "не удалось добавить источник"
		# Реконсиляция: сразу пересобрать артефакт под новый реестр (не ждать клиентский дебаунс —
		# он теряется при уходе со страницы → реестр и применённое расходятся). Дедуп по pidfile.
		spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"
		printf '{"ok":true,"code":0,"msg":"Источник добавлен — применяю"}\n'; exit 0 ;;
	src_add_blob)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		btype=$(field btype); case "$btype" in file|text) ;; *) fail "тип: file|text" ;; esac
		fmt=$(field format); case "$fmt" in auto|cidr|hosts|dnsmasq|adblock|domain) ;; *) fmt=auto ;; esac
		label=$(urldecode "$(field label)"); label=$(printf '%s' "$label" | tr -d '\t\r\n"\\' | tr -d '\001-\037\177' | cut -c1-120)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый файл (base64)"
		tmp=/tmp/enodia-src-blob.$$; printf '%s' "$content" | tr -d '\r' > "$tmp"
		id=$(sh "$ENODIA_DIR/lists-update.sh" add-blob "$cat" "$btype" "$fmt" "$label" "$tmp" 2>/dev/null); rm -f "$tmp"
		[ -n "$id" ] || fail "не удалось добавить источник"
		spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция (см. src_add_url)
		printf '{"ok":true,"code":0,"msg":"Источник добавлен — применяю"}\n'; exit 0 ;;
	src_edit_blob)   # перезаписать содержимое существующего file/text-источника (правка «вставленного текста»)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		id=$(field id); echo "$id" | grep -qE '^s[0-9]+$' || fail "плохой id"
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		[ -n "$content" ] || fail "пустой или битый текст (base64)"
		tmp=/tmp/enodia-src-blob.$$; printf '%s' "$content" | tr -d '\r' > "$tmp"
		sh "$ENODIA_DIR/lists-update.sh" set-blob "$cat" "$id" "$tmp" >/dev/null 2>&1; rc=$?; rm -f "$tmp"
		[ "$rc" = 0 ] || fail "не удалось сохранить (URL-источник не редактируется здесь)"
		spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция под новый текст
		printf '{"ok":true,"code":0,"msg":"Текст обновлён — применяю"}\n'; exit 0 ;;
	src_del)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		id=$(field id); echo "$id" | grep -qE '^s[0-9]+$' || fail "плохой id"
		sh "$ENODIA_DIR/lists-update.sh" del "$cat" "$id" >/dev/null 2>&1
		spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция: очистить/пересобрать артефакт под пустой/усечённый реестр
		printf '{"ok":true,"code":0,"msg":"Источник удалён — применяю"}\n'; exit 0 ;;
	src_toggle)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		id=$(field id); echo "$id" | grep -qE '^s[0-9]+$' || fail "плохой id"
		en=$(field en); case "$en" in 0|1) ;; *) fail "en: 0|1" ;; esac
		sh "$ENODIA_DIR/lists-update.sh" toggle "$cat" "$id" "$en" >/dev/null 2>&1
		spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"   # реконсиляция под изменённый реестр
		printf '{"ok":true,"code":0,"msg":"Источник %s — применяю"}\n' "$([ "$en" = 1 ] && echo включён || echo выключен)"; exit 0 ;;
	src_refresh)
		cat=$(field cat); _valid_lcat "$cat" || fail "неизвестная категория"
		[ -f "$ENODIA_DIR/lists-update.sh" ] || fail "lists-update.sh не установлен (обновите панель)"
		spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"
		printf '{"ok":true,"code":0,"msg":"Обновление запущено (фоном) — следите за прогрессом"}\n'; exit 0 ;;
	# Блокировка: мастер-переключатель категории (adblock/ipblock). Вкл → сразу качаем/применяем фоном.
	block_enable)
		cat=$(field cat); _lcat_switchable "$cat" || fail "категория: adblock|ipblock|zapret-cidr|zapret-dom"
		on=$(field on); case "$on" in 0|1) ;; *) fail "on: 0|1" ;; esac
		if [ "$on" = 1 ]; then
			if [ "$cat" = ipblock ]; then
				# ipblock: guarded-путь (safe-enable = вкл+применить+self-test с авто-откатом, слой 3).
				# Фоном (переживает обрыв SSH). Панель следит за .guard.state через data?section=sources. НАЧАЛО проверки —
				# синхронно (guard-begin): перечитанный сразу после ответа экран обязан увидеть APPLYING, а не прошлый итог;
				# и вторая проверка поверх идущей не запускается.
				# Отказ «уже идёт» — только на код 1: скрипт старше верба (частичное обновление) отвечает иным кодом, и тогда —
				# прежний путь, а не ложная причина.
				# Код 2 — прошлую проверку выключили, а она ещё доигрывает свой проход (закачку): вторая поверх неё не начинается.
				sh "$ENODIA_DIR/lists-update.sh" guard-begin "$cat" >/dev/null 2>&1; _gb=$?
				[ "$_gb" = 1 ] && fail "проверка связи уже идёт — дождитесь её итога"
				[ "$_gb" = 2 ] && fail "прошлая проверка связи ещё завершается — включите через минуту"
				spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" safe-enable "$cat"
				printf '{"ok":true,"code":0,"msg":"Включаю блокировку по адресам с проверкой связи — откачу автоматически, если оборвётся"}\n'; exit 0
			fi
			sh "$ENODIA_DIR/lists-update.sh" enable "$cat" 1 >/dev/null 2>&1
			spawn_bg "/tmp/enodia-lists-$cat.pid" "$ENODIA_DIR/lists-update.sh" update "$cat"
			printf '{"ok":true,"code":0,"msg":"%s"}\n' "$(_lcat_msg "$cat" on)"; exit 0
		fi
		sh "$ENODIA_DIR/lists-update.sh" enable "$cat" 0 >/dev/null 2>&1
		printf '{"ok":true,"code":0,"msg":"%s"}\n' "$(_lcat_msg "$cat" off)"; exit 0 ;;
	# Исключения категории: ВЕСЬ список (верб заменяет файл). Числа — от движка (lists-update.sh allow_set): сколько
	# записей стало, сколько строк не стало записью (не домен / не адрес IPv4) и КОГДА подействует (now — уже; later —
	# после обновления списков; off — блокировка выключена). Прежний ответ «применится при обновлении» был правдой
	# лишь наполовину и молчал про отброшенное: вставил адрес в исключения рекламы — он пропадал без следа.
	block_allow)
		cat=$(field cat); case "$cat" in adblock|ipblock) ;; *) fail "категория: adblock|ipblock" ;; esac
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null)
		tmp=/tmp/enodia-allow.$$; printf '%s\n' "$content" | tr -d '\r' > "$tmp"
		out=$(sh "$ENODIA_DIR/lists-update.sh" allow-set "$cat" "$tmp" 2>/dev/null | tail -1); rm -f "$tmp"
		case "$out" in
			*applied=reject*) [ "$cat" = ipblock ] && fail "в поле нет ни одного адреса IPv4 — прежний список не изменён"
			                  fail "в поле нет ни одного домена — прежний список не изменён" ;;
			kept=*) : ;;
			*) fail "не удалось сохранить исключения" ;;
		esac
		kp=$(printf '%s' "$out" | sed -n 's/.*kept=\([0-9]*\).*/\1/p'); dr=$(printf '%s' "$out" | sed -n 's/.*dropped=\([0-9]*\).*/\1/p')
		ap=$(printf '%s' "$out" | sed -n 's/.*applied=\([a-z]*\).*/\1/p')
		case "$ap" in now|later|off) : ;; *) ap=later ;; esac
		printf '{"ok":true,"code":0,"kept":%s,"dropped":%s,"applied":"%s","msg":"Исключения сохранены"}\n' "${kp:-0}" "${dr:-0}" "$ap"; exit 0 ;;
	# Пакетное добавление доменов/подсетей (текст/файл base64 или URL) — через domain.sh/apply-bypass.sh.
	bulk_domain)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null); [ -n "$content" ] || fail "пусто"
		n=$(printf '%s' "$content" | bulk_domains)
		printf '{"ok":true,"code":0,"msg":"Добавлено доменов в туннель: %s"}\n' "$n"; exit 0 ;;
	# Закачка списка — ОБЩИМ слоем subs-lib.sh (sub_fetch). Свой `curl -s` здесь был ЧЕТВЁРТОЙ копией
	# и успел разойтись с оригиналом сразу по четырём пунктам: без `--fail` страница 404 приезжала
	# как «список» (замер: из типовой строки ошибки вытаскивается ДВА «домена» — они молча
	# становились правилами), без `-L` легальная ссылка с редиректом давала «не удалось скачать»,
	# без потолка тело целиком ложилось в переменную (а это ОЗУ роутера), и гард SSRF проверял
	# только ИСХОДНЫЙ адрес. sub_fetch закрывает всё это одним местом (гард на КАЖДОМ хопе).
	bulk_domain_url)
		url=$(urldecode "$(field url)"); echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%~@+-]+$' || fail "URL: http(s):// и безопасные символы"
		_bu="/tmp/enodia-bulk-url.$$"
		sub_fetch "$url" "$_bu" -f || { rm -f "$_bu" 2>/dev/null; fail "не удалось скачать список (недоступен, пустой или адрес запрещён)"; }
		n=$(bulk_domains < "$_bu"); rm -f "$_bu" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"Добавлено доменов в туннель: %s"}\n' "$n"; exit 0 ;;
	bulk_dst)
		content=$(urldecode "$(field content)" | base64 -d 2>/dev/null); [ -n "$content" ] || fail "пусто"
		n=$(printf '%s' "$content" | bulk_dsts)
		printf '{"ok":true,"code":0,"msg":"Выведено мимо VPN: %s"}\n' "$n"; exit 0 ;;
	bulk_dst_url)
		url=$(urldecode "$(field url)"); echo "$url" | grep -qE '^https?://[A-Za-z0-9./?=&_:%~@+-]+$' || fail "URL: http(s):// и безопасные символы"
		_bu="/tmp/enodia-bulk-url.$$"
		sub_fetch "$url" "$_bu" -f || { rm -f "$_bu" 2>/dev/null; fail "не удалось скачать список (недоступен, пустой или адрес запрещён)"; }
		n=$(bulk_dsts < "$_bu"); rm -f "$_bu" 2>/dev/null
		printf '{"ok":true,"code":0,"msg":"Выведено мимо VPN: %s"}\n' "$n"; exit 0 ;;

	# --- Гео-категории (geo.sh): страны/сервисы/заблок-в-РФ → в VPN / мимо VPN / блок ---
	# geo_set пишет ТОЛЬКО выбор действия (мгновенно, без сети); сборку сетов зовёт фронт следом:
	# geo_apply (собрать из кэша, докачивая лишь недостающие ключи — дёшево, на смену действия) или
	# geo_update (принудительно перекачать все включённые — кнопка «Обновить списки» и cron).
	geo_set)
		# ВАЖНО: поле выбора называем act, НЕ action — иначе оно КОЛЛИДИРУЕТ с action=geo_set
		# (верб), и field action вернул бы первый матч «geo_set» вместо направления → всегда fail.
		key=$(field key); gact=$(field act)
		# key санируем charset'ом (в shell уходит только [a-z0-9-]); geo.sh set сам сверяет с каталогом.
		echo "$key" | grep -qE '^[a-z0-9-]+$' || fail "недопустимый ключ"
		case "$gact" in vpn|bypass|block|desync|off) ;; *) fail "действие: vpn|bypass|block|desync|off" ;; esac
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		run geo.sh set "$key" "$gact" ;;
	geo_slot)
		# Привязка гео-категории к доп-выходу (Ф1b, зеркало grp_slot): пишет ТОЛЬКО реестр —
		# пересборку фронт зовёт следом (geo_apply), как после geo_set.
		key=$(field key); slot=$(field slot)
		echo "$key" | grep -qE '^[a-z0-9-]+$' || fail "недопустимый ключ"
		case "$slot" in 0|[2-7]) ;; *) fail "доп-выход: 0 или 2..7" ;; esac
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		run geo.sh slot "$key" "$slot" ;;
	geo_preset)
		# Чип-пресет на десинк-выходе (Ф1b): включить/выключить гео-категорию (v2fly-*) с привязкой
		# к слоту одним действием. on=1: set vpn + slot (реестр, синхронно) → фоновая пересборка
		# (do_build медленный при первом резолве v2fly-каталога). on=0: set off. Ключ — узкий
		# whitelist пресетов (v2fly-youtube|discord|telegram), slot строгий 2..7.
		key=$(field key); slot=$(field slot); on=$(field on)
		case "$key" in v2fly-youtube|v2fly-discord|v2fly-telegram) ;; *) fail "неизвестный пресет" ;; esac
		case "$slot" in [2-7]) ;; *) fail "битый выход" ;; esac
		case "$on" in 0|1) ;; *) fail "нужно 0|1" ;; esac
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		if [ "$on" = 1 ]; then
			sh "$ENODIA_DIR/geo.sh" set "$key" vpn >/dev/null 2>&1
			sh "$ENODIA_DIR/geo.sh" slot "$key" "$slot" >/dev/null 2>&1
		else
			sh "$ENODIA_DIR/geo.sh" set "$key" off >/dev/null 2>&1
		fi
		spawn_bg /tmp/enodia-geo.pid "$ENODIA_DIR/geo.sh" apply
		printf '{"ok":true,"code":0,"msg":"%s"}\n' \
			"$([ "$on" = 1 ] && echo 'Привязываю пресет к выходу (фоном)' || echo 'Отвязываю пресет (фоном)')"; exit 0 ;;
	geo_apply)
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		spawn_bg /tmp/enodia-geo.pid "$ENODIA_DIR/geo.sh" apply
		printf '{"ok":true,"code":0,"msg":"Применяю гео-правила (фоном)"}\n'; exit 0 ;;
	geo_update)
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		spawn_bg /tmp/enodia-geo.pid "$ENODIA_DIR/geo.sh" update
		printf '{"ok":true,"code":0,"msg":"Обновление гео-списков запущено (фоном)"}\n'; exit 0 ;;
	geo_provider)
		# выбор провайдера на тип (service→rf-geosite|v2fly, country→ipdeny, blocked→rf-geoip).
		# provider-set сам пересобирает из кэша (каталог ключей типа меняется) — синхронно, дёшево.
		ptype=$(field ptype); pid=$(field pid)
		case "$ptype" in service|country|blocked) ;; *) fail "тип провайдера: service|country|blocked" ;; esac
		echo "$pid" | grep -qE '^[a-z0-9-]+$' || fail "недопустимый провайдер"
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		run geo.sh provider-set "$ptype" "$pid" ;;
	geo_freshness)
		# фоновое обновление дат апстрим-коммитов (GitHub API) — панель зовёт при открытии модалки.
		[ -f "$ENODIA_DIR/geo.sh" ] || fail "geo.sh не установлен (обновите панель)"
		spawn_bg /tmp/enodia-geo-fresh.pid "$ENODIA_DIR/geo.sh" freshness
		printf '{"ok":true,"code":0,"msg":"Обновляю даты апстрима (фоном)"}\n'; exit 0 ;;

	*)           fail "неизвестное действие" ;;
esac
