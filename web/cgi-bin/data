#!/bin/sh
# cgi-bin/data — READ-ONLY данные для карточек панели (Устройства / Сайты / Wi-Fi /
# Уведомления). Один CGI на 4 раздела, секция выбирается ?section=<имя> в QUERY_STRING.
# Зовётся GET-ом из панели (за HTTP-Basic). Ничего не меняет — только читает
# DHCP-лизы, хранилища apply-bypass, dnsmasq-конфиг доменов, hostapd и флаги notify.
# Управляющие действия — отдельный cgi-bin/action (POST + CSRF-токен).
#
# Имя секции берём из фиксированного белого списка (case) → инъекция невозможна,
# QUERY_STRING нигде в shell-команду не попадает.
# 2FA-гейт (totp.sh) — см. разбор в cgi-bin/status.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026 пробным CGI: все ENODIA_*
# пусты), а в режиме «всё на накопителе» литералы указывают в пустоту — панель отвечала бы
# «ничего не установлено» на живой системе, а ГЕЙТ ВТОРОГО ФАКТОРА ниже просто не находил бы
# totp.sh и молча пропускал запрос. Каталог кода знаем бесплатно из $0, остальное разбирает
# cgi-paths.sh: второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
if [ -f "$ENODIA_DIR/totp.sh" ]; then
	TOTP_LIB=1; . "$ENODIA_DIR/totp.sh"
	# СУДИМ ПО СПОСОБНОСТИ, А НЕ ПО НАЛИЧИЮ. totp.sh СТАРЕЕ формы входа сорсится успешно, но его
	# гейт при выключенном 2FA пропускал всё — а uhttpd к этому моменту уже поднят БЕЗ `-c`, то
	# есть панель отдавала бы данные и ДЕЙСТВИЯ без пароля. Признак эпохи — pw_verify (его же
	# спрашивает cgi-bin/login).
	command -v pw_verify >/dev/null 2>&1 || {
		echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
		echo "Cache-Control: no-store"; echo ""
		printf '{"ok":false,"need_login":true,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }
	totp_gate_deny
else   # НЕТ totp.sh — ОТКАЗ, А НЕ ПРОПУСК: двери-Basic больше нет, пускать некому (разбор — в totp.sh, «Гейт»)
	echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"need_login":true,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0
fi
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

D=${ENODIA_DIR:-/data/usr/app/enodia}
DS=${ENODIA_STATE:-/data/usr/app/enodia-state}
DB=${ENODIA_BIN:-/data/usr/app/enodia-bin}
EXCLUDE_CHAIN=VPN_EXCLUDE
FORCE_CHAIN=VPN_FORCE

# ГДЕ ЛЕЖИТ БИНАРЬ — спрашиваем store-lib, своей копии знания тут нет. С внешним накопителем
# половина бинарей живёт НЕ в $D, и проверки вида `-x "$DB/nfqws"` начинали отвечать «не
# установлен» о работающем компоненте: карточка Zapret рисовала «поставь nfqws» при живом
# десинке, «Серверы» просили бинарь у готового xray. Ответ обязан быть ОДИН на весь проект —
# он в store-lib.sh, и CGI не исключение (в `.sh` эта библиотека подключена везде).
# Сорсить ТОЛЬКО под `[ -f ]`: провалившийся `.` в busybox ash — фатальная ошибка спецбилтина,
# шелл выходит НА МЕСТЕ, и шим ниже стал бы мёртвым кодом (см. карту проекта).
if [ -f "$D/store-lib.sh" ]; then . "$D/store-lib.sh"; fi
command -v bin_path >/dev/null 2>&1 || bin_path() { printf '%s' "$D/$1"; }

# КОМУ ПРИНАДЛЕЖИТ АДРЕС — тоже не наше знание: аренды, neighbor, privacy-MAC и снимок «для кого
# заводили правило» живут в lease-lib.sh. Без библиотеки (старая установка, неполный payload)
# секция устройств обязана работать ровно как раньше — отсюда шимы-пустышки: новые поля просто
# не появятся, а список останется прежним.
if [ -f "$D/lease-lib.sh" ]; then . "$D/lease-lib.sh"; fi
command -v owner_get     >/dev/null 2>&1 || owner_get()     { return 1; }
# Правила по портам: какая строка действует, нормализованная форма портов и «адрес ли источник» — port-lib.sh, тот же разбор, по
# которому apply-bypass.sh ставит цепочку. Подключаем ЗДЕСЬ, до секций: им пользуются и список устройств, и сами правила.
command -v ip_owner_now  >/dev/null 2>&1 || ip_owner_now()  { return 1; }
if [ -f "$D/port-lib.sh" ]; then . "$D/port-lib.sh"; fi
command -v lease_ip_of_mac >/dev/null 2>&1 || lease_ip_of_mac() { return 1; }
# Шим ПУСТОЙ (не «ошибка»): устройства без аренды — надстройка над списком, и без библиотеки он
# обязан остаться прежним, а не пропасть целиком.
command -v neigh_pairs   >/dev/null 2>&1 || neigh_pairs()   { return 0; }
command -v mac_is_random >/dev/null 2>&1 || mac_is_random() { return 1; }
# У ЭТОГО шима код 0 («адрес местный»), а не 1, как у соседей: он гейтит ПРЕДУПРЕЖДЕНИЕ, и без
# библиотеки «не смог проверить» обязано читаться как «претензий нет». Верни он 1 — панель после
# неполного обновления пометила бы «адрес не из вашей сети» КАЖДОЕ устройство.
command -v ip_is_local   >/dev/null 2>&1 || ip_is_local()   { return 0; }

# jesc <лимит> — «текст роутера → строка внутри JSON» (json-lib.sh, одна копия на проект).
# Здесь этот конвейер был скопирован ЧЕТЫРЕЖДЫ и в прежнем, дефектном виде: обрезка шла ПОСЛЕ
# экранирования (на границе мог остаться нечётный `\` — сломанный JSON ВСЕГО ответа), `cut -c`
# резал БАЙТАМИ по кириллице, а сырой TAB никто не снимал. Цена не теоретическая: сводка
# подписок (.subs-last) на трёх подписках была 263 байта из тогдашнего лимита 300 — четвёртая обрывала
# сообщение посреди буквы (с 24.09.2026 сводку режет по записи сам писатель — subs-lib.sh::sub_sum_cut).
# Шим = ПРЕЖНЕЕ поведение файла, если либа не доехала.
if [ -f "$D/json-lib.sh" ]; then . "$D/json-lib.sh"; fi
command -v jesc >/dev/null 2>&1 || {
	jesc() { tr -d '\033\r' | sed 's/\[[0-9;]*m//g' | tr '\n\t' '  ' | cut -c1-"$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
}
# Данные (имена сетей) — jtxt; прежняя копия либы его не знает — ведём себя как раньше, через jesc.
command -v jtxt >/dev/null 2>&1 || jtxt() { jesc "$1"; }

# section=<имя> из QUERY_STRING (uhttpd кладёт его в env). Берём ровно поле section.
sec=$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | grep '^section=' | head -1 | cut -d= -f2)

# --- Устройства: DHCP-лизы + режим каждого (split / bypass / force) ----------
emit_devices() {
	# Аренды читаем ЧЕРЕЗ ПЕРЕМЕННУЮ, а не литералом в шести местах: путь у dnsmasq один, но
	# стенд (dev/devices-static-test.sh) обязан уметь подсунуть свой файл — иначе список
	# устройств проверяется только на живом роутере. Имя переменной — то же, что у lease-lib.sh.
	LEASES=${LEASE_FILE:-/tmp/dhcp.leases}
	# ОДИН АДРЕС — ОДНА СТРОКА. Источников ШЕСТЬ (аренды · соседи без аренды · три хранилища
	# режимов · порт-правила · правила по адресам), и каждый следующий обязан пропускать уже
	# напечатанное. Раньше каждый цикл сверялся ПО-СВОЕМУ (awk по арендам плюс grep по чужим
	# хранилищам), и адрес, лежащий сразу в двух хранилищах, печатался дважды.
	SEEN=" "
	seen_add() { SEEN="$SEEN$1 "; }
	# Кавычки вокруг `$1` в ШАБЛОНЕ обязательны: строка вида `192.168.31.*`, вписанная в хранилище
	# руками, иначе стала бы маской и молча съела бы из списка всю подсеть (стенд ловит).
	seen_has() { case "$SEEN" in *" $1 "*) return 0 ;; esac; return 1; }
	# «Онлайн» = пара IP|MAC есть в neighbor-таблице (lladdr, не FAILED/INCOMPLETE, недавно виден).
	# DHCP-лиз живёт до истечения аренды → без этого список копит офлайн-устройства.
	# Сверяем И MAC, а не только IP: устаревший лиз (устройство ушло, IP занял другой; или тот же
	# хост сменил Wi-Fi→Ethernet и получил новый IP с другим MAC) иначе красился бы «онлайн» и
	# тащил чужое/старое имя — ровно тот баг, когда имя в панели не совпадает с родной мордой.
	# MAC — В НИЖНИЙ РЕГИСТР: аренды и neigh печатают строчными, но сравнивается эта пара с MAC из
	# neigh_pairs (там tolower обязателен по той же причине), и разъехаться регистром им нельзя.
	NEIGH=" $(ip neigh show 2>/dev/null | awk '/lladdr/ && $NF!="FAILED" && $NF!="INCOMPLETE"{print $1"|"tolower($5)}' | tr '\n' ' ') "
	is_online() { case "$NEIGH" in *" $1|$2 "*) echo true ;; *) echo false ;; esac; }
	# РЕЖИМ АДРЕСА — общий ответ для аренд и для устройств без аренды: копия этой лестницы
	# (bypass → desync перебивает его → force → keep) разъехалась бы с первой же правкой
	# приоритетов, а показывает она ровно то, что делает ядро.
	dev_mode() {   # $1 = ip; результат в mode/keep/fslot (busybox: `local` нет, имена общие)
		mode=split; keep=false
		grep -qxF "$1" "$DS/.bypass-ips"  2>/dev/null && mode=bypass
		# «Целиком в десинк» = напрямую + nfqws по источнику. Проверяем ПОСЛЕ bypass и
		# перебиваем его: у такого устройства ACCEPT в VPN_EXCLUDE тоже стоит (это и есть
		# прямой путь режима), но строки в .bypass-ips движок не держит — режим ОДИН.
		grep -qxF "$1" "$DS/.desync-ips" 2>/dev/null && mode=desync
		# .fullvpn-ips: строка `IP` (основной туннель) либо `IP<TAB>sN` (доп-выход) —
		# сверяем ПЕРВОЕ ПОЛЕ, иначе привязанное к выходу устройство читалось бы «раздельно».
		fslot=$(awk -F'\t' -v want="$1" '$1==want{print $2; exit}' "$DS/.fullvpn-ips" 2>/dev/null)
		awk -F'\t' -v want="$1" '$1==want{f=1} END{exit f?0:1}' "$DS/.fullvpn-ips" 2>/dev/null && mode=force
		case "$fslot" in s[234]) ;; *) fslot="" ;; esac
		# keep = «мимо VPN, но ручные правила действуют» (цепочка VPN_KEEP). Осмысленно
		# ТОЛЬКО при mode=bypass — движок сам чистит строку при снятии выреза.
		[ "$mode" = bypass ] && grep -qxF "$1" "$DS/.keep-vpn-ips" 2>/dev/null && keep=true
		return 0   # `[ … ] && grep` последней командой = rc=1 у всей функции
	}
	# СТАРЫЕ АРЕНДЫ. Телефоны ходят с рандомизированным MAC: переподключился → новый MAC → новая
	# аренда с ДРУГИМ адресом, а прежняя живёт в файле до конца срока (lan — 12 часов). В списке
	# одно устройство двоилось, и родная морда Xiaomi (она смотрит на живые ассоциации) показывала
	# только новый адрес — отсюда вечное «в панели один IP, в морде другой». Признак старой
	# аренды: есть аренда с ТЕМ ЖЕ именем и БОЛЬШИМ сроком истечения. Имя «*» (клиент его не
	# прислал) сравнивать не с чем — такие строки не помечаем. Два прохода по одному файлу:
	# первый собирает максимум срока на имя, второй печатает адреса отставших.
	STALE_IPS=" $(awk 'NR==FNR{if($4!="*" && $1+0>m[$4]) m[$4]=$1+0; next} $4!="*" && $1+0<m[$4]{print $3}' "$LEASES" "$LEASES" 2>/dev/null | tr '\n' ' ') "
	# Закреплённые адреса (dhcp-static.sh) — читаем персист напрямую: он и есть истина, а запуск
	# скрипта ради одного столбца на каждый перерисованный список стоил бы дороже самого списка.
	PIN_IPS=" $(cut -f2 "$DS/.dhcp-static" 2>/dev/null | tr '\n' ' ') "
	# СТОКОВЫЕ РЕЗЕРВАЦИИ (родная морда Xiaomi, `/etc/config/dhcp`). У тестера их 100+, и без
	# этого столбца панель писала «адрес может уехать после переподключения» про адрес,
	# закреплённый НАВСЕГДА, и предлагала кнопку, которая обязана упереться в дубль `dhcp-host`.
	# Спрашиваем ВЛАДЕЛЬЦА (dhcp-static.sh stock) — разбор чужого формата живёт в одном месте.
	# Один запуск на весь список: в dev_extra его звать нельзя, там сто устройств = сто форков.
	# MAC приводим к нижнему регистру ОДИН раз (UCI пишет их прописными, наш norm_mac — строчными).
	STOCK_TSV=$(sh "$D/dhcp-static.sh" stock 2>/dev/null | tr 'A-Z' 'a-z')
	STOCK_IPS=" $(printf '%s
' "$STOCK_TSV" | cut -f2 | tr '
' ' ') "
	STOCK_PAIRS=" $(printf '%s
' "$STOCK_TSV" | tr '	' '=' | tr '
' ' ') "
	# СВОИ ИМЕНА (dev-names.sh) — метка ПАНЕЛИ по MAC: у Алисы и IoT имени в аренде нет вовсе. Спрашиваем ВЛАДЕЛЬЦА (`list`) и
	# ОДИН раз на весь список, как `dhcp-static.sh stock` выше: разбор персиста у него один, и руками правленый файл (CR, таб,
	# кавычка, MAC прописными) приезжает сюда уже чистым — в JSON его строки уходят как есть. Ищем подстрокой «⏎mac⇥» — без
	# форка на каждое из сотни устройств.
	DN_NL='
'
	DN_TAB=$(printf '\t')
	DEVNAMES="$DN_NL$(sh "$D/dev-names.sh" list 2>/dev/null)$DN_NL"
	dn_of() {   # $1 mac строчными → своё имя или пусто (в _dno)
		_dno=""
		[ -n "$1" ] || return 0
		case "$DEVNAMES" in
			*"$DN_NL$1$DN_TAB"*) _dno=${DEVNAMES#*"$DN_NL$1$DN_TAB"}; _dno=${_dno%%"$DN_NL"*} ;;
		esac
		return 0
	}
	# Хвост полей, общий для ВСЕХ четырёх мест печати устройства (аренды + три подбора из
	# хранилищ): второй копии этой арифметики заводить нельзя — поля разъедутся между списками.
	dev_extra() {   # $1 ip, $2 mac (пусто = спросим сеть), $3 online (true|false)
		_xmac="$2"
		[ -n "$_xmac" ] || _xmac=$(ip_owner_now "$1" 2>/dev/null)
		_xst=false
		[ "$3" = true ] || case "$STALE_IPS" in *" $1 "*) _xst=true ;; esac
		case "$PIN_IPS" in *" $1 "*) _xpin=true ;; *) _xpin=false ;; esac
		case "$STOCK_IPS" in *" $1 "*) _xpst=true ;; *) _xpst=false ;; esac
		# Адрес, который сток закрепил ЗА ЭТИМ MAC. Может отличаться от нынешнего (устройство ещё
		# не переполучило аренду) — предлагать закрепление всё равно нельзя: dnsmasq получит второй
		# `dhcp-host` на тот же MAC. Подстрокой, без форка на устройство.
		_xsip=""
		if [ -n "$_xmac" ]; then
			case "$STOCK_PAIRS" in
				*" $_xmac="*) _xsip=${STOCK_PAIRS#*" $_xmac="}; _xsip=${_xsip%% *} ;;
			esac
		fi
		_xrnd=false
		[ -n "$_xmac" ] && mac_is_random "$_xmac" && _xrnd=true
		# ПРАВИЛО ЗАВОДИЛИ ДЛЯ ДРУГОГО УСТРОЙСТВА. Строка в .ip-owner появляется только при
		# заведении правила по адресу; если нынешний владелец адреса — другой MAC, то политика
		# осталась на адресе, а не на устройстве: у прежнего её больше нет, у нынешнего она чужая.
		_xlost=false; _xom=""; _xoh=""; _xon=""
		_xrow=$(owner_get "$1" 2>/dev/null)
		if [ -n "$_xrow" ]; then
			_xom=$(printf '%s' "$_xrow" | cut -f1)
			_xoh=$(printf '%s' "$_xrow" | cut -f2 | tr -d '"\\')
			if [ -n "$_xom" ] && [ -n "$_xmac" ] && [ "$_xom" != "$_xmac" ]; then
				_xlost=true
				_xon=$(lease_ip_of_mac "$_xom" 2>/dev/null)   # куда переехало прежнее устройство (пусто = его сейчас нет)
			fi
		fi
		# АДРЕС НЕ ИЗ ЭТОЙ СЕТИ. Ловится после импорта бэкапа с ДРУГОГО роутера: правило
		# приезжает вместе с настройками, а адрес там из чужой локалки ⇒ не сработает никогда.
		# Ответ у владельца (lease-lib), считать подсети здесь нельзя — разъедутся.
		_xfor=false
		ip_is_local "$1" || _xfor=true
		# Своё имя — по MAC устройства (у строки без MAC — владельца адреса: ip_owner_now выше), и у ПРЕЖНЕГО владельца адреса
		# тоже: заметка «правило заводилось для …» обязана звать его тем же именем, что и весь список.
		dn_of "$_xmac"; _xal=$_dno
		dn_of "$_xom"; _xoa=$_dno
		printf ',"stale":%s,"pinned":%s,"rand":%s,"owner_lost":%s,"owner_mac":"%s","owner_host":"%s","owner_alias":"%s","owner_now":"%s","foreign":%s,"pinned_stock":%s,"stock_ip":"%s","alias":"%s"' \
			"$_xst" "$_xpin" "$_xrnd" "$_xlost" "$_xom" "$_xoh" "$_xoa" "$_xon" "$_xfor" "$_xpst" "$_xsip" "$_xal"
	}
	printf '{"devices":['
	first=1
	if [ -f "$LEASES" ]; then
		while read -r _exp mac ip host _rest; do
			[ -n "$ip" ] || continue
			dev_mode "$ip"
			[ "$host" = "*" ] && host=""
			host=$(printf '%s' "$host" | tr -d '"\\')
			[ "$first" -eq 1 ] || printf ','
			first=0
			onl=$(is_online "$ip" "$mac")
			seen_add "$ip"
			printf '{"ip":"%s","mac":"%s","host":"%s","mode":"%s","online":%s,"keep":%s,"fslot":"%s"%s}' "$ip" "$mac" "$host" "$mode" "$onl" "$keep" "$fslot" "$(dev_extra "$ip" "$mac" "$onl")"
		done < "$LEASES"
	fi
	# УСТРОЙСТВО БЕЗ АРЕНДЫ: адрес прописан НА САМОМ устройстве. Список строился ТОЛЬКО из аренд
	# dnsmasq, а телевизор/NAS/камера со статикой аренду не берёт НИКОГДА — такого устройства в
	# панели не было вовсе: ни увидеть, ни завести на него правило (жалоба тестера 04.09.2026 —
	# телевизор по кабелю со статическим адресом; на нашем BE7000 в тот же день замерено ТРИ
	# таких клиента из пятнадцати). Роутер о них знает — по ARP, и разбор этой таблицы живёт у
	# ВЛАДЕЛЬЦА (lease-lib.sh::neigh_pairs): формат строки один и тот же для нас и для склейки
	# Wi-Fi-станций, второй копии быть не должно. Нет библиотеки (старая установка, неполный
	# payload) — шим выше вернёт пусто, и список останется ровно прежним.
	# Через ФАЙЛ, а не пайп: `while … | read` ушёл бы в подшелл и потерял и `first`, и SEEN.
	NBSRC=/tmp/.enodia-nb-src.$$
	neigh_pairs > "$NBSRC" 2>/dev/null
	while IFS="$(printf '\t')" read -r ip mac; do
		[ -n "$ip" ] || continue
		seen_has "$ip" && continue
		dev_mode "$ip"
		[ "$first" -eq 1 ] || printf ','
		first=0
		seen_add "$ip"
		# «Онлайн» спрашиваем У ТОГО ЖЕ ОТВЕТЧИКА, что и для аренд, хотя строка и пришла из
		# neighbor: печатать здесь `true` литералом значило бы завести ВТОРОЙ ответ на вопрос
		# «в сети ли устройство» — и он разошёлся бы с первым, стоит фильтрам разъехаться.
		# Имени нет и взяться ему неоткуда (его сообщает клиент в DHCP-запросе, а этот клиент
		# DHCP не спрашивал) — панель подпишет устройство MAC-адресом.
		onl=$(is_online "$ip" "$mac")
		printf '{"ip":"%s","mac":"%s","host":"","mode":"%s","online":%s,"keep":%s,"fslot":"%s","nolease":true%s}' "$ip" "$mac" "$mode" "$onl" "$keep" "$fslot" "$(dev_extra "$ip" "$mac" "$onl")"
	done < "$NBSRC"
	rm -f "$NBSRC"
	# Офлайн-устройства: IP, что лежат в хранилищах bypass/force, но которых нет
	# в текущих лизах — чтобы их можно было вернуть в раздельный режим из панели.
	for pair in "bypass:$DS/.bypass-ips" "force:$DS/.fullvpn-ips" "desync:$DS/.desync-ips"; do
		m=${pair%%:*}; f=${pair#*:}
		[ -f "$f" ] || continue
		# IFS=TAB: у .fullvpn-ips вторым полем может стоять доп-выход (`IP<TAB>sN`), у
		# .bypass-ips второго поля нет — переменная просто останется пустой.
		while IFS="$(printf '\t')" read -r ip fslot; do
			[ -n "$ip" ] || continue
			seen_has "$ip" && continue
			seen_add "$ip"
			keep=false
			[ "$m" = bypass ] && grep -qxF "$ip" "$DS/.keep-vpn-ips" 2>/dev/null && keep=true
			case "$fslot" in s[234]) ;; *) fslot="" ;; esac
			[ "$first" -eq 1 ] || printf ','
			first=0
			printf '{"ip":"%s","mac":"","host":"","mode":"%s","online":false,"keep":%s,"fslot":"%s"%s}' "$ip" "$m" "$keep" "$fslot" "$(dev_extra "$ip" "" false)"
		done < "$f"
	done
	# Устройства, у которых ЕСТЬ правило по портам, но нет ни DHCP-лиза, ни строки в
	# bypass/force-хранилищах: без этого правило живёт на роутере, а в панели его негде
	# увидеть и снять (та же дыра, что цикл выше закрывает для офлайн-вырезов). Уникальные
	# src — через временный файл, а не пайп: `while … | read` ушёл бы в подшелл и потерял
	# флаг first (тем же приёмом пользуются циклы выше — `done < файл`).
	if [ -s "$DS/.port-rules" ]; then
		PRSRC=/tmp/.enodia-pr-src.$$
		cut -f1 "$DS/.port-rules" 2>/dev/null | sort -u > "$PRSRC"
		while read -r ip; do
			[ -n "$ip" ] || continue
			[ "$ip" = any ] && continue
			# Устройство — только из АДРЕСА: строку с источником «ANY», «10.0.0», «300.1.1.1» (бэкап, ручная правка) панель
			# показывает «битой» на «Весь роутер» и снимает там, а устройством её не открыть. И в printf ниже значение уходит
			# сырым — мусор вроде кавычки ломал бы весь ответ.
			if command -v port_src_ok >/dev/null 2>&1; then port_src_ok "$ip" || continue
			else case "$ip" in *[!0-9.]*) continue ;; esac; fi
			seen_has "$ip" && continue
			seen_add "$ip"
			[ "$first" -eq 1 ] || printf ','
			first=0
			printf '{"ip":"%s","mac":"","host":"","mode":"split","online":false,"keep":false,"fslot":""%s}' "$ip" "$(dev_extra "$ip" "" false)"
		done < "$PRSRC"
		rm -f "$PRSRC"
	fi
	# То же для устройств, у которых есть ТОЛЬКО правила по адресам (ни лиза, ни выреза, ни
	# порт-правила): иначе правило живёт на роутере, а снять его в панели негде — устройства
	# в списке нет. Та же дыра, что закрывают два цикла выше.
	DRSRC=/tmp/.enodia-dr-src.$$
	sh "$D/groups.sh" dev-list 2>/dev/null | cut -f1 | sort -u > "$DRSRC"
	if [ -s "$DRSRC" ]; then
		while read -r ip; do
			[ -n "$ip" ] || continue
			seen_has "$ip" && continue
			seen_add "$ip"
			[ "$first" -eq 1 ] || printf ','
			first=0
			printf '{"ip":"%s","mac":"","host":"","mode":"split","online":false,"keep":false,"fslot":""%s}' "$ip" "$(dev_extra "$ip" "" false)"
		done < "$DRSRC"
	fi
	rm -f "$DRSRC"
	# Правила по портам (цепочка VPN_PORTS, хранилище .port-rules: src⇥proto⇥порты⇥куда).
	# Отдаём ВСЕ разом вместе с устройствами: экран портов открывается из этой же карточки,
	# и второй запрос ради трёх строк не нужен — панель отбирает свои по src.
	printf '],"ports":['
	pf=1
	if [ -s "$DS/.port-rules" ]; then
		# ДЕЙСТВУЕТ ЛИ строка — тот же разбор, по которому apply-bypass.sh ставит цепочку (port-lib.sh, подключён вверху):
		# «443,99999» или «500-100» из бэкапа или ручной правки ядро пропускает, и панель обязана сказать
		# «не действует», а не рисовать чип пути. Строку всё равно отдаём — её надо видеть и снять.
		PTAB=$(printf '\t'); PCR=$(printf '\r')
		# `|| [ -n "$psrc" ]`: последняя строка без перевода строки (ручная правка) иначе терялась ЗДЕСЬ, хотя цепочка её ставит —
		# правило действует, а в панели его нет (ревью пачки 3, круг 3). `\r` из Блокнота срезаем тем же приёмом, что port-lib.sh.
		while IFS="$PTAB" read -r psrc pproto ppts pdir || [ -n "$psrc" ]; do
			pdir=${pdir%"$PCR"}
			[ -n "$pdir" ] || continue
			# Порты — в нормализованной форме, общей с цепочкой и ключом удаления (port-lib.sh): «443, 80» из
			# ручной правки действует в ядре — и без нормализации фильтр ниже её отсеивал (действует, а не видно).
			if command -v port_list_norm >/dev/null 2>&1; then ppts=$(port_list_norm "$ppts"); fi
			# страховка на случай правки файла руками: в JSON уходит только безопасный
			# набор символов (цифры/буквы/точка/запятая/дефис), всё прочее пропускаем
			case "$psrc$pproto$ppts$pdir" in *[!0-9a-zA-Z.,-]*) continue ;; esac
			pok=true
			if command -v port_line_ok >/dev/null 2>&1; then port_line_ok "$psrc" "$pproto" "$ppts" "$pdir" || pok=false; fi
			[ "$pf" -eq 1 ] || printf ','
			pf=0
			printf '{"src":"%s","proto":"%s","ports":"%s","dir":"%s","ok":%s}' "$psrc" "$pproto" "$ppts" "$pdir" "$pok"
		done < "$DS/.port-rules"
	fi
	# Правила устройства по адресам назначения (цепочка VPN_DEV; хранит groups.sh — группа с
	# непустым src). Отдаём тем же запросом и тоже ВСЕ разом: панель отбирает свои по src.
	# Направление переводим в словарь панели (vpn|direct|block|sN) — он общий с порт-правилами.
	#
	# conf=true — домен назван ipset-строкой ещё и ВНЕ групп (гео, одиночные домены, пул zapret).
	# Раньше это означало «одно из двух правил мертво» (dnsmasq применяет к домену РОВНО ОДНУ
	# строку), теперь строки склеивает dns-merge.sh и работают ОБА — флаг остался справкой о том,
	# что домен ведёт себя не только по этому правилу. Сам файл-агрегат из поиска ИСКЛЮЧЁН: он
	# производный и присутствует ровно у конфликтных доменов, то есть отвечал бы сам себе.
	printf '],"devrules":['
	df=1
	DRTAB=$(printf '\t')
	sh "$D/groups.sh" dev-list 2>/dev/null > /tmp/.enodia-devrules.$$
	# Домены ЧУЖИХ подсистем собираем ОДНИМ проходом, а не грепом на каждое правило: рядом лежат
	# доменный пул десинка (десятки тысяч строк) и многомегабайтный conf гео-блокировки, а карточка
	# устройств перерисовывается часто — N правил давали бы N полных сканов флеша.
	# Строка dnsmasq может нести НЕСКОЛЬКО доменов (`ipset=/a.com/b.com/set` — так пишет установщик
	# для списка re-filter), поэтому раскладываем ВСЕ поля между первым и последним «/»: анкор на
	# первый домен видел бы только его, и для соседей подсказка молчала бы. Регистр — вниз (dnsmasq
	# сравнивает имена без учёта регистра).
	DRDOM=/tmp/.enodia-devconf.$$
	DRCONF=""
	for _dc in /tmp/dnsmasq.d/*.conf /etc/dnsmasq.d/*.conf; do
		[ -f "$_dc" ] || continue
		# Свои файлы исключаем: 10-groups.conf — источник самих этих правил, 00-ipset-merge.conf —
		# производный агрегат, он присутствует ровно у конфликтных доменов и отвечал бы сам себе.
		case "${_dc##*/}" in 10-groups.conf|00-ipset-merge.conf) continue ;; esac
		DRCONF="$DRCONF $_dc"
	done
	: > "$DRDOM"
	# shellcheck disable=SC2086 # список путей должен разъехаться по аргументам
	[ -n "$DRCONF" ] && awk -F/ '/^ipset=\//{for(i=2;i<NF;i++) if($i!="") print tolower($i)}' \
		$DRCONF 2>/dev/null | sort -u > "$DRDOM"
	while IFS="$DRTAB" read -r dsrc dval ddir dslot; do
		[ -n "$dval" ] || continue
		case "$dsrc$dval$ddir$dslot" in *[!0-9a-zA-Z./_-]*) continue ;; esac
		case "$ddir" in
			vpn)    [ "${dslot:-0}" = 0 ] && ddir=vpn || ddir="s$dslot" ;;
			bypass) ddir=direct ;;
			block)  ddir=block ;;
			*)      continue ;;
		esac
		dconf=false
		if ! echo "$dval" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$'; then
			grep -qxF "$(printf '%s' "$dval" | tr 'A-Z' 'a-z')" "$DRDOM" 2>/dev/null && dconf=true
		fi
		[ "$df" -eq 1 ] || printf ','
		df=0
		printf '{"src":"%s","val":"%s","dir":"%s","conf":%s}' "$dsrc" "$dval" "$ddir" "$dconf"
	done < /tmp/.enodia-devrules.$$
	rm -f /tmp/.enodia-devrules.$$ "$DRDOM"
	# Есть ли ЧЕМ десинкать: режим «целиком в десинк» предлагать нельзя, пока ответа нет — он
	# означал бы просто «мимо VPN», а подпись обещала бы обход блокировок. Панель по этому флагу
	# прячет сегмент (и оставляет его видимым, если режим уже включён — иначе человек не смог бы
	# его снять после удаления Zapret).
	# Признаков ДВА, и бинаря МАЛО: на ядре 4.4 (AX3600) nfqws приезжает бутстрапом, а NFQUEUE в
	# ядре вырезан ⇒ `src-wire` молча не встаёт, устройство остаётся выведенным из туннеля БЕЗ
	# десинка — ровно тот худший режим, о котором предупреждает шапка rebuild_desync. Второй
	# признак спрашиваем у плагина (verb nfq-ok, проба кэширована), rc=2 = старая копия не знает
	# верба ⇒ НЕ сужу (та же идиома, что в emit_zapret ниже и в transport.sh).
	dsr=false
	if [ -x "$(bin_path nfqws)" ]; then
		dsr=true
		if [ -f "$D/zapret.sh" ]; then
			sh "$D/zapret.sh" nfq-ok >/dev/null 2>&1 || [ "$?" = 2 ] || dsr=false
		fi
	fi
	# КТО СПРАШИВАЕТ. Лестница ядра считается ДЛЯ ИСТОЧНИКА, и по умолчанию человек спрашивает про
	# устройство, с которого открыл панель, — его адрес знает только сервер (REMOTE_ADDR). Без этого
	# поля проверялка «что победит» заставляла бы выбирать устройство руками на каждый вопрос.
	# Не dotted-quad (клиент по IPv6, обратный прокси) — пустое поле: панель тогда не гадает.
	you=${REMOTE_ADDR:-}
	case "$you" in *[!0-9.]*) you="" ;; esac
	# ЗА TLS-ПОРТОМ ДО CGI ДОЕЗЖАЕТ АДРЕС ТЕРМИНАТОРА, то есть сам роутер (та же грабля, что у ключа
	# счётчика неудач входа в totp.sh). Его трафик в mangle PREROUTING не ходит вовсе, и «лестница для
	# этого устройства» была бы ни о ком — гасим поле, пусть панель не гадает.
	if [ -n "$you" ]; then
		# Имя моста — у владельца (router-lib.sh::lan_if), но библиотеку ради одной строки не сорсим:
		# этот CGI зовёт ОПРОС панели. Шим — той же формы, что у dump.sh и heal.sh.
		_lif=$(command -v lan_if >/dev/null 2>&1 && lan_if || echo br-lan)   # lan-lit: шим без router-lib.sh
		_lanip=$(ip -4 addr show "$_lif" 2>/dev/null | awk '/inet /{sub(/\/.*/,"",$2); print $2; exit}')
		case "$you" in 127.*) you="" ;; "$_lanip") you="" ;; esac
	fi
	printf '],"you":"%s","desync_ready":%s}\n' "$you" "$dsr"
}

# --- Сайты: пользовательские домены (dnsmasq) + bypass-dst (сайты мимо VPN) ----
# Хранилище CIDR (по строке на адрес) → элементы JSON-массива. Скобки печатает вызывающий:
# так один хелпер обслуживает и "dst", и "vdst", не зная про них ничего.
emit_cidr_file() {
	_f=1
	[ -f "$1" ] || return 0
	while read -r c; do
		[ -n "$c" ] || continue
		c=$(printf '%s' "$c" | tr -d '"\\')
		[ "$_f" -eq 1 ] || printf ','
		_f=0
		printf '"%s"' "$c"
	done < "$1"
}

emit_sites() {
	printf '{"domains":['
	first=1
	CUSTOM=/etc/dnsmasq.d/enodia-custom.conf
	# Миграция/страховка персиста: /etc = ramfs, enodia-custom.conf стирается на ребуте.
	# Если персиста на /data ещё нет, а живой conf непуст — засеваем его СЕЙЧАС (пока
	# домены на месте), чтобы heal.sh восстановил их после следующего ребута.
	[ -f "$DS/.enodia-custom.conf" ] || { [ -s "$CUSTOM" ] && cp "$CUSTOM" "$DS/.enodia-custom.conf" 2>/dev/null; }
	# Направление берём из ИМЕНИ СЕТА в строке: enodia_list = в VPN, enodia_bypass = мимо VPN (domain.sh
	# держит оба в одном файле). Отдавать домены скопом нельзя — уведённый мимо показался бы в
	# списке «через VPN». Объект {name,dir}; старый формат (голая строка) панель больше не ждёт —
	# читатель тут ровно один (openSites), и он обновляется вместе с этим файлом.
	if [ -f "$CUSTOM" ]; then
		for e in $(sed -n 's|^ipset=/\([^/]*\)/\(.*\)$|\1:\2|p' "$CUSTOM" 2>/dev/null); do
			d=$(printf '%s' "${e%%:*}" | tr -d '"\\')
			[ -n "$d" ] || continue
			[ "${e##*:}" = enodia_bypass ] && dir=bypass || dir=vpn
			[ "$first" -eq 1 ] || printf ','
			first=0
			printf '{"name":"%s","dir":"%s"}' "$d" "$dir"
		done
		# Заблокированные ОДИНОЧНЫЕ домены: domain.sh block пишет пару address=/дом/0.0.0.0 + /::;
		# берём ТОЛЬКО строку 0.0.0.0 (иначе домен задвоится). dir=block → карточка «Сайты» покажет
		# их отдельной секцией, снять — тем же domain_del (domain.sh remove режет обе address-строки).
		for d in $(sed -n 's|^address=/\([^/]*\)/0\.0\.0\.0$|\1|p' "$CUSTOM" 2>/dev/null); do
			d=$(printf '%s' "$d" | tr -d '"\\')
			[ -n "$d" ] || continue
			[ "$first" -eq 1 ] || printf ','
			first=0
			printf '{"name":"%s","dir":"block"}' "$d"
		done
	fi
	# Два списка адресов — «мимо VPN» (.bypass-dst) и «в VPN» (.vpn-dst) — читаются одинаково,
	# отличается только файл: у адреса те же три состояния, что у домена (см. apply-bypass.sh).
	printf '],"dst":['
	emit_cidr_file "$DS/.bypass-dst"
	printf '],"vdst":['
	emit_cidr_file "$DS/.vpn-dst"
	# Время последнего УДАЧНОГО обновления списков IP. Якорей ДВА, потому что путей
	# обновления два, и каждый метит СВОЙ файл:
	#   .iplist.count               — кроновый iplist-update.sh (05:00 и на буте);
	#   lists/tunnel-cidr/.snapshot — движок lists-update.sh, т.е. кнопка «Обновить»
	#                                 в панели и любая правка реестра источников.
	# Берём СВЕЖАЙШИЙ из двух: пока смотрели только на первый, ручное обновление шло
	# мимо якоря и панель писала «3 дн назад» СРАЗУ ПОСЛЕ успешной перекачки (поймано
	# 27.08.2026: пул пересобран, ipset 3548→3544, подпись — от последнего крона).
	# Оба стампа честны ОДИНАКОВО: ставятся только на РЕАЛЬНОМ применении пула, а
	# fallback-из-снимка не трогает ни один. Поле ts в sources.tsv для этого не годится
	# — оно тикает и на ПРОВАЛЕ закачки, т.е. подписало бы неудачу как свежий апдейт.
	mt=0
	for _ipf in "$DS/.iplist.count" "$DS/lists/tunnel-cidr/.snapshot"; do
		_ipt=$(stat -c %Y "$_ipf" 2>/dev/null)
		case "$_ipt" in ''|*[!0-9]*) _ipt=$(date -r "$_ipf" +%s 2>/dev/null) ;; esac
		case "$_ipt" in ''|*[!0-9]*) _ipt=0 ;; esac
		if [ "$_ipt" -gt "$mt" ]; then mt=$_ipt; fi
	done
	now=$(date +%s); case "$now" in ''|*[!0-9]*) now=0 ;; esac
	printf '],"iplist_updated":%s,"now":%s}\n' "$mt" "$now"
}

# --- Wi-Fi: по ОДНОЙ записи на ЖИВОЙ iface + мосты + правила сетей не в эфире + гостевая ------------
# Группировку по SSID делает ФРОНТ (busybox awk на этом роутере без рабочих index()/split() — не
# полагаемся на него вовсе; чистый sh-цикл). «Какая сеть на каком wlN» и «что в эфире» — только у
# wifi-lib.sh: прежде секция читала hostapd-конфы сама и отдавала выключенные сети как работающие
# (конф `hostapd-wl2.conf` от выключенного третьего радио лежал рядом с живыми — замер BE7000 22.09.2026).
#
# ifaces  — живые интерфейсы: сеть, режим ИЗ ЯДРА (physdev в VPN_EXCLUDE / VPN_FORCE), мост, диапазон по
#           частоте драйвера, скрытая ли, служебная ли сеть связи mesh-узлов (секция uci `bh_*` стока Xiaomi);
# bridges — подсеть каждого моста, который встретился (и гостевого, если он есть);
# offair  — строки хранилищ правил, чьей сети сейчас НЕТ в эфире: правило хранится и встанет само, когда сеть
#           появится, — но панель обязана его показать и дать снять (иначе снять можно только по SSH).
#           why: off — сеть есть в настройках Wi-Fi (выключена, радио не поднято), gone — сети с таким именем
#           нет вовсе (переименовали; legacy-имя интерфейса, которого больше нет);
# guest*  — режим гостевой ПОДСЕТИ (он живёт правилом по подсети, а не по интерфейсу), есть ли её мост, её
#           сети в эфире (имена — для узнавания: у стока CN это «小米共享WiFi_…», а не «гостевая»).
emit_wifi() {
	if [ -f "$D/wifi-lib.sh" ]; then . "$D/wifi-lib.sh"; fi
	# Шимы прежней копии библиотеки: секция беднее (без мостов, диапазонов и правил вне эфира), но живая.
	command -v wifi_ssid_of     >/dev/null 2>&1 || wifi_ssid_of()     { return 1; }
	command -v wifi_live_ifaces >/dev/null 2>&1 || wifi_live_ifaces() { ls -1 /sys/class/net 2>/dev/null | grep '^wl[0-9]'; }
	command -v wifi_bridge_of   >/dev/null 2>&1 || wifi_bridge_of()   { return 1; }
	command -v wifi_bridge_net  >/dev/null 2>&1 || wifi_bridge_net()  { return 1; }
	command -v wifi_band_of     >/dev/null 2>&1 || wifi_band_of()     { return 1; }
	command -v wifi_hidden_of   >/dev/null 2>&1 || wifi_hidden_of()   { return 1; }
	command -v wifi_uci_sec_of  >/dev/null 2>&1 || wifi_uci_sec_of()  { return 1; }
	command -v wifi_table       >/dev/null 2>&1 || wifi_table()       { return 0; }
	command -v wifi_key_state   >/dev/null 2>&1 || wifi_key_state()   { echo live; }
	# iface'ы мимо VPN (physdev ACCEPT в VPN_EXCLUDE) → строка " wl16 wl17 ".
	byp=" $(iptables -t mangle -S "$EXCLUDE_CHAIN" 2>/dev/null | \
		sed -n 's/.*--physdev-in \([A-Za-z0-9_-][A-Za-z0-9_-]*\).*/\1/p' | tr '\n' ' ') "
	# iface'ы ЦЕЛИКОМ в VPN (physdev в VPN_FORCE) — зеркало byp для 3-го режима.
	frc=" $(iptables -t mangle -S "$FORCE_CHAIN" 2>/dev/null | \
		sed -n 's/.*--physdev-in \([A-Za-z0-9_-][A-Za-z0-9_-]*\).*/\1/p' | tr '\n' ' ') "
	gp=false; [ -e /sys/class/net/br-guest ] && gp=true
	# ЧТО ГОВОРИТ ХРАНИЛИЩЕ о каждом живом интерфейсе — у его владельца (apply-bypass.sh if-states), одним вызовом на ответ.
	# Прежний движок верба не знает — печатает подсказку, в которой нет строк «wlN<TAB>…»: поле просто пустое.
	ifst=$(sh "$D/apply-bypass.sh" if-states 2>/dev/null)
	# ПОДЦЕПЛЕНЫ ЛИ ПРАВИЛА ВООБЩЕ — строка `@wired` того же ответа движка; нет строки (прежний движок) — null, «не знаем».
	wired=$(printf '%s\n' "$ifst" | awk -F'\t' '$1=="@wired"{print $2; exit}')
	case "$wired" in 1) wired=true ;; 0) wired=false ;; *) wired=null ;; esac
	# Одна выгрузка uci на весь ответ (разбор цены — у wifi-lib.sh::wifi_uci_show).
	WIFI_UCI=$(uci show wireless 2>/dev/null)
	# КАКОЙ МОСТ — ДОМАШНЯЯ СЕТЬ, говорит владелец (router-lib.sh::lan_if): панель подписывает подсеть по роли, а не по имени.
	if [ -f "$D/router-lib.sh" ]; then . "$D/router-lib.sh"; fi
	lan=$(command -v lan_if >/dev/null 2>&1 && lan_if 2>/dev/null)
	printf '{"lan":"%s","wired":%s,"ifaces":[' "$lan" "$wired"
	first=1; brs=" "; gssid=""; glive=0
	for ifc in $(wifi_live_ifaces); do
		ssid=$(wifi_ssid_of "$ifc" 2>/dev/null)
		# Движок НЕ ответил про интерфейс (прежний без верба, прежняя wifi-lib) — `null`, а не пустая строка: пусто значит
		# «в хранилище ничего», и панель объявила бы расхождение у каждой сети с правилом (ревью шага 5b, круг 2).
		st=$(printf '%s\n' "$ifst" | awk -F'\t' -v i="$ifc" '($1"")==(i""){print "=" $2; exit}')
		case "$st" in =bypass|=force|=both) st="\"${st#=}\"" ;; =) st='""' ;; *) st=null ;; esac
		bp=false; case "$byp" in *" $ifc "*) bp=true ;; esac
		fp=false; case "$frc" in *" $ifc "*) fp=true ;; esac
		br=$(wifi_bridge_of "$ifc" 2>/dev/null); band=$(wifi_band_of "$ifc" 2>/dev/null)
		hid=false; wifi_hidden_of "$ifc" && hid=true
		mesh=false; case "$(wifi_uci_sec_of "$ifc" 2>/dev/null)" in wireless.bh_*) mesh=true ;; esac
		[ -n "$br" ] && case "$brs" in *" $br "*) : ;; *) brs="$brs$br " ;; esac
		# Имя гостевой — без ведущих/хвостовых пробелов и без повторов: две VAP (2.4/5 ГГц) обычно с одним именем.
		if [ "$br" = br-guest ]; then
			s=$(printf '%s' "$ssid" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
			[ -n "$s" ] && case ", $gssid, " in *", $s, "*) : ;; *) gssid="${gssid:+$gssid, }$s" ;; esac
		fi
		[ "$first" -eq 1 ] || printf ','
		first=0
		printf '{"ifc":"%s","ssid":"%s","bypassed":%s,"forced":%s,"st":%s,"br":"%s","band":"%s","hidden":%s,"mesh":%s}' \
			"$ifc" "$(printf '%s' "$ssid" | jtxt 200)" "$bp" "$fp" "$st" "$br" "$band" "$hid" "$mesh"
	done
	printf '],"bridges":['
	[ "$gp" = true ] && case "$brs" in *" br-guest "*) : ;; *) brs="${brs}br-guest " ;; esac
	first=1
	for br in $brs; do
		net=$(wifi_bridge_net "$br" 2>/dev/null)
		[ "$first" -eq 1 ] || printf ','
		first=0
		printf '{"br":"%s","net":"%s"}' "$br" "$net"
	done
	printf '],"offair":['
	# Таблица интерфейсов — ОДИН проход на все строки хранилищ (разбор цены у wifi_table).
	WIFI_TAB=$(wifi_table 2>/dev/null)
	first=1
	for pair in "bypass:$DS/.bypass-ifaces" "force:$DS/.fullvpn-ifaces"; do
		m=${pair%%:*}; f=${pair#*:}
		[ -s "$f" ] || continue
		while IFS= read -r k || [ -n "$k" ]; do
			[ -n "$k" ] || continue
			st=$(wifi_key_state "$k" 2>/dev/null)
			case "$st" in off|gone) : ;; *) continue ;; esac
			[ "$first" -eq 1 ] || printf ','
			first=0
			printf '{"key":"%s","mode":"%s","why":"%s"}' "$(printf '%s' "$k" | jtxt 200)" "$m" "$st"
		done < "$f"
	done
	printf ']'
	# В ЭФИРЕ ЛИ ГОСТЕВАЯ — по ФАКТУ: порты её моста (у выключенного Wi-Fi гостевой их нет). Не «сколько наших wlN опознали»:
	# прежняя копия wifi-lib не знает мостов, и «не нашёл» читалось бы «Wi-Fi гостевой выключен» (ревью шага 5b, круг 1).
	glive=0
	# Порты-Wi-Fi (`wl*`): проводной порт в гостевом мосту не делает её Wi-Fi включённым (ревью шага 5b, круг 2).
	if [ "$gp" = true ]; then for p in /sys/class/net/br-guest/brif/wl*; do [ -e "$p" ] && glive=$((glive + 1)); done; fi
	# ПОДСЕТЬ, НА КОТОРУЮ ДЕЙСТВУЕТ ПРАВИЛО ГОСТЕВОЙ, — у владельца правила (apply-bypass.sh, GUEST_SUBNET): панель сверяет её с
	# подсетью моста, и расхождение — «режим на её устройства не действует», а не молчаливый чип.
	gn=$(sed -n 's/^GUEST_SUBNET=\([0-9./]*\).*/\1/p' "$D/apply-bypass.sh" 2>/dev/null | head -1)
	[ -n "$gn" ] || gn=192.168.33.0/24
	# Режим гостевой подсети.
	if   [ -f "$DS/.fullvpn-guest" ]; then g=force
	elif [ -f "$DS/.bypass-guest" ] || ip rule show 2>/dev/null | grep -qF "from $gn lookup main"; then g=bypass
	else g=split; fi
	printf ',"guest":"%s","guest_present":%s,"guest_ssid":"%s","guest_live":%s,"guest_rule":"%s"}\n' "$g" "$gp" "$(printf '%s' "$gssid" | jtxt 400)" "$glive" "$gn"
}

# --- Уведомления: включены? настроены (есть SMTP_PASS)? + текущие поля (БЕЗ пароля)
# для префилла формы. Пароль НЕ отдаём наружу — только флаг has_pass.
emit_notify() {
	en=true;  [ -f "$DS/.notify-off" ] && en=false
	cf=false
	if [ -s "$DS/notify.conf" ] && grep -q '^SMTP_PASS=.' "$DS/notify.conf" 2>/dev/null; then cf=true; fi
	host=$(sed -n 's/^SMTP_HOST=//p' "$DS/notify.conf" 2>/dev/null | head -1 | tr -d '"\\')
	port=$(sed -n 's/^SMTP_PORT=//p' "$DS/notify.conf" 2>/dev/null | head -1 | tr -d '"\\')
	tls=$(sed -n  's/^SMTP_TLS=//p'  "$DS/notify.conf" 2>/dev/null | head -1 | tr -d '"\\')
	user=$(sed -n 's/^SMTP_USER=//p' "$DS/notify.conf" 2>/dev/null | head -1 | tr -d '"\\')
	mto=$(sed -n  's/^MAIL_TO=//p'   "$DS/notify.conf" 2>/dev/null | head -1 | tr -d '"\\')
	# «О ЧЁМ ПИСАТЬ» — поводы называет РОУТЕР (events.sh — владелец классов и файла выбора), панель лишь подписывает их
	# словами. Роутер старше (нет верба `classes`) — поля нет вовсе: панель скажет это, а не нарисует пустой выбор.
	cl=''
	if [ -f "$D/events.sh" ]; then
		cl=$(sh "$D/events.sh" classes 2>/dev/null | awk '$1 ~ /^[a-z]+$/ && ($2 == "on" || $2 == "off") { printf "%s{\"id\":\"%s\",\"mail\":%s}", (n++ ? "," : ""), $1, ($2 == "on" ? "true" : "false") }')
	fi
	[ -n "$cl" ] && cl=",\"classes\":[$cl]"
	printf '{"enabled":%s,"configured":%s,"smtp_host":"%s","smtp_port":"%s","smtp_tls":"%s","smtp_user":"%s","mail_to":"%s"%s}\n' \
		"$en" "$cf" "${host:-smtp.yandex.ru}" "${port:-465}" "${tls:-auto}" "$user" "$mto" "$cl"
}

# --- Режим VPN: авто-failover (две оси) + full-tunnel («весь трафик через VPN»). -
emit_settings() {
	m=$(cat "$DS/.failover-mode" 2>/dev/null | tr -d ' \r\n');     [ -n "$m" ] || m=sticky
	e=$(cat "$DS/.failover-escalate" 2>/dev/null | tr -d ' \r\n'); [ -n "$e" ] || e=cross
	fh=$(cat "$DS/.failover-home" 2>/dev/null | tr -d ' \r\n"\\')
	# ДОМ — ЭТО ДВА УРОВНЯ, и панель обязана показать оба: домашний СЕРВЕР (.failover-home,
	# был здесь всегда) и домашний ТРАНСПОРТ (.transport-home). Второй пишет ТОЛЬКО ручной выбор
	# (`transport.sh switch <t> --home`), и до 09.09.2026 его не отдавала ни одна секция: режим
	# «резерв + возврат» был включён, сторож честно возвращал — а узнать, КУДА он вернётся и
	# задан ли дом вообще, из панели было нельзя. Пустой `transport_home` — законное состояние
	# («дом не задан»), а не ошибка: тогда возвращается только сервер.
	th=$(cat "$DS/.transport-home" 2>/dev/null | tr -d ' \r\n"\\')
	tc=$(cat "$DS/.transport" 2>/dev/null | tr -d ' \r\n"\\')
	# ВЫКЛЮЧЕННЫЙ ТУМБЛЕР БЬЁТ ВЕСЬ БЛОК ВОЗВРАТА: сторож с `.vpn-off` выходит из тика раньше
	# любых проверок, значит никакого «вернётся, когда оживёт» не произойдёт. Без этого признака
	# экран рапортовал бы «сейчас роутер дома» при выключенном VPN — то есть благополучие там,
	# где ничего не работает.
	vo=false; [ -f "$DS/.vpn-off" ] && vo=true
	ft=false; [ -f "$DS/.full-tunnel" ] && ft=true
	printf '{"failover_mode":"%s","failover_escalate":"%s","failover_home":"%s","transport_home":"%s","transport":"%s","vpn_off":%s,"full_tunnel":%s}\n' "$m" "$e" "$fh" "$th" "$tc" "$vo" "$ft"
}

