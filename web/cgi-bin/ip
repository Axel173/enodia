#!/bin/sh
# cgi-bin/ip — отдаёт IP панели в JSON: «ваш WAN» (реальный публичный) и «зарубежный» (через VPN).
#
# WAN-IP. Берём адрес интерфейса, через который идёт дефолт в MAIN-таблице (туннельный дефолт живёт
# в table 1000, т.е. это НЕ туннель → адрес именно WAN-iface). Если он УЖЕ публичный (обычный роутер
# на границе провайдера) — это и есть реальный WAN, отдаём как есть, без сетевой пробы (мгновенно).
# Если же он ПРИВАТНЫЙ (роутер за NAT/CGNAT — двойной роутер, 4G-оператор и т.п.) — локальный адрес
# «не отражает реального WAN», поэтому пробуем узнать настоящий публичный IP: bind curl к WAN-iface
# (--interface) уводит запрос НАПРЯМУЮ, в обход нашего собственного туннеля, и удалённая сторона
# отвечает публичным адресом провайдера.
# NB: внешний `curl api.ipify.org` без bind сюда НЕ годится — он ушёл бы в VPN (Cloudflare/ipify ∈
# iplist_set) и показал бы зарубежный IP вместо WAN. Метод пробы (IP-литерал) — в ip-lib.sh.
#
# Зарубежный IP — выходной через VPN: awg → --interface awg0; альт (xray/hy2) → --socks5-hostname
# 10808. Это сетевая проба (секунды) — оттого ip вынесен в отдельный CGI, фронт зовёт его реже status.
# Read-only: адреса читаем локально, наружу только GET за собственным IP (через ip-lib.sh).
#
# ПОЧЕМУ ЗДЕСЬ КЭШ, ПАРАЛЛЕЛЬ И ОТКАЗ ОТ «ПРИВАТНОГО ВМЕСТО ВНЕШНЕГО» (замерено на AX3600 17.08.2026,
# роутер за роутером): пробы шли ПОДРЯД по 7 с каждая, и три запроса кряду отдавали ровно ОДИН адрес
# из двух — то «WAN есть, зарубежного нет», то наоборот; в последнем случае как «ваш внешний IP»
# показывался ПРИВАТНЫЙ 192.168.31.128. Причина промахов не сеть: те же пробы через полчаса дали
# 12/12 за ~0 с, а падали они в минуты, когда dnsmasq грузил 300 тыс. строк гео (load 2.2) — бюджет
# съедал ЗАНЯТЫЙ роутер. Отсюда три решения:
#   1. КЭШ последнего УДАЧНОГО ответа в /tmp (TTL 3 мин, ключ = транспорт|конфиг|WAN-iface, так смена
#      сервера обнуляет его сама). Панель зовёт нас раз в минуту — раньше это были 7–14 с curl'а
#      КАЖДУЮ минуту навсегда, теперь сеть трогаем раз в три; `?force=1` кэш обходит.
#   2. Две пробы ПАРАЛЛЕЛЬНО: промах одной больше не съедает бюджет другой (было sum, стало max).
#   3. Проба промолчала и кэша нет ⇒ отдаём ПУСТО, а не локальный адрес: «внешний IP 192.168.31.128»
#      — неверное утверждение, а сам локальный адрес и так уезжает отдельным полем wan_local.
# Возраст ответа отдаём полями *_age — панель подписывает им устаревшее значение.
# 2FA-гейт (totp.sh) — см. разбор в cgi-bin/status.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026 пробным CGI: все ENODIA_*
# пусты), а в режиме «всё на накопителе» литералы указывают в пустоту — панель отвечала бы
# «ничего не установлено» на живой системе, а ГЕЙТ ВТОРОГО ФАКТОРА ниже просто не находил бы
# totp.sh и молча пропускал запрос. Каталог кода знаем бесплатно из $0, остальное разбирает
# cgi-paths.sh: второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
if [ -f "$ENODIA_DIR/totp.sh" ]; then
	TOTP_LIB=1; . "$ENODIA_DIR/totp.sh"
	# СУДИМ ПО СПОСОБНОСТИ, А НЕ ПО НАЛИЧИЮ. totp.sh СТАРЕЕ формы входа сорсится успешно, но его
	# гейт при выключенном 2FA пропускал всё — а uhttpd к этому моменту уже поднят БЕЗ `-c`, то
	# есть панель отдавала бы данные и ДЕЙСТВИЯ без пароля. Признак эпохи — pw_verify (его же
	# спрашивает cgi-bin/login).
	command -v pw_verify >/dev/null 2>&1 || {
		echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
		echo "Cache-Control: no-store"; echo ""
		printf '{"ok":false,"need_login":true,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }
	totp_gate_deny
else   # НЕТ totp.sh — ОТКАЗ, А НЕ ПРОПУСК: двери-Basic больше нет, пускать некому (разбор — в totp.sh, «Гейт»)
	echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"need_login":true,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0
fi
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

D=${ENODIA_DIR:-/data/usr/app/enodia}
DS=${ENODIA_STATE:-/data/usr/app/enodia-state}
if [ -f "$D/ip-lib.sh" ]; then . "$D/ip-lib.sh"; fi    # probe_ext_ip / is_private_ip (единый примитив внешнего IP)
# Возраст отметки — через age_since (clock-lib): кэш лежит в /tmp, то есть рождается ПОСЛЕ загрузки,
# а часы без RTC прыгают вперёд через ~13 мин ⇒ голая разность объявила бы свежий ответ вековым
# (и наоборот). Шим = прежнее поведение. Следит C24.
if [ -f "$D/clock-lib.sh" ]; then . "$D/clock-lib.sh"; fi
command -v age_since >/dev/null 2>&1 || age_since() {
	case "$1" in ''|*[!0-9]*) echo 999999; return ;; esac
	[ "$1" -gt 0 ] && echo $(( $(date +%s) - $1 )) || echo 999999
}
# trim + дефолт, а НЕ `cat || echo awg`: ту же граблю уже чинили в cgi-bin/status и cgi-bin/traffic,
# сюда она не доехала. `cat` на СУЩЕСТВУЮЩЕМ-но-ПУСТОМ .transport успешен ⇒ `||` не срабатывает,
# t="" проваливается в `*)` — и «зарубежный IP» при живом AmneziaWG мерился бы через socks 10808
# (у awg его нет) ⇒ карточка «IP-адреса» вечно показывала бы прочерк. То же от хвостового \r.
t=$(cat "$DS/.transport" 2>/dev/null | tr -d ' \r\n'); [ -n "$t" ] || t=awg

# URL пробы выхода — настраиваемый (экран панели «Проверка серверов»), дефолт — IP-литерал trace (см. ip-lib.sh).
# Валидируем строго: только https://хост[/путь] безопасного набора; иначе пусто → дефолт библиотеки.
# НЕ для WAN (тот берём локально/bind'ом — см. шапку), только для «зарубежного» через VPN.
EGRESS=$(grep '^egress_url=' "$DS/.prefs" 2>/dev/null | head -1 | cut -d= -f2-)
echo "$EGRESS" | grep -qE '^https://[A-Za-z0-9._~-]+(/[A-Za-z0-9._~/-]*)?$' || EGRESS=""

# Имя WAN — у владельца (ip-lib.sh::wan_iface, сорсится выше; следит C81); шим = прежняя строка.
command -v wan_iface >/dev/null 2>&1 || wan_iface() { ip route show default 2>/dev/null | awk '/^default/{d=""; for(i=1;i<=NF;i++) if($i=="dev") d=$(i+1); if(d!="" && d !~ /^(awg|xtun)/){print d; exit}}'; }
wan_if=$(wan_iface)
wan_local=""
[ -n "$wan_if" ] && wan_local=$(ip -4 addr show dev "$wan_if" 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)

# Активный конфиг — часть ключа кэша: смена сервера меняет зарубежный выход, и ответ обязан
# обновиться СРАЗУ, а не через TTL. Файл спрашиваем по транспорту (владелец имени — switch-vpn/плагин).
case "$t" in
	awg)  cfg=$(cat "$DS/.active" 2>/dev/null | tr -d ' \r\n') ;;
	xray) cfg=$(cat "$DS/.xray-active" 2>/dev/null | tr -d ' \r\n') ;;
	hy2)  cfg=$(cat "$DS/.hy2-active" 2>/dev/null | tr -d ' \r\n') ;;
	*)    cfg="-" ;;
esac
CACHE=/tmp/.enodia-ipcache       # /tmp: сеть спрашиваем часто, флеш этого не заслужил. Имя НЕСЁТ
                                 # префикс: /tmp — общий namespace, и опираться, как раньше, на
                                 # ЛЕГАСИ-маску `/tmp/.awg-*` нельзя (legacy-name: она же ниже) —
                                 # она живёт лишь затем, чтобы
                                 # подобрать следы ДОРЕБРЕНДИНГОВЫХ установок, и однажды уйдёт.
                                 # Уборку даёт `/tmp/.enodia-*` в RAM_GLOBS uninstall.sh (следит C54).
TTL=180
KEY="$t|${cfg:--}|${wan_if:-?}"
FORCE=0
case "$QUERY_STRING" in *force=1*) FORCE=1 ;; esac

# Кэш: "<ключ> <wan_ip> <wan_ts> <vpn_ip> <vpn_ts>", пустое значение = «-» (иначе `read` сдвинет
# поля — та же грабля, из-за которой в .traffic-last завели шестое поле).
c_key=""; c_wan="-"; c_wts=0; c_vpn="-"; c_vts=0
[ -f "$CACHE" ] && read c_key c_wan c_wts c_vpn c_vts < "$CACHE"
for n in c_wts c_vts; do eval "x=\$$n"; case "$x" in ''|*[!0-9]*) eval "$n=0";; esac; done
if [ "$c_key" != "$KEY" ]; then c_wan="-"; c_wts=0; c_vpn="-"; c_vts=0; fi   # другой транспорт/сервер/WAN
[ "$c_wan" = "-" ] && c_wan=""
[ "$c_vpn" = "-" ] && c_vpn=""
w_age=$([ -n "$c_wan" ] && age_since "$c_wts" || echo -1)
v_age=$([ -n "$c_vpn" ] && age_since "$c_vts" || echo -1)

# Что нужно мерить. WAN: только если локальный адрес приватный (у роутера на границе провайдера он
# и есть настоящий, сетевая проба избыточна — эта ветка остаётся МГНОВЕННОЙ, как была).
# stale <возраст> — «пора мерить заново» (нет ответа вовсе, просрочен TTL или спросили force=1).
stale() { [ "$FORCE" = 1 ] && return 0; [ "$1" -lt 0 ] && return 0; [ "$1" -gt "$TTL" ]; }
border=0                                   # роутер НА ГРАНИЦЕ: адрес WAN-iface уже публичный
if [ -n "$wan_local" ] && ! is_private_ip "$wan_local"; then border=1; fi
need_w=0; need_v=0
if [ "$border" = 0 ] && [ -n "$wan_if" ] && stale "$w_age"; then need_w=1; fi
case "$t" in
	# zapret — десинк-direct: туннеля/socks нет, «зарубежного выхода» нет by design.
	zapret) v_bind=""; v_to=0 ;;
	awg)    v_bind="--interface awg0"; v_to=7 ;;
	*)      v_bind="--socks5-hostname 127.0.0.1:10808"; v_to=9 ;;
esac
if [ -n "$v_bind" ] && stale "$v_age"; then need_v=1; fi

# ПАРАЛЛЕЛЬНО: две пробы по 7–9 с подряд давали до 16 с на запрос, и промах одной съедал бюджет
# другой. Результат через файлы в /tmp (подстановку из фона в busybox не забрать), `wait` — общий
# (без детей возвращается сразу, отдельный гард не нужен).
# tries=2 (4-й аргумент): пустой ответ добиваем вторым узлом trace. Здесь это уместно, а в health
# транспортов — нет: там та же проба крутится в переборе конфигов (разбор в ip-lib.sh).
TMP="/tmp/.enodia-ipcache.$$"
# ЗАБИРАЕМ ЗА УБИТЫМИ ПРЕДШЕСТВЕННИКАМИ. Свои временные файлы мы снимаем ниже, но CGI могут убить
# на середине: пробы тут 7–9 с, а uhttpd рвёт затянувшийся запрос — и `.w`/`.v` остаются в ОЗУ
# НАВСЕГДА (в /tmp их не чистит никто, кроме удаления). ЗАМЕРЕНО на AX3600 31.08.2026: четыре
# таких файла от двух мёртвых pid за пять часов аптайма. Судим по ЖИВОСТИ ХОЗЯИНА (pid зашит в
# имя), а НЕ по возрасту: параллельный запрос панели идёт своим pid'ом, и трогать его нельзя —
# он как раз пишет туда результат. Заодно подбираем `.c` — ступень записи кэша, если `mv` не удался.
trap 'rm -f "$TMP.w" "$TMP.v" "$TMP.c" 2>/dev/null' EXIT
trap 'exit 1' INT TERM HUP PIPE
for _st in /tmp/.enodia-ipcache.*.w /tmp/.enodia-ipcache.*.v /tmp/.enodia-ipcache.*.c \
           /tmp/.awg-ipcache.*.w /tmp/.awg-ipcache.*.v /tmp/.awg-ipcache.*.c; do   # legacy-name: остатки ДОРЕБРЕНДИНГОВОГО имени кэша — подобрать и забыть
	[ -f "$_st" ] || continue
	_sp=${_st%.*}; _sp=${_sp##*.}                       # <pid> из <...>.<pid>.<w|v|c>
	case "$_sp" in ''|*[!0-9]*) continue ;; esac
	[ -d "/proc/$_sp" ] || rm -f "$_st" 2>/dev/null
done
if [ "$need_w" = 1 ]; then ( probe_ext_ip "--interface $wan_if" 7 "" 2 > "$TMP.w" 2>/dev/null ) & fi
if [ "$need_v" = 1 ]; then ( probe_ext_ip "$v_bind" "$v_to" "$EGRESS" 2 > "$TMP.v" 2>/dev/null ) & fi
wait

now=$(date +%s)
# WAN: на границе — адрес интерфейса как есть (пробы не было и не нужно). Иначе результат пробы,
# а если промолчала — ПРОШЛЫЙ удачный ответ с его возрастом (панель его подпишет).
if [ "$border" = 1 ]; then
	wan="$wan_local"; c_wts="$now"; w_age=0
else
	wan="$c_wan"
	if [ "$need_w" = 1 ]; then
		pub=$(cat "$TMP.w" 2>/dev/null | tr -d ' \r\n')
		if [ -n "$pub" ]; then wan="$pub"; c_wts="$now"; w_age=0; fi
	fi
fi
vpn="$c_vpn"
if [ "$need_v" = 1 ]; then
	got=$(cat "$TMP.v" 2>/dev/null | tr -d ' \r\n')
	if [ -n "$got" ]; then vpn="$got"; c_vts="$now"; v_age=0; fi
fi
rm -f "$TMP.w" "$TMP.v" 2>/dev/null

echo "$wan" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || { wan=""; w_age=-1; }
echo "$vpn" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || { vpn=""; v_age=-1; }
# Приватный адрес НЕ выдаём за внешний: он и так уезжает полем wan_local (панель покажет его в
# подсказке), а строка «ваш внешний IP: 192.168.31.128» — прямая неправда.
if [ -n "$wan" ] && is_private_ip "$wan"; then wan=""; w_age=-1; fi

# Кэш пишем ТОЛЬКО с удачными значениями (промах не должен затирать последний верный ответ).
# Через ступень + mv: два одновременных запроса панели иначе могли бы порвать строку на середине.
printf '%s %s %s %s %s\n' "$KEY" "${wan:--}" "$c_wts" "${vpn:--}" "$c_vts" > "$TMP.c" 2>/dev/null &&
	mv "$TMP.c" "$CACHE" 2>/dev/null

# wan_local отдаём отдельно: фронт показывает его в подсказке при NAT («за NAT: <локальный> на <iface>»).
# *_age: секунды с момента ИЗМЕРЕНИЯ (0 = только что, -1 = ответа нет вовсе) — панель подписывает
# устаревшее значение, чтобы «зарубежный IP» пятиминутной давности не читался как «сейчас так и есть».
printf '{"wan_ip":"%s","vpn_ip":"%s","wan_if":"%s","wan_local":"%s","wan_age":%s,"vpn_age":%s,"ttl":%s}\n' \
	"$wan" "$vpn" "${wan_if:-?}" "$wan_local" "$w_age" "$v_age" "$TTL"
