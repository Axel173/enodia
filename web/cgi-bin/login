#!/bin/sh
# cgi-bin/login — ВХОД В ПАНЕЛЬ ПО ПАРОЛЮ (первый фактор) и выход на этом устройстве.
#
# ЗАЧЕМ СВОЯ ФОРМА, А НЕ HTTP-Basic (03.09.2026): Basic сверял сам uhttpd, и перебор пароля НЕ
# ТОРМОЗИЛСЯ (401 внутри одного keep-alive, до CGI попытка не доезжала), хэш обязан был быть `$1$`
# (musl-crypt панели падал на `$6$`), а «выйти» не существовало. Теперь пароль сверяем МЫ:
# pw_verify в totp.sh (одна копия — там же хэш, миграция прежнего uhttpd.conf, сессии и гейт),
# неудачи считает тот же totp_lock_* (пауза 60 с → ×2 → 15 мин), успех рождает сессию УРОВНЯ 1
# (пароль принят); при включённом TOTP гейт следом попросит код, и cgi-bin/2fa повысит эту же
# сессию до уровня 2.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ CGI, А НЕ ВЕТКА В 2fa: тот целиком про код, и его гейт требует хотя бы
# парольную сессию — а вход по определению происходит БЕЗ неё. Своего гейта у `login` нет (это и
# есть вход), у `logout` — тоже (гасим предъявленную куку; без неё гасить нечего).
#
# Защита:
#  - CSRF-токен синхронизатора (как в action) на КАЖДУЮ операцию: чужая страница без токена
#    сюда не постучится (а кука ещё и SameSite=Strict);
#  - пароль в теле base64 (в нём бывают & и %, а form-поле плоское; та же форма, что у смены
#    пароля в action), из base64 наружу — только `%2B/%2F/%3D` от encodeURIComponent;
#  - пауза после неудач ОБЩАЯ с кодом и ПЕР-АДРЕСНАЯ (totp_lock_key: по голому HTTP это адрес
#    клиента, за panel-tls — один на всех, кто пришёл по HTTPS): totp_lock_left до проверки,
#    totp_lock_bump после провала. Удачный пароль СБРАСЫВАЕТ счётчик своего источника только при
#    выключенном TOTP — иначе знающий пароль обнулял бы паузу между попытками подбора кода;
#  - тело ≤ 4096 байт, только POST.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026), каталог кода знаем из $0,
# остальное разбирает cgi-paths.sh — второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
ENODIA_DIR=${ENODIA_DIR:-/data/usr/app/enodia}
TOKFILE=/tmp/enodia-panel-token

TOTP_LIB=1
[ -f "$ENODIA_DIR/totp.sh" ] || {
	echo "Content-Type: application/json; charset=utf-8"; echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0; }
. "$ENODIA_DIR/totp.sh"
command -v pw_verify >/dev/null 2>&1 || {
	echo "Content-Type: application/json; charset=utf-8"; echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }

# Ответ формируем ДО заголовков: от результата зависит Set-Cookie.
out=""; cookie=""
say()  { out=$(printf '{"ok":true,"msg":"%s"}' "$1"); }
deny() { out=$(printf '{"ok":false,"msg":"%s"}' "$1"); }

emit() {
	echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"
	[ -n "$cookie" ] && echo "Set-Cookie: $cookie"
	echo ""
	printf '%s\n' "$out"
	exit 0
}

[ "$REQUEST_METHOD" = "POST" ] || { deny "только POST"; emit; }

len=${CONTENT_LENGTH:-0}
case "$len" in ''|*[!0-9]*) len=0 ;; esac
{ [ "$len" -gt 0 ] && [ "$len" -le 4096 ]; } || { deny "пустой или слишком большой запрос"; emit; }
body=$(head -c "$len")
field() { echo "$body" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2-; }
# urldecode значения формы — ТА ЖЕ строка, что в cgi-bin/action и cgi-bin/backup (CGI
# самодостаточны, общей библиотеки у них нет; равенство трёх копий сторожит C37). Нужна логину:
# имя приезжает после encodeURIComponent, и без
# декодирования «admin » сравнивалось бы как «admin20» — отказ там, где имя верное.
urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/+/ /g; s/%\(..\)/\\x\1/g')"; }

tok=$(field token)
echo "$tok" | grep -qE '^[0-9a-f]+$' || { deny "нет токена"; emit; }
{ [ -s "$TOKFILE" ] && [ "$tok" = "$(cat "$TOKFILE")" ]; } || { deny "неверный токен (перезагрузите панель)"; emit; }

op=$(field op | tr -cd 'a-z')

case "$op" in
	# --- Вход по паролю. Единственное место, где рождается сессия (2fa её только повышает).
	login)
		left=$(totp_lock_left)
		[ "${left:-0}" -gt 0 ] 2>/dev/null && { out=$(printf '{"ok":false,"msg":"слишком много неудачных попыток","lock":%s}' "$left"); emit; }
		# ЛОГИН. Поле в форме ВИДИМОЕ (менеджеры паролей ключуют запись парой «имя + адрес»), а
		# значит, правится человеком — и проверять его обязаны мы: pw_user_ok в totp.sh (там же и
		# само имя). Проверка эта — ЧЕСТНОСТЬ ЭКРАНА, А НЕ ЗАЩИТА, и потому НЕ ТРАТИТ ПОПЫТКУ:
		# имя не секрет (его печатает сам отказ, оно в README и в enodia.py), а перебиратель просто
		# не пришлёт поле — пустое мы обязаны принимать, иначе не войдёт панель из браузерного кэша
		# и ПК-скрипт старой версии. Считать промах логина неудачным ВХОДОМ значило бы запирать на
		# четверть часа живого человека, которому менеджер подставил своё имя записи, не давая
		# перебору ничего. Гард `command -v` — про смешанное обновление (новый CGI + старый
		# totp.sh): без него «команда не найдена» = ненулевой код = отказ ЛЮБОМУ паролю.
		if command -v pw_user_ok >/dev/null 2>&1 && ! pw_user_ok "$(urldecode "$(field user)")"; then
			deny "логин у панели один — ${PANEL_USER:-admin}"; emit
		fi
		# base64 от encodeURIComponent: символы алфавита `+ / =` приезжают как %2B %2F %3D, прочих
		# спецсимволов в base64 нет — полный urldecode тут не нужен (и не заводим третью копию).
		pw=$(field pass | sed 's/%2[Bb]/+/g; s/%2[Ff]/\//g; s/%3[Dd]/=/g' | base64 -d 2>/dev/null | tr -d '\r\n')
		[ -n "$pw" ] || { deny "пустой пароль"; emit; }
		pw_verify "$pw"; r=$?
		case "$r" in
			# КОМАНДЫ ЗДЕСЬ НЕТ — она под формой входа (`PW_RESET_CMD` в panel.js): одна копия, и та — моноширинно с переносом только
			# по «/». Строкой отказа команда рвалась на 320 px «enodia-|boot» (ревью шага 8a, круг 3), а вторая копия разъезжалась бы
			# с первой. Читает этот отказ только форма входа панели (ПК пароль задаёт сам и этот CGI не спрашивает).
			2) deny "пароль панели не задан — задайте его с компьютера (enodia-setup) или по SSH командой ниже" ;;
			0)
				# UA и адрес пишем ЗДЕСЬ и только здесь — единственный момент, когда мы знаем, с какого
				# устройства пришёл вход. Санитайзеры живут в totp.sh (значения из заголовков
				# полностью подконтрольны клиенту и уезжают и в TSV, и в JSON).
				# «ЗАПОМНИТЬ МЕНЯ»: галочка формы, ВКЛЮЧЕНА по умолчанию. Сроки знает totp.sh
				# (totp_sess_ttl) — здесь мы только пересказываем галочку, чтобы срок строки сессии и
				# Max-Age куки приехали ИЗ ОДНОГО МЕСТА. Пустой ttl = «решай сам»: так входит и панель
				# из кэша браузера, и totp.sh СТАРЕЕ галочки (тогда `command -v` не найдёт функцию).
				ttl=""
				command -v totp_sess_ttl >/dev/null 2>&1 && ttl=$(totp_sess_ttl "$(field remember)")
				t=$(totp_sess_new "${HTTP_USER_AGENT:-}" "${REMOTE_ADDR:-}" 1 "$ttl") || { deny "не удалось создать сессию"; emit; }
				cookie=$(totp_cookie_hdr "$t" "$ttl")
				# Хэш старее `$6$` (бессолевой `uhttpd -m` или солёный `$1$` из миграции Basic) —
				# переписать сейчас: plaintext есть ровно в этот момент. Не вышло — не беда, вход состоялся.
				pw_upgrade "$pw" >/dev/null 2>&1 || true
				n2=false
				if totp_enabled; then n2=true; else totp_lock_reset; fi
				out=$(printf '{"ok":true,"msg":"вход выполнен","need2fa":%s}' "$n2") ;;
			*)
				totp_lock_bump
				left=$(totp_lock_left)
				if [ "${left:-0}" -gt 0 ] 2>/dev/null; then out=$(printf '{"ok":false,"msg":"пароль не подошёл","lock":%s}' "$left")
				else deny "пароль не подошёл"; fi ;;
		esac ;;
	# --- Выход на ЭТОМ устройстве: отзываем предъявленную сессию и гасим куку. Остальные
	# устройства — в «Панель → Доступ к панели» (cgi-bin/2fa: sessions/others/logout/revoke).
	logout)
		c=$(totp_cookie)
		[ -n "$c" ] && totp_sess_revoke "$(totp_sess_id "$c")" >/dev/null 2>&1
		cookie=$(totp_cookie_gone); say "вы вышли" ;;
	*) deny "неизвестная операция" ;;
esac

emit
