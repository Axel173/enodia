#!/bin/sh
# cgi-bin/status — отдаёт ЖИВОЙ статус роутера панели в JSON (read-only).
# Зовётся uhttpd (CGI, -x /cgi-bin); доступ держит гейт сессии ниже (totp.sh), а не сервер.
# Проба — тот же срез, что шапка меню enodia.py (токены FW/LOAD/RAM/DISK/
# TPT/.active/LIVE), но сразу JSON-ом. Всё локально/мгновенно, без egress-проб и без
# изменения состояния (ни одной команды, что трогает туннель/iptables/DNS).
#
# ГЕЙТ ВХОДА (одинаковым блоком во всех CGI, кроме token, login и 2fa): пока вход не пройден,
# панель не отдаёт ни данных, ни действий. Логика ОДНА — в totp.sh; сорсим её, а не форкаем:
# гейт бежит на КАЖДОМ поллинге статуса. НЕТ totp.sh — ОТКАЗ, а не пропуск: пропуск был верен,
# пока дверь держал HTTP-Basic самого uhttpd, а с формой входа (03.09.2026) пускать больше
# некому — разбор в totp.sh, у totp_gate_deny.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026 пробным CGI: все ENODIA_*
# пусты), а в режиме «всё на накопителе» литералы указывают в пустоту — панель отвечала бы
# «ничего не установлено» на живой системе, а ГЕЙТ ВТОРОГО ФАКТОРА ниже просто не находил бы
# totp.sh и молча пропускал запрос. Каталог кода знаем бесплатно из $0, остальное разбирает
# cgi-paths.sh: второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
if [ -f "$ENODIA_DIR/totp.sh" ]; then
	TOTP_LIB=1; . "$ENODIA_DIR/totp.sh"
	# СУДИМ ПО СПОСОБНОСТИ, А НЕ ПО НАЛИЧИЮ. totp.sh СТАРЕЕ формы входа сорсится успешно, но его
	# гейт при выключенном 2FA пропускал всё — а uhttpd к этому моменту уже поднят БЕЗ `-c`, то
	# есть панель отдавала бы данные и ДЕЙСТВИЯ без пароля. Признак эпохи — pw_verify (его же
	# спрашивает cgi-bin/login).
	command -v pw_verify >/dev/null 2>&1 || {
		echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
		echo "Cache-Control: no-store"; echo ""
		printf '{"ok":false,"need_login":true,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }
	totp_gate_deny
else   # НЕТ totp.sh — ОТКАЗ, А НЕ ПРОПУСК: двери-Basic больше нет, пускать некому (разбор — в totp.sh, «Гейт»)
	echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"need_login":true,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0
fi
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

D=${ENODIA_DIR:-/data/usr/app/enodia}
B=${ENODIA_BOOT:-/data/usr/app/enodia-boot}
DS=${ENODIA_STATE:-/data/usr/app/enodia-state}
DB=${ENODIA_BIN:-/data/usr/app/enodia-bin}
F=/usr/share/xiaoqiang/xiaoqiang_version

# Устройство несущей — у владельца (ip-lib.sh::carrier_iface, следит C81): по нему шапка решает
# «везёт ли VPN». Шим = та же строка на случай частичной установки.
if [ -f "$D/ip-lib.sh" ]; then . "$D/ip-lib.sh"; fi
command -v carrier_iface >/dev/null 2>&1 || carrier_iface() { ip route show table 1000 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'; }
# Единый детект модели (та же логика, что у префикса писем/событий). Шим-фолбэк ниже.
if [ -f "$D/router-lib.sh" ]; then . "$D/router-lib.sh"; fi

# Возраст отметки времени с защитой от скачка часов. Шим = прежнее поведение.
if [ -f "$D/clock-lib.sh" ]; then . "$D/clock-lib.sh"; fi
command -v age_since >/dev/null 2>&1 || age_since() {
	case "$1" in ''|*[!0-9]*) echo 999999; return ;; esac
	[ "$1" -gt 0 ] && echo $(( $(date +%s) - $1 )) || echo 999999
}

rom=$(grep -E "option ROM " "$F" 2>/dev/null | sed "s/.*'\(.*\)'.*/\1/")
ch=$(grep -E "option CHANNEL " "$F" 2>/dev/null | sed "s/.*'\(.*\)'.*/\1/")
[ -n "$rom" ] && fw="$rom${ch:+ ($ch)}" || fw="?"

# Модель роутера для шапки (не хардкод — установка едет и на AX3600/BE3600). Детект в
# router-lib.sh (router_model → «Xiaomi AX3600»), там же его использует префикс писем.
# Шим: lib ещё не залит на роутер (первый полл после обновления) → мягкий дефолт «Xiaomi».
model=$(command -v router_model >/dev/null 2>&1 && router_model)
[ -n "$model" ] || model="Xiaomi"

# Загрузка ЦП — РЕАЛЬНАЯ утилизация из /proc/stat (как top), а НЕ loadavg. loadavg — это
# средняя длина очереди задач за 1 мин (плюс задачи в D-state), а НЕ %занятости CPU: на
# роутере фантомная нагрузка ~1.0 (демон вечно в очереди) давала «25%» при top ~3% (жалоба
# тестера, железо BE7000+AX3600). Считаем ДЕЛЬТУ занятых/всего тиков между ДВУМЯ поллами
# статуса (снимок в /tmp = RAM): панель поллит статус каждые пару секунд ⇒ дельта = средний
# %занятости за интервал, совпадает с top. Без sleep (не тормозим CGI). Первый полл (снимка
# нет) или дельта≤0 (перезагрузка обнулила /tmp) → короткий РЕАЛЬНЫЙ сэмпл (1 с, как sysinfo),
# а НЕ loadavg: на этом железе loadavg раздут (~1.0-1.4), и (l/cores)*100 врал бы ~35% в
# ПЕРВОМ кадре после загрузки страницы — ровно та болезнь, от которой ушли к /proc/stat.
CPU_SNAP=/tmp/.enodia-cpu-stat
set -- $(awk '/^cpu /{tot=0;for(i=2;i<=NF;i++)tot+=$i; print tot, $5+$6; exit}' /proc/stat 2>/dev/null)
ntot="$1"; nidle="$2"
ptot=""; pidle=""
[ -r "$CPU_SNAP" ] && read ptot pidle _r < "$CPU_SNAP" 2>/dev/null
[ -n "$ntot" ] && printf '%s %s\n' "$ntot" "$nidle" > "$CPU_SNAP" 2>/dev/null
cpu=""
if [ -n "$ptot" ] && [ -n "$ntot" ]; then
	cpu=$(awk -v pt="$ptot" -v pi="$pidle" -v nt="$ntot" -v ni="$nidle" 'BEGIN{
		dt=nt-pt; di=ni-pi;
		if(dt<=0){exit}
		v=(1-di/dt)*100; if(v<0)v=0; if(v>100)v=100;
		printf "%d", v+0.5 }')
fi
if [ -z "$cpu" ]; then
	# Снимка ещё нет (первый полл после ребута/сброса /tmp) или дельта была ≤0. Берём короткий
	# реальный сэмпл /proc/stat (1 с — busybox sleep без дробей), а не loadavg (см. коммент выше).
	# Срабатывает лишь пока снимка нет ⇒ обычный 2-сек поллинг (снимок уже есть) НЕ тормозим.
	sleep 1
	set -- $(awk '/^cpu /{tot=0;for(i=2;i<=NF;i++)tot+=$i; print tot, $5+$6; exit}' /proc/stat 2>/dev/null)
	s2tot="$1"; s2idle="$2"
	[ -n "$s2tot" ] && printf '%s %s\n' "$s2tot" "$s2idle" > "$CPU_SNAP" 2>/dev/null
	if [ -n "$ntot" ] && [ -n "$s2tot" ]; then
		cpu=$(awk -v pt="$ntot" -v pi="$nidle" -v nt="$s2tot" -v ni="$s2idle" 'BEGIN{
			dt=nt-pt; di=ni-pi;
			if(dt<=0){print 0; exit}
			v=(1-di/dt)*100; if(v<0)v=0; if(v>100)v=100;
			printf "%d", v+0.5 }')
	fi
	[ -z "$cpu" ] && cpu=0
fi

ramfree=$(awk '/^MemFree:/{f=$2}/^MemAvailable:/{a=$2}END{printf "%d",(a==""?f:a)/1024}' /proc/meminfo 2>/dev/null)
ramtot=$(awk '/^MemTotal:/{t=$2}END{printf "%d",t/1024}' /proc/meminfo 2>/dev/null)

# Флеш для бейджа шапки. ФОРМУЛА ОБЯЗАНА СОВПАДАТЬ С `cgi-bin/sysinfo` (там же и полный разбор):
# «занято» = total − available, процент — от НЕГО, а НЕ готовая колонка `Use%` из df (та считает
# used/(used+avail), то есть без неснижаемого резерва UBIFS, и на /data расходилась с показанными
# рядом мегабайтами на 6 пунктов). Разъедутся эти два места — снова получим два ответа про одно
# место на соседних экранах, ровно то, что чинили 16.08.2026.
# ТОМ спрашиваем ПО ПУТИ каталога, а не по литералу `/data`: на BE10000 это ЧУЖОЙ том
# (стоковый cfg), а мы живём на `/data/usr` — литерал показывал бы чужие 4.7 МБ (следит C50).
# …НО «том, где лежит код» — это НЕ ВСЕГДА флеш роутера: в режиме «всё на накопителе» $D
# указывает на флешку, и бейдж начинал отвечать 29 ГБ вместо 14 МБ, то есть переставал отвечать
# на единственный вопрос, ради которого на него смотрят («сколько осталось НА РОУТЕРЕ»; флешку
# показывает карточка хранилища). Якорь — бутстрап: он резидентен на /data ПО ОПРЕДЕЛЕНИЮ и в
# любой раскладке лежит на том же томе, что и код в обычной. Откат на $D — для установок
# старее бутстрапа: без него df по несуществующему пути дал бы 0/0 и прочерк в шапке.
DF_AT="$B"; [ -d "$DF_AT" ] || DF_AT="$D"
dl=$(df "$DF_AT" 2>/dev/null | tail -1)
disktot=$(echo "$dl" | awk 'NF>=5 && $(NF-4)+0>0{printf "%.0f",$(NF-4)/1024}')
diskfree=$(echo "$dl" | awk 'NF>=5 && $(NF-4)+0>0{printf "%.0f",$(NF-2)/1024}')
diskpct=$(echo "$dl" | awk 'NF>=5 && $(NF-4)+0>0{printf "%.0f%%",($(NF-4)-$(NF-2))*100/$(NF-4)}')
# ЗАНЯТОЕ — своим числом, а не разностью двух уже округлённых: панель показывает «занято из всего» подписью под мерой
# (раздел «Роутер», шаг 6a), и разность расходилась с «О роутере» (sysinfo считает так же, как здесь) на мегабайт.
# Нет df — пусто, и в JSON уходит null: «не знаю», а не ноль.
diskused=$(echo "$dl" | awk 'NF>=5 && $(NF-4)+0>0{printf "%.0f",($(NF-4)-$(NF-2))/1024}')

# НАКОПИТЕЛЬ — ЧЕТВЁРТАЯ МЕРА В ШАПКЕ. Спрашиваем ВЛАДЕЛЬЦА (store-lib.sh: маркер `.bin-store`
# плюс сентинел каталога), а не `[ -d /mnt/… ]`: вся опциональность хранилища собрана там, и
# литерала имени маркера здесь быть не должно.
# ОТВЕТА ТРИ, и третий — не «нет»: маркер есть, а каталог не опознан ⇒ хранилище ВКЛЮЧЕНО, НО
# НЕ НАЙДЕНО (флешку вынули, не смонтировалась, чужая разметка). Сегодня этот случай в шапке
# не виден вовсе, а тяжёлые бинари при нём мертвы — потому он и получает свою меру, янтарную,
# а не пустое место.
# СКОЛЬКО ЗАНЯТО считает ТА ЖЕ пара функций, что и карточка хранилища (fs_total_b/fs_free_b и
# их общий fs_line) — второй формулы «сколько занято» в проекте быть не должно.
# Сорсим БЕЗУСЛОВНО, гарда «есть ли маркер» здесь нет: имя маркера знает библиотека, и литерал
# `.bin-store` тут был бы второй копией. Цена замерена на BE7000 10.09.2026: 200 сорсингов — меньше
# секунды (у store-lib.sh при сорсинге НЕТ форков вовсе), 200 сорсингов ВМЕСТЕ с df — ровно 1 с,
# то есть ~5 мс на опрос при поллинге раз в 2 с. df при этом зовём, только когда есть что мерить.
stst=none; storetot=0; storefree=0; storepct=0
if [ -f "$D/store-lib.sh" ]; then . "$D/store-lib.sh"; fi
if command -v store_state >/dev/null 2>&1; then
	stst=$(store_state)
	if [ "$stst" = ok ]; then
		# fs_line печатает «<всего_КБ> <свободно_КБ> <точка>»: точка ПОСЛЕДНЕЙ (в ней бывает пробел), числа
		# берём С НАЧАЛА.
		# КИЛОБАЙТЫ, а не байты: 32-ГБ накопитель в байтах — 3.4e10, а арифметика шелла
		# тут не обязана быть 64-битной; КБ (3.3e7) помещаются с запасом.
		_sl=$(fs_line "$(store_root)")
		if [ -n "$_sl" ]; then
			storetot=${_sl%% *}; _sl=${_sl#* }; storefree=${_sl%% *}
			# ЧИСЛОВОЙ ГАРД ПЕРЕД АРИФМЕТИКОЙ, и он не formality: `$(( слово/1024 ))` в busybox ash —
			# ФАТАЛЬНАЯ ошибка разбора: шелл умирает на месте, а панель получает ОБОРВАННЫЙ JSON вместо
			# статуса. Разбор строки df у fs_line, но чужой формат df всё ещё может принести слово.
			case "$storetot" in ''|*[!0-9]*) storetot=0 ;; esac
			case "$storefree" in ''|*[!0-9]*) storefree=0 ;; esac
			storetot=$((storetot/1024)); storefree=$((storefree/1024))
			[ "$storetot" -gt 0 ] && storepct=$(( (storetot-storefree)*100/storetot ))
		fi
		unset _sl
	fi
fi

# ВАЖНО: `cat || echo awg` НЕ ловит СУЩЕСТВУЮЩИЙ-но-ПУСТОЙ .transport (cat успешен → t="") →
# case падал в *) (label=AmneziaWG, но live-проба шла по alt-socks 10808, а не awg-handshake) —
# при пустом .transport шапка/трафик врали. Читаем с trim + дефолт awg.
# ПОЧЕМУ ДЕФОЛТ `awg` ЗДЕСЬ ОСТАЁТСЯ, хотя в `cgi-bin/traffic` на том же месте стоит вопрос
# оркестратору (`configured` → `t=none`). Пробовали 17.08.2026 — и откатили: у `traffic` от `t`
# зависит РОВНО имя интерфейса, а здесь `t` расходится во ФРОНТ тремя путями, и `none` ломает все
# три. `panel.js`: вкладка экрана «Серверы» по умолчанию = `cur.transport`, иначе 'xray' — на
# свежей установке экран открылся бы на Xray вместо AmneziaWG; поле «Рукопожатие» уходит из
# awg-ветки в вердикт сторожа; `openCfgMenu` ищет `d['none']`. Цена — реальная регрессия, выигрыш —
# только гигиена сырого поля, которое панель и так гейтит по `configured`.
# ЧТО ОСТАЁТСЯ ЗНАТЬ: `"transport":"awg"` при пустом флаге — НЕ утверждение «стоит AmneziaWG», а
# исторический дефолт. Единственный честный ответ «настроен ли транспорт вообще» — поле
# `configured` (его считает оркестратор), и КАЖДЫЙ новый потребитель обязан спросить именно его.
t=$(cat "$DS/.transport" 2>/dev/null | tr -d ' \r\n'); [ -n "$t" ] || t=awg
case "$t" in
	xray)   label="Xray";      cfg=$(cat "$DS/.xray-active" 2>/dev/null)
		# Протокол активного outbound'а: xray несёт vless/vmess/trojan/ss — помечаем в шапке
		# (vless=норма → без пометки). Живой конфиг = xray.json, фолбэк — именованный по .xray-active.
		xpf="$DS/xray.json"; [ -f "$xpf" ] || xpf="$DS/xray-configs/$(echo "$cfg" | tr -d ' \r\n').json"
		xp=$(grep -oE '"protocol"[[:space:]]*:[[:space:]]*"(vless|vmess|trojan|shadowsocks)"' "$xpf" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
		case "$xp" in vmess) label="Xray · VMESS" ;; trojan) label="Xray · Trojan" ;; shadowsocks) label="Xray · Shadowsocks" ;; esac ;;
	hy2)    label="Hysteria2"; cfg=$(cat "$DS/.hy2-active" 2>/dev/null) ;;
	# byedpi БЕЗ серверного конфига (DPI-десинк): «конфиг» = стратегия (.byedpi-args; нет → авто).
	# Раньше byedpi проваливался в *) → шапка врала «AmneziaWG» + .active (см. seg-подсветку ByeDPI).
	byedpi) label="ByeDPI";    [ -s "$DS/.byedpi-args" ] && cfg="своя стратегия" || cfg="авто" ;;
	# zapret (десинк-direct без VPS, nfqws) — «конфиг» = стратегия (.zapret-args; нет → дефолт).
	# Без явной ветки проваливался бы в *) → шапка врала «AmneziaWG».
	zapret) label="Zapret";    [ -s "$DS/.zapret-args" ] && cfg="своя стратегия" || cfg="дефолт" ;;
	*)      label="AmneziaWG"; cfg=$(cat "$DS/.active" 2>/dev/null) ;;
esac

# Живость несущей. VPN РЕАЛЬНО несёт трафик только если выполнены ВСЕ три:
#  1) ip rule fwmark 0x1 → table 1000 ПРИСУТСТВУЕТ. Это ключевое: `vpn-toggle off`
#     снимает ИМЕННО это правило (default в table 1000 и бэкенд при этом остаются),
#     и marked-трафик идёт напрямую = VPN выключен. Без проверки п.1 тумблер врал
#     «включён» после выключения VPN.
#  2) в table 1000 есть default (несущая awg0/xtun);
#  3) бэкенд активного транспорта жив (awg → свежий handshake awg0 <180с; альт →
#     socks 10808 слушается = QUIC/Reality-сессия установлена).
# Бэкенд активного транспорта (НЕЗАВИСИМО от ip rule — чтобы «рукопожатие» в шапке
# показывалось и при выключенном VPN): awg → возраст рукопожатия awg0 (сек); альт →
# слушается ли socks 10808 (= QUIC/Reality-сессия установлена). hs_age=-1 → н/д
# (альт или ещё ни одного рукопожатия), backend=1 → бэкенд жив (awg: handshake <180с).
now=$(date +%s)
hs_age=-1; backend=0
case "$t" in
	awg)
		hs=$("$DB/awg" show awg0 latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')
		case "$hs" in ''|*[!0-9]*) hs=0 ;; esac
		# Возраст — через age_since (clock-lib.sh), НЕ «now - hs»: часы без RTC прыгают вперёд
		# через ~13 мин после загрузки, и шапка честного туннеля показывала «рукопожатие 21 час
		# назад» + backend=0, то есть «поднят, но не везёт». [[watchdog-clock-step-false-death]]
		if [ "$hs" -gt 0 ]; then hs_age=$(age_since "$hs"); [ "$hs_age" -lt 180 ] && backend=1; fi ;;
	# zapret — несущей нет (десинк на форварде): «бэкенд жив» = демон nfqws жив.
	zapret)
		zp=$(cat /tmp/enodia-zapret-nfqws.pid 2>/dev/null | tr -d ' \r\n')
		{ [ -n "$zp" ] && kill -0 "$zp" 2>/dev/null; } && backend=1 ;;
	*)
		netstat -ltn 2>/dev/null | grep -q '127.0.0.1:10808' && backend=1 ;;
esac

# VPN РЕАЛЬНО несёт трафик только при ВСЕХ трёх: ip rule fwmark→1000 (его снимает
# `vpn-toggle off`) + default в table 1000 + живой бэкенд активного транспорта.
# ZAPRET — особый: туннеля (default в table 1000) НЕТ by design (весь трафик напрямую),
# «активен» = демон nfqws жив + правило NFQUEUE на месте (десинк реально работает).
# ВЕРДИКТ СТОРОЖА о несущей. Единственный, кто РЕАЛЬНО щупает egress, — watchdog.sh (раз в
# 2 мин); панель поллится раз в 10 с и egress-проб не делает by design, поэтому её собственные
# признаки живости у альтов вырождены: `backend` для xray/hy2/byedpi — это буквально «socks 10808
# слушает», а слушает он и когда outbound давно не отвечает. Итог (жалоба тестера 09.08.2026):
# шапка держала зелёное «VPN включён · Xray · сессия активна · пинг 47 мс», пока сторож уже
# 15 минут писал «проба egress пуста» и держал прямой режим. Читаем его вердикт — файл дешёвый.
# ФАЙЛА НЕТ = ВЕРДИКТА НЕТ, а НЕ «всё хорошо»: /tmp/enodia-watchdog.xstate пишет только сторож, а
# КАЖДЫЙ плагин на up/down его СНОСИТ (grep `enodia-watchdog.xstate` — все пять) ⇒ сразу после
# ручного переключения мы честно молчим до первого тика, вместо того чтобы врать в любую сторону.
# awg ИСКЛЮЧЁН ЯВНО, а не «по факту того, что сторож ему xstate не пишет»: у awg есть точный
# собственный признак (возраст handshake), а xstate от ПРЕДЫДУЩЕГО альта в /tmp пережил бы
# переключение, не будь у каждого плагина `rm -f` на up/down — и панель показала бы «не везёт
# трафик» поверх свежего рукопожатия. Не полагаемся на чужую уборку там, где хватает одной ветки.
wd_carrier=""
[ "$t" = awg ] || case "$(cat /tmp/enodia-watchdog.xstate 2>/dev/null | tr -d ' \r\n')" in
	HEALTHY) wd_carrier=ok ;;
	SUSPECT) wd_carrier=suspect ;;
	FAILED)  wd_carrier=fail ;;
	*)       wd_carrier="" ;;
esac

live=0
if [ "$t" = zapret ]; then
	# «NFQUEUE где-то в POSTROUTING» — НЕ ответ про транспорт: очередь общая у транспорта,
	# доп-выхода и устройства «целиком в десинк» ⇒ живой ВЫХОД рисовал зелёное «Zapret активен»
	# поверх транспорта, чьи правила снёс fw3 reload. Спрашиваем владельца. Код 2 = старая копия
	# верба не знает (или файла нет) ⇒ судим как раньше: обновление ОДНОЙ панели не должно гасить
	# шапку на роутере, где скрипты постарше.
	_zrc=2
	[ -f "$D/zapret.sh" ] && { sh "$D/zapret.sh" t-wired >/dev/null 2>&1; _zrc=$?; }
	if [ "$_zrc" = 2 ]; then
		_zrc=1; iptables -t mangle -S POSTROUTING 2>/dev/null | grep -q NFQUEUE && _zrc=0
	fi
	[ "$backend" = 1 ] && [ "$_zrc" = 0 ] && live=1
elif ip rule show 2>/dev/null | grep -q 'fwmark 0x1' && [ -n "$(carrier_iface)" ] && [ "$backend" = 1 ]; then
	# «Несущая держит маршрут» спрашиваем у владельца (ip-lib.sh::carrier_iface, следит C81):
	# свой разбор `ip route show table 1000` тут был ЧЕТВЁРТОЙ копией того же ответа — а это
	# вердикт «жив ли VPN» в ШАПКЕ панели (ревью 3, 06.09.2026).
	live=1
fi

# Xray-подписка: из какой ПОДПИСКИ активный сервер (по префиксу sub-<tag>-, tag из .subs) —
# показываем в шапке «↳ подписка: …». cfg тут ещё СЫРОЕ имя файла (до подстановки имени ниже).
sub_label=""
if [ "$t" = xray ] && [ -n "$cfg" ] && [ -f "$DS/.subs" ]; then
	TAB=$(printf '\t')
	# Владелец = ДЛИНЕЙШИЙ подходящий тег, НЕ первый по порядку в файле: теги подписок
	# бывают префиксами друг друга («liberty» ⊂ «liberty-белые»), а «-» встречается и
	# ВНУТРИ тега ⇒ break на первом совпадении показывал бы метку чужой подписки (симптом:
	# конфиг верный, а «↳ подписка: …» врёт). Зеркало ownerTag() в panel.js и
	# del_sub_configs в cgi-bin/action.
	blen=-1
	while IFS="$TAB" read -r tg u lab; do
		[ -n "$tg" ] || continue
		case "$cfg" in sub-"$tg"-*)
			tl=${#tg}; [ "$tl" -gt "$blen" ] && { blen=$tl; sub_label="$lab"; } ;;
		esac
	done < "$DS/.subs"
fi
# Управляющие байты — вон вместе с кавычками: метка и ремарка (ниже) — ДАННЫЕ, их пишут панель и подписка, и сырой байт в JSON
# ронял бы разбор статуса на КАЖДОМ опросе — шапка «роутер не ответил» (ревью приёмки, круг 3). Диапазон первым — C111.
sub_label=$(echo "$sub_label" | tr -d '\000-\037"\\')

# ИМЯ ФАЙЛА — ОТДЕЛЬНЫМ ПОЛЕМ (`config_file`), до подмены ниже: `config` у сервера подписки — ремарка провайдера, а сверять
# «какой сервер активен» с именем файла по ремарке нельзя — экран активного сервера считал себя «не активным» на КАЖДОМ опросе
# и перечитывался каждые 10 с, стирая правку (ревью пачки 2, круг 2). Имя файла — [A-Za-z0-9_.-], фильтр — на всякий случай.
cfg_file=$(echo "$cfg" | tr -d '\000-\037"\\')
# Xray-подписка: показать НАСТОЯЩЕЕ имя сервера (из .sub-names, с эмодзи/флагом) вместо
# sub-<tag>-… — иначе шапка врала «sub-svpq96g-14» вместо выбранного «🇵🇱 Польша».
if [ "$t" = xray ] && [ -n "$cfg" ] && [ -f "$DS/.sub-names" ]; then
	fr=$(grep "^$cfg$(printf '\t')" "$DS/.sub-names" 2>/dev/null | head -1 | cut -f2-)
	[ -n "$fr" ] && cfg="$fr"
fi
# Конфиг, добавленный руками (vpn://, файл, ссылка): настоящее имя — у cfg-names.sh («Frankfurt 🇩🇪 vps» вместо файла
# Frankfurt-DE-vps). Спрашиваем ВЛАДЕЛЬЦА, ключ — вид и файл; не знает — остаётся то, что было.
case "$t" in awg|xray|hy2)
	# Файла имён нет — и спрашивать некого: status зовут раз в 10 с, а запуск владельца — это разбор ~37 КБ шелла (ревью с.95).
	if [ -n "$cfg_file" ] && [ -s "$DS/.cfg-names" ] && [ -f "$D/cfg-names.sh" ]; then
		fr=$(sh "$D/cfg-names.sh" get "$t" "$cfg_file" 2>/dev/null)
		[ -n "$fr" ] && cfg="$fr"
	fi ;;
esac

# Минимальный JSON-эскейп для имени конфига (убираем кавычки/бэкслеши и управляющие байты — см. sub_label выше).
cfg=$(echo "$cfg" | tr -d '\000-\037"\\')

# full-tunnel («весь трафик через VPN») — для динамического подзаголовка шапки
# (сплит vs весь-в-туннель). Флаг переживает ребут (на /data).
ft=false; [ -f "$DS/.full-tunnel" ] && ft=true

# Режим поддержки активен? (пидфайл dbclient жив И запись /tmp/.enodia-support-active есть). Дёшево —
# без egress-проб. Фронт держит индикатор «поддержка активна» в шапке, пока туннель открыт.
# …И ПОКА СОЕДИНЕНИЕ ВОССТАНАВЛИВАЕТСЯ — тоже: запись «доступ открыт до такого-то» жива, а туннель порвал сброс
# conntrack (смена транспорта), и до тика сторожа демона нет. Гасить в эти две минуты «поддержка активна» значило бы
# сказать «доступа нет» при открытом доступе. Мёртвый демон при живой записи — редкость, и тогда ответ берём у
# ВЛАДЕЛЬЦА (`support.sh status`: открыта ли сессия, есть ли чем её переподнять), своей копии правила здесь нет.
sup=0
if [ -s /tmp/.enodia-support-active ]; then
	# Срок — и на горячем пути: без `timeout -t` у туннеля и без сторожа (после «Отключить VPN») живой dbclient держал бы «поддержка
	# активна» и после срока; истёкшую запись закрывает вопрос владельцу ниже (ревью шага 6d, круг 3).
	read -r _sp _se _sr < /tmp/.enodia-support-active
	case "$_se" in ''|*[!0-9]*) _se=0 ;; esac
	sp=$(cat /tmp/enodia-support-tunnel.pid 2>/dev/null | tr -d ' \r\n')
	if [ "$(date +%s)" -lt "$_se" ] && [ -n "$sp" ] && kill -0 "$sp" 2>/dev/null; then sup=1
	elif [ -f "$D/support.sh" ] && sh "$D/support.sh" status 2>/dev/null | grep -q '"pending":1'; then sup=1
	fi
fi

# Готовые транспорты (плагин+конфиг+бинарь) — фронт подсветит доступные сегменты.
# Локально/быстро (только проверки файлов), без сети.
ready=$(sh "$D/transport.sh" list 2>/dev/null)
rj=""
for r in $ready; do rj="$rj${rj:+,}\"$r\""; done

# УСТАНОВЛЕН ≠ ГОТОВ. Пикер «Сменить транспорт» подписывал «не установлен» ВСЁ, чего нет в ready,
# и на роутере, где «Компоненты» показывают AmneziaWG и Zapret ПОСТАВЛЕННЫМИ, это прямая ложь: у
# первого просто нет сервера, у второго ядро не умеет NFQUEUE. Разницу считает роутер (ещё один
# лёгкий прогон по файлам, сети не трогает), а панель по ней НАЗЫВАЕТ ПРИЧИНУ. Старая копия
# скрипта верба не знает → список пуст ⇒ фронт ведёт себя как раньше.
inst=$(sh "$D/transport.sh" installed 2>/dev/null)
ij=""
for r in $inst; do ij="$ij${ij:+,}\"$r\""; done

# ВЫБРАН ЛИ ТРАНСПОРТ ВООБЩЕ. Установка «только панель» — штатное первое состояние роутера:
# панель есть, транспорта нет, правил в ядре нет. Шапке этого не вывести из полей выше: `t`
# там уже подставлен дефолтом awg, и роутер, где ничего не выбирали, выглядел бы как роутер
# со СЛОМАННЫМ AmneziaWG — то есть аварией вместо следующего шага. Ответ у оркестратора
# (пустой `.transport` И нет awg.conf); код 2 = старая копия скрипта ⇒ считаем «выбран».
tcfg=1
if [ -f "$D/transport.sh" ]; then
	sh "$D/transport.sh" configured >/dev/null 2>&1
	[ "$?" = 1 ] && tcfg=0
fi

# Непрочитанные события — колокольчику в шапке. Считаем здесь, а не отдельным
# запросом: шапка и так поллит статус, а лишний round-trip на каждый тик дороже,
# чем awk по журналу (≤100 строк). Старая установка без events.sh → 0.
# Гард `-f`, а НЕ `-x`: скрипт зовётся ЧЕРЕЗ `sh`, то есть бит исполнения ему не нужен вовсе,
# а снятый (дрейф деплоя, ручная копия, чужой архиватор) молча обнулял бы колокольчик — панель
# показывала бы «непрочитанных нет» при полном журнале. Класс граблей Б5-9.
ev_unread=0
[ -f "$D/events.sh" ] && ev_unread=$(sh "$D/events.sh" unread 2>/dev/null)
case "$ev_unread" in ''|*[!0-9]*) ev_unread=0 ;; esac

# Доп-выходы: сколько ВКЛЮЧЁННЫХ реально не везут свой трафик (`slots.sh state` — факты ядра,
# без egress-проб). Шапка держит индикатор «выход не работает»: до этого включённый выход с
# мёртвой несущей выглядел зелёным ВЕЗДЕ (реестр говорит on), а его сайты втихую ехали основным
# туннелем — или, при fallback=direct, вообще напрямую мимо VPN. Считаем здесь по той же
# причине, что и события: шапка и так поллит статус (10 с), отдельный round-trip дороже.
# ВЫКЛЮЧЕНО ЧЕЛОВЕКОМ — ОТДЕЛЬНОЕ ПОЛЕ, а не просто «live=0». Причин у «не везёт» теперь две, и
# для человека они РАЗНЫЕ: туннель упал (чинить) против «я сам выключил» (норма). До 02.09.2026
# второй не существовало — выключение жило до ребута; теперь это состояние на /data, и шапка
# обязана его называть, иначе выключенный своими руками роутер выглядит сломанным.
# Считаем ВЫШЕ доп-выходов: их вердикт от этого флага зависит (см. ниже).
voff=0; [ -f "$DS/.vpn-off" ] && voff=1

# ГДЕ РОУТЕР СТОИТ ОТНОСИТЕЛЬНО ДОМА (дом / резерв / прямой режим) и вернётся ли. Вердикт — у СТОРОЖА
# (`watchdog.sh standing`): правила возврата живут в его тике, и второго сравнения «текущее против
# домашнего» здесь быть не должно — ровно такое сравнение в панели и называло резерв «домом».
# ЗОВЁМ ТОЛЬКО ПО СТРОКЕ ВЕРБА В ФАЙЛЕ: старая копия сторожа аргументов не разбирает и на `standing`
# прогнала бы ПОЛНЫЙ ТИК — перебор серверов и failover на каждом опросе шапки. Нет верба — поля
# пустые (`back_in` = -1), и панель молчит, а не выдумывает. Это строка чужого stdout, а в JSON она уходит как есть:
# перечисления — только из белого списка, имя (`back_to`) — через `jesc`.
# jesc <лимит> — «текст роутера → строка внутри JSON» (json-lib.sh, одна копия на проект; разбор у
# cgi-bin/data). Шим = прежний конвейер, если либа не доехала.
if [ -f "$D/json-lib.sh" ]; then . "$D/json-lib.sh"; fi
command -v jesc >/dev/null 2>&1 || {
	jesc() { tr -d '\033\r' | sed 's/\[[0-9;]*m//g' | tr '\n\t' '  ' | cut -c1-"$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
}
fo_st=""; fo_back=""; fo_to=""; fo_in=-1; fo_md=""; fo_why=""; fo_hw=""; fo_of=""; fo_ofa=""
if [ -f "$D/watchdog.sh" ] && grep -q '^\[ "\$1" = standing \]' "$D/watchdog.sh"; then
	while IFS='=' read -r k v; do
		case "$k" in
			standing) case "$v" in none|off|boot|direct|reserve|home|unset) fo_st=$v ;; esac ;;
			back)     case "$v" in transport|server|none) fo_back=$v ;; esac ;;
			back_to)  fo_to=$(printf '%s' "$v" | jesc 64) ;;
			back_in)  case "$v" in -1) fo_in=-1 ;; ''|*[!0-9]*) ;; *) fo_in=$v ;; esac ;;
			mode)     case "$v" in off|sticky|home) fo_md=$v ;; esac ;;
			# …и ЧТО МЕШАЕТ ПОПЫТКЕ при обещанном возврате: wan|unhealthy (то же поле, другой вопрос).
			# `noprog` — только в прямом режиме туннеля: программы активного протокола на роутере нет, сам не выйдет.
			back_why) case "$v" in mode|noprog|pair|not_ready|blind|gone|no_orc|no_switch|wan|unhealthy|raising|switching|unwired|stuck) fo_why=$v ;; '') ;; *) fo_why=unknown ;; esac ;;
			# Почему не вернётся домашний ПРОТОКОЛ при обещанном возврате сервера: набор тот же, что у
			# back_why при back=none (стенд сверяет, что оба белых списка не разъехались).
			home_why) case "$v" in mode|noprog|pair|not_ready|blind|gone|no_orc|no_switch) fo_hw=$v ;; '') ;; *) fo_hw=unknown ;; esac ;;
			# «Куда уведёт падение» — имя транспорта; список тот же, что у SELECTABLE оркестратора.
			back_on_fail) case "$v" in awg|xray|hy2|byedpi|zapret) fo_of=$v ;; esac ;;
			# КОГДА случится переход по падению: сразу (режим «Выкл») или после перебора серверов.
			back_on_fail_at) case "$v" in now|pool) fo_ofa=$v ;; esac ;;
		esac
	done <<EOF
$(sh "$D/watchdog.sh" standing 2>/dev/null)
EOF
fi

ex_on=0; ex_bad=0
if [ -f "$D/slots.sh" ] && [ -s "$DS/.slots" ]; then
	for st in $(sh "$D/slots.sh" state 2>/dev/null | cut -f2); do
		case "$st" in
			off) ;;
			up|idle) ex_on=$((ex_on+1)) ;;
			# «НЕ РАБОТАЕТ» — ЭТО ДИАГНОЗ, а при выключенном человеком VPN опущенный выход
			# НОРМА: с 02.09.2026 `off` гасит и несущие доп-выходов (иначе zapret-выход
			# продолжал десинкать — замер на железе). Без этого гейта роутер, который человек
			# сам же и выключил, показывал в шапке красную пилюлю «выход не работает» и звал
			# чинить исправное. Флаг спрашиваем здесь, а не во фронте: своей арифметики у
			# панели нет — она рисует то, что сказал роутер.
			*) ex_on=$((ex_on+1)); [ "$voff" = 1 ] || ex_bad=$((ex_bad+1)) ;;
		esac
	done
fi
printf '{"transport":"%s","proto_label":"%s","config":"%s","config_file":"%s","sub_label":"%s","live":%s,"vpn_off":%s,"backend":%s,"carrier":"%s","standing":"%s","back":"%s","back_to":"%s","back_in":%s,"fo_mode":"%s","back_why":"%s","home_why":"%s","back_on_fail":"%s","back_on_fail_at":"%s","hs_age":%s,"ready":[%s],"installed":[%s],"configured":%s,"full_tunnel":%s,"support_active":%s,"events_unread":%s,"exits_on":%s,"exits_bad":%s,"model":"%s","fw":"%s","cpu_pct":%s,"ram_free":%s,"ram_total":%s,"disk_free":%s,"disk_total":%s,"disk_used":%s,"disk_used_pct":"%s","store_state":"%s","store_pct":%s,"store_free":%s,"store_total":%s,"ts":%s}\n' \
	"$t" "$label" "${cfg:-?}" "$cfg_file" "$sub_label" "${live:-0}" "$voff" "${backend:-0}" "$wd_carrier" "$fo_st" "$fo_back" "$fo_to" "$fo_in" "$fo_md" "$fo_why" "$fo_hw" "$fo_of" "$fo_ofa" "${hs_age:--1}" "$rj" "$ij" "$tcfg" "$ft" "$sup" "$ev_unread" "$ex_on" "$ex_bad" "$model" "$fw" "${cpu:-0}" "${ramfree:-0}" "${ramtot:-0}" "${diskfree:-0}" "${disktot:-0}" "${diskused:-null}" "${diskpct:-?}" "$stst" "${storepct:-0}" "${storefree:-0}" "${storetot:-0}" "$now"
