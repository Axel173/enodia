#!/bin/sh
# cgi-bin/traffic — трафик для панели (read-only, без сетевых проб).
# Зовётся uhttpd (CGI) ТОЛЬКО после HTTP-Basic. Состояние НЕ меняет.
#
# Отдаёт: (1) мгновенные кумулятивные счётчики VPN-несущей (awg0/xtun), WAN (eth0) и несущих
# доп-выходов (`exits[].cur_*`) вместе с ТОЧНОЙ отметкой `up` (аптайм с сотыми) — фронт по дельте
# между опросами считает ТЕКУЩУЮ скорость; (2) суммы за сегодня/неделю/
# месяц/год и (3) массив последних дней для столбчатого графика — из посуточного файла
# `.traffic-daily`, который пишет фоновый `traffic-acct.sh` (cron */5). Чтобы цифры были
# «живыми» между тиками cron, к суммам ПРИБАВЛЯЕМ незаписанную дельту (текущие счётчики −
# последний замер `.traffic-last`). (4) РАЗРЕЗ ПО ВЫХОДАМ — сколько прошло через каждый
# доп-выход и сколько мимо всех туннелей («напрямую»), И ТО, И ДРУГОЕ ЗА ЧЕТЫРЕ ОКНА (сегодня ·
# 7 дней · 30 дней · год): экран «Трафик» строит на них разрезы, а вычитание «WAN минус несущая
# минус выходы» обязано иметь ОДНОГО владельца — панель своего не считает.
# С `?live=1` — ТОЛЬКО пункт (1), без проходов по посуточному файлу: его просит живая скорость
# в шапке, когда карточки трафика не видны (разбор у ветки «ЛЁГКИЙ ОТВЕТ» ниже).
# С `?dev=<окно>` / `?dmac=<mac>` — РАЗРЕЗ ПО УСТРОЙСТВАМ, свой ответ у своего владельца (traffic-dev.sh: счётчики прошивки
# trafficd по MAC; по IP роутер считать не может — NSS-offload уводит потоки мимо netfilter). Числа — %.0f (awk-double до 2^53),
# НЕ %d (busybox awk %d 32-битный → переполнение на счётчиках >2 ГБ).
# 2FA-гейт (totp.sh) — см. разбор в cgi-bin/status.
# uhttpd НЕ ПЕРЕДАЁТ CGI своё окружение (замер на железе 01.09.2026 пробным CGI: все ENODIA_*
# пусты), а в режиме «всё на накопителе» литералы указывают в пустоту — панель отвечала бы
# «ничего не установлено» на живой системе, а ГЕЙТ ВТОРОГО ФАКТОРА ниже просто не находил бы
# totp.sh и молча пропускал запрос. Каталог кода знаем бесплатно из $0, остальное разбирает
# cgi-paths.sh: второй копии этого рассуждения в проекте быть не должно.
_cgid=${0%/web/cgi-bin/*}; [ "$_cgid" = "$0" ] && _cgid=
if [ -n "$_cgid" ] && [ -f "$_cgid/cgi-paths.sh" ]; then . "$_cgid/cgi-paths.sh"; fi
if [ -f "$ENODIA_DIR/totp.sh" ]; then
	TOTP_LIB=1; . "$ENODIA_DIR/totp.sh"
	# СУДИМ ПО СПОСОБНОСТИ, А НЕ ПО НАЛИЧИЮ. totp.sh СТАРЕЕ формы входа сорсится успешно, но его
	# гейт при выключенном 2FA пропускал всё — а uhttpd к этому моменту уже поднят БЕЗ `-c`, то
	# есть панель отдавала бы данные и ДЕЙСТВИЯ без пароля. Признак эпохи — pw_verify (его же
	# спрашивает cgi-bin/login).
	command -v pw_verify >/dev/null 2>&1 || {
		echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
		echo "Cache-Control: no-store"; echo ""
		printf '{"ok":false,"need_login":true,"msg":"totp.sh старее формы входа (обновите панель)"}\n'; exit 0; }
	totp_gate_deny
else   # НЕТ totp.sh — ОТКАЗ, А НЕ ПРОПУСК: двери-Basic больше нет, пускать некому (разбор — в totp.sh, «Гейт»)
	echo "Status: 403 Forbidden"; echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"; echo ""
	printf '{"ok":false,"need_login":true,"msg":"totp.sh не установлен (обновите панель)"}\n'; exit 0
fi
echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

D=${ENODIA_DIR:-/data/usr/app/enodia}
DS=${ENODIA_STATE:-/data/usr/app/enodia-state}
LAST="$DS/.traffic-last"
DAILY="$DS/.traffic-daily"
# BY DEVICE (`?dev=<window>` — the «Устройства» tab, `?dmac=<mac>` — the device screen): its own answer from its owner
# (traffic-dev.sh), before every pass below — the tab asks for the devices only, and none of the interface sums is needed.
# The values are checked by the script (window from a list, MAC by mac_ok); `%3A` — a MAC the browser encoded.
case "$QUERY_STRING" in
	*dmac=*|dev=*|*'&dev='*)
		if [ ! -f "$D/traffic-dev.sh" ]; then printf '{"ok":false,"msg":"traffic-dev.sh не установлен (обновите панель)"}\n'; exit 0; fi
		case "$QUERY_STRING" in
			*dmac=*) _tq=${QUERY_STRING#*dmac=}; _tq=${_tq%%&*}; _tq=$(printf '%s' "$_tq" | sed 's/%3[Aa]/:/g')
			         sh "$D/traffic-dev.sh" json-mac "$_tq" 2>/dev/null ;;
			*) _tq=${QUERY_STRING#*dev=}; _tq=${_tq%%&*}; sh "$D/traffic-dev.sh" json "$_tq" 2>/dev/null ;;
		esac
		exit 0 ;;
esac
# trim + дефолт: `cat || echo awg` не ловил пустой-но-существующий .transport (t="" → vif=xtun,
# и счётчики VPN читались с xtun вместо awg0). См. ту же грабля в cgi-bin/status.
t=$(cat "$DS/.transport" 2>/dev/null | tr -d ' \r\n')
# Пусто = ЛИБО роутер СТАРШЕ флага (несущая там awg — историческое поведение, ломать нельзя), ЛИБО
# установка «только панель», где транспорта нет вовсе. Отличает их ОДИН владелец — оркестратор;
# код 2 = старая копия скрипта ⇒ ведём себя как раньше. Без этого карточка подписывалась «Трафик ·
# awg0» на роутере, где awg0 не существует и наших правил нет вообще (замерено на AX3600
# 16.08.2026) — шапка честно писала «Протокол не выбран», а карточка тут же называла несущую.
# Фолбэк на awg спрашиваем ТОЛЬКО при пустом флаге, то есть на настроенном роутере форка нет.
if [ -z "$t" ]; then
    t=awg
    if [ -f "$D/transport.sh" ]; then
        sh "$D/transport.sh" configured >/dev/null 2>&1
        [ "$?" = 1 ] && t=none
    fi
fi
# Пустой vif панель рисует как «Трафик» без имени интерфейса (см. tr-vif в panel.js).
# zapret — В ОДНОЙ ВЕТКЕ С none: у десинка несущей НЕТ ВООБЩЕ (весь трафик идёт напрямую), а
# `*)` подписывал карточку несуществующим xtun и держал «через VPN» вечным нулём. Класс тот же,
# что «вилка забыла альт ⇒ шапка врёт AmneziaWG»: у каждой вилки по транспорту спрашивай, знает
# ли она все пять. Ту же ветку держит traffic-acct.sh (там "-", здесь "" — см. его комментарий);
# на zapret и none счётчики несущей нулевые в любом случае, поэтому расхождение первого поля с
# .traffic-last ничего не стоит.
case "$t" in none|zapret) vif="" ;; awg) vif=awg0 ;; *) vif=xtun ;; esac
# Имя WAN — у владельца (ip-lib.sh::wan_iface, следит C81; та же строка у писателя traffic-acct.sh); шим = прежняя.
if [ -f "$D/ip-lib.sh" ]; then . "$D/ip-lib.sh"; fi
command -v wan_iface >/dev/null 2>&1 || wan_iface() { ip route show default 2>/dev/null | awk '/^default/{d=""; for(i=1;i<=NF;i++) if($i=="dev") d=$(i+1); if(d!="" && d !~ /^(awg|xtun)/){print d; exit}}'; }
wan_if=$(wan_iface)

devbytes() { sed 's/:/ /' /proc/net/dev 2>/dev/null | awk -v i="$1" '$1==i{print $2" "$10; f=1} END{if(!f)print "0 0"}'; }
set -- $(devbytes "$vif");          vrx=${1:-0}; vtx=${2:-0}
set -- $(devbytes "${wan_if:-_}");  wrx=${1:-0}; wtx=${2:-0}
# ТОЧНАЯ ОТМЕТКА К ЭТИМ СЧЁТЧИКАМ — аптайм ядра с сотыми, прочитанный СРАЗУ за ними (шаг 2j
# редизайна: живая скорость в шапке). Скорость панель считает дельтой счётчиков между двумя
# опросами, и делить её на `ts` нельзя: `date +%s` — это ЦЕЛЫЕ секунды, а на пятисекундном тике
# секунда туда-сюда даёт до 20 % ошибки, то есть линия в шапке прыгала бы на ровном трафике.
# Чтение своё, а не у владельца аптайма в clock-lib.sh: тот отдаёт целые секунды — ровно то, от
# чего здесь уходим, — и вердикта по числу тут нет, оно уезжает в JSON делителем. Встроенный
# `read`, без форка: CGI зовут раз в пять секунд.
{ read -r up _ < /proc/uptime; } 2>/dev/null   # raw-uptime: делитель скорости в JSON, нужны сотые
# Форма числа — ровно «цифры[.цифры]»: поле уезжает в JSON без кавычек, и огрызок вроде «5.»
# сломал бы ответ целиком. Ноль панель понимает как «точной отметки нет» и берёт `ts`.
case "$up" in ''|*[!0-9.]*|.*|*.|*.*.*) up=0 ;; esac

# незаписанная дельта (текущие счётчики − последний замер acct'а), с детектом обнуления.
# Формат .traffic-last — КОНТРАКТ с traffic-acct.sh: "vif vrx vtx wrx wtx wif". Шестое поле (имя
# WAN-iface) дописано 04.08.2026 и ЧИТАТЬ ЕГО ОБЯЗАТЕЛЬНО: без него `read` сложил бы «wtx wif» в
# одну переменную, та не прошла бы числовую проверку → lwtx=0 → «незаписанной дельтой» показался
# бы ВЕСЬ кумулятивный счётчик WAN. Старый файл из пяти полей → lwif пуст → судим как раньше.
# СТАРТОВОЕ `lwif="?"` — не мелочь: пустая строка тут означает «файл СТАРОГО формата, суди как
# раньше», и она же доставалась случаю «файла НЕТ ВОВСЕ». Тогда `wsame` выходил истинным при
# lwrx=0, и «незаписанной дельтой» объявлялся ВЕСЬ кумулятивный счётчик WAN. Видно это на КАЖДОЙ
# свежей установке: замерено на AX3600 16.08.2026 — панель через минуту после установки писала
# «сегодня через интернет 14.2 ГБ» (это счётчик с последней перезагрузки роутера), и так до первого
# тика traffic-acct (до 5 минут). «?» = «в прошлый замер базы не было» — ровно наша ситуация, и
# ветка wunk ниже честно даёт ноль. Пятиполевый файл старого формата затрёт «?» пустой строкой
# сам (шестого поля в нём нет) — прежнее поведение сохраняется.
lvif=""; lvrx=0; lvtx=0; lwrx=0; lwtx=0; lwif="?"
[ -f "$LAST" ] && read lvif lvrx lvtx lwrx lwtx lwif < "$LAST"
for n in lvrx lvtx lwrx lwtx; do eval "x=\$$n"; case "$x" in ''|*[!0-9]*) eval "$n=0";; esac; done
set -- $(awk -v vif="$vif" -v lvif="$lvif" -v vrx="$vrx" -v vtx="$vtx" -v wrx="$wrx" -v wtx="$wtx" \
             -v lvrx="$lvrx" -v lvtx="$lvtx" -v lwrx="$lwrx" -v lwtx="$lwtx" \
             -v wif="${wan_if:-?}" -v lwif="$lwif" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f";
    wsame=(lwif=="" || wif==lwif); wunk=(lwif=="?");   # "?" = в прошлый замер WAN не существовало
    printf "%.0f %.0f %.0f %.0f",
      (vif==lvif&&vrx>=lvrx)?vrx-lvrx:(vif==lvif?vrx:0),
      (vif==lvif&&vtx>=lvtx)?vtx-lvtx:(vif==lvif?vtx:0),
      wunk?0:((wsame&&wrx>=lwrx)?wrx-lwrx:(wsame?wrx:0)),
      wunk?0:((wsame&&wtx>=lwtx)?wtx-lwtx:(wsame?wtx:0)) }')
uvr=${1:-0}; uvt=${2:-0}; uwr=${3:-0}; uwt=${4:-0}

now=$(date +%s); today=$(date +%F)
src="$DAILY"; [ -f "$src" ] || src=/dev/null

# --- ДОП-ВЫХОДЫ: сколько прошло через КАЖДЫЙ (шаг 2f) ---------------------------------------
# ИМЯ НЕСУЩЕЙ ВЫХОДА БЕРЁМ ИЗ `.traffic-last`, А НЕ У ОРКЕСТРАТОРА. Спросить `transport.sh
# slot-iface` было бы честнее по форме, но панель дёргает этот CGI РАЗ В ПЯТЬ СЕКУНД, а один
# такой вопрос — три форка (transport.sh -> slots.sh show -> плагин). Писатель (traffic-acct.sh,
# cron */5) уже спросил и записал ответ строкой "s<id> <iface> <rx> <tx>" — читаем готовое.
# ОТСУТСТВИЕ СТРОКИ = НЕТ ЖИВОЙ НЕСУЩЕЙ, и это ещё не приговор: у zapret-выхода её нет ВООБЩЕ
# (десинк идёт напрямую, его объём физически неотделим от прямого) — вот он и правда без счётчика;
# а у выключенного в обед её уже нет, зато сегодняшний объём лежит в полях посуточного файла.
# Итог «считать нечем» складывается ниже из ОБОИХ признаков, а не из одного этого.
# Exit ids = slots.sh MIN_ID..MAX_ID (C130 checks this list) — the same list as the writer's. Per-exit values live in
# variables NAMED by the id (sl<k>if, ls<k>rx, s<k>r …); `eval` only ever sees our names and a digit from this list
# or a `[2-7]` case. The daily tail is positional: exit k at $(2k+3)/$(2k+4) — the first three exits keep $7..$12 as before.
SLOT_IDS="2 3 4 5 6 7"
for _k in $SLOT_IDS; do eval "sl${_k}if=''; ls${_k}rx=0; ls${_k}tx=0"; _kmax=$_k; done
if [ -f "$LAST" ]; then
	while read -r _k _i _r _t; do
		case "$_k" in s[2-7]) _n=${_k#s}; eval "sl${_n}if=\$_i; ls${_n}rx=\$_r; ls${_n}tx=\$_t" ;; esac
	done < "$LAST"
fi
for _k in $SLOT_IDS; do
	for n in ls${_k}rx ls${_k}tx; do eval "x=\$$n"; case "$x" in ''|*[!0-9]*) eval "$n=0";; esac; done
done
# Незаписанная дельта выхода — ТА ЖЕ ЛЕСТНИЦА, что у несущей выше: имя то же и счётчик вырос ⇒
# разность; счётчик упал ⇒ интерфейс пересоздали, отсчёт от нуля; интерфейса нет ⇒ ноль.
# Сравнивать имя с прошлым не нужно: оно ОТТУДА ЖЕ и по определению совпадает — здесь мы лишь
# доводим счёт до «сейчас», а смену несущей выхода судит писатель.
# Вторая пара — СЫРОЙ счётчик несущей «сейчас» (шаг 2j): живую скорость «напрямую» панель
# считает как «весь WAN минус несущая минус выходы» за последние секунды, а дельту между двумя
# опросами можно брать только у счётчиков, прочитанных ИЗ ЯДРА. Дельта «сегодняшних» объёмов
# ниже для этого не годится: на тике cron писатель переносит байты из `.traffic-last` в посуточный
# файл, и CGI, прочитавший файлы посередине записи, отдал бы разом пять минут трафика — пик,
# которого не было. Чтение то же самое, что для дельты: ни одного лишнего форка.
slot_now() {   # <iface> <прошлый rx> <прошлый tx> -> "drx dtx rx tx" (незаписанная дельта + сырой счётчик)
	[ -n "$1" ] || { echo "0 0 0 0"; return; }
	set -- $(devbytes "$1") "$2" "$3"
	awk -v r="$1" -v t="$2" -v lr="$3" -v lt="$4" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f";
		printf "%.0f %.0f %.0f %.0f", (r>=lr)?r-lr:r, (t>=lt)?t-lt:t, r, t }'
}
# Гард на КАЖДОМ вызове — не дубль внутреннего: `$( )` порождает подоболочку ДО того, как функция
# успеет выйти по своему `[ -n "$1" ]`, то есть на роутере без выходов (это большинство) мы платили
# бы тремя форками за три гарантированных нуля — двенадцать раз в минуту.
# The unwritten deltas reach the awk passes below through the ENVIRONMENT (TU<k>R / TU<k>T): busybox awk has no
# split(), and a `-v` per exit would be one more hand-kept list of ids in every pass.
for _k in $SLOT_IDS; do
	eval "_i=\$sl${_k}if; _lr=\$ls${_k}rx; _lt=\$ls${_k}tx"
	_u="0 0 0 0"; [ -n "$_i" ] && _u=$(slot_now "$_i" "$_lr" "$_lt")
	set -- $_u; export "TU${_k}R=${1:-0}" "TU${_k}T=${2:-0}"; eval "cs${_k}r=\${3:-0}; cs${_k}t=\${4:-0}"
done

# --- ЛЁГКИЙ ОТВЕТ (`?live=1`): ТОЛЬКО СЧЁТЧИКИ «СЕЙЧАС» (шаг 2j) ---------------------------------
# Живой скорости в шапке нужны счётчики и точная отметка — и ничего из того, ради чего этот CGI
# дорог: окна за неделю/месяц/год и столбцы по дням — это проходы awk по посуточному файлу. Панель
# просит лёгкий ответ, когда ни одна карточка трафика не видна (обе выключены или свёрнуты), и
# тогда обещание экрана «Карточки главной» — «выключенная карточка — меньше работы для роутера» —
# остаётся правдой и для них: без этой ветки шапка тянула бы полный разбор ради двух чисел.
# Поля — ТЕ ЖЕ ИМЕНА и тот же смысл, что у полного ответа (панель считает скорость одной функцией
# по любому из двух), а `light` говорит, что сумм и дней тут нет вовсе, а не «они нулевые».
# Выходы — только с несущей: у выхода без неё вычитать из провода нечего (разбор у slot_now).
# Exits without a carrier are skipped: there is nothing to subtract from the wire for them (see slot_now).
case "$QUERY_STRING" in *live=1*)
	lex=''
	for _k in $SLOT_IDS; do
		eval "_i=\$sl${_k}if; _cr=\$cs${_k}r; _ct=\$cs${_k}t"
		[ -n "$_i" ] || continue
		case "$_i" in *[!a-z0-9._-]*) continue ;; esac
		lex="$lex${lex:+,}{\"id\":$_k,\"if\":\"$_i\",\"cur_rx\":$_cr,\"cur_tx\":$_ct}"
	done
	# «Сегодня» шапки «Обзора» — одна строка посуточного файла (сегодняшняя) плюс незаписанная дельта: один проход awk без окон и дней.
	set -- $(awk -v today="$today" -v uvr="$uvr" -v uvt="$uvt" -v uwr="$uwr" -v uwt="$uwt" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f"}
		$2==today{a+=$3;b+=$4;c+=$5;d+=$6} END{printf "%.0f %.0f %.0f %.0f", a+uvr, b+uvt, c+uwr, d+uwt}' "$src" 2>/dev/null)
	printf '{"light":1,"transport":"%s","vif":"%s","wan_if":"%s","vpn_rx":%s,"vpn_tx":%s,"wan_rx":%s,"wan_tx":%s,"exits":[%s],"today_vpn_rx":%s,"today_vpn_tx":%s,"today_wan_rx":%s,"today_wan_tx":%s,"ts":%s,"up":%s}\n' \
		"$t" "$vif" "${wan_if:-?}" "${vrx:-0}" "${vtx:-0}" "${wrx:-0}" "${wtx:-0}" "$lex" "${1:-0}" "${2:-0}" "${3:-0}" "${4:-0}" "$now" "$up"
	exit 0 ;;
esac
# Суммы по выходам — отдельным проходом по тому же файлу. ГАРД — «ЕСТЬ ЛИ ВЫХОДЫ ВООБЩЕ», а НЕ
# «есть ли у них несущая сейчас»: выход, выключенный в обед, уже унёс сегодня свои гигабайты, и
# они лежат в полях хвоста ($7 и дальше). Спроси мы только про живые несущие — эти байты вычлись бы из
# «напрямую» (там их нет) и не показались бы нигде: доли перестали бы сходиться в сто процентов,
# а объём молча пропал бы с экрана. На роутере без выходов реестра нет и форка не будет.
#
# ЧЕТЫРЕ ОКНА, А НЕ ОДНО (шаг 2g). Экрану «Трафик» тот же разрез нужен за неделю, месяц и год —
# и посчитать его ОБЯЗАН роутер: «напрямую» за период это ВЫЧИТАНИЕ (весь WAN минус несущая минус
# выходы), а второй владелец того же вычитания в панели разошёлся бы с первым. Окна считаются В
# ТОМ ЖЕ ПРОХОДЕ: файл читается один раз, лишнего форка не появилось.
#
# ВЫВОД ИМЕНОВАННЫЙ (`eval`), А НЕ ПОЗИЦИОННЫЙ. Чисел стало тридцать два, и `set --` с `${25}` —
# ровно тот класс ошибки, за который в этом файле уже платили («седьмое поле уехало бы в wif»).
# Опасности в eval тут нет: awk печатает ТОЛЬКО наши имена и ТОЛЬКО числа через `%.0f`, ни один
# байт из файла состояния в имена не попадает. Инициализация нулями ОБЯЗАТЕЛЬНА и выше eval:
# awk не запустился (нет файла, нет прав) ⇒ переменных бы не стало вовсе.
for _k in $SLOT_IDS; do eval "s${_k}r=0; s${_k}t=0; w${_k}r=0; w${_k}t=0; m${_k}r=0; m${_k}t=0; y${_k}r=0; y${_k}t=0"; done   # сегодня · 7 · 30 дней · год
sxr=0; sxt=0; wxr=0; wxt=0; mxr=0; mxt=0; yxr=0; yxt=0   # суммы всех выходов по окнам
if [ -s "$DS/.slots" ]; then
	# Незаписанную дельту прибавляем ВНУТРИ awk: `$(())` у busybox бывает 32-битной, а суточный
	# объём выхода легко переваливает за 2 ГБ — ровно та грабля, из-за которой весь этот файл
	# считает через awk-double (точен до 2^53 ≈ 9 ПБ). Она относится к «сейчас» ⇒ входит во ВСЕ
	# окна, как и u* у несущей ниже.
	eval "$(awk -v today="$today" -v now="$now" -v km="$_kmax" \
	  'BEGIN{OFMT="%.0f";CONVFMT="%.0f"}
	  { ep=$1+0
	    for(k=2;k<=km;k++){ f=2*k+3; r=$f+0; t=$(f+1)+0
	      if($2==today)       { dr[k]+=r; dt[k]+=t }
	      if(ep>=now-604800)  { ar[k]+=r; at[k]+=t }
	      if(ep>=now-2592000) { br[k]+=r; bt[k]+=t }
	      if(ep>=now-31536000){ cr[k]+=r; ct[k]+=t } } }
	  END{ for(k=2;k<=km;k++){ ur=ENVIRON["TU" k "R"]+0; ut=ENVIRON["TU" k "T"]+0
	         printf "s%dr=%.0f s%dt=%.0f w%dr=%.0f w%dt=%.0f m%dr=%.0f m%dt=%.0f y%dr=%.0f y%dt=%.0f\n", k, dr[k]+ur, k, dt[k]+ut, k, ar[k]+ur, k, at[k]+ut, k, br[k]+ur, k, bt[k]+ut, k, cr[k]+ur, k, ct[k]+ut
	         xd1+=dr[k]+ur; xd2+=dt[k]+ut; xa1+=ar[k]+ur; xa2+=at[k]+ut; xb1+=br[k]+ur; xb2+=bt[k]+ut; xc1+=cr[k]+ur; xc2+=ct[k]+ut }
	       printf "sxr=%.0f sxt=%.0f wxr=%.0f wxt=%.0f mxr=%.0f mxt=%.0f yxr=%.0f yxt=%.0f\n", xd1, xd2, xa1, xa2, xb1, xb2, xc1, xc2 }' "$src")"
fi

# суммы по периодам (+ незаписанная дельта u* — она относится к «сейчас» = во все периоды)
set -- $(awk -v now="$now" -v today="$today" -v uvr="$uvr" -v uvt="$uvt" -v uwr="$uwr" -v uwt="$uwt" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f"}
{
  e=$1+0;
  if($2==today){dvr+=$3;dvt+=$4;dwr+=$5;dwt+=$6}
  if(e>=now-604800){wvr+=$3;wvt+=$4;wwr+=$5;wwt+=$6}
  if(e>=now-2592000){mvr+=$3;mvt+=$4;mwr+=$5;mwt+=$6}
  if(e>=now-31536000){yvr+=$3;yvt+=$4;ywr+=$5;ywt+=$6}
}
END{ printf "%.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f",
  dvr+uvr,dvt+uvt,dwr+uwr,dwt+uwt, wvr+uvr,wvt+uvt,wwr+uwr,wwt+uwt,
  mvr+uvr,mvt+uvt,mwr+uwr,mwt+uwt, yvr+uvr,yvt+uvt,ywr+uwr,ywt+uwt }' "$src")
tdvr=${1:-0}; tdvt=${2:-0}; tdwr=${3:-0}; tdwt=${4:-0}
wvr=${5:-0};  wvt=${6:-0};  wwr=${7:-0};  wwt=${8:-0}
mvr=${9:-0};  mvt=${10:-0}; mwr=${11:-0}; mwt=${12:-0}
yvr=${13:-0}; yvt=${14:-0}; ywr=${15:-0}; ywt=${16:-0}

# ПРОШЛОЕ ОКНО — ДЛЯ ПЛИТОК ЭКРАНА «ТРАФИК» («−4 % к прошлой», «↑ 3 п.п.» доли туннеля; макет, Л6). Сумма прошлого окна — то же
# чтение того же файла, и считать её обязан роутер: панель своей арифметики над историей не держит. Окна: вчера (к «сегодня»),
# [14..7) дней назад, [60..30) и [730..365). `full` — история покрывает прошлое окно ЦЕЛИКОМ (первая строка файла не позже его
# начала, с запасом в сутки: отметка строки — первый тик учёта за день); неполное окно сравнивать нельзя — плитка молчит, а не
# рисует «+900 %» против двух дней истории. Вчерашний день — последняя строка до сегодняшней, и только если ей не больше двух суток.
# Вывод ИМЕНОВАННЫЙ (`eval`, как у выходов выше): awk печатает только наши имена и только числа.
pdv=0; pdw=0; pdf=0; pwv=0; pww=0; pwf=0; pmv=0; pmw=0; pmf=0; pyv=0; pyw=0; pyf=0
eval "$(awk -v now="$now" -v today="$today" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f"}
	{ e=$1+0; if(NR==1) first=e
	  if($2!=today){ yv=$3+$4; yw=$5+$6; ye=e }
	  if(e>=now-1209600 && e<now-604800){ wv+=$3+$4; ww+=$5+$6 }
	  if(e>=now-5184000 && e<now-2592000){ mv+=$3+$4; mw+=$5+$6 }
	  if(e>=now-63072000 && e<now-31536000){ av+=$3+$4; aw+=$5+$6 } }
	END{ if(!NR) exit
	     printf "pdv=%.0f pdw=%.0f pdf=%d\n", yv, yw, (ye>0 && ye>=now-172800) ? 1 : 0
	     printf "pwv=%.0f pww=%.0f pwf=%d\n", wv, ww, (first<=now-1209600+86400) ? 1 : 0
	     printf "pmv=%.0f pmw=%.0f pmf=%d\n", mv, mw, (first<=now-5184000+86400) ? 1 : 0
	     printf "pyv=%.0f pyw=%.0f pyf=%d\n", av, aw, (first<=now-63072000+86400) ? 1 : 0 }' "$src" 2>/dev/null)"
pbool() { [ "$1" = 1 ] && echo true || echo false; }

# окно графика: week=7 дней, month=30 дней (дневные столбцы), year=12 месяцев (агрегат).
# Во всех случаях сегодняшний столбец += незаписанная дельта (живой бар). Данные берём из
# того же посуточного файла (traffic-acct держит 400 дней). busybox awk: только массивы+substr.
# ВЫХОДЫ ЗА ДЕНЬ (`x` = [выход 2 … 7], rx+tx) — ТОЛЬКО у дня, где хвост выходов ЕСТЬ (12+ полей):
# подсказка графика делит «мимо туннеля» на выходы и «напрямую» лишь там, где делить есть ЧЕМ. День
# из шести полей — либо выходов без несущей, либо записанный до 10.09.2026, когда хвоста не было
# вовсе; различить их нечем, и ноль в `x` соврал бы про второй случай. Месяц года получает `x`, только если
# хвост есть у ВСЕХ его записанных дней: у переходного месяца (сентябрь 2026 — дни до 10-го без хвоста) выходы
# занизились бы, а «напрямую» выросло (ревью пачки 2, круг 3). Такой месяц делится честно надвое, как день без хвоста.
rng=week
case "$QUERY_STRING" in *chart=year*) rng=year ;; *chart=month*) rng=month ;; esac

if [ "$rng" = year ]; then
	days=$(awk -v today="$today" -v uvr="$uvr" -v uvt="$uvt" -v uwr="$uwr" -v uwt="$uwt" -v km="$_kmax" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f"}
	{ k=substr($2,1,7); v[k]+=$3+$4; w[k]+=$5+$6; if(!(k in seen)){seen[k]=1; ord[++n]=k}
	  nr[k]++; if(NF>=12){ nx[k]++; for(j=2;j<=km;j++){ f=2*j+3; x[k "_" j]+=$f+$(f+1) } } }
	END{ for(k in nr) if(nx[k]==nr[k]) hx[k]=1
	     tk=substr(today,1,7); if(!(tk in seen)){seen[tk]=1; ord[++n]=tk}
	     v[tk]+=uvr+uvt; w[tk]+=uwr+uwt;
	     us=0; for(j=2;j<=km;j++){ u[j]=ENVIRON["TU" j "R"]+ENVIRON["TU" j "T"]; us+=u[j] }
	     if(us>0){ if(!(tk in nr) || (tk in hx)) hx[tk]=1; for(j=2;j<=km;j++) x[tk "_" j]+=u[j] }
	     s=n-11; if(s<1)s=1;
	     for(i=s;i<=n;i++){ k=ord[i]; printf "%s{\"d\":\"%s\",\"vpn\":%.0f,\"wan\":%.0f", (i>s?",":""), substr(k,3), v[k], w[k]
	       if(k in hx){ printf ",\"x\":["; for(j=2;j<=km;j++) printf "%s%.0f", (j>2?",":""), x[k "_" j]; printf "]" }
	       printf "}" } }' "$src")
else
	N=7; [ "$rng" = month ] && N=30
	days=$(tail -n "$N" "$src" 2>/dev/null | awk -v today="$today" -v uvr="$uvr" -v uvt="$uvt" -v uwr="$uwr" -v uwt="$uwt" -v km="$_kmax" 'BEGIN{OFMT="%.0f";CONVFMT="%.0f"}
	{ vpn=$3+$4; wan=$5+$6; hx=(NF>=12)
	  for(j=2;j<=km;j++){ f=2*j+3; x[j]=$f+$(f+1) }
	  if($2==today){ vpn+=uvr+uvt; wan+=uwr+uwt; us=0
	    for(j=2;j<=km;j++){ u=ENVIRON["TU" j "R"]+ENVIRON["TU" j "T"]; x[j]+=u; us+=u }
	    if(us>0) hx=1 }
	  printf "%s{\"d\":\"%s\",\"vpn\":%.0f,\"wan\":%.0f", (NR>1?",":""), substr($2,6), vpn, wan
	  if(hx){ printf ",\"x\":["; for(j=2;j<=km;j++) printf "%s%.0f", (j>2?",":""), x[j]; printf "]" }
	  printf "}" }')
fi

# --- «КУДА ИДЁТ ТРАФИК»: строки выходов + прямой путь ---------------------------------------
# СЧИТАЕМ ЗДЕСЬ, А НЕ В ПАНЕЛИ. «Напрямую» — это ВЫЧИТАНИЕ (весь WAN минус несущая минус выходы),
# и второй ответ на тот же вопрос в панели разошёлся бы с первым. Владелец ответа один.
# КЛАМП В НОЛЬ ОБЯЗАТЕЛЕН: в туннеле байт БОЛЬШЕ, чем на проводе (инкапсуляция), а в истории
# тестеров лежат дни, когда учёт несущей сбился (до 17.08.2026 смена несущей заряжала весь её
# счётчик, см. traffic-acct.sh) — отрицательное «напрямую»
# читалось бы как поломка панели, хотя сломан день в истории.
# ЧЕТЫРЕ ОКНА СЧИТАЕМ ОДНИМ ФОРКОМ и одной формулой: разведи их по вызовам — и «сегодня» с
# «неделей» разъедутся первой же правкой клампа. Сумму выходов окно приносит готовой (`?xr`/`?xt`
# из прохода выше), поэтому здесь на окно ровно три пары чисел. Пользовательских функций у
# busybox-awk нет — кламп выписан по строке на окно, а не спрятан в one-liner.
set -- $(awk -v twr="$tdwr" -v twt="$tdwt" -v tvr="$tdvr" -v tvt="$tdvt" -v tsr="$sxr" -v tst="$sxt" \
	-v awr="$wwr" -v awt="$wwt" -v avr="$wvr" -v avt="$wvt" -v asr="$wxr" -v ast="$wxt" \
	-v bwr="$mwr" -v bwt="$mwt" -v bvr="$mvr" -v bvt="$mvt" -v bsr="$mxr" -v bst="$mxt" \
	-v cwr="$ywr" -v cwt="$ywt" -v cvr="$yvr" -v cvt="$yvt" -v csr="$yxr" -v cst="$yxt" \
	'BEGIN{OFMT="%.0f";CONVFMT="%.0f";
	t1=twr-tvr-tsr; if(t1<0)t1=0; t2=twt-tvt-tst; if(t2<0)t2=0;
	a1=awr-avr-asr; if(a1<0)a1=0; a2=awt-avt-ast; if(a2<0)a2=0;
	b1=bwr-bvr-bsr; if(b1<0)b1=0; b2=bwt-bvt-bst; if(b2<0)b2=0;
	c1=cwr-cvr-csr; if(c1<0)c1=0; c2=cwt-cvt-cst; if(c2<0)c2=0;
	printf "%.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f", t1,t2,a1,a2,b1,b2,c1,c2 }')
dirr=${1:-0};  dirt=${2:-0}
wdirr=${3:-0}; wdirt=${4:-0}
mdirr=${5:-0}; mdirt=${6:-0}
ydirr=${7:-0}; ydirt=${8:-0}

# Строки доп-выходов: имя и транспорт — из реестра (`.slots`), объём — из счётчиков выше.
# `counted:false` = «считать нечем» (нет своей несущей: zapret или выключенный выход) — панель
# обязана сказать это словами, а не нарисовать ноль.
exits=''
SLOTS_FILE="$DS/.slots"
if [ -s "$SLOTS_FILE" ]; then
	_tab=$(printf '\t')
	while IFS="$_tab" read -r _sid _snb _stp _scfg _sfb _sen; do
		case "$_sid" in [2-7]) ;; *) continue ;; esac
		eval "_sif=\$sl${_sid}if; _sr=\$s${_sid}r; _st=\$s${_sid}t; _wr=\$w${_sid}r; _wt=\$w${_sid}t; _mr=\$m${_sid}r; _mt=\$m${_sid}t; _yr=\$y${_sid}r; _yt=\$y${_sid}t; _cr=\$cs${_sid}r; _ct=\$cs${_sid}t"
		# САНИТАЙЗ — ПРОВЕРКОЙ ФОРМЫ, А НЕ `tr`: поля едут в JSON как есть, а приезжают из файла
		# на флеше, и разорвать строку кавычкой нельзя дать. Через `tr` это было бы ТРИ форка на
		# выход, а панель дёргает CGI раз в пять секунд — на трёх выходах девять процессов каждые
		# пять секунд. `case` делает то же в шелле и вдобавок ЧЕСТНЕЕ: `tr` молча выкусывает
		# подозрительный символ и отдаёт огрызок, а мы отдаём ПУСТО — «не разобрали».
		case "$_stp" in ''|*[!a-z0-9]*) _stp="" ;; esac
		case "$_sif" in *[!a-z0-9._-]*) _sif="" ;; esac
		case "$_snb" in *[!A-Za-z0-9+/=]*) _snb="" ;; esac
		_son=false; [ "$_sen" = on ] && _son=true
		# «СЧИТАТЬ НЕЧЕМ» — ЭТО ПРО ЧИСЛО, А НЕ ПРО ИНТЕРФЕЙС. У выхода, выключенного в обед,
		# несущей уже нет, но сегодняшний объём у нас ЕСТЬ (он в полях посуточного файла) —
		# сказать про него «без счётчика» значило бы спрятать реальные гигабайты. А у
		# zapret-выхода нет ни несущей, ни полей: и вот он честно без счётчика.
		#
		# ...И ПОТОМУ ОТВЕТ СВОЙ У КАЖДОГО ОКНА (шаг 2g). Выход, снятый три дня назад, за СЕГОДНЯ
		# честно «без счётчика», а за НЕДЕЛЮ у него объём есть — и он уже вычтен из недельного
		# «напрямую». Один флаг на все окна означал бы либо спрятанные гигабайты в недельном
		# разрезе, либо нарисованный ноль в сегодняшнем: доли перестали бы сходиться в сто
		# процентов ровно на одном из экранов.
		_scn=false; _wcn=false; _mcn=false; _ycn=false
		[ -n "$_sif" ] && { _scn=true; _wcn=true; _mcn=true; _ycn=true; }
		# «есть ли ненулевой объём» — БЕЗ арифметики: числа тут за 2^31, а `$(())` у busybox
		# бывает 32-битной. Достаточно спросить, встречается ли в них цифра кроме нуля.
		case "$_sr$_st" in *[!0]*) _scn=true ;; esac
		case "$_wr$_wt" in *[!0]*) _wcn=true ;; esac
		case "$_mr$_mt" in *[!0]*) _mcn=true ;; esac
		case "$_yr$_yt" in *[!0]*) _ycn=true ;; esac
		# `cur_rx`/`cur_tx` — сырой счётчик несущей выхода (разбор у slot_now). Несущей нет —
		# нули, и панель по пустому `if` понимает, что вычитать из провода нечего: трафик такого
		# выхода (zapret) и так идёт по проводу напрямую.
		exits="$exits${exits:+,}$(printf '{"id":%s,"name_b64":"%s","transport":"%s","if":"%s","enabled":%s,"counted":%s,"rx":%s,"tx":%s,"week_counted":%s,"week_rx":%s,"week_tx":%s,"month_counted":%s,"month_rx":%s,"month_tx":%s,"year_counted":%s,"year_rx":%s,"year_tx":%s,"cur_rx":%s,"cur_tx":%s}' \
			"$_sid" "$_snb" "$_stp" "$_sif" "$_son" "$_scn" "${_sr:-0}" "${_st:-0}" \
			"$_wcn" "${_wr:-0}" "${_wt:-0}" "$_mcn" "${_mr:-0}" "${_mt:-0}" "$_ycn" "${_yr:-0}" "${_yt:-0}" \
			"${_cr:-0}" "${_ct:-0}")"
	done < "$SLOTS_FILE"
fi

printf '{"transport":"%s","vif":"%s","wan_if":"%s","vpn_rx":%s,"vpn_tx":%s,"wan_rx":%s,"wan_tx":%s,' \
	"$t" "$vif" "${wan_if:-?}" "${vrx:-0}" "${vtx:-0}" "${wrx:-0}" "${wtx:-0}"
printf '"exits":[%s],"direct_rx":%s,"direct_tx":%s,' "$exits" "$dirr" "$dirt"
printf '"today_vpn_rx":%s,"today_vpn_tx":%s,"today_wan_rx":%s,"today_wan_tx":%s,' "$tdvr" "$tdvt" "$tdwr" "$tdwt"
printf '"week_vpn_rx":%s,"week_vpn_tx":%s,"week_wan_rx":%s,"week_wan_tx":%s,"week_direct_rx":%s,"week_direct_tx":%s,' "$wvr" "$wvt" "$wwr" "$wwt" "$wdirr" "$wdirt"
printf '"month_vpn_rx":%s,"month_vpn_tx":%s,"month_wan_rx":%s,"month_wan_tx":%s,"month_direct_rx":%s,"month_direct_tx":%s,' "$mvr" "$mvt" "$mwr" "$mwt" "$mdirr" "$mdirt"
printf '"year_vpn_rx":%s,"year_vpn_tx":%s,"year_wan_rx":%s,"year_wan_tx":%s,"year_direct_rx":%s,"year_direct_tx":%s,' "$yvr" "$yvt" "$ywr" "$ywt" "$ydirr" "$ydirt"
