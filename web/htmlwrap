#!/bin/sh
# htmlwrap — uhttpd-интерпретатор для *.html панели: отдаёт документ с `Cache-Control: no-cache`.
#
# ЗАЧЕМ (поймано на железе AX3600 2026-07-21). Стоковый uhttpd отдаёт статику с ETag/Last-Modified,
# но БЕЗ `Cache-Control` ⇒ браузер кэширует ЭВРИСТИЧЕСКИ (~10% возраста файла) и после обновления
# панели может держать СТАРЫЙ index.html. Инвариант `?v=<CODE>` спасает только ПОДресурсы
# (panel.js/panel.css): если сам документ приехал из кэша, в нём и ссылка старая — панель
# показывает прошлую версию («карточки DoH нет», «фича не приехала»), и это невоспроизводимо,
# потому что зависит от возраста кэш-записи. У uhttpd нет опции заголовков (`uhttpd -h` — только
# докрут/CGI/аутентификация), зато есть `-i .ext=<интерпретатор>`: файл с этим расширением
# исполняется как CGI, а значит МЫ печатаем заголовки. Отсюда этот скрипт (`web-ui.sh` передаёт
# `-i .html=$DOCROOT/htmlwrap`).
#
# Документ ~21 КБ и запрашивается раз на открытие панели ⇒ отказ от кэша документа ничего не стоит;
# тяжёлые panel.js/panel.css по-прежнему кэшируются и рвутся по `?v=<CODE>` — здесь ничего не меняем.
#
# ГРАБЛЯ: путь к файлу uhttpd передаёт первым аргументом (как обычный `#!`-интерпретатор), но
# подстраховываемся CGI-переменными — иначе ошибка в одной сборке uhttpd = белая страница вместо панели.

f="$1"
[ -n "$f" ] || f="$PATH_TRANSLATED"
[ -n "$f" ] || f="$SCRIPT_FILENAME"

if [ ! -f "$f" ]; then
	printf 'Status: 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nnot found\n'
	exit 0
fi

printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-cache, must-revalidate\r\n\r\n'
cat "$f"
